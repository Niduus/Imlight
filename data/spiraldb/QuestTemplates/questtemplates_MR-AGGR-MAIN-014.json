            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Sultana, I have some bad news. During the battle, the Thuggies seized the opportunity to break into the Palace Treasure Vault!",
            "m_picture": "GUI/NpcPortraits/Portrait_FennecFox_Boss_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Swan_MIR_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1404010,
