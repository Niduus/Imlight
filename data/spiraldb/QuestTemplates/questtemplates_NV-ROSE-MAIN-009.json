            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello, Wizard. I presume it is now time I introduced myself properly?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/The_Valet_NV-ROSE_022.mp3",
