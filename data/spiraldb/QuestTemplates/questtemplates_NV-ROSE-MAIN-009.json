            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I never realized how hard the Spiral makes it to do good. It's impossible. I give. They take. They ask for more.",
