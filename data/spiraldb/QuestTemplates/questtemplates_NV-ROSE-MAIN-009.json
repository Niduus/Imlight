          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "The Valet X Manticore",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/The_Valet_X_Manticore_NV-ROSE_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well past time, you loafing lummox of LIES! Who are you really?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-ROSE_083.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520450,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV_Standin_Manticore_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am Manticore. I am the savior of the First World.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Manticore_NV-ROSE_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520557,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV_Standin_Manticore_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "When I first went to Polaris, I saw it as a simple, young, arrogant, and easily duped society. A possible base of operations and nothing more.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Manticore_NV-ROSE_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520557,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You swine! How dare you! We are going to-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-ROSE_084.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520450,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV_Standin_Manticore_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Chaotic. Indecisive. Passionate, but aimless. Perfect for infiltration and indoctrination. Little did I realize you would stumble on this...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Manticore_NV-ROSE_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520557,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV_Standin_Manticore_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This Dasein can generate matter and magic through will alone. He can expand across the Skyways, through and over every world.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Manticore_NV-ROSE_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520557,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV_Standin_Manticore_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He can be the glue that binds us all together as we were always meant to be. He just needs more guidance.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Manticore_NV-ROSE_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520557,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well? Go stop him!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-ROSE_085.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520450,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-DEstate-NPC26-B_Persona",
