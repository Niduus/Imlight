  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You should follow Keziah and that Runa lady back to the Outsiders Camp, make sure she sticks to the deal she promised us. But, don't be a stranger, okay?",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_207.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-019_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Uh-huh.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-BLACK_094.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700051,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-019_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Our cure still isn't perfect. We haven't found a way around the rapid aging. Using it now could be...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-BLACK_095.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700051,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-019_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Horrible.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-BLACK_096.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700051,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-019_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But Velma promised me help from the Arcanum, in exchange for anything I can find out about Miranda Briar.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-BLACK_097.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700051,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-019_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Maybe we won't have to resort to the worst. We'll see.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-BLACK_098.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700051,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-019_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yeah...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-BLACK_099.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700051,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-019_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If I were you, Scion of Bartleby, I might have a few questions to ask of my master.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-BLACK_100.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700051,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-019_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But that's just me.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-BLACK_101.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700051,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My Scion, I see that Miranda Briar is no longer among the living. I know this road was a difficult one, but-",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "WHAT? No, the seed, I know she absorbed it, but that... she became a dream?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Did you truly think me unaware of the Dreaming? I may not see it as I see all else, but I see the events that occurred because of it.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes... as I see all things. You cannot understand the burden of omniscience, to know that the fate of worlds shifts upon my whim...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...There are times I miss the absence of my eye. Yet in that moment of blindness, I let a rot fester, one who moves now unseen through time and space.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I cannot see her future, nor even the actions she might take. They splinter off into a kaleidoscope of possibility.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Miranda Briar has fractured tomorrow and even I cannot see what she will do next.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You let her go, I understand. I have had a long time to process this moment of... uncertainty. I considered warning you about Sybil...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...I thought perhaps I could prepare you for the Scholomance. But the dreams, Wizard, the nightmare tomorrows...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Without Sybil's death, you are slow to reach Darkmoor, Lucy never escapes Graveholm, the Mortal Plain never rebels. And Miranda Briar still vanishes.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Omniscience is a curse, my Scion, a constant choice between evils. I can only hope I made the right one.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Because what Miranda Briar has become, I cannot foresee; her future actions send so many ripples as to wash out her goal.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I cannot see her. I cannot predict her. And I have no idea what Miranda Briar may do next.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bartleby_DM-BLACK_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38230,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
