                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/LoganSpiralGlider_KH2_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283192,
