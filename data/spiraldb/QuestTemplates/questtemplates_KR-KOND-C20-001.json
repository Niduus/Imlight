                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/LoganSpiralGlider_KH2_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283192,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
