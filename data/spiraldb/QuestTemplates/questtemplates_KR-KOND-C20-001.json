            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No Hopper can break the Shadow Queen's curse, so I must live here in this cave, alone, for all eternity. :Cough:",
            "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_E_NPC.dds",
