                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Did you get the missing Elixir ingredients? Good. Let me have them. Give me a moment to grind the Plumeria Blossoms in...",
                "m_picture": "GUI/NpcPortraits/Portrait_Moth_SageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/LoganSpiralGlider_KH2_11.mp3",
