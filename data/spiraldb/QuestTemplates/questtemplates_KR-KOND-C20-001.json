            "m_dialogEvent": "",
            "m_actorTemplateID": 1283228,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-KondhaDesert-NPC26_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "With a flick of her fur-less finger, she cast the same fate upon me that she cast upon the forest: a never-die-life of sand.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_E_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/DuranDuneFather_KH2_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283228,
            "m_cameraName": ""
          },
          {
