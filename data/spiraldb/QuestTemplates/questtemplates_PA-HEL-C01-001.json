  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm glad you stopped by. Strange stories have reached my ears, tales of a sorcerer inhabiting a tower on Pegasus Place.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Belladonna_Crisp.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BelladonnaCrisp_WYS_96.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465135,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They call him Lyon Lorestriker, and it is said that he has dark plans for all of Wysteria... and the rest of the Spiral.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Belladonna_Crisp.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BelladonnaCrisp_WYS_97.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465135,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Lyon has possession of a powerful magic gem that gives him incredible powers... a gem known as the Heart of the Helephant!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Belladonna_Crisp.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BelladonnaCrisp_WYS_98.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465135,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go and investigate the sealed Tower of the Helephant, on Pegasus Place, recover the Heart of the Helephant, and bring it to me.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Belladonna_Crisp.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BelladonnaCrisp_WYS_99.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465135,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The doors to the tower are sealed... so you may need to find another way into the tower. I am sure you will find a means...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Belladonna_Crisp.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BelladonnaCrisp_WYS_100.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465135,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC03_Persona",
