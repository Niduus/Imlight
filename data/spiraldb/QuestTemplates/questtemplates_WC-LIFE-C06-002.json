      "m_displayImage1": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Welcome to the Atheneum, young Wizard from afar. How can I help you on this fine day?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_41.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh dear... it seems that the state of the facilities being what they are now, I will have some difficulty helping you with that request. There was a crystal with the Rota of Reading on it, but it may have been looted. Let me check the records...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_42.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh my... you're in luck! That crystal was checked out before the invasion. It's in the hands of... oh my... you're out of luck. It's in the hands of the Collector, an irredeemable thief of crystals and what have you.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_43.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you think you can recover it from her, you've clearly gone cuckoo.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_44.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What's that? You only found half of the crystal? Oh my... that won't do! Half a Rota is no Rota at all. Let me check the records here... perhaps I can help you.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_45.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "My apologies... I didn't notice this notation. The crystal was returned in a damaged fashion. We fined his account, but he never paid.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_46.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The previous borrower was Scarrik Gallowgaunt, an unscrupulous opportunist that used the Dragon Titan's raid to claim some power. You should go check with him and see if he has the other half. He dwells in the Labyrinth.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_47.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Good work! You've recovered both parts of the crystal. I'll get it mended and ready for you to watch.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_48.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I always keep a roll of crystal tape on hand for repairs like that. Good as new! Step right over to the crystal stand and place it into the slot... you should be able to learn the Rota of Reading from that crystal. \\n",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_49.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              }
            ]
          }
