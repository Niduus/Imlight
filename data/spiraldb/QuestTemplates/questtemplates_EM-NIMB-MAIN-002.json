            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-NIMB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And so the bugs scurry away from the Forces of Light! As they should. Flee, miscreants, flee for your lives!",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Noble_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Vanitus_EM2_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1413241,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-NIMB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wait! Where is Captain Pork?",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Crewman_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Sparck_EM2_61.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1413243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-NIMB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I... I can't be sure with all the commotion. But I do believe I saw those Dark Cloud brigands carry him away.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Noble_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Vanitus_EM2_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1413241,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-NIMB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Then we must rescue him at once.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Crewman_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Sparck_EM2_62.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1413243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-NIMB-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, of course you must. Lord Vanitus, see to the details of the rescue outside, would you? We feel we must rest.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_RulerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Vicereine_EM2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1413250,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-NIMB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As you wish, Vicereine. Come, Wizard, meet me in the Citadel Proper.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Noble_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Vanitus_EM2_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1413241,
                "m_cameraName": ""
              }
            ]
          }
