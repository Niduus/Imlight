                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The saboteurs are caught, their efforts undone. A conflict with Puerto Nuovo was averted. And New Vicorgia grows by the day. You were... adequate.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_Governor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Rottingham_Weiler_NV-CONA_033.mp3",
