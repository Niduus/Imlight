            "m_personaName": "NV-CON-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Do you think friendship can survive death itself? You must warn the others here.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_033.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546270,
