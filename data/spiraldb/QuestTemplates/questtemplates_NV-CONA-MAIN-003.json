            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You're a hero, they'll listen. This world is a trap and they must leave before it snaps shut.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_034.mp3",
