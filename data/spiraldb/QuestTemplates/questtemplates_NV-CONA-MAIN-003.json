            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "AAAH! You heard that, yes? It speaks from everywhere. A voice from a thousand mouths. You know who it is. And you know that because of you, it died.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
