                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, the central rock. I thought we were calling it \"New Regent's Square.\" At any rate, I'll send troops to pick up that yipping papillon.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_Governor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Rottingham_Weiler_NV-CONA_032.mp3",
