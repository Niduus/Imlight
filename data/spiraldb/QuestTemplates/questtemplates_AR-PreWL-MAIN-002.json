    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh no, I couldn't come with you for the same reasons we never accompany you: there's far too much to study. Besides there may still be... warrants.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Zander_AR-PreWL_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340970,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your task is simple, the experience anything but. Cross the Outback to reach the Dreaming. Then take the soil you brought with you from Novus and-",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Zander_AR-PreWL_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340970,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You didn't bring soil from Novus? I could have sworn I told you to. Hmm, maybe not. Things were quite hectic here at the time.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Zander_AR-PreWL_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340970,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "At any rate, you need that soil. It is Novus. Novus is Dasein. Bringing that to the Dreaming will bring Dasein there too.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Zander_AR-PreWL_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340970,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Quickly, return to Conatus and collect a soil sample.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Zander_AR-PreWL_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340970,
            "m_cameraName": ""
          }
        ]
      },
