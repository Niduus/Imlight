            "m_personaName": "AH-FLOOD-NPC02-F_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "She's here. She's just over there and we can't reach. Jaki, what about your Ice Grenades, can they freeze the water?",
