            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So unplug it and plug it back in. I don't care whose soul it is.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_Distant_AH-FLOOD_002.mp3",
