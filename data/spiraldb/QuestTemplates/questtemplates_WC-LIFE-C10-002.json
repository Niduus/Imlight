            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Those spells must be recovered! Venture, if you can, to Dragonspyre, where you must speak with Milos Bookwyrm in the Atheneum.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfMoolindaWu_ZFA_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38204,
