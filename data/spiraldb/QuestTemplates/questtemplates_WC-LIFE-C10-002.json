            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfMoolindaWu_ZFA_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
