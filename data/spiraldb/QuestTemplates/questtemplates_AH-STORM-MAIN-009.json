      "m_displayImage1": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "All of them... they're all just... gone. I convinced them. I made them understand, made them convert... just to end like this...",
                "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-STORM_023.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1753027,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Not necessarily. They could have swam for it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_NomadF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phillis_Windstone_AH-STORM_020.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1753023,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Do you know what did this?",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-STORM_061.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765150,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Could have been anything. Briar hitched at a lot of ports before coming here, found things at each of them, but she wasn't keen on sharing details.",
                "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-STORM_024.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1753027,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As we sailed here, though, there was always something... rumbling below... a low tremor. We thought it was the waves.",
                "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-STORM_025.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1753027,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Great. Another mystery. Well, I suppose we best be getting' back to the others then and figure out our next move.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-STORM_057.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779132,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm enlisting too. You're after Miranda Briar, who... did <italics>this... </italics>to her crew, to my crew. One of our ships has a plank with her name on it.",
                "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-STORM_026.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1753027,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, nice to see you buoyed up about something other than sacrificing us. I'll sail with you back to Captain Powe.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_NomadF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phillis_Windstone_AH-STORM_021.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1753023,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC06B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But then I'm going to find Soulik Shelli. We need to rally the troopers and find that bilge rat.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_NomadF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phillis_Windstone_AH-STORM_022.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1753023,
                "m_cameraName": ""
              }
            ]
          }
        ]
