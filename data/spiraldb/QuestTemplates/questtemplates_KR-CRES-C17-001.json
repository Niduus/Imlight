              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-CrescentBeach-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Spellbinder, maybe your bug-friend forgot to give you all of the true-yarns. You better ask him soft-soft again.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/JoshuaRazorWeed_KH2_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283101,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-CrescentBeach-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now the Pen looks like it will catch-and-hold a hug-em squeeze-em Goat Weaver! Thanks for your work-sweat, Spellbinder.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/JoshuaRazorWeed_KH2_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283101,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
