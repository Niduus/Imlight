                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So now, we just still-wait? This makes no wise-sense. Why would the Goat Weaver just hop into... this?",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/JoshuaRazorWeed_KH2_08.mp3",
