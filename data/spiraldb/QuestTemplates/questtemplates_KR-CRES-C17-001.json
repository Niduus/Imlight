                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It shouldn't be long until a hungry Goat Weaver hops into the Pen for some Comestibles. I better keep my eyes razored to trap him!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_B_NPC.dds",
