            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KtorrJrrol_KHR_47.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-TyrianGorge-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I need you to make some Cinnactin Powder. Start by collecting Cinnabar Dust here in the Gorge.",
            "m_picture": "GUI/NpcPortraits/Portrait_Millipede_Warrior_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KtorrJrrol_KHR_48.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-TyrianGorge-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then go to the Moon Cliffs and extract Sassafras Essence from the Sassafras Men. Don't worry, they won't feel it.",
            "m_picture": "GUI/NpcPortraits/Portrait_Millipede_Warrior_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KtorrJrrol_KHR_49.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-TyrianGorge-NPC02_Persona",
            "m_nameOverride": "",
