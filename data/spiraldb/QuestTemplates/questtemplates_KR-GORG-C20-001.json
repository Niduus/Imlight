            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-TyrianGorge-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now a foot itch might not sound so bad to a strange creature like you, but you don't have one hundred feet to scratch.",
