            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Listen Spellbinder, I've got a company to captain. If you're going to be down here, you might as well be of good use.",
            "m_picture": "GUI/NpcPortraits/Portrait_Millipede_Warrior_H_NPC.dds",
