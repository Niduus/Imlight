            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Those miserable grubs I call soldiers are having trouble working because they've been hit by an outbreak of Sweaty Foot Fungus.",
