            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, no, well... sometimes. If I meet something that really needs deading, you know.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Quest_Complete.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bloop_AH-PRIM_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1756041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-PRIM-NPC02-K_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And if we let you out, are we suddenly going to need deading?",
            "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Tarrak_Hadfield_AH-PRIM_111.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1761075,
