            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, that is in the Eastern Sea... somewhere. I can definitely help you... if you free me.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Quest_Complete.dds",
