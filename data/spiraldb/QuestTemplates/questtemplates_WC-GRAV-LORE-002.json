  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What does it mean? I don't understand! No Pekrons here! Other areas have Pekrons, some high concentrations, some low, but I have no idea why!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_39.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You... you've been working with me. You were there at Unicorn Park. Are you not completely flabbergasted with this business?",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_40.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "On one hand, it's entirely made up - Pekuliarities are impossible, but on the other hand, we saw it with our own two, er four eyes!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_41.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bah! Stop doubting, Aegon! Stop doubting! We must try to figure out why some areas of the Spiral have higher concentrations than others.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_42.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is another member of our Order, a Necromancer named Jordyn Malniz - she's been doing some more... radical experiments with Pekrons.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_43.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I recently lost contact with Jordyn, and I fear some trouble may have befallen her. Visit her lab in Marleybone and make sure she's safe.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_44.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My goodness. You don't think THEY got to Jordyn, do you? I certainly hope not. Do hurry and make sure she's all right.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_45.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          }
        ]
