                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You're back? I mean... you're back! But where is Jordyn? She's leaving the Order? That's impossible! Why would she... she became possessed? Oh dear!",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_46.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I knew these Pekuliarities were dangerous, but not that dangerous! I will have to think on this. Yes. Indeed.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_47.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In the meantime, however, we will continue with your assignments. Keep checking in daily. Until tomorrow then. Yes.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
