  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As I was saying... it's dinner time!",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FLOOD_099.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752125,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Actually, I think it's time to hear what the Wiz-Kid learned in the Akashic Records.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The what?",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Qismah_Shasa_AH-FLOOD_062.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752090,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The living memory of all Eldritch discoveries. They're everywhere here... though getting to them can be tricky.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_027.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What do you want from me? The Access Point is broken. We'll have to try something else.",
            "m_picture": "GUI/NpcPortraits/TurtleFanatic_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Snaps_AH-FLOOD_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752128,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Mythic Bleeds, that's what they are! This broken access point spilling out these records...",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FLOOD_100.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752125,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bingo. But the Akasha doesn't just share memory, it absorbs it, channels it, reflects it. Whoops, probably should have done this part at 'absorbs.'",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_028.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "See, the Access Point is broken, so the Akasha gets unstable and well...",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_029.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ahhhh!",
            "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Jaki_Whisperwind_AH-FLOOD_080.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1791000,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Friends, Wiz-Kid, they're a liability. Now you're going to save them instead of dragging me to the Arcanum like the good little servant you are.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_030.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Whereas I...",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_031.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Huh? What? What are you doing?",
            "m_picture": "GUI/NpcPortraits/TurtleFanatic_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Snaps_AH-FLOOD_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752128,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ahhhhh!",
            "m_picture": "GUI/NpcPortraits/TurtleFanatic_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Snaps_AH-FLOOD_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752128,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...I can be more flexible. It's liberating. Freedom is independence. No friends to save, no gods to obey. Just you and your mission.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_032.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ha! Fair point. Big loner me, I keep trying to recruit you, don't I? That's not friendship, though, kid. That's... courtesy.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_033.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FLOOD-NPC02-I_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And courtesy has its limits. Now off you go. Save your friends and mine. There really isn't any choice, is there?",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-FLOOD_034.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752129,
            "m_cameraName": ""
          }
        ]
