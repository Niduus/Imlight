          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I thank you for restoring the Spiral Cup to its rightful place. Though you have proved a worthy duelist, I feel it will stay here.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_32.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The student you face for your final round of the tournament is none other than Randolf Spellshine.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_33.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Randolf is my greatest pupil, the finest student I have ever taught in all of my years at Pigswick Academy.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_34.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Still, you must at least attempt the formality of the duel. Go to the Hall of the Gorgon, to face your defeat.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_35.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Unbelievable! This hall will be the emptier for the lack of the cup that has adorned it for so long.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_36.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Go and tell Headmistress Crisp that Pigswick's record is broken, and that Ravenwood is the winner now.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_37.mp3",
                "m_action": "",
