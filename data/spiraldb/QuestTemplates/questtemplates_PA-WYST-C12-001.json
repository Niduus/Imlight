            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm relieved to put the matter of the missing Spiral Cup behind us, and I apologize for our suspicions.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Belladonna_Crisp.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BelladonnaCrisp_WYS_67.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465135,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you be so kind as to return the cup to the Tournament Hall, and to speak to Master Glendemming about your final match?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Belladonna_Crisp.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BelladonnaCrisp_WYS_68.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465135,
            "m_cameraName": ""
          }
        ]
      },
