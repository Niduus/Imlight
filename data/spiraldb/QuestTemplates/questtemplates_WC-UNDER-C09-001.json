                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wait a moment... you are no simple baker of tasty pastries, are you? You stand revealed as a Wizard of Wizard City.",
