            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, what is the vexation if I pilfered a small quantity of Dream Water from the infinite reserve of the Drovers?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Owner_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Mr_Cane_WL-BILLA_008.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608172,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "'Cause we have a treaty to do exactly not that. This is the sort of thing that could lead to civil war.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Superior_Judge_Rozzer_WL-BILLA_024.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608179,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Is that not already transpiring? Those marauders on the avian steeds, are they not Drover-born?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Owner_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Mr_Cane_WL-BILLA_009.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608172,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Could be they're behind these monsters. Trying to take back the Dreaming, even though it should belong to ALL of Wallaru.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Kangaroos_Judge_E_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Nelson_WL-BILLA_011.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608180,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Emu Riders are not allied with the Drovers. They're attacking them as well. Attacking them with... Drop Bears.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Joan_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Joan_Locke_WL-BILLA_059.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608167,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Blast me for a fool! The answer is obvious. The Emu Riders are unleashing the monsters upon both groups! We must tell Morp at once!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Joan_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Joan_Locke_WL-BILLA_060.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608167,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, yes, Ms. Locke, go play with your backwood allies. I have dreams to sell.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Owner_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Mr_Cane_WL-BILLA_010.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608172,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Do not mistake me, Mr. Cane. Your unlawful exploits will be among my topics of discussion as well.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Joan_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Joan_Locke_WL-BILLA_061.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608167,
                "m_cameraName": ""
              }
            ]
