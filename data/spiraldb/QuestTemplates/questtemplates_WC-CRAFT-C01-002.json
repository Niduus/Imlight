            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you placed your Basic Crafting Table in your dorm room or castle and made the Daggers of Absolution? Return here when you've got those for me. You must bring the two daggers to me, as requested.",
            "m_picture": "GUI/NpcPortraits/Human_WCShopKeepF_E_NPC.dds",
