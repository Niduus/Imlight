            "m_personaName": "WC-Shop-Recipe-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now with your work-table, you can begin to learn the fine trade of crafting, making your own items.",
            "m_picture": "GUI/NpcPortraits/Human_WCShopKeepF_E_NPC.dds",
