    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Treacle? That does give us one possible suspect for the gang's leader... but no, it's inconceivable. He's the most trusted name in all of Marleybone...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_Governor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Rottingham_Weiler_NV-NEWV_024.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546202,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "General Benedict Brutus von Booth. Yet I can't deny his unfathomable love for that putrid Treacle. And his family does hold title in Karamelle.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_Governor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Rottingham_Weiler_NV-NEWV_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546202,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Dash it all, we must investigate him. He's a right pain in the tail though, so I can't do anything officially. Thus I'm throwing you to the wolves.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_Governor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Rottingham_Weiler_NV-NEWV_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546202,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, don't be so fussy. It's just metaphorical wolves. Though I suppose, it would literally be angry dogs. At any rate, to Booth's home with you!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_Governor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Rottingham_Weiler_NV-NEWV_027.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546202,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC02_Persona",
