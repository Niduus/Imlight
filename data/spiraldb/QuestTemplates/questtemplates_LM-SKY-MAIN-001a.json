  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You seek the wonders of the Old One? You've come to the right place - alone of his children, we have fully embraced his wisdom!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Zogi_Mogi_LM-SKY_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524724,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "SkyCity Citizen A",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But they are an alien - from the corrupt world below! They clearly stole Duck Savage's autogyro - they must have corrupted Buck!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_Citizen_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/SkyCity_Citizen_A_LM-SKY_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I do not believe so, my fellow citizens. My apologies again, Wizard.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Zogi_Mogi_LM-SKY_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524724,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Buck Gordon has been... corrupted into being unmutual by forces unknown. But how was he corrupted? We do not know.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Zogi_Mogi_LM-SKY_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524724,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Please, allow me to show you our utopia, the fulfillment of the Old One's dream, and you will see no evil could reside here.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Zogi_Mogi_LM-SKY_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524724,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You've only one Stone left now, my Champion. Well done. Everything is better when you adhere to my design.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-SKY_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I learned a lesson from the Manders: left to their own devices, the peoples of the Spiral will not advance, they will decline into barbarism.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-SKY_027.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I now believe that the First World was not simply fractured. It was also <italics>warped</italics>. Its pieces cannot simply be reassembled.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-SKY_028.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Creating a new First World will take more than raw power. It will take craftsmanship. It will take artistry. It will take <italics>vision</italics>.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-SKY_029.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And I am the only one who sees clearly what must be done.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-SKY_030.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are not a citizen. But I still welcome you to our Community. We live in mutual peace, harmony, and contentment. Our Community is perfect.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/SkyCity_Citizen_D_LM-SKY_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524733,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are not a citizen. But... oh wait, I already said that. Welcome! And goodbye.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/SkyCity_Citizen_D_LM-SKY_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524733,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have never seen your like before. Where do you come from? The... Spiral? Fascinating! Is it part of the world below?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/SkyCity_Citizen_E_LM-SKY_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524734,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm sure it is a wonderful place, or it must seem so to beings who do not dwell in our Community. Which is perfect.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/SkyCity_Citizen_E_LM-SKY_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524734,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We live in mutual peace, harmony, and contentment. To do otherwise would be unmutual. Be seeing you!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/SkyCity_Citizen_E_LM-SKY_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524734,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are the Outsider that has come among us! What do you think of our Community? We live in mutual peace, harmony, and contentment.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/SkyCity_Citizen_F_LM-SKY_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524735,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Sky City Citizen Crowd",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mutual peace, harmony, and contentment.",
            "m_picture": "GUI/NpcPortraits/Portrait_Platypus_CitizenF_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Sky_City_Citizen_Crowd_LM-SKY_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I hope you learn that, and quickly. You must join in our harmony. I would hate to see you declared unmutual.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Platypus_CitizenF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/SkyCity_Citizen_F_LM-SKY_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524735,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I wonder what awaits us in the Guest Tower. Mutual Peace, harmony, and contentment, no doubt.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-SKY_129.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524717,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Thank goodness you're safe! I got to you just in time!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Wilma_Deering_LM-SKY_002.mp3",
