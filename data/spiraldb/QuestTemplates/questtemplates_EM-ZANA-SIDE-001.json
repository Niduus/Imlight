  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Sssh! Do you hear it? LISTEN! The Chewing... Munching... Noshing... Gobbling! They think I'm mad. But I'm the only one who knows the truth!",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Prophet_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Shadow is not our greatest enemy. No. The greatest threat to the Alphoi is cake. And pie! And cookies! It's our own gluttony!",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Prophet_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Gobblers, scourge of the edible worlds. You know of them, yes? Would it surprise you to learn that we Alphoi <ITALICS>are </ITALICS> Gobblers?",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Prophet_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Or, better to say, they are us. Or they were us. Point is, they succumbed to the cravings - to the cake's lies! They... devolved.",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Prophet_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I won't let that happen again. We must spread the message of restraint and moderation, or else Zanadu will suffer a fate far worse than the Shadow.",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Prophet_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But I'm not exactly allowed inside the Leisure Dome at present. Could you distribute these Pamphlets to the Alphoi patrons inside?",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Prophet_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Cakes leave crumbs. Crumbs bring spiders. Grandfather Spider. Hurry with those pamphlets.",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Prophet_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
