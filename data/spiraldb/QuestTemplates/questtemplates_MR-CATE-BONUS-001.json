            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Being a numismatist - that's a fancy way of saying coin collector - my life's work is collecting coins from every era of Mirage's history.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_MerchantF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Amahl_MIR_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254088,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've explored and excavated nearly every inch of Mirage, only to discover that the best source of ancient coinage is the Scaly Trengils!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_MerchantF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Amahl_MIR_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254088,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you happen to recover any shiny Antique Coins from the Scaly Trengils, I'll gladly trade you for coinage you can actually use!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_MerchantF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Amahl_MIR_04.mp3",
