      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC01-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The White Symbol leads to the time of the Eldritch's Downfall. We know Bartleby finishing the Song of Creation negated the fluid ways they used magic.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_149.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752243,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC01-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The six fundamental Schools solidified and consumed all other strands or threads, as they called them. But it's still strange they couldn't adapt.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_150.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752243,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC01-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Maybe in the collapse of their civilization, we can find the key to how they started it.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_151.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752243,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
