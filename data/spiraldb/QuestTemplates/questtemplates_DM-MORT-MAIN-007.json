  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*Cough Cough Cough* I don't... I am sorry... give me a moment",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_074.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Lucy... we've talked about this. You can't exert yourself.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_081.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am fine, Madam Briar. It is just... all these photographs, the things we do, the things I used to do with nary a second thought.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_075.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Tis not your cure, but revelation that makes me ill. We have silenced artists, driven people from their homes, destroyed families.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_076.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "All so we could sate our gluttonous appetites. It's... I.... *cough cough cough cough*",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_077.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And that's enough. Come on, let me take you to the Magicians, see what's happening.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_082.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, perhaps you are right.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_078.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You should probably share those photos with the crowd, Wiz-Kid.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_083.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Burn all who disparage our noble Lords!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_A_MOB.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Angry_Villager_A_DM-MORT_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687177,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Angry Villager",
            "m_picture": "",
            "m_soundFile": "",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Good luck with that.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_084.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Am I mad or did these three not just ascend? Yet this Photomance shows them in the woods, as human. Quincy never went near the woods. Tis a forgery!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Angry_Villager_A_DM-MORT_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687177,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could be. I don't go near the woods either, but just woke up out there tonight with this strange child gawking at me.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Luther_Tillman_DM-MORT_015.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687170,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And I got to wonder about that harp in the Mayor's House. That belongs to Mina, I know, only one of you lumps worth the air you breathe.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Luther_Tillman_DM-MORT_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687170,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Listen to the Wizard. They speak the truth. We are not protected, we are devoured. Some through ascension. Some disappear in the woods.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Others, like me, take ill or get injured and succumb to our wounds. But all of it is a lie to cover up the House of Cups' only interest...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...Death.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello, Wizard. Worry not, for tis only Lucy. *Cough Cough* As I spoke to the Broken Branch, I convinced them to aid us.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So I joined them. I lead them. I am Death for them, and death for the immortals. Together, we will topple the House of Cups.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          }
        ]
      }
    ]
