      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, the wayward Shadowmancer! And she brings a friend. What would ever possess the mighty scholar to return to this world she so hates?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderQueen_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Queen_Glorina_DM-OUT_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ha! She retains her sharp tongue. Good, good. If we cannot slay our enemies, let us at least wound their pride. Now what do you wish?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderQueen_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Queen_Glorina_DM-OUT_002.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Her, I know not. But them, ah, theirs is a name even the Great Houses have learned to fear. And, lucky for you, we camp now near their grand city.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderQueen_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Queen_Glorina_DM-OUT_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We may have sufficient ingredients for one glamour. Your friend can ask after them. You and I, child, have much catching up to do.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderQueen_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Queen_Glorina_DM-OUT_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687136,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
