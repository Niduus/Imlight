                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It does sound very similar to things the Sisters would tell us.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Baukclaw_DM-OUT_015.mp3",
