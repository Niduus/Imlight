            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And more rescued waifs have joined our caravan! Good. As our numbers grow, so does our strength. No creature of the night shall ambush us again.",
