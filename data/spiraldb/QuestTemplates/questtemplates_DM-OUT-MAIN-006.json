              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-BLACK-NPC-001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, the original founder of the Scholomance used everything they could get their hands on, so it stands to reason they used Shadow...",
                "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-OUT_172.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700033,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-BLACK-NPC-001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "...But that doesn't make Shadow anymore evil than the early Fire or Life Magic they used. It's all a matter of what you do with it.",
                "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-OUT_173.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700033,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-BLACK-NPC-001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Maybe I can show you someday. And, yes, I see you there, Wizard.",
                "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-OUT_174.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700033,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-BLACK-NPC-001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Look, I'm not really the mushy sort, yeah? You saw stuff about me I didn't want to face... but I think I needed to... I don't know. Just...",
                "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-OUT_175.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700033,
