                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "...Thanks.",
                "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-OUT_176.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700033,
