  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Or at least that's what we're calling it. A piece of it did appear above Regent's Square after all. There is some disagreement here, however...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_DesertExplorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Erasmus_Snifflesworth_NV-CONA_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546272,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I should say so. This world shines also above the new Polaris. I did not get fired here from a cannon to let some Dog name it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-CONA_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My feathered friend, is that how you arrived? You should have invested in Valencian steel airships. They weather the harsh winds quite well.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_NobleF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Contessa_DiNario_NV-CONA_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546274,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "At least we didn't crash this time when I - yes, I - mapped the skies to this place. That is why I should name it... er... Wizard, what should I name it?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-CONA_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546273,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Novus, you say? Oui, oui, if this name suits the Hero of La Pingouin Revolution, it suits all of Polaris!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-CONA_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Novus is indeed a fine name. Because it's new, naturally! Now what say you, Wizard, shall I give you the tour? Splendid! This way!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_DesertExplorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Erasmus_Snifflesworth_NV-CONA_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546272,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Tell them, Wizard! Tell them of the whispers and the screams and the dead things that live again! Tell them about this world.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546270,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Actually, ravings aside, that is something I would very much like to know. You call this world Novus. This central hub, what do you call it?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-CONA_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546273,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The poisoned Conatus!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_027.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546270,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Conatus, fine. And you say dead things live again? Interesting. Perhaps, Wizard, you should follow me to Puerto Nuovo to tell us all you know.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-CONA_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546273,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your friends there are not invited. We do not know them. Or trust them. Or care for the general tallness of them. Ditch them, then come find us.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-CONA_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546273,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Fools! All of you are fools!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_028.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546270,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So there are Stones of Heaven in other worlds too? A single territory binding the feuding Sky Empires. Huh.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cow_Ronin_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Moo_Bu_NV-CONA_051.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546271,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's a delicate situation we've discovered. Probably best someone watches the crazed conqueror to ensure he doesn't shatter it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cow_Ronin_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Moo_Bu_NV-CONA_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546271,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
