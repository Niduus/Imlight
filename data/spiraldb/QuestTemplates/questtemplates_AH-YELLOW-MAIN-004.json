  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This relic... let me hold it. All this knowledge, this understanding, how did you acquire it?",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_035.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The living memory of your research in the future.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-YELLOW_111.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752265,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I never anticipated the results so soon. We can act much faster than the Tritons expect.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_036.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I don't think he heard you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Qismah_Shasa_AH-YELLOW_108.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752368,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I gathered.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-YELLOW_112.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752265,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, creativity is the key. The mind is an endless wellspring of potential. And the Tritons... they are inventive indeed.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_037.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Imagine turning your enemies' thoughts, their own power, against them. The stronger they are, the stronger you become.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_038.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "An infinite fire ignited by a single creative spark. All we need is the flint.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_039.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This was once a Triton city... perhaps remnants of their creations remain. If you are to turn their creativity against them...",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-YELLOW_113.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752265,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, yes, but it is not enough to have any creations. I need symbols of what the Tritons fear, what they respect, and how they destroy.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_040.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then let us seek those out.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-YELLOW_114.mp3",
            "m_action": "",
