          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Returned already? Good. Yes, the Tritons use storms to destroy so they can make anew in their image. But those they made turned their power against them.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_041.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And so we shall continue. With the Akasha we created. These symbols will make an imprint, transform the Akasha from something invisible...",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_042.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
