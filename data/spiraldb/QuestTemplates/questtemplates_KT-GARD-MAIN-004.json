  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "At any rate, the records state that to restore the Font of Cultivation, it must be... eh, turn the page...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_038.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Cultivated! Well, that tracks. \"In turn,\" they say, \"the font will nourish the tarnished soul.\" What the blinking blimey does that mean?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_039.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This is proving to be a lot of work. What say we stop and go fishing or some such? Do you really care about this random student from ages ago?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_040.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, very well, he greeted you into the Spiral, fine. Then this \"tarnished soul\" bit is the key, I expect.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_041.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The font seeks redemption, not mere attention. Forgiveness is how we cultivate a harmonious world and all that rot.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_042.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Some of the Tuts' former lackeys still linger here, reduced to squalor. Perhaps you can convince them to do something with their lives.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_043.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I hate fighting. I wish, oh wish, someone would pop out of the sky and offer me a job tending a garden. Oh well. Wait... what? Sure!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Henchman_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Tut_Tough_C_KT-GARD_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594465,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Who are you? Oh, right. You restored the Font of Cultivation? Splendid. Next is the Font of Blossoms.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_044.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          }
        ]
      }
