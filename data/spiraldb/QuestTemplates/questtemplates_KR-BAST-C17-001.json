                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There's an ancient and valuable Burrower Warhorn hidden somewhere in Bastion. I want it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Bee_Warrior_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/StingerBell_KHR_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223231,
