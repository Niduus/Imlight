                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But this time, I'm going to need more than the promise of a favor before I tell you what I know. I'm a trader, not a giver.",
