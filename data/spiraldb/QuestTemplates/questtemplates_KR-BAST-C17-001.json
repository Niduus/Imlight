                "m_personaName": "KR-MoonCliffs-NPC21_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'll tell you how to get the Music Box if you bring me Loratio's Warhorn. Your little Mouse friend can tell you where to find it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Bee_Warrior_A_NPC.dds",
