      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC02-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So good news, I figured out who's been watching us.",
                "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Tarrak_Hadfield_AH-PRIM_070.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1761075,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC02-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I think they're Eldritch. Despite all signs to the contrary, their civilization persists.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Zander_AH-PRIM_050.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756060,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC02-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Eh, sort of. Not exactly building cities with dragons anymore.",
                "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Tarrak_Hadfield_AH-PRIM_071.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1761075,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC02-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "How could we? The song vanished from the air and, with it, our power. So we entreated the great Primals for aid. Some the Bird, some the Bug.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_TreeF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/The_Nameless_AH-PRIM_006.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1766034,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC02-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But only the Tree responded. He made us a forest of song and power, but then fell silent, left us to the mercies of our rivals.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_TreeF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/The_Nameless_AH-PRIM_007.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1766034,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC02-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You, though, you restored voice to one of the trees. It will sing again. You will show us how.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_TreeF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/The_Nameless_AH-PRIM_008.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1766034,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC02-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As I told you... I can't just revive anything. That Tree was sort of special, understand?",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Zander_AH-PRIM_051.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756060,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC02-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No. Your leader must explain to our elder. They are eager to welcome you to our cause in the Hall of Thorns.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_TreeF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/The_Nameless_AH-PRIM_009.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1766034,
                "m_cameraName": ""
              }
            ]
          }
        ]
