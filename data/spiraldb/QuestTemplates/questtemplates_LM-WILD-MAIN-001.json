  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But the Wildlands are dangerous for Lemurs as meek and savory as myself. I know! YOU can find the Sanctum of Secrets.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Hierarch_of_Purpose_LM-WILD_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520116,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not exactly following the rules, but then I'm sure the Founder wouldn't support being eaten.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Hierarch_of_Purpose_LM-WILD_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520116,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*Gulp*",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_LinNoHat_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/The_Nothing_LM-WILD_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520117,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is a Mana Font just through that thicket there. Our ancestors would wait by it for hours until the Founder spoke.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Hierarch_of_Purpose_LM-WILD_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520116,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If there is a secret sanctum to be found, that is where it will be. Good luck to you. I will return to Telos.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Hierarch_of_Purpose_LM-WILD_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520116,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Congratulations.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-WILD_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, hello.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_LinNoHat_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/The_Nothing_LM-WILD_029.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520117,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In finding this place, you have completed a great test. And your reward is a terrible truth. Lemuria is not what I told you.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-WILD_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Indeed, it is only a small part of a larger cosmos we call the Spiral, a fragmentary collection of societies spawned from the mythical First World.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-WILD_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is in the hope of recreating that primordial paradise that I brought you all here, to learn how to align the fragments like the pieces of a puzzle.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-WILD_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've had to keep you hidden. Others would not agree with my work. But now, I hope, my task reaches fruition. Take the Attunement Stone.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-WILD_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Stone? That must mean this thing.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_LinNoHat_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/The_Nothing_LM-WILD_030.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520117,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "To aid you on your journey, I pre-programmed the Synthesizer to play a single note and unlock new magicks and a new Spell.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
