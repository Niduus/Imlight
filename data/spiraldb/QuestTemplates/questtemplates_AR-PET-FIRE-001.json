                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of course! Wait. What's with that Egg? Vulcus forged a Raging Bull pet? Then let us thank the coals he won't be creating more!",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/IgnusFerric_MIR_37.mp3",
                "m_action": "",
                "m_dialogEvent": "",
