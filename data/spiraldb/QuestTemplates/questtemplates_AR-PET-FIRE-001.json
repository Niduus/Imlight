                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard! You got my Empyrian Ore back... er... well, most of it. What? Vulcus created Fireblood? Pet Snacks as flux you say?",
