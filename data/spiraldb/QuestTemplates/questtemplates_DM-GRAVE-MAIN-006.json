            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But, oh, I forget myself. As do you. I must say you gambled considerably visiting me at this hour. Day breaks in mere minutes.",
