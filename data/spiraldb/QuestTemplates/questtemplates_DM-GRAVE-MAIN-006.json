            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Still, SOMETHING is invading our home in the day. And you say they are changing Lucy? Into what?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Vampire_Base_C_NPC.dds",
