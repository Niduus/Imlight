            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Fortunately, I do have a spare coffin you may use. Take this key and use the Guest Quarters round the side of the house.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Vampire_Base_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Arthur_Easton_DM-GRAVE_018.mp3",
