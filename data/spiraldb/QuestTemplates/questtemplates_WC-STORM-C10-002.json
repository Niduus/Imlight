                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I can't stop you, so if you must know, the Hoarder is the Plaza of Conquests. Defeat the Hoarder to claim your spell!",
