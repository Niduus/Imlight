                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It is malicious and evil, a thief of spells and a destroyer of Wizards. I would warn you away, if I thought you'd listen!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/MilosBookwyrm_ZFA_30.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
