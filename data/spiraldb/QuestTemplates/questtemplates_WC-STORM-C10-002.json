  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have good news and bad news for you...",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfHalstonBalestrom_ZFA_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'll give you the bad news first! I've looked around and I can't find a single copy of the Sirens spell here!",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfHalstonBalestrom_ZFA_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My sources tell me that the only source of the spell is a frightening individual in Dragonspyre named the Hoarder!",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfHalstonBalestrom_ZFA_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Hoarder has been collecting spells to keep them from Wizards. So if you want the Sirens spell, you must go to Dragonspyre!",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfHalstonBalestrom_ZFA_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Speak to Milos Bookwyrm in the Atheneum. He can tell you to find the Hoarder! That's the good news, just so you know.",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfHalstonBalestrom_ZFA_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          }
        ]
      },
