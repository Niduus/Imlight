            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You should be heading to Zafaria's Baobab Crown, to speak to the Librarian, Kiliman Copperleaf. He will help get your Basilisk.",
