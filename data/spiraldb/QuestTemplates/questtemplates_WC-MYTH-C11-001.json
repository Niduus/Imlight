  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings. It has come to my attention that you are not quite up to par in the field of pet management and training.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ProfCyrusDrake_AVA_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38206,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "To remedy this, I am granting you a new pet, or, more excitingly, instructing you in the way in which you can earn your own.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ProfCyrusDrake_AVA_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38206,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The pet in question is the Basilisk, a creature you should have gained passing familiarity with by now.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ProfCyrusDrake_AVA_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38206,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "To learn more, I encourage you to speak to my distant colleague Kiliman Copperleaf, in the Library in Baobab Crown, in Zafaria.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ProfCyrusDrake_AVA_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38206,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As it happens, Zafaria is quite hospitable to Basilisks. Kiliman will instruct you as to where you can find one.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ProfCyrusDrake_AVA_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38206,
            "m_cameraName": ""
          }
        ]
      },
