                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There was a clutch of Basilisk eggs in the Savannah, but no more! It was taken by a poacher named Idris Beast-Taker.",
