            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, don't tell me. The truth is for your shadow. Its reaction will tell you what it means.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_063.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
