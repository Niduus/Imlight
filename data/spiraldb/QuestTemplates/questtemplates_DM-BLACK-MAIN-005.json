          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now you must wait for a second night. Tonight, the shadow won't knock. It enters and it lies.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_064.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Dispel the lesser shadows, the diminished aspects, with a Touch of Magic and tell the most influential one the truth you have learned.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_065.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-006-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "These truths from the depths, you have shared? If he knows everything that will happen, then he knew this would happen.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_NothingPlayer_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Shadow_Self_Emperor_DM-BLACK_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700068,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-006-B_Persona",
