            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "From the moment we met, he knew the Arcanum would happen, Sybil...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_NothingPlayer_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Shadow_Self_Emperor_DM-BLACK_005.mp3",
