  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-HOPE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ha-ha, indeed, well said, my friend. Your truth is to help others, as you demonstrated countless times in our journey.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_WL-HOPE_132.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608049,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-HOPE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your Walk was for your friend after all. I think you should now return to Novus and check on him. The rest of us have much to do here.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_WL-HOPE_133.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608049,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-HOPE-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Quite. We've a mess of political wranglings to contend with, a truce to pitch to the Prime Minister, and ample questions still to answer.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Joan_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Joan_Locke_WL-HOPE_095.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608110,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-HOPE-NPC46_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Who is Wallaru? What is the Dreaming for? How do we not make the same mistakes as the olds?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-HOPE_056.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594313,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-HOPE-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We can't change what was done. But we can find a balance and live here together, respectfully and sustainably.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Joan_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Joan_Locke_WL-HOPE_096.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608110,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-HOPE-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Think I'll come with. You said one night that Copy Qhat and Quake Charmer are there?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-HOPE_104.mp3",
