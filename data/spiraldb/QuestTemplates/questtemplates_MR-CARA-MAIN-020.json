              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Grandmother Raven",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I understand what drove you to defy my servants, but this was unnecessary. You have now been exposed to knowledge unfit for any mortal.",
                "m_picture": "GUI/NpcPortraits/Portrait_GH_Raven_Grandmother_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/GrandmotherRaven_MIR_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Grandmother Raven",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Judge me not for what you learned. If I chose otherwise, there would be no Spiral. Doomed as it may be, it has still been a glorious ride.",
                "m_picture": "GUI/NpcPortraits/Portrait_GH_Raven_Grandmother_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/GrandmotherRaven_MIR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Grandmother Raven",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "For the Moment, I've set Time aright again. To reset the Sands, you must reclaim the Chronoshards and the Eye of History from the Chronoverge.",
                "m_picture": "GUI/NpcPortraits/Portrait_GH_Raven_Grandmother_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/GrandmotherRaven_MIR_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Grandmother Raven",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But make no mistake about my intentions - the priority now is to destroy Spider for once and all, whatever the cost. Do not fail me in this.",
                "m_picture": "GUI/NpcPortraits/Portrait_GH_Raven_Grandmother_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/GrandmotherRaven_MIR_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              }
            ]
          }
        ]
