      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, my father and sisters have told me many stories of you. They call you the never-tiring, and the wide-seeing Wizard.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Erytheia_AQL_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741235,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Gloomy Hades has called you to Tartarus? That is where his palace lies, built on the ruins of Pompeii. It is the realm of the dead!",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Erytheia_AQL_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741235,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Long ago, Pompeii was a vibrant city. But the people turned away from the Immortals and pursued forbidden arts.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Erytheia_AQL_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741235,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Immortals were displeased, and punished them. They sent a Gorgon to Pompeii, to attack the people without mercy!",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Erytheia_AQL_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741235,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Then Hades ripped up the earth and swallowed the city, pulling it down into the abyss.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Erytheia_AQL_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741235,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I don't know of anyone who has entered dread Tartarus for the Immortal Games and returned.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Erytheia_AQL_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741235,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "However, if anyone can survive the tear-streaked palace of Hades, I suspect it will be you. Stay vigilant, Wizard!",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Erytheia_AQL_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741235,
                "m_cameraName": ""
              }
            ]
          }
        ]
