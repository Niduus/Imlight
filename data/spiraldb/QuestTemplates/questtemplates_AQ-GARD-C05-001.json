            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They will praise and reward your victory. But you must know they do not like to lose, so they may not play fair.",
            "m_picture": "GUI/NpcPortraits/Portrait_Satyr_Druid_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Silenus_AQL_31.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 741209,
