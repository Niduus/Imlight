            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My youngest daughter, rosy-tressed Erytheia, can tell you stories of Tartarus.",
            "m_picture": "GUI/NpcPortraits/Portrait_Satyr_Druid_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Silenus_AQL_32.mp3",
