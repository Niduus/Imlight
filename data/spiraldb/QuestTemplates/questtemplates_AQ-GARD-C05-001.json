            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Immortals are truly impressed by your ability, and wish to put the ultimate test before you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Satyr_Druid_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Silenus_AQL_30.mp3",
            "m_action": "",
