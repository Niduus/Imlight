            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My high-hearted friend, I have heard whispers that Hades the Unseen has invited you to his deep, gloomy home!",
            "m_picture": "GUI/NpcPortraits/Portrait_Satyr_Druid_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Silenus_AQL_29.mp3",
            "m_action": "",
