            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You're the only one here with the power to stop this kook. He has a Laboratory in the Science Center. You must act quickly!",
