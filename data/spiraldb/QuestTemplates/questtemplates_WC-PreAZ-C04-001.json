    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A Quetzal Messenger from Azteca? You say the poor creature was being chased by Morganthe's minions? Very worrisome.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Let's take a look at that message. Oh my! A plea for help against the forces of Shadow!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Years ago, Azteca was cut off from the rest of the Spiral by a great comet. Many believed it was destroyed, but I was not so sure.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Spiral now reveals this world to us in its darkest hour. It falls upon us to act.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Take the key this brave Quetzal brought us, and travel through Bartleby's Spiral Door to Azteca.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Find this Pacal Redmask, and bring light to drive away the shadows!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go quickly, young Wizard, but be careful! I suspect Morganthe's hand in this, somewhere!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
