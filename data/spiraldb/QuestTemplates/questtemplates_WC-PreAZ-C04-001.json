            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go to Azteca to investigate this \"Shadow,\" and help those whom you encounter. You'll get extra credit, of course!",
