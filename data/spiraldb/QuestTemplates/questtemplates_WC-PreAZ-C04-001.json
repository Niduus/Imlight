            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Young Wizard, just imagine it! You'll be the first to revisit one of the oldest parts of the Spiral!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
