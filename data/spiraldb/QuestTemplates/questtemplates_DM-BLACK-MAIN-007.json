  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Coins are said to represent the material world, the dirt of the ground, the Earth you might say. Oh, I know of your origins, Scion from Beyond.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_073.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your tune was sampled into the Great Song itself by its very singer, but it is still the beat of the Earth; that is the rhythm of your heart.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_074.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are music. You are material. You are Earth and the Spiral. What does your song sound like?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_075.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps if you open that bottle, you will find out.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_076.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This will require, of course, that you LISTEN. The Sound of shadow should NOT be MUTED.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_077.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Did that come from the old Shadow School? Why would your personal path to the Scholomance lead there?",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_118.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Did the Magician not free the creator of Shadow? Did they not see it spread to the Spiral? Perhaps the Shadows aren't done with you yet.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_078.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mine was a very different route. I saw myself from tomorrow, distraught and miserable. And I crafted the cards to better understand why.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_079.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But your key, it seems, is music?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_080.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We have a Musicology Scholar at the Arcanum who would say that music is memory, emotional memory, the truth of a moment inscribed as melody.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_119.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I used to think he was just full of himself, but maybe he was on to something.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_120.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hmm. This is the Voice of Coins, the song of Coins, that is its connection to the Scholomance. So it stands to reason we need Voices of Swords, Wands and Cups.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_081.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps you need to demonstrate the attributes they exemplify? Swords, for example represent mind and will, so-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_082.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, yes, free the knaves of wands from the Hierophant's control. That should be an adequate declaration of will. If you can do it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_083.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Get away from me, putrid mortal, lest I catch one of your many diseases.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700040,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am NOT mortal; I am an Immortal-in-Waiting, soon to ascend to the House of Wands and join the eternal hunt for the Scholomance.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700040,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Uh-huh. I'm supposed to believe that there are entire villages out there of people duped into believing they will ascend to the House of Cups?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700040,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Vampires are just bitey little bat people, they are not that clever; and neither are you. Shoo!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700040,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-009_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bestia displodo... no... humanis displodo. That doesn't seem to be doing it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Baukclaw_DM-BLACK_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-009_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, why won't you just explode? Magus displodo!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Baukclaw_DM-BLACK_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-009_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No... is displodo even the right incantation?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Baukclaw_DM-BLACK_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Saw you talking to the apprentices. Did they try to explode you? Yeah, that's what I would've done.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_121.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          }
        ]
      }
    ]
