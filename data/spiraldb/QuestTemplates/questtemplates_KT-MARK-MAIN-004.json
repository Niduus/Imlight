            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No matter. We shall vanquish them. I will join you when you seek to cross that gate, Spellbinder.",
