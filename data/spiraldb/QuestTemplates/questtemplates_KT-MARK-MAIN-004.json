            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Excellent! Then you can enter the Lie-brary. But DON'T! Not without my Scrawls of Truth! They're the real history buried by the Moon.",
