    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Come, the Governor awaits our complaints.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-NEWV_101.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546279,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, yes, much better away from all the politics. I can finally think! My mind is again abuzz with notions of- Oh! The Irks!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_028.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Specifically those Fetching Irks over there. Utterly tantalizing in their unobtainability. Anyway, they like to chew on the cables.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_029.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Living up to their name, the little devils. Those cables attach to conductors I installed on each spire. A harrowing feat of applied science...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_030.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...If I do say so myself. They help us attune to Dasein's unique thought frequency and transmit it to devices like the one in my lab.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_031.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Frame of Mind? Exactly! Soon we will understand his complete Frame of Mind. But first you must shoo off those Fetching Irks.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_032.mp3",
            "m_action": "",
