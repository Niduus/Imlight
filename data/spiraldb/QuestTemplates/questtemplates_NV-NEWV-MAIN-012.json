  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Rottingham thinks he can torture the world into submission. I will not have it! Will you, Wizard? Bien. Then let us make for the Governor's House.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-NEWV_070.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546298,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Excitable bunch, aren't they? At any rate, tell me about this Frame of Mind.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_058.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I see. Our explorers did report a floating picture frame of an especial peculiarity. When they approached it, it flew away with great haste.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_059.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They saw it enter a nearby Cave, but dared not follow. Perhaps the Frame will be more amenable to you? Most people seem to be.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_060.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-DEstate-NPC26-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can feel them all. Monquista... Valencia... Polaris... Marleybone... and more... all my Shards, the empty ones. I am strong enough now to reach them.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/KM_Z00_CavityChamberVoid.dds",
            "m_soundFile": "Sound/Dialogue/Dasein_G5_Wizard_NV-NEWV_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1717127,
            "m_cameraName": ""
          }
        ]
