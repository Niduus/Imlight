  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-ZAM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You did an excellent job with those upstart Impi Raiders. I have heard two rival lieutenants are now refusing to work together.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Queen_Amahle_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/AmahleAutumnrain_ZFA_32.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465286,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-ZAM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This kind of internal strife is intolerable. We need both tribes to work together.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Queen_Amahle_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/AmahleAutumnrain_ZFA_33.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465286,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-ZAM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you talk to Juma Fasttrack and Laduma Thunderhoof and resolve their issues so they will follow orders?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Queen_Amahle_NPC.dds",
