                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello, outsider. The Queen sent you? Yes, my warriors and I have issues.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Gugu_FastTrack_NPC.dds",
