                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We are ready to fight the big noses. And you will see how the left horn is the better horn!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Leduma_ThunderHoof_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/LadumaThunderhoof_ZFA_04.mp3",
