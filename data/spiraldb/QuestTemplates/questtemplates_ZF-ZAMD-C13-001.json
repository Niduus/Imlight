                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Queen has a problem with us? Well, we have a problem with our orders. We are far more skilled than Juma's soldiers.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Leduma_ThunderHoof_NPC.dds",
