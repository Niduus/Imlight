                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We will not take orders from the Thunderhoofs. Tell the Queen if we cannot lead we will not fight.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Gugu_FastTrack_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/JumaFasttrack_ZFA_02.mp3",
