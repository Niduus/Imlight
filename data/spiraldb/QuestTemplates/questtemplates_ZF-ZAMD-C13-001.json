                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Queen specifically asked for us to be the left horn of the \"Horns of the Buffalo\"? We cannot refuse such an honor.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Leduma_ThunderHoof_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/LadumaThunderhoof_ZFA_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465302,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-ZAM-NPC05_Persona",
