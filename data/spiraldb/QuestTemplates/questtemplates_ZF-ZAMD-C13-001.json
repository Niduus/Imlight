                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We must lead the army against the big noses. To do less would be a dishonor. You tell the Queen that!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Leduma_ThunderHoof_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/LadumaThunderhoof_ZFA_02.mp3",
