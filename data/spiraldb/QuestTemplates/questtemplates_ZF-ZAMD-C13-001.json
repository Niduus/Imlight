                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We can be the the right horn of the \"Horns of the Buffalo\" against the big noses?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Gugu_FastTrack_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/JumaFasttrack_ZFA_03.mp3",
