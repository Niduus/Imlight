                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You think we should give them equal places of honor? Wonderful! You are almost as great a military genius as my husband!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Queen_Amahle_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/AmahleAutumnrain_ZFA_37.mp3",
