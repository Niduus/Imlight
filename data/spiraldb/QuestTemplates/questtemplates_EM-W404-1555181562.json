      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-HUSK-NPC03-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh great...",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Bat_EM2_60.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1448092,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Rat",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ahh... Hello, Wizard... Little brother.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Raspoutine_A_MOB.dds",
                "m_soundFile": "Sound/Dialogue/Rat_EM2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Scorpion",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We've been waiting a long time for this.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Xerxes_A_MOB.dds",
                "m_soundFile": "Sound/Dialogue/OverlordXerxesScorpion_EM2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-HUSK-NPC03-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You mean you've been waiting for Wizard to say they're sorry for forcing Daddy to banish you to the Shadow Realm?",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Bat_EM2_61.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1448092,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Scorpion",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, Bat. You always were the mouthy one. No, Father sent us to offer you one last chance to forsake your riffraff friends and fall in line.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Xerxes_A_MOB.dds",
                "m_soundFile": "Sound/Dialogue/OverlordXerxesScorpion_EM2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-HUSK-NPC02-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ha! So is saying 'riffraff', like, a thing in your family? So lame.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Mellori_EM2_93.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1448072,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Rat",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, good, the Raven-Child is here too. That'll save us the trouble of hunting you down after Bat comes to his senses and betrays this Wizard.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Raspoutine_A_MOB.dds",
                "m_soundFile": "Sound/Dialogue/Rat_EM2_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-HUSK-NPC03-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That would be what a Child of Chaos would do. I mean, it wouldn't even be wholly unexpected, would it?",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Bat_EM2_62.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1448092,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-HUSK-NPC03-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The thing is, my grim brothers, unlike you, I've got a true purpose that's far greater than just being Father's puppet. Wizard, attack!",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Bat_EM2_63.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1448092,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
