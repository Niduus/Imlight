  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You know, it occurs to me that if we did something to calm the Sea-Spirits, they’d leave us alone.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There’s an altar down the way that seems to be devoted to the Storm Lord, some sort of patron to the Sea-Spirits.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "When we arrived on the beach, we saw that the Water-Moles placed pieces of sea-foam crystal on the altar.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now the sea-foam crystal is gone... and I notice that the Sea-Spirits leave the Water-Moles well enough alone.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps we should follow suit! Can you go and scavenge up some sea-foam crystal from the beach and place it on the Storm-Lord altar?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
