  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go away! I don't have time for your Drama Club bake sale or whatever nonsense you're- Oh, you're you! Glad you've come. We've got work to do...",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/AegonStatz_EM2_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've discovered discrepancies between the results of your Pekron readings versus those collected by my Wide-Range Spiral Pekronometer.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/AegonStatz_EM2_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What's a Wide-Range Spiral Pekronometer? Why, it's a device that reads Pekron levels over the entire wide range of the Spiral!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/AegonStatz_EM2_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What do you mean, why do I need your readings if there's already a machine that does it? Because even pseudo-science requires confirmation!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/AegonStatz_EM2_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you collect an environmental Pekron reading in the Wizard City Dye Shop? That should be the only reading I'll need today. Probably. Maybe.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/AegonStatz_EM2_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          }
        ]
      }
    ]
