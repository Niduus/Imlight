  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, it looked like YOU were fleeing in terror! I was laying... a clever trap. With cunning and skill and ropes and things.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-OUT_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562753,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Emu Rider B",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One, two, one, two!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_A_MOB.dds",
            "m_soundFile": "Sound/Dialogue/Emu_Rider_B_WL-OUT_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, crikey, not these guys again! Flee! Flee in terror!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-OUT_054.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562753,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Emu Rider B",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One, two, no escape for you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_A_MOB.dds",
            "m_soundFile": "Sound/Dialogue/Emu_Rider_B_WL-OUT_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So this may surprise you, but I am not, in fact, the Outback's greatest explorer. No, it's true. I'm just, I guess, a performer.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-OUT_057.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562753,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My real name's Paul. I just put on a show. Tourists come for the Walkabout. I give them a little adventure, a taste of the Dream Water...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-OUT_058.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562753,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...And they go home all the happier. Nobody walks across the whole Outback anymore. Come on, look at it. Did I say the water I gave you was fake?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-OUT_059.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562753,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So... aye... As you can see the Purple Pond, once the Purple Lake, has kind of dried up. I blame the heat. Nothing some food coloring can't fix, right?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-OUT_060.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562753,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Right. Anyway, hate to ask, but you seem capable. I need you to rescue Steve. You know, the Krok Hunter. He's my business partner, yeah?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-OUT_061.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562753,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'll head to your camp in a bit. Maybe you and your old Dromel pal can find Steve?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-OUT_062.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562753,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-OUT-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So Krokodile Dundara was just a showman peddling fake Dream Water. Too bad. I guess we'll have to manage the Walkabout on our own.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_WL-OUT_034.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608160,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
