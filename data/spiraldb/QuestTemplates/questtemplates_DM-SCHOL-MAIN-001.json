      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC29_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Good, good, you're stabilizing now. So then, what do we do here? We are enemies after all and you have just infiltrated our base.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-SCHOL_081.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC29_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You just want Miranda, I know, but how can I give up the only person to ever help us? What could you possibly offer?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-SCHOL_082.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC29_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A databrain? From the Gray Man? The sheer volume of knowledge that old demon must have possessed. This... this could help us refine our cure...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-SCHOL_083.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC29_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...Maybe even design it so it doesn't rapidly age the ancients we use it on. Yes, I think this will be a suitable trade.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-SCHOL_084.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC29_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Miranda's lab is just over yonder. Have at it. I'm going to poke at this brain until I figure out how to carry it. How did you?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-SCHOL_085.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC29_Persona",
