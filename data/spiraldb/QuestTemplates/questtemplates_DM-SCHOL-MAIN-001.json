            "m_dialog": "'Magic,' very cute. Do not make me change my mind.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-SCHOL_086.mp3",
