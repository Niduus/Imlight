            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/AcanWinefeather_AZT_13.mp3",
            "m_action": "",
