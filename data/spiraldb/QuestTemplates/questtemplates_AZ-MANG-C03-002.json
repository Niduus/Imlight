            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He will also ignite them if any of us challenge him. However, if you remove the Orbs of Natron, he'll lose his leverage.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/AcanWinefeather_AZT_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726111,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC03_Persona",
