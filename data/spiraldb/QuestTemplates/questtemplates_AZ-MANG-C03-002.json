            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Caquix Nine Shadows has vowed he would rather see Tula Village burn to a cinder than give it back to the Aztecosaurs.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_C_NPC.dds",
