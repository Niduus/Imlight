            "m_personaName": "AZ-MANG-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He has created magical Orbs of Natron that can burn water itself, and hidden them around the Floating Gardens.",
