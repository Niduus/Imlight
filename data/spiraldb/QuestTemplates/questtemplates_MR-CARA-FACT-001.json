            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Aha! You are undoubtedly the Good Camaritan of legend, returned to save us Nomads in these dark times. Sandiago won't say, but he knows.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Merchant_A_NPC.dds",
