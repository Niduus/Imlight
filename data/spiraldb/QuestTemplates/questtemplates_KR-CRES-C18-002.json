            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC32_Persona",
                "m_nameOverride": "Stellan DuneStrider",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You there! Stranger. What do you have-and-hold there? Hop closer and let me razor eye...",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StellanSandStrider_KH2_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1299031,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC32_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It is the Kondha Rune! How do you have-and-hold this? Are you a thing-thief? A life-stealer?",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StellanSandStrider_KH2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1299031,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC32_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It was a gift from Stikken SandStrider? Stikken grokked the Kondha Rune would help. And so it has... It has navigated you to me.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StellanSandStrider_KH2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1299031,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC32_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I am Stellan SandStrider, Stikken's blood-brother. You are on a long hop, yes?",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StellanSandStrider_KH2_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1299031,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC32_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Please accept this as a token of my open-heart for your help to all hoppers. May you die another day!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Hunter_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StellanSandStrider_KH2_05.mp3",
