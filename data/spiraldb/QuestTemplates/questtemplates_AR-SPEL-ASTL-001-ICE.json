    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes? What do you want? Oh, that's right, I called you. Hrph. Glad to see you didn't overly concern yourself with getting here in a timely fashion.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/LibrarianFitzhume_GRV_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346371,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now, I believe I've a note for you here somewhere... Ah, here we are:",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/LibrarianFitzhume_GRV_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346371,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "'The Scholar's Lounge is not your personal summoning chamber. Remove your dastardly creations immediately, or clean out your office.'",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/LibrarianFitzhume_GRV_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346371,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "-Oop, Wrong note! Here's your message. Mmhm. Ooo, you've been summoned by the Astral Scholar, Qyburn Stellargaze. Lucky you! Run along then.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/LibrarianFitzhume_GRV_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346371,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why are you still here? Qyburn Stellargaze wants to talk to you in the Astral Office. Do you need a map? It's right there. Go on. You can do it.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/LibrarianFitzhume_GRV_07.mp3",
