      "m_displayImage1": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What took you so long? I submitted that Service Request ages ago. Miss Indoor Thunderstorm next door has created quite the mold situation.",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/QyburnStellargaze_GRV_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340973,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh my stars, you're not the Custodian. You're the new arrival, aren't you? Of course you are. I called for you! Come! Come!",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/QyburnStellargaze_GRV_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340973,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, well, hello there! As you may have gathered, I am Qyburn Stellargaze, the Arcanum's foremost resident Astral Scholar.",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/QyburnStellargaze_GRV_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340973,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So glad to finally meet you. Sorry for the humidity in here. Apparently Ione has no regard for other peoples' upper respiratory systems!",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/QyburnStellargaze_GRV_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340973,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ugh, speaking of feeling bad - The reason I summoned for you is because I felt awful that I wasn't able to meet you when you first arrived.",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/QyburnStellargaze_GRV_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340973,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I just get so wrapped up in my research that I tend to miss things. I swear, this whole place could fall into a black hole and I'd never know!",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/QyburnStellargaze_GRV_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340973,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Anyway, I just wanted to let you know that I have several fascinating Astral Spells that I'd be willing to teach you if you're ever interested.",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/QyburnStellargaze_GRV_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340973,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'll be right here whenever you're ready. No pressure. But I do need to get back to work, so you just let me know, OK? Great.",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/QyburnStellargaze_GRV_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340973,
                "m_cameraName": ""
              }
            ]
          }
