  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your arrival is well-timed. I must ask for your assistance once more.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_132.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As you know, there are many worlds in the Spiral. Wizard City is one, and you likely know of others.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_133.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One of these worlds is Grizzleheim, a cold and wintry place peopled with fierce warriors.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_134.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Grizzleheim world-tree was once linked to the rest of the Spiral, but the contact was lost... we thought it was destroyed.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_135.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bartleby now informs me that the portal to Grizzleheim is now active, and travel there is possible. Fortuitous news, indeed!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_136.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We have great need of friends in this dark time. Go to Grizzleheim and make allies of the fierce warriors dwelling there. You should speak to their king.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_137.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you gone to Grizzleheim yet to speak to their king? Go to Bartleby and be on your way, at once! Time is short!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_138.mp3",
