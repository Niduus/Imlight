                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Finally, White means \"Downfall,\" likely when the Song of Creation was done and they fell into feuding tribes. Or \"Wah Wah,\" according to Briar.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_133.mp3",
