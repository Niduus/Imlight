          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC01-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You found all three symbols? What do they mean?",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_130.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC01-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yellow means \"Ascension\" or \"Yikes!\" as Miranda said. Raven knows why. So that's probably early history, just as the Eldritch established themselves.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_131.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC01-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Blue means \"Prosperity.\" I would guess this is the height of their civilization. Weird Miranda thought that was \"Boring!\"",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_132.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
