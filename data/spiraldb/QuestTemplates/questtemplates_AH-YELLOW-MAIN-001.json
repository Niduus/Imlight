      "m_displayImage1": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Welcome, friends! Welcome to the Hall of Discovery! What brings you here today? I hope it is an inquisitive nature!",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_019.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Are you... Balaur?",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-YELLOW_089.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752265,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That is the spirit! I AM Balaur, foremost researcher of the Ahmarric Threads. And, oh, do I smell Triton scales in your possession?",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_020.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, thank you, I will let these cure. You see, we have identified over a thousand Ahmarric Threads, but which ones are most useful against Tritons?",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_021.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "One THOUSAND threads? As in a thousand schools of magic?",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Qismah_Shasa_AH-YELLOW_086.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752368,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, not all threads are created equal. Some seem to be withering, others staying firm. While six in particular are getting stronger every day.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_022.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "One is a strand of purest Heat, oddly another its opposite in Cold. There is a Rhythmic Thread whose increased oscillations mirror the strengthening.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_023.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But the ones we still need to test are the Spiritual Thread, the Creative Thread and the Destructive.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_024.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Crafter has been working to weave the strings of these threads into usable forms. I eagerly await his results.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_025.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752287,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I say we eagerly seek him out.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Qismah_Shasa_AH-YELLOW_087.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752368,
                "m_cameraName": ""
              }
            ]
          }
