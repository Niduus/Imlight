                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Because I love, you see, love all things. Even them, who I hate.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Base_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lovecrafter_AH-YELLOW_008.mp3",
