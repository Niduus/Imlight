          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You can find him in the Hall of Discovery.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Lapona_Olosohpa_AH-YELLOW_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752283,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
