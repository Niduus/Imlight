            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I blame the nonsensical design of this maze of a fort. It is a veritable labyrinth! What I need is a Map.",
            "m_picture": "GUI/NpcPortraits/Portrait_Minotaur_Pirate_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/Kosmas_KH2_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283114,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-FortRachias-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've seen those contemptible Black Shields buzzing about with Maps of the Fort, and I need you to get one for me.",
            "m_picture": "GUI/NpcPortraits/Portrait_Minotaur_Pirate_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/Kosmas_KH2_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283114,
