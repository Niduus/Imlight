            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The safe return of my Golden Horns of Asterion is a buoy to my humor, Wizard. Yet, I am still plagued by discontent.",
            "m_picture": "GUI/NpcPortraits/Portrait_Minotaur_Pirate_A_NPC.dds",
