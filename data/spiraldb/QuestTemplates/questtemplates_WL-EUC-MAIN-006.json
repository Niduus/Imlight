  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC10-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The olds fight and deal and choose tomorrows what we have to live in. What new scaries come from today?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-EUC_035.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560358,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC01-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If I may, Ms. Furryosa, your outrage upon discovering the origins of the Great Barrier was valid, but unfocused, easily manipulated.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Joan_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Joan_Locke_WL-EUC_078.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560323,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC10-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*GAH!*",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-EUC_036.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560358,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC01-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Quite. You need more than fury. You need a destination. I too am in need of direction. Perhaps we should both of us join this Wizard in entering the Dreaming?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Joan_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Joan_Locke_WL-EUC_079.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560323,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC10-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But only Thought-Leaders can- no, that's oldsspeak. Yes! I walk. I walk and the raiding stops. Sand the eyes by the fire. Tomorrow, we dream.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-EUC_037.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560358,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC02-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You did right by us, mate. The Drop Bear population has... dropped. That's a little highbrow wordplay for us to depart on.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_LeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Morp_WL-EUC_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560328,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC02-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Great Barrier is open to you. Though are you sure about bringing Furryosa along? She's a bit... much.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_LeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Morp_WL-EUC_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560328,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC02-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "True. I suppose we've all been a bit much. Maybe the Dreamer's guidance is just what she needs.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_LeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Morp_WL-EUC_054.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560328,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC02-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Very well. I grant you and your companions permission to enter the Dreaming.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_LeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Morp_WL-EUC_055.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560328,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC05-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Breathe deep, my friends, for this is not water you tread, but the living dreams of Wallaru!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_WL-EUC_101.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560335,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
