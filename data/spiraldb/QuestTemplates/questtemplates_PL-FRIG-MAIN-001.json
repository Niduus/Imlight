                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Nah. I don't see any resemblance. Besides, he said to let the Osky through, no one else. We'll have to whip these ones into shape.",
                "m_picture": "GUI/NpcPortraits/Portrait_Moose_Warrior_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/PitFiendA_POL_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
