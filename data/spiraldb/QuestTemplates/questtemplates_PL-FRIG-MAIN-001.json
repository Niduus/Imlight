                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Maybe we let the master deal with these troublemakers? Yes, I think he might enjoy that. We should get back to our other duties, at any rate.",
                "m_picture": "GUI/NpcPortraits/Portrait_Moose_Warrior_A_MOB.dds",
