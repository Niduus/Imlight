                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Looks like we got even more Pingouins who've managed to escape from their cages. Why they rush back into the Maw, I have no idea.",
                "m_picture": "GUI/NpcPortraits/Portrait_Moose_Warrior_A_MOB.dds",
