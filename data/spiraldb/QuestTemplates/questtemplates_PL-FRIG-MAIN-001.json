                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Pingouins? I only see one Pingouin. In fact, this other one looks a bit like the master, don't you think?",
