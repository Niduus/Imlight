                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Basilisks? So that old rascal Drake expects me to do his work for him, does he?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Professor_Balance.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/Alhazred_ZFA_19.mp3",
