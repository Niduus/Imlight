                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Basilisk is the king of lizards, a six-legged, razor-clawed creature whose very vision is like venom!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Professor_Balance.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/Alhazred_ZFA_20.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39302,
