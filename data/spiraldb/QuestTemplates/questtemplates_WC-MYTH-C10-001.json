                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They hunt by locking eyes with their prey, and stunning them, so if you should see a Basilisk in the wild, look away!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Professor_Balance.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/Alhazred_ZFA_21.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39302,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-SPHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I could go on, but the basics will suffice. You would think someone named Drake would have more to say on the matter...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Professor_Balance.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/Alhazred_ZFA_22.mp3",
