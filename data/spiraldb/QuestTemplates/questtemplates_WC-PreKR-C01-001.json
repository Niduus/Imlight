                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Jambo</ITALICS>, young Wizard. It has been some time. Even from here I can see that the Shadows grow long across the Spiral.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Inyanga_WhiteStripe_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/InyangaWhitestripes_KHR_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465266,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You wish my help? Of course, I will do what I can to aid one who did so much for my world. What is it that I can do?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Inyanga_WhiteStripe_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/InyangaWhitestripes_KHR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465266,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "To join the Council of Light? You bestow a great honor upon me, Wizard. Tell Merle Ambrose I will come to his side at once!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Inyanga_WhiteStripe_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/InyangaWhitestripes_KHR_03.mp3",
                "m_action": "",
