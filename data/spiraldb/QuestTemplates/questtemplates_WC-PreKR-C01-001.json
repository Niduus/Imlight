                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That was quick! You flew with the speed of Gamma's wings. What did they say?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MerleAmbrose_KHR_11.mp3",
