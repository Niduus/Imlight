              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-ABBEY-NPC26_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "By the Spiral, it is the young Wizard, back amongst us! But I can tell from your visage that dark times are still ahead.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Artorius_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KingArtorius_KHR_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205069,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-ABBEY-NPC26_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Merle Ambrose asks me to join the Council of Light? That I cannot do, for there is still much work I must do to restore the land.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Artorius_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KingArtorius_KHR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205069,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-ABBEY-NPC26_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But Avalon will not refuse Ravenwood in this hour of need. Instead, the Lady of the Lake will go in my place.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Artorius_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KingArtorius_KHR_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205069,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-ABBEY-NPC26_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Speak to her and tell her it is my command!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Artorius_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KingArtorius_KHR_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205069,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-ABBEY-NPC26_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But before you go, I have one more gift for you, blessed Knight of the Silver Rose. The Sword of Kings has bonded to your spirit.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Artorius_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KingArtorius_KHR_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205069,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-ABBEY-NPC26_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You may summon its power whenever you feel the darkness press upon you. Use it only for justice!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Artorius_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KingArtorius_KHR_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205069,
