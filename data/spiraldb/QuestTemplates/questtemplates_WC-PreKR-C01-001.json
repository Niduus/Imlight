            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, my dear young Wizard. You are well rested, I hope, from your last ordeal? It is long past time we dealt with Morganthe.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_KHR_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We must rally the forces of Light! Sadly, the Council is reduced to only Diego, the Emperor of MooShu, Lydia Greyrose, and myself.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_KHR_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I need your aid, for you have forged a robust relationship with many defenders of Light.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MerleAmbrose_KHR_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38168,
            "m_cameraName": ""
          },
          {
