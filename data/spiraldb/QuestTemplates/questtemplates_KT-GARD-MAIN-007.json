  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Indeed, it looks quite full. You should now be able to reach your poor friend imprisoned on the other side.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_064.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But do remember the lesson of the fonts. You came to this new world, became a student, a hero, and gave back more than you took.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_065.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is okay to let go now, give up and give in and let the Spiral fend for itself.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_066.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Or don't. Good luck, Earthborn.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuail_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Quentin_Quail_KT-GARD_067.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594437,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Ceren_Nightchant_KT-GARD_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594478,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Duck? What duck? I saw no duck. And wait, did that Krok say Wizard? THE Wizard?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Ceren_Nightchant_KT-GARD_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594478,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That's right!",
            "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Istar_KT-GARD_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594441,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I remember you when you were barely an initiate on Unicorn Way. You made quite a name for yourself.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Ceren_Nightchant_KT-GARD_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594478,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I grew up a bit too since then, moved on from all that questing stuff. I really just wanted to, I don't know, decorate.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Ceren_Nightchant_KT-GARD_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594478,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm a Housing Designer now. It speaks to me. Hit me up when you're done saving the day and maybe I can give you a great deal.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Ceren_Nightchant_KT-GARD_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594478,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Do you decorate bottles? Because mine is looking real dated. Let's talk on our way back to Mellori. I saw her outside earlier.",
            "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Istar_KT-GARD_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594441,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hey, Wizard, looks like you saved Ceren the Salesman.",
            "m_picture": "GUI/NpcPortraits/Human_Mellori_C_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Mellori_KT-GARD_024.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634342,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And I can save you a bundle on your next house. Get <italics>nightchanted</italics> with our great deals. But, seriously, thanks Wizard.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Ceren_Nightchant_KT-GARD_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594478,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And Istar, found your way back again? How are you doing?",
            "m_picture": "GUI/NpcPortraits/Human_Mellori_C_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Mellori_KT-GARD_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634342,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-GARD-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not so great. I kept messing up as usual..",
            "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Istar_KT-GARD_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594441,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hey, we've been over this. You just need to find confidence, yeah? Don't let some old grumps get you down. You'll come through in the end.",
            "m_picture": "GUI/NpcPortraits/Human_Mellori_C_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Mellori_KT-GARD_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634342,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That's two of your seven friends found, Wizard. Now what?",
            "m_picture": "GUI/NpcPortraits/Human_Mellori_C_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Mellori_KT-GARD_027.mp3",
            "m_action": "",
