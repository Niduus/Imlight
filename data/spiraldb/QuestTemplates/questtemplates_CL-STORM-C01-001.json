            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You must collect the Storm Shards. One was lost in the rubble. Water-Lurkers and Morgantine soldiers took the others.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Morgantine_Ghost_03_NPC.dds",
