  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Alright, alright, let me see if I got this straight. The Tritons did settle this world. But they died. Lucky stiffs.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They were wiped out by their own creations, the Eldritch, who themselves declined into a trio of warring clans after the Song of Creation was finished.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And you found all this out in, what, a few days? I miss being young.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_027.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why? You were still slow as a slug back then.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-BALE_024.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765006,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, right, I forgot, the \"Soulik\" of the Shellions. Thanks - so much - for bringing her back in one piece. Alright, let's throw her in the brig.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_028.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Uh... Soulik Shelli... remember... the deal? She returns the remaining captives and you...",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_NomadF_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Phillis_Windstone_AH-BALE_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1727074,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What? Oh, sweet Sapwe, fine. Don't throw her in the Brig. She can redeem herself by capturing-",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_029.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Dismembering!",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-BALE_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765006,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "CAPTURING Miranda Briar. We're not savages. So you can clean up that sailor's mouth of yours, but not the violent disposition? Oi.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_030.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But we're not wanderers anymore. We're a society now; this world belongs to us and the clutches to come. Just get that witch off of it.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_031.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well at least you're doing something for once. Wiz-Kid, the Soulik lent us some Troopers; Phobus is with them. They'll get us to the Eastern Sea.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-BALE_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765006,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC09C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your Scholar friends are over there, figuring out something with navigation. Check in with them and we'll catch up later.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_NomadF_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Phillis_Windstone_AH-BALE_027.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1727074,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
