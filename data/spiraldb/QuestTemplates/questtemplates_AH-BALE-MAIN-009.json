      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC03B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What do you mean you just found an island?",
                "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-BALE_045.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765016,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC03B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sir, I mean we went looking for land before and didn't find any, then went looking again and did, sir.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Trooper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Cooper_Trooper_AH-BALE_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765017,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC03B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ack, moments like this make me wish I didn't hate Miranda Briar. Anyway, Wizard, that chimerical island is where we'll make landfall.",
                "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-BALE_046.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765016,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC03B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You made friends with a monster, did ye? Not the one from the attack? Oy, good. But I donnae know where it is, so we'll start with the island.",
                "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-BALE_047.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765016,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC03B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Scion, I can answer that, Scion. I am Trooper Captain First Grade Cooper, Scion. You may call me Cooper the Trooper.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Trooper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Cooper_Trooper_AH-BALE_002.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765017,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC03B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "With me are fellow Troopers: Hooper, Super and Clyde. We will swim you and your friends to the Eastern Sea on your order. Just talk to Super.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Trooper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Cooper_Trooper_AH-BALE_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765017,
                "m_cameraName": ""
              }
            ]
          }
        ]
