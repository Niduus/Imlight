                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of course I'll sign! I've been meaning to do some improvements around here, and a spot of ready cash will come in handy!",
