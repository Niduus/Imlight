      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hey dere, li'l Wizard! If'n ya got a moment, dere's something ya could look inta fer me... a matter of an inheritance.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Explorer.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProspectorZeke_ZFA_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465462,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Long ago, a lord and lady outa Marleybone sailed across the Spiral ta Zafaria, hopin' fer new lives here.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Explorer.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProspectorZeke_ZFA_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465462,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Their ship was wrecked... the only survivor was a little pup... found and raised by the Blackback Gorillas as one of their own!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Explorer.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProspectorZeke_ZFA_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465462,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Rumor has it he's become a reg'lar King o' the Jungle, famous across all Zafaria. They call him Zantar o' the Gorillas!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Explorer.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProspectorZeke_ZFA_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465462,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now his long-lost relatives in Marleybone just want ta get his signature... seems he's due ta inherit a bit of wealth!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Explorer.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProspectorZeke_ZFA_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465462,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could ya go to the Drum Jungle? See if'n ya can find Zantar, and get 'im ta sign this registered letter ta claim his inheritance?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Explorer.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProspectorZeke_ZFA_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465462,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He may be wild and savage... unable ta understand a word of what yer sayin', so be patient with 'im! Ye'll get through!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Explorer.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProspectorZeke_ZFA_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465462,
            "m_cameraName": ""
          }
        ]
