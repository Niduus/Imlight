      },
      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Runa? You forged a pact with Runa? We can cure the Curse... and you will help us? If we help you find Briar...",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jack_of_Knaves_WC-PreAH_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717126,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Very well. I don't know where she is or what she wants, but I do know she never cared about the curse. Her interest was in how we cured it.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jack_of_Knaves_WC-PreAH_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717126,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What do you mean?",
                "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jaki_Whisperwind_WC-PreAH_006.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717126,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The curse of Darkmoor is just magic. When we remove it, we remove magic from the host, drain it, transfer it. That is what Briar cared about.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jack_of_Knaves_WC-PreAH_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717126,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well... that and the Scholomance itself. You saw the ghosts that haunt it? The strange be-tentacled preceptors? They interested Briar most of all.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jack_of_Knaves_WC-PreAH_006.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717126,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Be-tentacled? Like octopi? Oh, like squids! Like... the Old One. He was a squid! Kind of. We never really knew what he was, or where he came from.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jaki_Whisperwind_WC-PreAH_007.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717126,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But if his people built the Scholomance, who knows what else they did?",
                "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jaki_Whisperwind_WC-PreAH_008.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717126,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh my Spirits! You're right, Wizard, the Old One knew what else they did... and Dasein knows what he knew! We should talk to him!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jaki_Whisperwind_WC-PreAH_009.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717126,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC49-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "By which I mean YOU should talk to him!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jaki_Whisperwind_WC-PreAH_010.mp3",
                "m_action": "",
                "m_dialogEvent": "",
