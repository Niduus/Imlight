      "m_displayImage1": "GUI/NpcPortraits/Portrait_Monkey_Keeper_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, well, look who it is, our newest Scholar fresh from an expedition. I had hoped you would throttle those stick figures for mussing my books.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Keeper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Librarian_Fitzhume_WC-PreAH_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346371,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Instead, Scholar Venkman told us you made a deal with them! Awfully pacifistic for someone who spends their time throwing monsters at people.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Keeper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Librarian_Fitzhume_WC-PreAH_002.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346371,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And now I have to go search my entire library for anti-aging enchantments, stabilizing components and something called a \"Soul Cage...\"",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Keeper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Librarian_Fitzhume_WC-PreAH_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346371,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "...All to help the louts who disorganized it in the first place. Anti-aging, bah! Let them rot, I say.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Keeper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Librarian_Fitzhume_WC-PreAH_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346371,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, or send a scroll saying 'Huehue-' Hmm? Why are you still here? Go see Ione. Always see Ione. Shoo, shoo!",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Keeper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Librarian_Fitzhume_WC-PreAH_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346371,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
      "m_noQuestHelper": false,
