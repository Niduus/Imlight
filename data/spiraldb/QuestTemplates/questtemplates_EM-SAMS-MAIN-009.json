            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Getting Mellori to the Chain did the trick, Wizard. I'm happy to say she's finally on the mend.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Beans_EM2_34.mp3",
            "m_action": "",
            "m_dialogEvent": "",
