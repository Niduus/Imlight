                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Who are you? Why do you wish to know of the forgotten projects? Oh, yes, the Eldritch made monsters. We made ONE monster to suit one purpose.",
                "m_picture": "GUI/NpcPortraits/Portrait_ Khrulhu_Base_D_NPC.dds",
