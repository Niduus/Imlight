                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But we mustn't speak of such things in the open. The weak-tendrilled invertebrates that run our society fear Balaur's preceptors will hear.",
                "m_picture": "GUI/NpcPortraits/Portrait_ Khrulhu_Base_D_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Hatecrafter_AH-WHITE_008.mp3",
