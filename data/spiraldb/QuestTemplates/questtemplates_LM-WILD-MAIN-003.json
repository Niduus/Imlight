  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Centaurzan, PROTECTOR OF THE PROTECTION-NOT-HAVING, will help Softfoot find Ursai... if Softfoot help Centaurzan first.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Centaurzan, WARDEN OF THE WILDERNESS, live in Cabin. Then Fossa infest it. Centaurzan, CHAMPION OF THE BEASTS, deathly allergic to Fossa.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If Softfoot clear out Cabin, Centaurzan, MISSER OF ROOF, show Softfoot way into Ursai Village.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Softfoot clear out Cabin? Centaurzan, HAVER OF FEELINGS, is most appreciative! Will tell Softfoot secret of Ursai Village:",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Many moons ago, Villagers grow angry with outsiders ruining tranquil Ursai lifestyle. So they make Village hard to get into. Very exclusive.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Centaurzan, KNOWER OF INFORMATION, know how to get in. She pretty sure. See innocent deadly Poisonthorn vines there? Path to Ursai behind them.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But Softfoot need Salve from Durian Fruit to get through Poisonthorns without dying from thorn poison. Plenty Durian Fruit in Wildlands. Giddyap!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah good, Softfoot have Durian Fruit. Now Centaurzan, SALVEOLOGIST, make Durian Salve. Aaaannd...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*Gags* Done. Here, Softfoot smear Salve on entire body. *Vomits in mouth* Ugh. Centaurzan, REGRETER OF NOSE, forget how stinky Durian is.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Luckily, Poisonthorn Vines hate Durian Salve stink too. Vines will wilt, revealing entrance to Ursai Village. But Softfoot take heed! Ursai Villagers... <ITALICS>interesting</ITALICS> characters.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-WILD-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Outsiders who go in, rarely come out. But hey, maybe Softfoot too stinky for Bears to eat now. Heh heh. Centaurzan, FOSSA-FREE HOMEOWNER, away!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Centaur_TarzanF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Centaurzan_LM-WILD_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "'Sup? I'm Tosh. How'd you get past the Poisonth- *Sniff* Oooh. Durian. Clever. Disgusting. Awesome! I've never met anything like you before.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-WILD_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520122,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Say, a while back the ground shook and the sky got all funky. Was that you? BOOYA! I KNEW it. The Bears all said I was crazy, but I was right!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-WILD_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520122,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Story of my life. I'm always pointing out interesting things, but the Bears just dismiss me. Only thing they care about is not caring. And naps.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-WILD_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520122,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not me, though. Nuh-uh. The Ol' Boi's got bigger plans for me. I'm gonna be interesting, important. You'll see. Everyone will see. Very soon...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-WILD_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520122,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
