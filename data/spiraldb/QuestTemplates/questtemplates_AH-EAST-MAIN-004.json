  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC04-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You, your scholars, Phillis and Phobus will be the Ground Team. They're heading to Nemo now.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-EAST_039.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752186,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC04-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Approach on foot, beneath the notice of the sopping creatures in the sea... most anyway. Then we'll have two Swim Teams to scout the two sides of the trench.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-EAST_040.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752186,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC04-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Cooper Trooper will lead a team to the south, Powe and I to the north. We find Briar, meet up, feed her to Bloop.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-EAST_041.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752186,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC04-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "MMMM... evil.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kaiju_Good_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bloop_AH-EAST_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752180,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC04-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Troopers are distributing those gloppin' Jellyfish so you can see down there. We'll be using Conchs to coordinate the three teams. Keep in touch and let's do this.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-EAST_042.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752186,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC04-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard... Sinek lives in the Trench. He has hunted me for... oh, so long. I smash so many things.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kaiju_Good_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bloop_AH-EAST_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752180,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC04-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So the Tritons made a sound that keeps me away. An Anti-Bloop Bloop. Oh, I hate it. Smash it, so I can come down and help you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kaiju_Good_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bloop_AH-EAST_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752180,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
