      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, you return. Behold my greatest creation...<italics> the Nautilizer II...</italics>",
                "m_picture": "GUI/NpcPortraits/FishBot_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Nemo_AH-EAST_016.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752401,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It is admittedly not as impressive as the <italics>Nautilizer I</italics>. But I made do with what I could find.",
                "m_picture": "GUI/NpcPortraits/FishBot_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Nemo_AH-EAST_017.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752401,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And what exactly is this... uh... marvel of technology supposed to do?",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-EAST_106.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752189,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As it lowers us deeper into the sea, it uses magical wards to alter our bodies so we can endure the pressure.",
                "m_picture": "GUI/NpcPortraits/FishBot_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Nemo_AH-EAST_018.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752401,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So... as long as we can breathe, we can walk around without getting smooshed? Neat!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Jaki_Whisperwind_AH-EAST_132.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752190,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yeah, you guys have fun with that.",
                "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Tarrak_Hadfield_AH-EAST_175.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752182,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Indeed. I too will sit this one out.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Qismah_Shasa_AH-EAST_121.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752192,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, no you won't.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-EAST_173.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752191,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Agreed. We are all going. We will follow the lead of our newest Scholar and we will bring Miranda Briar back to face justice.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-EAST_129.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752187,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "For Sybil. For Darkmoor. For everyone she hurt or will hurt. Let's load into that ramshackle tub and end this.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Zander_AH-EAST_188.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752193,
                "m_cameraName": ""
              }
            ]
          }
