  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-KING-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Spiders made threats that'll haunt me forever! I felt very unsafe! It's not what I signed up for when I, uh, answered my spiritual calling.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_ShamanF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Kanga-guru_WL-KING_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608155,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-KING-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, well it's in the past now and we are in the present. Let's get to the reason we've sought you out, oh wise one. My friend seeks the Dreaming.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-KING_037.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-KING-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Right! Of course. Many seek the Dreaming. It clarifies your goals and brings your hopes into being. It is profound inspiration in the purest form.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_ShamanF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Kanga-guru_WL-KING_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608155,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-KING-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Dream Waters are difficult to find. My sacred Divining Rods could lead the way, but they were stolen by the Bushwhackers that roam these lands.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_ShamanF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Kanga-guru_WL-KING_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608155,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-KING-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now that sounds like an adventure, eh, mate? I know you can do it. The hero always gets the adventure they're ready for. Go find those Divining Rods!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gator_Hunter_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Krokodile_Dundara_WL-KING_038.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1608154,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-KING-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My heart is lightened by the return of these sacred Divining Rods, vital tools I need to commune with the spirit energies of the ethos.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_ShamanF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Kanga-guru_WL-KING_007.mp3",
