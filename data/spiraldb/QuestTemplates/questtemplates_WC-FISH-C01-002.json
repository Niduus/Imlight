            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ya ready for your next Fishing lesson now? Ayuh, sounds like someone's hooked on Fishing. Let's get started!",
            "m_picture": "GUI/NpcPortraits/Portrait_Pelican_Fisherman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/LuckyHookline_FIS_26.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206837,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-Pelican-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ya're a bright kid, so I'm sure ya noticed that the Lesser Frost Lure I gave ya is an Ice school spell.",
            "m_picture": "GUI/NpcPortraits/Portrait_Pelican_Fisherman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/LuckyHookline_FIS_27.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206837,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-Pelican-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "An' ya probably also noticed that the Frost Dekoi and the Icecuda are both Ice school fish. Ice fish like Ice lures.",
            "m_picture": "GUI/NpcPortraits/Portrait_Pelican_Fisherman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/LuckyHookline_FIS_28.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206837,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-Pelican-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You can catch non-Ice fish with your Lesser Ice Lure, but you'll have a better chance if you buy the other school Lures.",
            "m_picture": "GUI/NpcPortraits/Portrait_Pelican_Fisherman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/LuckyHookline_FIS_29.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206837,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-Pelican-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
