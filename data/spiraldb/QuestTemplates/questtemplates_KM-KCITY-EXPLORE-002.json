            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you collect all the Peanut Buttercups you come across? It shouldn't take long. I'm sure you'll be done in a jiff. Thank you, friend!",
