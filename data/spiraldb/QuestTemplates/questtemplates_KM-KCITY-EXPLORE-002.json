            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh hello! Isn't Karamelle delightful? Of all the places Zeke has dragged me- um, I mean, that the Royal Museum has sent me, this is my favorite.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
