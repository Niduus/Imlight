      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yo, you ready for some combat training? Let's start with a little friendly sparring. Don't worry, you ain't fighting me. I'm too old.",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You're gonna spar with Qhreed. Yo, Qhreed, grab your mouthpiece!",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yo, go easy on the Wizard. We're all friends here, OK? Now, ring the bell Qhreed.",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Eh, yo, you can say that again!",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ha, yeah. He's right, Wizard. You're quite the fighter. But you could be better. Come here. I've got something for you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "When it comes to fighting, I thought I knew all there was to know, ya know? But you've got moves I ain't never seen before.",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yo, but just cuz I can't show you any new moves don't mean I can't help you get better. Here, I want you to have this...",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This gear is going to boost your PIP Recovery when casting an odd ranked spell.",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You know, like if you have six PIPs and cast a rank five spell, you get a chance to recover that unused PIP. Yo, you're welcome!",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC06-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Eh, you know, now that we've punched up your game, you ready for round two?",
                "m_picture": "GUI/NpcPortraits/Portrait_Ophidian_Brute_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RahqiBalBoa_MIR_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391055,
                "m_cameraName": ""
              }
            ]
          }
