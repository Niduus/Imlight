            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_PU_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
