            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You seem to know your way around here. Any chance you can go and rescue them?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_PU_04.mp3",
