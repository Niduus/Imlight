            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They just disappeared mysteriously, one by one. I can’t imagine why they left, but I fear all manner of deviltry!",
