            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I say! I hate to be a bother, as you’ve been a tremendous help, but there’s a matter I could use your assistance with.",
