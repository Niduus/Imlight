  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Broken Branch? Is that who those people were? They wanted my blood. Something about testing for the Were Curse.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And you wouldn't let them? WHY wouldn't you let them?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_018.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Because they are backwoods mystics who make clothing out of twigs! While it is true the Curse is highly transmissible, and the Weres in particular...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...Favor bolstering their numbers, I would not trust strangers in masks to judge my humanity. If I am turned, then I am turned!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Are you turned?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_019.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Presumably not.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That's not good enough! Weres can transform at will, Wizard. Neither sun nor moon need affect them. They hide in plain sight and strike!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_020.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Were you not the one alone in Were-Bear custody? Perhaps you have turned and this is misdirection!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What! We have to go back to camp, Wizard! We can't just stay here!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Indeed, the Wizard speaks true. If one of us has turned, they would only spread the curse further. Only Queen Glorina can allow us back.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_015.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I know not where she is, nor any special technique to locate her. You must track her the old-fashioned way, Wizard. Use what you know of our Queen.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Find signs of Glorina throughout the Howling Lands to lead you to her.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_017.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC05A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, the Scion Child of the Wretched Tree! Finally come to do some actual saving in Darkmoor, have you? No need. We Outsiders save ourselves.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderQueen_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Queen_Glorina_DM-HOWL_019.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634675,
            "m_cameraName": ""
          }
        ]
      }
