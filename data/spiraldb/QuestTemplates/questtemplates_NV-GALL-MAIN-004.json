  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-DEstate-NPC26-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I would quite happily give them anything they want.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/KM_Z00_CavityChamberVoid.dds",
            "m_soundFile": "Sound/Dialogue/Dasein_G4_Baby_Ponce_NV-GALL_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1717127,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Principe Mario di Mario",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And that is the problem, as I told you the last time we spoke! You must not make anything for anybody. They must buy all the things. Right, Don?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_080.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why... why is he a baby?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-GALL_046.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563034,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dasein G4 Manzana",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I sense greed in you, desire for wealth and resources in excess of your need.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/KM_Z00_CavityChamberVoid.dds",
            "m_soundFile": "Sound/Dialogue/Dasein_G4_Manzana_NV-GALL_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That is actually much more disturbing.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-GALL_047.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563034,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Principe Mario di Mario",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Enough! Dasein, we have reached an impasse. You insist on granting wishes. I insist you do not. By Valencian law, there is one resolution: we duel!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_081.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dasein G4 Nana",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If that... is your wish, I can manifest ideal opponents and a battleground for you... through there.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/KM_Z00_CavityChamberVoid.dds",
            "m_soundFile": "Sound/Dialogue/Dasein_G4_Nana_NV-GALL_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Principe Mario di Mario",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Excellent. Wizard, as my second, you must attend the duel. Onward.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_082.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Dasein! Show yourself. It is time for your reckoning! The duel was won and my demands will be met.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_085.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dasein G4 Copy Qhat",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As you wish.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/KM_Z00_CavityChamberVoid.dds",
            "m_soundFile": "Sound/Dialogue/Dasein_G4_Copy_Qhat_NV-GALL_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No! No more of that. There will be no more wishes for anyone! Remove the Valencian Steel Veins, stop regrowing the Monquistan trees!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_086.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "WHAT? I did not agree to that. Take the steel, but those trees are ours.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-GALL_049.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563034,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The trees are still yours. To tend to and to raise naturally. Not to mine incessantly for endless resources. It is a small price to pay for peace.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_087.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A small price we pay to you, you mean? Hmm? For your lumber and goods?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-GALL_050.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563034,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Would you prefer we go back to fighting until this world shakes itself to pieces?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_088.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Very well. Dasein, is it? Do as his Highness requests. Grant none on this world any further boons.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-GALL_051.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563034,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Splendid! Now let us return to Puerto Nuovo and tell everyone of the compromise we made today!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_089.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dasein G4 Wizard",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You know, I'm not sure anyone can be the glue that binds those two civilizations. But I wonder...",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/KM_Z00_CavityChamberVoid.dds",
            "m_soundFile": "Sound/Dialogue/Dasein_G4_Wizard_NV-GALL_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No use shouting, Wizard, Dasein is gone. Is this Manticore you're asking about important? Huh. Well, come along, let us go... compromise.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-GALL_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563034,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wondrous news, my friends, Principe Mario di Mario of House Mario has saved you all!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-GALL_090.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1563033,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
