          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-MORT-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ho there, stranger, we don't see many visitors round these parts, what with the beasts in the Whispering Woods.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Edward_Farmer_DM-MORT_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687159,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-MORT-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, don't believe what that kook is telling you. We've been here generations we 'ave, protected by the benevolent House of Cups.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Edward_Farmer_DM-MORT_002.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687159,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-MORT-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They sit up there in their celestial palace and keep us safe from the things what stalk the night. Lucky people, we are, to live under their good graces.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Edward_Farmer_DM-MORT_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687159,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
      "m_noQuestHelper": false,
      "m_destinationZone": "Darkmoor/DM_Z02_MortalPlain",
