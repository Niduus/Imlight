                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Silly thing to say, what parent doesn't do that? Thank the heroic stranger, son.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Nomad_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Geppetto_Oarsman_AH-FORB_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752414,
