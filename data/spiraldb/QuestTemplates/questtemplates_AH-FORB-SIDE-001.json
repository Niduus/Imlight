                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You found him? You found my boy? Oh, thank you, thank you. I made him myself, you know.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Nomad_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Geppetto_Oarsman_AH-FORB_003.mp3",
