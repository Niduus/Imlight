                "m_personaName": "AH-FORB-NPC13_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, I hope he isn't in shock from this traumatic experience. A telepathic Whalebird, really! Whoever heard of such a thing?",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Nomad_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Geppetto_Oarsman_AH-FORB_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752414,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC13_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But then there are strange beasts in these waters, I cannot deny it. I spoke with the Trooper nearby. We will follow him to the Eastern Sea.",
