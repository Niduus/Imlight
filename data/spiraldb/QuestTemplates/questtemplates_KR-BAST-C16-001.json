            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, young warrior, hello. Word has spread that you are a valiant and powerful ally. May I trouble you for assistance?",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/CalvertHawklord_KHR_05.mp3",
