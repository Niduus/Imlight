                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Or when you're starving on the open ocean, surrounded by nothing but salt water and hungry men.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Captain_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Powe_AH-BALE_010.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1761029,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC08B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Too true, too true, I presume. Never seen an ocean before meself, so I'll take your word for it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-BALE_018.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1727083,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC08B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The other Scholars are scattered about trying to decipher where Miranda went and what she's after. Go gather 'em, will ye?",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-BALE_019.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1727083,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
