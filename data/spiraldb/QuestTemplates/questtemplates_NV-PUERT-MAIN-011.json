  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "<ITALICS>Sorpredente!</ITALICS> I wonder... Is this truly a good thing? Alas, what will be will be.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_029.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562151,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Let us go tell the Principe what you have accomplished. Perhaps he will now have his wish. For Valencia's sake.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_030.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562151,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard - you have come. Thank goodness! This is a calamity! Something terrible has happened. The fish - look at them. LOOK!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-PUERT_057.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They are Valencian Snapper no more. They are cold, stinky Sole - the worst of all fish!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-PUERT_058.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wait... this is no accident? Your friend Dasein, he has done this? Pourquois? Wait, the VALENCIANS did this? How?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-PUERT_059.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What? WHAT? The Unicorns seek to deprive us, and YOU have been their instrument? This is not maintaining peace! It's an act of war!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-PUERT_060.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But... we of Polaris are an enlightened nation, ruled by reason and equality, not the greed of monarchs. We will not start a war. We will negotiate!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-PUERT_061.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard, you will stand in for the Valencian government, since you are so close. To the Negotiation Chamber with you! C'est by the Basstille.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-PUERT_062.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          }
        ]
      }
    ]
