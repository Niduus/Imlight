          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Your friend, he heard you? And he has done as I asked? FABULOSO! I have taken the Pingouins' Snapper away. Or at least, he says I have.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_026.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562164,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If the Snapper are gone, there is no need for military action, enjoyable as it might be. We must go to La Ville Rose and verify this is the case.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_027.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562164,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And by we, I of course mean you. I shall remain here and begin celebrating. Oh, if only I could see their little faces! Draw me a sketch, Wizard.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_028.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562164,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, <ITALICS>amico mio</ITALICS>! You are back quickly this time. So what did the Pingouins say? Where is your sketch?!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_029.mp3",
