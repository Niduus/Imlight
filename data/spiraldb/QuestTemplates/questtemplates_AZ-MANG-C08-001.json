  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello, young traveler. I am the legendary Philosoraptor. Surely you've heard of me? No, huh? A new quandary to ponder, then.",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I ponder the Great Questions of Life! Do we avoid risks in life so we can make it safely to death?",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Or! Do we see colors differently? Is my red your green? Is your blue my blue?",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In order to philosophize in the manner of the ancients I need my much-revered Thinking Rock. It is one of a kind.",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Lamentably, those malodorous, hirsute Monquistans took it and claimed it for their captain.",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Without it, I cannot answer the Great Questions. If actions are stronger than words, why is the pen mightier than the sword?",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Please go and teach the Monquistans the error of their ways. Do not hesitate to be as forceful in your argument as need be!",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go Old School, as it were! They are milling about by their vessel in Saltmeadow Swamp!",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 726112,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-MANG-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go to Saltmeadow Swamp and \"persuade\" the Monquistans to return my Thinking Rock.",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_G_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Philosoraptor_AZT_09.mp3",
