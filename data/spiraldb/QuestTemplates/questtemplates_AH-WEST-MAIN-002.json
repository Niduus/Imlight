          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Perhaps we should destroy the Core? No, you may need the Akashic Records yourself if Miranda finds what she wants without them.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_032.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Difficult choice. I am unaccustomed to uncertainty.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_033.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As for what Miranda may desire from the Akashic Records... the Eldritch made many things. Monsters and weapons and... ah...",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_034.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "...The Storm Engine was reactivated.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_035.mp3",
