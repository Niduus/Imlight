      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Eldritch were an industrious people, living in the twilight years as I sang the Song of Creation.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_022.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They might have even become a dominant force in the Spiral... had things turned out differently.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_023.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I did nothing, my Scion. The Eldritch's fate was... inescapable. And the Bales? Could I have saved them, their world? Yes, of course.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_024.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But then the Kroks would have moved to other worlds, different worlds. Which world do you save and which do you sacrifice?",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_025.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In the sequence I chose, the Kroks are ultimately defeated. In other timelines, they still reign over countless worlds to this day.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_026.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In the cold calculus of morality, I picked the lesser evil. But, yes, Scion, as you say... that is poor comfort to those sacrificed for it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_027.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You have seen some of the Eldritch horrors yourself. The Scholomance that fomented dark impulses of souls and mangled bodies into cursed proportions.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_028.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That was but one such academy, one such weapon, and it condemned an entire world for countless centuries. The Akashic Records contain many more.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_029.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Thus you must disable this access point before Miranda Briar discovers it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_030.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC08-A_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Simply remove the Core from the Gateway and it will become useless.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-WEST_031.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756269,
                "m_cameraName": ""
              }
            ]
          }
        ]
