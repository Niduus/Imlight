      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Turtle_Captain_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC09-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I don't care if the king of trees says the Shellions might be there. I won't be sailin' into danger on a hunch.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Captain_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Powe_AH-WEST_019.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756089,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC09-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But... perhaps we should risk it ourselves. I am an expert in storms. I shall accompany you on this journey, Wizard.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-WEST_033.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756080,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC09-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And if this is a Storm Engine as ye say, well that's my arena. So I'm in too.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-WEST_023.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765131,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC09-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, leave that Akashic Core with me. Maybe I can find out how it works.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-WEST_106.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756085,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-WEST-NPC09-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Very well then... let us take another Rowboat to this Storm Engine.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-WEST_034.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756080,
                "m_cameraName": ""
