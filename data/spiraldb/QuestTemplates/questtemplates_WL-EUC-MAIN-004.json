            "m_actorTemplateID": 1560338,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC02-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hey now! That's missing the point, mate. It's not just one outsider. It's the Townies that invite them. They're the problem. Always... always have been.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_LeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Morp_WL-EUC_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560328,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-EUC-NPC05-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The lead Rider told you to jump in a lake for answers? Some feuds transcend time and reason. But the Dreaming remembers. Be mindful, Wizard.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_WL-EUC_092.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560335,
            "m_cameraName": ""
          }
        ]
      },
