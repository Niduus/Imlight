          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Alright, today's the day. Or night. Doesn't matter. This is where we separate the Roos from the Joeys. Many of you won't be coming back.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Superior_Judge_Rozzer_WL-BILLA_009.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608179,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There's only two of us.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_D_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Lawless_WL-BILLA_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608181,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But to all of you who die, know you die in service of something greater than yourself. Know you die for salad bars.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Superior_Judge_Rozzer_WL-BILLA_010.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608179,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And spas, and golf courses, for lagoons and excessive mark-ups, for towels that will never be returned. Know you die for a dream.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Superior_Judge_Rozzer_WL-BILLA_011.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608179,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "My dream! Rather, that is, the dream of Wallaru as a significant economic power in the Spiral. Is that not worthy of sacrifice?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Frog_Owner_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Mr_Cane_WL-BILLA_007.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608172,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-BILLA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Eh, politics ain't my arena. This Pipeline though is about to be. Come on, Wizard, let's go smear it with monsters.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Superior_Judge_Rozzer_WL-BILLA_012.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608179,
                "m_cameraName": ""
              }
            ]
          }
        ]
