            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, I'm just a Deer, with a Deer's courage. Morg told me where his lair is, but he bragged that nobody can breach the gates. How do we get in?",
