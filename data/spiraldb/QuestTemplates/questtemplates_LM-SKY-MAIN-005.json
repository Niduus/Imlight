            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Eye Robots! Morg reprogrammed them - if you dismantle their data banks you can find the Entry Code to unlock the gate!",
