      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, the conquering hero. Savior of the cats and dogs and squids and such. Destroyer of humanity.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_134.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Just some kid from Australia is the end of us all.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_138.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But then I should never have expected better of you, I don't know why I did. You're part of the problem after all.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_140.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Do you know what it is, why Earth is in such a terrible shape, why we need to go outside the box to save it?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_141.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Maybe if you weren't busy twiddling your thumbs and paid attention to the world you left, you'd see it.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_144.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There's really only one reason. Whatever your issue is, your enemy, the cause you've chosen over all others - they're all symptoms of the same disease.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_145.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "People. It's always people. These selfish, narrowminded, empty-headed NPCs running around causing problems for their betters to fix.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_146.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I guess I hoped you'd understand, that the unique outsider's perspective you've enjoyed here would enlighten you.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_147.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In all your little return trips, didn't you look? All the same evils you fight here are there as well. You didn't notice that? No.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_149.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC46-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Because you're just part of the problem too, and I'll have to solve you like I'm going to solve everyone else. See you again real soon, Wiz-Kid.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AR-PostAH_152.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779245,
                "m_cameraName": ""
              }
            ]
          }
        ]
