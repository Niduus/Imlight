            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Sooooooo... mission accomplished right? Our first real team quest. I think we nailed it. Let's do it again!",
