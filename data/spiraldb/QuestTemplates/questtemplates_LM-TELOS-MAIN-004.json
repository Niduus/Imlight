      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Anyway, we've got a dark Old One secret to dive into. Let's keep this adventure rolling!",
            "m_picture": "GUI/NpcPortraits/Portrait_Chicken_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Bantam_LM-TELOS_046.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487444,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ha-ha! The Wizard! Like what I've done with the place? It's still a work in progress, but I've got plans. BIG plans.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Horse_Explorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Stallion_Quartermane_LM-TELOS_032.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521319,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Tell me of your adventures! Did you find another Monitoring Station? What bizarre monstrosities did you encounter?! And is that a masked Chicken?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Horse_Explorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Stallion_Quartermane_LM-TELOS_033.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521319,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The name is Kit Bawker. Most know me as the Ghost Who Squawks. But you can call me... the Bantam!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Chicken_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Bantam_LM-TELOS_050.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487444,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, I like the cut of this fella's jib. Ha-ha! Now for my news: Our Lemur hosts tell me there's another Monitoring Station in the Night Forest.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Horse_Explorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Stallion_Quartermane_LM-TELOS_034.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521319,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's a simple bushwhack through the Wildlands. If you reach the Carnosaurs you've gone too far. Ha-ha! Bantam, let's you and I look over this map.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Horse_Explorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Stallion_Quartermane_LM-TELOS_035.mp3",
