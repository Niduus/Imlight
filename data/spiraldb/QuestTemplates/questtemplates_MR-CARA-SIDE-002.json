      "m_displayImage1": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello, Wayfarer. I'm sorry you've come all the way from wherever it is you've come all the way from, but I am not accepting new commissions.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What? Burdie asks for me? That changes things! It was Burdie who steered me away from the thief's life, and encouraged me to pursue art.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'd love to repay Burdie with mosaics, but I'm afraid my patron, Ali Uup, will not allow it. He's not the generous type.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I make art exclusively for the ruthless Thuggie Captain in return for his 'protection' - protection I never asked for.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you can work it out with Ali Uup, I will gladly make mosaics for Burdie in Caravan. But I'm not optimistic. Good luck!",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard! What news? You won my leave? Goodness! I won't ask how. You must be quite the master of your craft.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm excited to be able to repay Burdie. Even if I do have to return to this cesspool eventually. Let's be off!",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "For you, Burdie, I will create as many mosaics as you desire. I only wish I could do more.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Alas, I must return to the service of the Thuggie Captain, Ali Uup, as soon as my work here is complete.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Abbas_MIR_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378114,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
