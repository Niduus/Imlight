            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So you just stop, that's why! Stop interfering with our experiments, stop fighting us wherever you find us, just stop!",
