            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, Miranda Briar attacked the Arcanum; we simply went along. Because we needed to, because your master left us no choice.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_010.mp3",
