          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC15_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So Poirot got you to do his dirty work did he? He's wanted to pin something on me since I pinned him at the Week's End Box Social Wrestle-a-Thon.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroHunter_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MaxtheHunter_EM2_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447375,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC15_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sore loser, he is. And I guess he thinks accusing a hunter of attacking the Cretan Bull is an easy cop. Even though I didn't do it.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroHunter_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MaxtheHunter_EM2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447375,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC15_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I was at the Hunters Guild, brawling with some of them Whirlyburly slugs.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroHunter_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MaxtheHunter_EM2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447375,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC15_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you ask me, Eleanor's the one you want. She's been sore ever since a Blue Ox ran through her fancy dishware shop.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroHunter_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MaxtheHunter_EM2_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447375,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
