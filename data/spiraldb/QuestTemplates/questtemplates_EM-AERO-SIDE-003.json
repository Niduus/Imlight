            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC16_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, look at you... whatever you are. Quite the fetching attire, I see. Quite fetching. What can I do for you?",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/EleanortheSocialite_EM2_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447376,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC16_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, is Hercules still going on about that silly Cretan Bull? He doesn't actually think I attacked the wretched thing, does he?",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/EleanortheSocialite_EM2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447376,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC16_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "He does? Well, I never. But, no, it wasn't me. I was up in Nimbus, hobnobbing with royalty. A very prestigious honor for Aero Dwarves, you understand.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/EleanortheSocialite_EM2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447376,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC16_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But Ebenezer, now he's never been fond of the Cretan Bull. Always traipsing mud around or some such. You should talk to him.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/EleanortheSocialite_EM2_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447376,
                "m_cameraName": ""
              }
            ]
          }
        ]
