                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If anyone's looking for some revenge, it's her.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroHunter_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MaxtheHunter_EM2_05.mp3",
