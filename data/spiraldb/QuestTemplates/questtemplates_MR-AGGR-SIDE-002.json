            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ridding those properties of the Thuggie squatters was a good deed, my friend. And in return, I've got a good deed for you...",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_O_NPC.dds",
