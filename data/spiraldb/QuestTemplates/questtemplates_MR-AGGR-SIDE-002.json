                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Leave me alone. I've no money for you to steal anyway. What? Dunestrider wishes to make amends? Wow! Thank you! And thank you, Yahya!",
