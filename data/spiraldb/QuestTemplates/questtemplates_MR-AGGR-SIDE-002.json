            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'd escort you to it, but I really should head to my Office and get to work returning these keys to their rightful owners. Enjoy your new estate!",
