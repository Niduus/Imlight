            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_O_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/YahyaDunestrider_MIR_12.mp3",
