                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Who am I? Why it's a-me, Mario di Mario, Principe of House Mario! Explorer of the Spiral, unlike my brother, of whom we do not speak. *Ffneh!*",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562164,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What is this you say? Marleybone seeks to start a war between us and our Monkey allies? This is OUTRAGEOUS!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_002.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562164,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Worst of all, they unleash Demons - actual Demons - in our landing camp. It's-a ruined! RUINED I say! And soon... Oh no no no NO!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562164,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Governor, she is coming soon! Lady Pesca, she is touring another castle. If she sees such chaos, I am DOOMED! It's a-down the tubes for Mario!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562164,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You, human - take me to the Neutral Pavilion on Conatus at once! The Dogs will pay for this. THEY WILL PAY!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562164,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And I will accompany you as a witness, in the name of our glorious alliance.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_027.mp3",
                "m_action": "",
