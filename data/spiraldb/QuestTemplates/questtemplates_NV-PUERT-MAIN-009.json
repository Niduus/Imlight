  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Marleybonian Dogs would set us at each other's throats? A coward's plan! But it almost worked. Don Manzana, without you we would have been lost.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Unicorn_Guard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Captain_Argento_NV-PUERT_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562160,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You flatter me. It was the Wizard who thwarted their ambitions. Wizard, I see Ponce de Gibbon's tales of your weakness were but jealousy.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Swarms of the fiends remain. It will take time to defeat them, but these Silver Weapons, they will give us the strength to do it. <ITALICS>Grazie</ITALICS>, Wizard.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Unicorn_Guard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Captain_Argento_NV-PUERT_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562160,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But a more important task remains. The Marleybonians must be made to PAY for this treachery! The cowards, they have gone too far this time.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Unicorn_Guard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Captain_Argento_NV-PUERT_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562160,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard, go to the illustrious leader of our expedition: the Principe. He will get to the bottom of this!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Unicorn_Guard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Captain_Argento_NV-PUERT_015.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562160,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "An excellent suggestion. In the spirit of our noble and glorious alliance, I will accompany you, Wizard. Vamanos.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          }
        ]
