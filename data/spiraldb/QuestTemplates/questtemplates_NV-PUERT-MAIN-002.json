  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Salutations, great Monquistador. As the first Valencian to sail to every world, I am honored to be in the company of such an esteemed explorer.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562151,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You flatter me. Your achievements in <ITALICS>sailing</ITALICS> are indeed remarkable. I have always preferred to muddy my feet when I explore.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-PUERT_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562150,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This must be a new thing for you, exploring the lands of Puerto Nuovo. Other than strange monsters you needed saving from, what have you found?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-PUERT_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562150,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Marvelous things, wonderful things! Look at these... I hesitate to call them ruins. The proportions, the arrangements - they're mathematically perfect!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562151,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And the flora! Oh, I should have brought a poet with me. Instead, I have nothing but surveyor's tools. I wonder, could you assist me?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562151,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I was making a plan of the ruins when the monsters attacked. Please, help me finish my measurements so I can pass on their perfection to the Spiral!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562151,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have no head for math and architecture. Wizard, surely you can help with these measurements.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-PUERT_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562150,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Grazie! Grazie! Thank you so much. With these notes I will be able to make an exact master plan. The greatest artisans of Valencia will be awed.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562151,
