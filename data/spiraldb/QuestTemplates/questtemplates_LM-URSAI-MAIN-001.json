  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "At the Killawahoo Ceremony! The Ol' Boi's going to be so impressed by the song I'm working up, he's gonna put the Angry Mountain to sleep forever!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-URSAI_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520122,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You should stay for the Ceremony! Ooh, but you'll need to clear that with the Hierarch first. She's in her Sanctum of Reflection.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-URSAI_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520122,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Don't worry, Juju will totally say yes. She's even more laid back than the Bears. Also my aunt! Worst she'll do is guilt you into doing chores.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-URSAI_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520122,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah! Wake up, Chew'i, you're having a nightmare again! Oh. You're real. Go ahead then, do your worst. I'm too tired to fight back. What's that...?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bear_Islander_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Chewi_LM-URSAI_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520124,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...Juju sent you to help with Killawahoo Ceremony preparations? Nice. I'm too tired for follow-up questions. Just collect three bushels of Mangos.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bear_Islander_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Chewi_LM-URSAI_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520124,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Thing is, someone already ate all the ripe Mangos here in the village. It was probably the Ghost Who Squawks. No need to investigate.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bear_Islander_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Chewi_LM-URSAI_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520124,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But I hear the Wildlands are lousy with Mango trees. That's no problem for a big strong... whatever you are, right? Great. Good luck!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bear_Islander_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Chewi_LM-URSAI_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520124,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wow! Those are some funky looking Mangos! You say you plucked them off walking Mango Trees? Which you've dubbed, 'Humangos?'",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bear_Islander_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Chewi_LM-URSAI_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520124,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can't tell if you're speaking gibberish, or if I'm too tired to comprehend the words coming out of your weird little face. Either way, thanks.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bear_Islander_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Chewi_LM-URSAI_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520124,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
