        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh... you’re after parts for the submersible? I’ve bad news, then.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It’s been a relentless assault since we arrived, and now we’re in a bit of a jam.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Some dastardly saboteur has untethered our dirigible, the <ITALICS>SGS Explorer.</ITALICS>",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We kept our supplies on the dirigible, including submersible parts, to keep them from the Water-Moles, but now the dirigible’s gone!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Suspecting the worst, we sent a search party after it..., but the Sea-Spirits bedeviled us and kept us from searching.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you’re willing to help, you’re my new best friend! I’m tapped for resources, and am so weary.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-LAND-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you go and roust those blighters? Don’t worry about hurting them... they’re just animate sea-water. They re-form in a jiffy!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Lower01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PierceStanson_CEL_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211522,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
