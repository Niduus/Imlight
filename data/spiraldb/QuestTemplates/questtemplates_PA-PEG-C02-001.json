      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wysteria was once wild and overgrown with vines, but we cut them back and made this place a school... Pigswick Academy!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465145,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am Groundskeeper Verne, head gardener around here. It is my job to know every inch of these streets and parks!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465145,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "These Goblins and their Hobgoblin overseers are new, arriving just when the tournament was to begin.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465145,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They are not native to this world of Wysteria, so I would like to know where they came from!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465145,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Since they arrived, some strange new plants have sprung up on Pegasus Place, and I suspect they're tied to the new visitors!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465145,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you go and collect three samples of these strange plants, so I can do some research into their world of origin?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_13.mp3",
