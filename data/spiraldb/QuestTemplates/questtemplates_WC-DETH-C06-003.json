            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Without twigs from the Death Tree and the sackcloth from Gloria Krendall, we can't make your Scarecrow. How much more do you need to know?",
