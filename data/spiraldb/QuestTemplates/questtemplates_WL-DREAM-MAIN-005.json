          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Townie Dream A",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We're just looking to improve quality of life. Maybe we didn't think about the long-term consequences.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Kangaroos_Judge_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Townie_Dream_A_WL-DREAM_003.mp3",
