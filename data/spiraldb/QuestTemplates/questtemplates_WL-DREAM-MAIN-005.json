          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Drover Dream A",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We tried to protect the Dreaming. We pretended it was wisdom, but really, we panicked and insulated ourselves.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_RangerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Drover_Dream_A_WL-DREAM_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-DREAM-NPC03-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why is life so stupid, Wizard? And messy and complicated? I want to trample-stomp something, ahhhhhhhhhhh! But I don't know who. Both sides are bad.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-DREAM_051.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560425,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-DREAM-NPC03-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But I eye them now. I eye their reasons. One side builds, one side maintains. Both sides don't think about tomorrow.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-DREAM_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560425,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-DREAM-NPC03-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I still don't like it. But worse is Freddie. I eye him clear as wombat spit. He doesn't care about Townies or Drovers. Only himself.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-DREAM_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560425,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-DREAM-NPC03-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He's simple, easy, he we can trample-stomp.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-DREAM_054.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560425,
            "m_cameraName": ""
          }
        ]
