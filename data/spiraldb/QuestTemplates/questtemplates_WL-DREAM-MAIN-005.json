            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Drovers are liars.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_KoalaRider_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Furryosa_WL-DREAM_050.mp3",
