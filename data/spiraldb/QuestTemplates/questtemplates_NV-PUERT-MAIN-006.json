  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have word that Ponce de Gibbon has gone mad! He is in our fortress, raving about the Water of Life, his old obsession. He won't come out.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Madness is such an unseemly thing and the good Don is leading his soldiers astray. But none would risk dishonor by detaining a noble like him.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Therefore, Wizard, I must beseech you to enter Ponce de Gibbon's Fortress and dissuade him of this folly.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is done, then. How unfortunate. Children can be so embarrassing. And messy. Little Ponce will be put on a ship for home.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Strange, none of the other water here had that effect. Only where de Gibbon looked did he find what he most desired. Why?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No matter. I will see that only the best nannies attend to him. I will also make sure nobody drinks this water. Just in case.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          }
        ]
      }
    ]
