            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We are readying the Kermes Fire for Warlord Kravenly's final push to drive the Burrowers from the Last Wood.",
            "m_picture": "GUI/NpcPortraits/Portrait_Millipede_Warrior_H_NPC.dds",
