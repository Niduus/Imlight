            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-TyrianGorge-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Sky Screamers by the Milkweb Gate have tight control of the  <ITALICS>Kieselguhr</ITALICS> Powder. I don't know how you'll convince them to give some up.",
            "m_picture": "GUI/NpcPortraits/Portrait_Millipede_Warrior_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KtorrJrrol_KHR_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-TyrianGorge-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Of course, once stabilized, you'll then need a Fuse to light it. You knew that, right?",
            "m_picture": "GUI/NpcPortraits/Portrait_Millipede_Warrior_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KtorrJrrol_KHR_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223193,
