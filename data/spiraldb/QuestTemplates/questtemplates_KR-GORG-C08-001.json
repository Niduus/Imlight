            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you been on the front lines fighting the Burrower vermin? Good on you, Spellbinder.",
            "m_picture": "GUI/NpcPortraits/Portrait_Millipede_Warrior_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/KtorrJrrol_KHR_04.mp3",
