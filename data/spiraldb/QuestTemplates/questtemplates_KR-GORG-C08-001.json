            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What do you need? To move some Kermes Fire? If you mix some <ITALICS>Kieselguhr</ITALICS> Powder into it, oh yeah, it will stabilize.",
