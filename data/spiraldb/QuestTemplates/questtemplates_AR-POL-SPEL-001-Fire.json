  "m_questLevel": 100,
  "m_questRepeat": 0,
  "m_onStartQuestScript": "",
  "m_onEndQuestScript": "",
  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well, if it isn't the most promising young Pyromancer in all the Spiral. How are you, my friend? I hope the pressure here's not getting to you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IgnusFerric_POL_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340968,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Accomplished as my colleagues may be, they forget that we're not just here to pursue our individual interests. We're here for a common cause.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IgnusFerric_POL_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340968,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And seeing as how you just joined us, I was thinking I might share some of me favorite spells. Matter of fact, I got a real sizzler in mind.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IgnusFerric_POL_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340968,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But I can't share it with you until you've been approved by the Arbiter Proctis, Cyrio Cassini. Go see him and get tested. I'll be here.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IgnusFerric_POL_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340968,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
