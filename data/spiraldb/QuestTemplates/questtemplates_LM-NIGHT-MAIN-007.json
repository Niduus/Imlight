  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is for that reason we have built these Apple Watchmen to keep her away.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_058.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But now you must remove these wards so that we may call the Doctor Witch to tell us what to do.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_059.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Dr. Abigail B. Witch at your service, though you don't seem ill. Your friend however... clear cases of the Blotch, the Rheumbas and the Blerps.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_CitizenF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Doctor_Witch_LM-NIGHT_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520138,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Enough of thine quackery! We know you are a purveyor of maladies and ills.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_062.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am a purveyor of diagnoses... and bills. It is hardly my fault you all live sickly lives. Now what do you wish? Ah, case of Malughast, eh?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_CitizenF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Doctor_Witch_LM-NIGHT_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520138,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The technical term is actually \"Manavore.\" Dreadful creatures, very rare. Drawn to Mana Wisps and wonder. And then they eat them both.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_CitizenF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Doctor_Witch_LM-NIGHT_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520138,
            "m_cameraName": ""
          }
        ]
      }
    ]
