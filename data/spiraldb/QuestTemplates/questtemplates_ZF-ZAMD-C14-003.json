      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-ZAM-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Do you know much of Zafaria of old? Time was when the Umbra Queen ruled the whole land from her Spider Temple.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Blind_WhiteMane_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/BlindWhitemane_ZFA_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465306,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-ZAM-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Her shadow fell on all people, and they were forced to serve her dark whims. But there was always hope.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Blind_WhiteMane_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/BlindWhitemane_ZFA_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465306,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-ZAM-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A Lion king, a Zebra witch doctor, an Elephant longdreamer, and a Gorilla chief created a mighty spell to open a Spiral Door.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Blind_WhiteMane_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/BlindWhitemane_ZFA_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465306,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-ZAM-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A council of Wizards came through and helped them tear down the Spider Temple and restore the world to brightness.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Blind_WhiteMane_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/BlindWhitemane_ZFA_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465306,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-ZAM-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Perhaps we are hearing that story again today.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Blind_WhiteMane_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/BlindWhitemane_ZFA_17.mp3",
