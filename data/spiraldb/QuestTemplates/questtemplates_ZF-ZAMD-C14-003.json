            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have one last favor to ask of you, outsider. This war has meant I hear nothing but the sounds of battle day and night.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Blind_WhiteMane_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/BlindWhitemane_ZFA_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465306,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-ZAM-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I miss the sounds of music. Could you play the drum circle for me? Then I will tell you a story.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Blind_WhiteMane_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/BlindWhitemane_ZFA_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465306,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-ZAM-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Please play the drum circle. It will take me back to a better time, if only for a little while. Then I will tell you a story.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Blind_WhiteMane_NPC.dds",
