  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They must be heroes in the mold of Stallion Quartermane. Like Solomon. They share his bravado, his skill, his... adventurousness.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-MAND_107.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507625,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "All Heroes are good, yes? They oppose villains, who are evil - as Lucien was. So why do Duck and Mandar seem so... oppositional?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-MAND_108.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507625,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Is one secretly a villain? Will they betray us at a critical moment? I suppose we must follow them to this safe haven of Mandar's to find out.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-MAND_109.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507625,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What now? You only beat me because there are two of you. Come to gloat? Or would you fight me again?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_020.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mandar, I am not your enemy. Moth-Amon is. He's the enemy of everyone in Mandoria. He betrayed us both - let's fight him together!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_079.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you truly fight against Moth-Amon, then I will fight beside you. But for Grom's sake, the Ancient One's Fane must never open again!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why not? Look at the sky - the world has changed. We must find the knowledge of the Ancient One so we can understand what is happening.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_080.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Once before it was opened, and from it streamed foul demons that sought to destroy Mandoria.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Interesting. One seeks to discover, the other to defend. Both noble goals. How can they be reconciled?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-MAND_111.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507625,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I believe you, Mandar. Here is my bargain: I help you overthrow Moth-Amon, you help me open the Sanctum, and we fight the demons together.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_081.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Imagine how glorious the battle will be! The name of Mandar will be the stuff of legend! Surely with this Wizard's help we will prevail.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_082.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So be it - may Mithra guide our blades. I shall be king of Mandoria by my own hand TWICE, by Grom! But how can I stand against Moth-Amon's magic?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have an idea. Come to my campsite - we can make our plans there. Let's go, Wizard.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_083.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
