              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC23_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hold, Skion. You wouldn't want to startle my guards now. Let us behold the first naming in generations. Child, take your place in the song!",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_TreeF_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Grandperson_Tree_AH-PRIM_009.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756055,
                "m_cameraName": ""
              },
              {
