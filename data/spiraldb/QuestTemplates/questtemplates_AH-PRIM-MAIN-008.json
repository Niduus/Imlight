                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It is done. The song is taken. And you are nameless no longer... Oliver.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_TreeF_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Grandperson_Tree_AH-PRIM_010.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756055,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC23_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And you, Skion, you have seen our ways. You will abide by them. You will revive our Trees, or our next Nameless will become Skion instead.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_TreeF_B_NPC.dds",
