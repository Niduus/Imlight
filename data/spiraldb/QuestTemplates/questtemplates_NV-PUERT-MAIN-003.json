            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is hard to believe such an aesthetically perfect paradise could be so dangerous.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_011.mp3",
