          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In my experience, the most beautiful places are the deadliest of all. I can remember when I went to the Cerulean Chasm of- but I digress.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-PUERT_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562150,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I see the opening to another valley over there. Have you explored it yet?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ponce_de_Gibbon_NV-PUERT_015.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562150,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not yet. I dispatched a Clockwork Surveyor to scout it out, but it has not returned. I was just beginning to follow when the monsters attacked.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_ExplorerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Fernanda_Maregellan_NV-PUERT_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562151,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Never send a machine to do an Explorer's work! Come, Wizard, accompany me while I discover a new corner of this wondrous place!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
