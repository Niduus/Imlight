                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/YuriSmokesnare_BAT_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1353028,
