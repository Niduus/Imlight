                "m_personaName": "DS-Fishing-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Back faster than I had expected. Do not feel shame. You are not the first to be burned by the mighty Sentinels.",
