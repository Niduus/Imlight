                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wait... your Fish Basket... is that... and a... You caught them all! Well done! I am impressed.",
