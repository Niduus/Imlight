            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Use whatever trickery you must to find and release the Lords of Night from Morganthe's clutches. Then, defeat her once and for all!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MerleAmbrose_KHR_34.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223205,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Arachnis-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Morganthe is forcing the ancient Aztecosaur spirits, the Lords of Night, to sing the Song of Creation anew.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MerleAmbrose_KHR_30.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223205,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Arachnis-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In her version of the great song, she is the stalwart hero battling the cruel forces of injustice.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MerleAmbrose_KHR_31.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223205,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Arachnis-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But if she is able to complete her Song of Creation, the Spiral will be forever broken!",
