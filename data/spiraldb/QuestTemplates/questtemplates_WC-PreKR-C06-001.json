            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Young Wizard, Morganthe's wards keep us out of Khrysalis. But we will remain here, as close as we can get, to watch over you.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MerleAmbrose_KHR_28.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223205,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
