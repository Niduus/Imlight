  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Miranda Briar could have inflicted great cruelty with such a weapon, clouded worlds in malice, or built a fortress out of spite.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-STORM_057.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But such does not appear to be her goal, so you must hurry to find the last Circuit Rune and rescue your companions.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-STORM_058.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ms. Fury and Focus and Ferocity sure didna seem to get far on her own. No, not at all. Who built the Arcanum? Not the Nimbari.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-STORM_049.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779132,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And who maintains it? Aye, I do. Thanklessly and with a smile.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-STORM_050.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779132,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I was just happy to have a place to belong, people to call friends. But deep down, I knew, I always knew, but never wanted to admit...",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-STORM_051.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779132,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...You all look down on me like everyone else.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-STORM_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779132,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Be forewarned, many traps await you in this final place. Step carefully.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
