            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now we know who our true enemy is: Morg. He calls himself Morg the Merciless.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Deer_Hero_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Buck_Gordon_LM-SKY_024.mp3",
