            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What's that, Wizard? You can create magical images of it with... Photomancy? Amazing! Photomanced images of the Font will show if my plan can work.",
