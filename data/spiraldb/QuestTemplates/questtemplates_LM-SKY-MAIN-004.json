            "m_actorTemplateID": 1524737,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The same. He built the Mind Ray and reprogrammed the Eye Robots. But his real plan is far worse. He explained it in great detail. With charts.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Deer_Hero_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Buck_Gordon_LM-SKY_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524712,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Morg plans to boost the Mind Ray using the new Mana infusion. He'll increase its range and power a hundredfold! He can enthrall all of Lemuria!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Deer_Hero_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Buck_Gordon_LM-SKY_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524712,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If I could manipulate the Mana Font, I might be able to depower the Ray. But the Mongonium Badges aren't ready - how can I get to it?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Doctor_Varkoz_LM-SKY_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524738,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC13_Persona",
