          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Morg? The Chief Magical Engineer?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Thun_LM-SKY_009.mp3",
