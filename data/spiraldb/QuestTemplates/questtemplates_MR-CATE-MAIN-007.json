                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What now? Treasure hunters seeking to loot this place? Poor wretches - these antiquities belong to Overlord Xerxes now, in his brilliance.",
                "m_picture": "GUI/NpcPortraits/Portrait_Durvish_Sergeant_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/CaptainCosrow_MIR_01.mp3",
