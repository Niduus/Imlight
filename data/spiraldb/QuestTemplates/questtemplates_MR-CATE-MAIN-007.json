                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Let us destroy the Duke and every other living member of House Purrzian. They've brought it upon themselves. First though, these interlopers.",
                "m_picture": "GUI/NpcPortraits/Portrait_Durvish_Warrior_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DurvishSeeker_MIR_02.mp3",
