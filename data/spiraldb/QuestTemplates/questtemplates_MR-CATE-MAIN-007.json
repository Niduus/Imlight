                "m_nameOverride": "Myriarch Ephialtes",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello. I know Cosrow didn't let you waltz in here, so you must have defeated him. Ah, you're the Wizard the Overlord warned us about.",
                "m_picture": "GUI/NpcPortraits/Portrait_Durvish_Captain_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/MyriarchEphialtes_MIR_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Myriarch Ephialtes",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, I believe he has special plans for you... but what are you doing here? The Chronoshard? That old thing? Why? It's worthless.",
                "m_picture": "GUI/NpcPortraits/Portrait_Durvish_Captain_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/MyriarchEphialtes_MIR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Myriarch Ephialtes",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I would simply give it to you, but my orders are to bring back everything to the Overlord. In fact, perhaps I'll bring you back as well...",
                "m_picture": "GUI/NpcPortraits/Portrait_Durvish_Captain_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/MyriarchEphialtes_MIR_03.mp3",
