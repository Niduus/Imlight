                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What's this? Did that prissy Duke Dairyus dare to betray us? I knew it! The modern House Purrzian is an embarrassment to our legacy!",
                "m_picture": "GUI/NpcPortraits/Portrait_Durvish_Warrior_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DurvishSeeker_MIR_01.mp3",
