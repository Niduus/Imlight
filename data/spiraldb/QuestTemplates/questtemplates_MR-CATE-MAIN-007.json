                "m_personaName": "",
                "m_nameOverride": "Captain Cosrow",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of course, we must destroy all who stand against us, both on the battlefield and off. I think we'll make an example of you. Yes.",
                "m_picture": "GUI/NpcPortraits/Portrait_Durvish_Sergeant_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/CaptainCosrow_MIR_03.mp3",
