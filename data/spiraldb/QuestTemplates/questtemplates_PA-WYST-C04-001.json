  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "From what you describe, the plant is Wild Viridian. It grows native to Weirwood, where I come from.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Beatrice_Wildwind_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BeatriceWildwind_WYS_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465149,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Goblins like to use it as a seasoning, so they plant it wherever they go. If it's here on Wysteria, it's their doing!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Beatrice_Wildwind_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BeatriceWildwind_WYS_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465149,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A Goblin portal is dangerous to meddle with, but I know of an incantation that can close it, never to return.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Beatrice_Wildwind_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BeatriceWildwind_WYS_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465149,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We'll need some ingredients for the incantation, and those can be found in the Merchant Street here in Pigswick Academy!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Beatrice_Wildwind_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BeatriceWildwind_WYS_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465149,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Here's a list of ingredients. Visit the merchants listed and return to me when you have the items on my list!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Beatrice_Wildwind_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BeatriceWildwind_WYS_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465149,
