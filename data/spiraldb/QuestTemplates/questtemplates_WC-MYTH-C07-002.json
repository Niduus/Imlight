          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-SCI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What can I do fer ye on this fine day, my spell-slinging friend?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_48.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-SCI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, a Quicksilver Shield? Not a problem! I’ve got one right here... Oh, wait... I don’t. Are ye daft?!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_49.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-SCI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of course it’ll be a bit of a a problem! It’s not like I’ve got a brace of ‘em in me pockets!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_50.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-SCI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If’n ye wants a Quicksilver Shield, ye’ll have ta help get me the stuff ta make it with! Quicksilver!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_51.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-SCI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The only source of quicksilver is a runaway Steambot called Talos. He made off wit’ the last of our supply.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_52.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-SCI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "He’s hiding in one of the towers in the Crystal Reactor. I’d have dealt with the troublesome git by now, but I’m busy!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_53.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-SCI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That was some piece of work! I’ll have yer Quicksilver Shield right quick!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_54.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-SCI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That should do ye nicely! Take that back ta yer school with ye, and good luck!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_55.mp3",
