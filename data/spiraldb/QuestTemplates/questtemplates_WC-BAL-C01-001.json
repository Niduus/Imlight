                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Are you kidding? Storm is the most powerful of the schools. Back in the First Age, the Tritons practically drowned all the Dragons by themselves!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Storm.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/BorisTallstaff_QST_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38264,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If Bartleby had not stopped them, well, there wouldn't be any Fire School. But you won't hear Falmea speak of that!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Storm.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/BorisTallstaff_QST_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38264,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Life, Death and Myth, they have their good points. But, to watch Professor Balestrom cast a Stormzilla, well, you know Storm is to be feared...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Storm.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/BorisTallstaff_QST_03.mp3",
