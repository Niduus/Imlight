      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So you have spoken with the representatives of the Fire, Ice and Storm schools. You noticed how they all claim to be the best school, didn't you?",
                "m_picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfArthurWethersfield_QST_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81103,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, they all speak the truth, in their own way. Each school has its advantages, but each school also has its own disadvantages.",
                "m_picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfArthurWethersfield_QST_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81103,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But Balance draws on elements from each of the other schools, incorporating bits and pieces to fill in the gaps between them.",
                "m_picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfArthurWethersfield_QST_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81103,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Visit the pond in the Commons. Stand in the water and absorb what it has to teach you. Believe it or not, you will receive enlightenment...",
                "m_picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfArthurWethersfield_QST_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81103,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So, you were visited by a Minion of Balance? Smashing! It seems you have completed your first assignment, $PLAYER_FIRSTNAME$!",
                "m_picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfArthurWethersfield_QST_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81103,
