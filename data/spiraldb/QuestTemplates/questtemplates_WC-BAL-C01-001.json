                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You want to know about Fire? Well, for starters, it's the most powerful school. Its magic is derived from the Dragons that ruled in the time of Titans.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Girl_Fire02.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ReginaFlametalon_QST_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38266,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Before the Dragons could destroy the Giants by melting them into the sea, the Great Tree and Great Raven put them into a magical slumber.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Girl_Fire02.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ReginaFlametalon_QST_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38266,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you ever decide to join a real school, not saying that Balance is all that bad, consider Fire. But only if you want to join the best.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Girl_Fire02.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ReginaFlametalon_QST_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38266,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
