                "m_actorTemplateID": 1761029,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC04C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hop on the ship when you're ready and we'll set sail to the Western Sea, then we'll find our way from there.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Captain_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Powe_AH-BALE_013.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1761029,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC04C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I've only got two rules: Save your sea sickness for land, and sing no shanties. My father was killed by a sea shanty. I can't bear the sound of them.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Captain_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Powe_AH-BALE_014.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1761029,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC04C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I prefer the sounds of sitars we heard over Rajah. Now, on you go. Anchors aweigh!",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Captain_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Powe_AH-BALE_015.mp3",
                "m_action": "",
