                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yer group's all aboard and we got clearance to shove off.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Captain_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Captain_Powe_AH-BALE_012.mp3",
                "m_action": "",
