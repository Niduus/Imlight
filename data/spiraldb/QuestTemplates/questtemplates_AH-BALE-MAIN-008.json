  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "She'll loan us the vessel and crew if we share any findings and rescue her people from the Shellions.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Zander_AH-BALE_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "'Shellions.' Terrible name. Came from the Briar creature, no doubt. I knew she smelled wrong the moment I met her.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_019.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But you say she's the one that led you here?",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Zander_AH-BALE_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yeah. My Sub-Soulik, Terra, she made the contact a few months ago. Eventually, Briar sent us the Sky Coordinates of this world, called it Ahmarra.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_020.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Terra called her the Blessing of the Tritons. That should have been a warning sign, but I'm old and not as quick as I used to be.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A warning sign of what?",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Zander_AH-BALE_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A warning sign that some of us were a little too suggestible. I think Briar saw the lingering rage, fed it, used it.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And now she has henchman to help her find whatever it is she wants here.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Zander_AH-BALE_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And sacrifices to offer up to whatever guards it. So, yeah, I'll give you a ship, Scion, but bring our people back.",
            "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-BALE_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765005,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-BALE-NPC11D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Come on then, Wizard, to the Ship.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Zander_AH-BALE_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765141,
            "m_cameraName": ""
          }
        ]
      }
    ]
