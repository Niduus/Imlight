                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That means you've secured the Chaos Heart as well! Great work, Understudy. I'd say that's deserving of an Arcanum promotion, eh, Ione?",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
