                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Pork_EM2_143.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1452085,
                "m_cameraName": ""
              },
