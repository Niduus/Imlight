                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/IoneVirga_EM2_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1452084,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR_StandIn_Pork_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sparck is on Nimbus... helping your mother. But he asked me to give you this communicator we designed together. Here, let me show you how it works...",
