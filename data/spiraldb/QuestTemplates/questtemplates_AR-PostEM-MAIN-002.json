                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Once all the appropriate paperwork has been reviewed and filed, perhaps. Until then, I will give my thanks, along with a heartfelt, 'Good work'.",
