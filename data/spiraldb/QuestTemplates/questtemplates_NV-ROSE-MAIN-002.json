                "m_personaName": "NV-ROSE-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh no, my Café! The earthquake is crumbling it. Quickly, there are people trapped inside. Someone must rescue them.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_TownieF_E_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Isobel_NV-ROSE_002.mp3",
