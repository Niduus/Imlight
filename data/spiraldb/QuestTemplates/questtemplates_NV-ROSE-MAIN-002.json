                "m_actorTemplateID": 1520453,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-ROSE-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Desole, Wizard, I don't know anything about feathers. I was out here all night. And, non, non picture frames either.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_TownieF_E_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Isobel_NV-ROSE_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520453,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-ROSE-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I want to like this place. C'est chic, non? But it has been only trouble since we arrived.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_TownieF_E_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Isobel_NV-ROSE_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520453,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-ROSE-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Food shortages, fish that wear shoes, and that fool who started fires. What is wrong with this world?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_TownieF_E_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Isobel_NV-ROSE_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520453,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-ROSE-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It's not a world! It's a being from beyond everything known, a living black hole that seeks to absorb life itself!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-ROSE_048.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520464,
