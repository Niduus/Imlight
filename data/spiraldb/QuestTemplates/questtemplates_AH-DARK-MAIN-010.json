      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Gah, my everything hurts!",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-DARK_032.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756184,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You walk around too much. You're not two hundred anymore.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-DARK_063.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756185,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I wouldn't have to walk around so much if my Sub Soulik didn't set everything on fire and scamper off like a hatchling to the sea.",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-DARK_033.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756184,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yeah... I know...",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-DARK_064.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756185,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Forgiveness doesn't come easy, Terra. There will have to be a tribunal.",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-DARK_034.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756184,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I won't resist it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-DARK_065.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756185,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Good. I got enough to deal with. Now where was I... Pain! Oh, also gratitude. To you Wizard. Your Scholars came by with Briar in chains. Good, good.",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-DARK_035.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756184,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I expect you'll keep her contained better than us... and we have more pressing concerns.",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-DARK_036.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756184,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We have a whole world to explore... history to uncover and even lost tribes of Eldritch to meet, as I understand it. The Bale Expedition is over.",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-DARK_037.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756184,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Society of the Turtle is just beginning. And we owe it all to you. Well, mostly to you. We still did all the sailing and-",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleLeaderF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Sahi_Shelli_AH-DARK_038.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756184,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BALE-NPC09C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "She means thanks, kid. Really. Now go blanking deal with Briar.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-DARK_066.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756185,
