          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dyvim Whitehart Distance",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "KIIIIIIIAAAAA!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Unknown.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Dyvim_Whitehart_Distance_KT-MARK_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-MARK-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That sound like antler mouse. To battle, Wizard!",
            "m_picture": "GUI/NpcPortraits/Portrait_Bear_Strongman_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Ivan_KT-MARK_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1560925,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "SHHHHH! The Moon is listening and the walls are its eyes.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuack_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Old_Quack_KT-MARK_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dyvim Whitehart",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Come, Spellbinder, let us leave this madman to his rants.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Dyvim_Whitehart_KT-MARK_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, I'm not mad. I wish I was. The lie is so much saner than the truth. And the truth is that the Moon burns worse than the Sun.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuack_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Old_Quack_KT-MARK_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are being led into a story that ends in death. The Bard is a wielder of Myth, Myth is story, and a story becomes more true as it's repeated.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuack_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Old_Quack_KT-MARK_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Each play you attend only increases his power.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuack_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Old_Quack_KT-MARK_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dyvim Whitehart",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But we cannot enter his abode until we do so; it is magically sealed.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Dyvim_Whitehart_KT-MARK_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Seals? Where? Shhh, shhh, no seals. Attend the plays, yes. Or abandon your friend. Spring every trap and endure. Or just walk away?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuack_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Old_Quack_KT-MARK_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dyvim Whitehart",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Spellbinder! That is brilliant! If the plays are all conjurations of Myth, they were created by the Bard, but maintain a slight independence.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Dyvim_Whitehart_KT-MARK_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Dyvim Whitehart",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They can be turned against their creator. Tell us, mad bird, can this be done?",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Dyvim_Whitehart_KT-MARK_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can it? Should it? Should I? Okay, okay, let us see it through. Each play is a lie, its characters figures of history twisted and distorted.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuack_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Old_Quack_KT-MARK_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-SELE-NPC-12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "With truth we can unwind them. I might know where to look. Where should we begin?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonQuack_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Old_Quack_KT-MARK_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634382,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
