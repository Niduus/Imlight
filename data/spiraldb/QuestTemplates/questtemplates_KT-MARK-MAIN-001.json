    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-MARK-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, Ivan not know where antler mouse is. Ivan think we must fight everything in-",
            "m_picture": "GUI/NpcPortraits/Portrait_Bear_Strongman_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Ivan_KT-MARK_004.mp3",
            "m_action": "",
