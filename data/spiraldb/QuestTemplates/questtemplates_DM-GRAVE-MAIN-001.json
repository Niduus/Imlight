  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC01F_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Tell me, why would a Gargoyle be outside the city now?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_CommanderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Commander_Ahk_To_DM-GRAVE_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675597,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC01F_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your duty is to guard this place and keep the other Great Houses in line. Should we fail, should we shirk this task...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_CommanderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Commander_Ahk_To_DM-GRAVE_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675597,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC01F_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...Darkmoor itself would fall to war. So, knowing that, why would you think it acceptable to take a stroll in the woods?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_CommanderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Commander_Ahk_To_DM-GRAVE_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675597,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC01F_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Who am I to ask? You tempt fate with your defiance, for I am Ahk'To, Lady of Swords, Heir to Krin'Toth, your Commander. Now what are you doing?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_CommanderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Commander_Ahk_To_DM-GRAVE_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675597,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC01F_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You seek the Broken Branch? I know not whether to applaud your initiative or denounce your folly. I think instead, I will grant you leave.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_CommanderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Commander_Ahk_To_DM-GRAVE_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675597,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC01F_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You may find a passable selection of witnesses at a local inn, like the Fang & Claw. See what they say about the Broken Branch.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_CommanderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Commander_Ahk_To_DM-GRAVE_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675597,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC01F_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And be wary, pebble, others have walked this path... none have returned.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_CommanderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Commander_Ahk_To_DM-GRAVE_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675597,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC08A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So you have come asking after my poor Lucy. Why? To mock our misfortune?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Vampire_Base_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Arthur_Easton_DM-GRAVE_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704023,
            "m_cameraName": ""
          }
        ]
      }
    ]
