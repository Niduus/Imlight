                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wilkommen, Valued Citizen, please to come to Vana's Varieties, the latest in artisanal delights in up-and-coming Gutenstadt.",
                "m_picture": "GUI/NpcPortraits/Portrait_Hamster_ImperfectF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Street_Nana_DM-SPELL_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1704305,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-KCITY-NPC24_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Enjoy your dessert and have a contemporary and successful afternoon. Wait... wait... WAIT! I know you! You are the one who ousted Nana!",
                "m_picture": "GUI/NpcPortraits/Portrait_Hamster_ImperfectF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Street_Nana_DM-SPELL_002.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1704305,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-KCITY-NPC24_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I lost my job because of you! Oh, 'Karamelle needs to rebrand, nobody trusts Nana, the sweetsy schtick got real old real fast.'",
                "m_picture": "GUI/NpcPortraits/Portrait_Hamster_ImperfectF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Street_Nana_DM-SPELL_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1704305,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-KCITY-NPC24_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now I work for a fusion candy shop, blending our sweet gummies with Marlzipan from the Isle of Dogs. Have you ever tried Marlzipan?",
                "m_picture": "GUI/NpcPortraits/Portrait_Hamster_ImperfectF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Street_Nana_DM-SPELL_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1704305,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-KCITY-NPC24_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It tastes like suffering. So, here, have a coupon to Vana's Varieties in Gutenstadt. My compliments.",
                "m_picture": "GUI/NpcPortraits/Portrait_Hamster_ImperfectF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Street_Nana_DM-SPELL_005.mp3",
