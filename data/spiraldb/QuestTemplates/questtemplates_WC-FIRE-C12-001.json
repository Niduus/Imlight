                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You've come seeking information about the Sun Serpent? A more fiery being there has never been...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Thurston_Plunkett.dds",
