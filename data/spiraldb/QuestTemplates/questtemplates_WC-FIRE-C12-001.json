                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ThurstonPlunkett_AZT_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 225849,
