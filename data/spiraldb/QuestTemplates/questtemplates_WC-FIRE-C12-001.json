                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Venture there and read the inscriptions circling the base of the map of the Grand Spiral. Return here when you are finished!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Thurston_Plunkett.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ThurstonPlunkett_AZT_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 225849,
                "m_cameraName": ""
              },
              {
