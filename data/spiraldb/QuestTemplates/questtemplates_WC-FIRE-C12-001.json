                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wonderful! I hope you were able to decipher those ancient scratchings... I could make neither heads nor tails of them!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Thurston_Plunkett.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ThurstonPlunkett_AZT_04.mp3",
                "m_action": "",
