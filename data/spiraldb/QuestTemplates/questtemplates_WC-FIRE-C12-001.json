                "m_personaName": "CL-CRAB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, but I'm getting ahead of myself! If you wish to know more of the Sun Serpent, its coming was foretold within the Chantry.",
