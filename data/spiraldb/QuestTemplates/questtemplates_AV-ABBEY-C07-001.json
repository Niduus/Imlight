            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello! You must be the good Wizard everyone is talking about.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Squire_Jimmy_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/PageJimmy_AVA_01.mp3",
