          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My name is Jimmy and I am a lowly page. You can call me Page Jimmy if you wish, but I long to be a full-fledged Knight one day.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Squire_Jimmy_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/PageJimmy_AVA_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617196,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One of my duties as page to my master, Sir Peter of the Grant, is to play him songs on my Jaw Harp.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Squire_Jimmy_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/PageJimmy_AVA_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617196,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I was writing him a song about swans... when I was attacked by Night Goblins!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Squire_Jimmy_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/PageJimmy_AVA_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617196,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They got me so dazed and confused I dropped my Jaw Harp. Now the Goblins have it!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Squire_Jimmy_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/PageJimmy_AVA_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617196,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I don’t have the skill to fight them. Could you go and fight the Night Goblins to get my Jaw Harp back?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Squire_Jimmy_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/PageJimmy_AVA_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617196,
