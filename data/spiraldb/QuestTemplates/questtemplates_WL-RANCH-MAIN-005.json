        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-RANCH-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard! Have you found that tick, Ned Collie? I've brought in reinforcements and rounded up his whole gang.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Judi_WL-RANCH_039.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1594052,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-RANCH-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This place was a hotbed of lawlessness. Judges are citing contraband, zoning issues, grazing wombats after midnight. It's chaos!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Judi_WL-RANCH_040.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1594052,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-RANCH-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Or it was. But now this land can go to respectful citizens of the Spiral. Decent people. People with dreams. Imagine it... a Valencian amusement park.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Judi_WL-RANCH_041.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1594052,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WL-RANCH-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I've set up a field office in the house to manage the transition. If I'm not out here, I'll be in there. When you find Collie, bring him to me for sentencing.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Koala_JudgeF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Judi_WL-RANCH_042.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1594052,
                "m_cameraName": ""
              }
            ]
          }
        ]
