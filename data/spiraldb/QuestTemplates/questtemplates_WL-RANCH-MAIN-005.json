  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I used to be a Judge, Wizard. You probably guessed that. They trained me, honed me into a weapon of law. Specifically, agricultural law.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-RANCH_047.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But it got out of hand, yeah? Judges have their specialties and they take them seriously... scary seriously. And they ARE the law.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-RANCH_048.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But just seizing homesteads? I don't know.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-RANCH_049.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'll keep an eye out. You check in with the local ranking Judge.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-RANCH_050.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594073,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I saw everything. Read her lips from here. That's why you eat your carrots, Wizard.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-RANCH_051.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And it did seem suspicious. But not enough to just side with Ned Collie. The man once hijacked a Sky Train and dumped everyone on a rock.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-RANCH_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You say Judi set up a field office in the main house? Must be the non-barricaded door then, if she comes and goes.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-RANCH_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Search her office for clues. I'll keep her distracted. Using my natural charm, you know.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Judge_Veg_WL-RANCH_054.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594073,
            "m_cameraName": ""
          }
        ]
      }
