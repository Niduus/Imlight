                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I lost my wand! I was menaced by Green Men and Barkskin Treants! He didn't even send anyone after me! I barely escaped.",
