                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Randolf? I will tell you what's wrong! He asked me if I wanted to go sightseeing in Tanglewood Way, and then he left me there!",
