  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mind your tongue when you speak to me, you worthless scum!",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_O_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZurelliaChitinSmasher_KH2_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283210,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Sorry, but I can't risk any nosey antennae catching me asking for your  help. Just stand there and... and  look cowed. That's perfect.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_O_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZurelliaChitinSmasher_KH2_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283210,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Vazivika the SpiritBreaker is supposed to interrogate the merchants to root out information on Fifth Column activity.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_O_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZurelliaChitinSmasher_KH2_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283210,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But what she is doing is threatening to report the merchants, guilty or not, unless they give her bribes.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_O_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZurelliaChitinSmasher_KH2_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283210,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'd be branded a traitor if I reported my commanding officer. That's why I need you to stop her. And discreetly.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_O_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZurelliaChitinSmasher_KH2_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283210,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Vazivika's house is just over there. Confront her inside. Just don't mention my name!",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_O_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZurelliaChitinSmasher_KH2_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283210,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wait for Vazivika the SpiritBreaker in her house, and convince her to stop forcing the merchants to give her bribes.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_O_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZurelliaChitinSmasher_KH2_07.mp3",
