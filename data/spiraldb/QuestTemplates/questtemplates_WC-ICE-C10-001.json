            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And it's one of my favorites... the Woolly Mammoth! A powerful creature called from the dim recess of time!",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfLydiaGreyrose_ZFA_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38172,
