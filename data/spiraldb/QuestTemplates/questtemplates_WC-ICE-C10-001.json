                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Grey Rose of Ravenwood must trust your skill in magic, so I wish you luck learning your new spell.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_BearScout_Peasant_Purple.dds",
