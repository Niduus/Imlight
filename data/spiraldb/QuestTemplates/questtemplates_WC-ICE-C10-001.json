            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've been reviewing my curriculum and realize you're due to learn a new spell! How did the time get away from us?",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfLydiaGreyrose_ZFA_02.mp3",
