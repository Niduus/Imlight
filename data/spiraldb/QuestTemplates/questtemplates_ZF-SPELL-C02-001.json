            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As you can see, one of the key treasures of Zamunda is this Star Obelisk. It lends the Moon Gardens a sense of the sublime.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Mandisa_Autumnrain_NPC.dds",
