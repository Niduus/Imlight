            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-ZAM-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have studied the Obelisk for many months, and recently had a breakthrough! But the Longdreamer Shamans stole my Star Rituals!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Mandisa_Autumnrain_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/MandisaAutumnrain_ZFA_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-ZAM-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I cannot translate the meaning of the Star Obelisk without them. Can you get them back for me?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Mandisa_Autumnrain_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/MandisaAutumnrain_ZFA_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-ZAM-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'll find the Longdreamer Shamans in the Zamunda Outskirts. Once you retrieve them, I'll teach you how to read the Star Obelisk.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Mandisa_Autumnrain_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/MandisaAutumnrain_ZFA_12.mp3",
            "m_action": "",
