            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "May shade and rain follow you, you Too Tall Mutant. Go take it back to your mystics.",
