            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wait, the Moon Skull Priestess was giving it to the Undead? I don't want to become some kind of vampire! I must think this over.",
