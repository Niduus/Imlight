        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, you see, I retired to keep watch over this crossroads while the other nomads roam the desert. This place - Caravan - it is sacred.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Sandiago_MIR_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1379033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "For centuries, when there is danger in the desert, this is where the nomads gather for safety. When the Winds of Change blow, they know to come.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Sandiago_MIR_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1379033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "After this recent sand storm... the Winds of Change began blowing, but the nomads have not come. I fear they have been held up on the road.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Sandiago_MIR_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1379033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I believe the Winds brought you here to aid us, to find the nomads and shepherd them to safety. Go west, Wanderer. Find nomads and aid them.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Sandiago_MIR_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1379033,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I wandered this desert for... many years, but never have I witnessed a sand storm of such magnitude as this latest one. What does it portend?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Sandiago_MIR_11.mp3",
