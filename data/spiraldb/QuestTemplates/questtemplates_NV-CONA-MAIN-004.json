  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I don't care about Catmandu! I mean I do care; of course I care. I've no doubt Moo Bu can handle it. We have to save the settlers of Novus!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_037.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546270,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Like I told you before, the world is a trap. It leeches off of them, absorbs them, becomes them!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_038.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546270,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You spoke to it...? What... did it say? They are dividing it... causing it stress? Which leads to creatures like Irks?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_039.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546270,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What monsters will it create if stress turns into rage? Quickly, we must warn the Spiral Powers of the dangers. To the Conference Tent!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_MonkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/String_Caster_Fuzhi_NV-CONA_040.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546270,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I do not think we have been properly introduced. Citizen Maxine Rockhoppierre, hero of La Resistance and leader of the new Polaris.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-CONA_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Technically, Red Rosa heads the Citizens' Assembly, ma'am.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/The_Valet_NV-CONA_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546276,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Quiet, you! You gormless goofus. Pitooey, I spit at your name. But Wizard, now there is a name respected in Polaris.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-CONA_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So when you say this world, this Dasein, created lands in our image and for our use, I listen. Come with me to our Shard, oui?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-CONA_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is a problem for which, I think, you are uniquely suited. Come, come. You too, you gargantuan lummox, you blocker of the sun you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-CONA_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546275,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*Sigh*",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moose_Manticore_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/The_Valet_NV-CONA_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546276,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-CON-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Behold, Wizard, La Ville Rose!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-CONA_010.mp3",
