              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC03-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No, I said it about the last seven. But this time I'm sure. There is a tiny puddle of Life Energy still nestled within.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Zander_AH-PRIM_033.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756060,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-PRIM-NPC03-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And the things the Wizard brought will help me draw it to the surface once we return.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Zander_AH-PRIM_034.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756060,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
