                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, yes, this tree still has some life in it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
