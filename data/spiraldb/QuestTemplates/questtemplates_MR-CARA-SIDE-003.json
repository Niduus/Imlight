            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My most profitable spice is derived from the Saffron Crocus flower. But the Scaly Trengils have overrun the South Road where it grows.",
