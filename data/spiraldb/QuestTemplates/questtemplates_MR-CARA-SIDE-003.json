            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Good day, Wayfarer. If you would deign to help a lowly spice merchant, I would be forever in your debt. You see, my very way of life is in danger!",
