            "m_personaName": "LM-URSAI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Absolutely not! Don't be ridiculous, people. I know what to do, but we have to hurry. We must prepare a trebuchet. Wizard, we need your help too.",
