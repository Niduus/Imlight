            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This doesn't seem right. Why would the Old One require such an...<ITALICS> ending</ITALICS>?",
