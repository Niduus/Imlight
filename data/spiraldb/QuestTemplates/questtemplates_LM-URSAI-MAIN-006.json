            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It does tell us what we should do, but we're not doing it. So everybody pack up your things, we're moving! Fast. Let's hustle people!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Juju_LM-URSAI_035.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520123,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Pack? Move? Hustle?!? Me rather take me chances with the volcano. What exactly do the Writs say, Juju?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bear_Islander_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Grizztopher_LM-URSAI_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520125,
