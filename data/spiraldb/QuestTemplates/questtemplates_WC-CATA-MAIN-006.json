      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-CATA-NPC01-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, you survived! I was just about to send some students in after you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_54.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1487041,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-CATA-NPC01-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You say Prince Viggor is gone? Wonderful! That means it's safe to investigate the remaining Knowledge Crystals. Think of all the history!",
                "m_picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_55.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1487041,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-CATA-NPC01-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Lost knights, Druids, forgotten wars, what else is down here? The mind reels. But it sounds like you have one more task.",
                "m_picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_56.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1487041,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-CATA-NPC01-E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Bury Viggor's Knowledge Crystal by the last remaining Spell Trees of Dragonspyre. Come find me again when you're done.",
                "m_picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_58.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1487041,
                "m_cameraName": ""
              }
            ]
          }
        ]
