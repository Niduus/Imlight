      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ACAD-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It didn't, you know... prove him right. Poor Prince Viggor, so dismissive of the lower classes, he missed a lot when he left.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ashley.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/TreeAshley_CAT_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126321,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ACAD-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That change he talked about, that was the founding of this Academy, where they taught everyone not just about magic, but how to use it right.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ashley.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/TreeAshley_CAT_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126321,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ACAD-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "At least until the generals and kings unleashed the Dragon Titan. But that's ancient history. Come here, Wizard, let's catch up on today.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ashley.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/TreeAshley_CAT_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126321,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ACAD-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So what have you been doing? Exploring Catacombs, huh? Yeah, me, I've just been here. I'm always here.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ashley.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/TreeAshley_CAT_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126321,
                "m_cameraName": ""
              }
            ]
          }
        ]
