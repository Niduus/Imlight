  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC01-E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Long ago, a plague on Dragonspyre caused a social upheaval. Believing his society doomed, Prince Viggor led a contingent to conquer Ravenwood.",
            "m_picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_48.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC01-E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It seems he thought the Spell Trees here would provide him unmatched power. But the Druidic inhabitants fought back. And both sides were destroyed.",
            "m_picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_49.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC01-E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Records of this were contained in Knowledge Crystals, which are now bleeding out tormented specters, who are forced to relive this tragedy.",
            "m_picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_50.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487041,
            "m_cameraName": ""
