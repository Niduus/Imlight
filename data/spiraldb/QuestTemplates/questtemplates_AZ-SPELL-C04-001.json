      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-TIERRA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What brings you back here, Magician? The Tears of the Moon Shrine?",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChiefF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChalchiuGreenSkirt_AZT_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-TIERRA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Tears of the Moon Shrine survived when the Pyramid of Mother Moon vanished beneath the waters... but that was ages ago.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChiefF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChalchiuGreenSkirt_AZT_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-TIERRA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Its treasures have long been looted. I've heard stories say they were taken into the Greenstone Mines.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChiefF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChalchiuGreenSkirt_AZT_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-TIERRA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you sought something from the Tears of the Moon Shrine, it is likely held by Eke Chuah, a deathless Moon Skull spellbinder.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChiefF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChalchiuGreenSkirt_AZT_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-TIERRA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Eke Chuah dwells in the Chamber of Red Sorrow in the Greenstone Mines, and his evil has grown even in death.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChiefF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChalchiuGreenSkirt_AZT_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-TIERRA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I would not face him in battle for any reward... so give up your quest and return to your home.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChiefF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChalchiuGreenSkirt_AZT_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-TIERRA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I cannot believe you defeated Eke Chuah! Take the Moon Platter... and may the light of Mother Moon shine always on you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChiefF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChalchiuGreenSkirt_AZT_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689134,
                "m_cameraName": ""
              }
            ]
          }
