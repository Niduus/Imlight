                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah. It seems Sister Iroolan failed in her duties. She will have to atone for that. There will be no atonement for your transgressions, however.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_SorcererF_C_MOB.dds",
