                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Unfortunately for you, it must remain a secret for now, which means you know too much. Come, Wizard, I will try to make this quick and painless.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_SorcererF_C_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RevMotherMehoim_MIR_13.mp3",
