              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CATE-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I was worried you might catch on to the enchantment placed on Pol. The Binny Jezzerit are destined to govern House Tabbi, and this is our way.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_SorcererF_C_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RevMotherMehoim_MIR_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1381314,
