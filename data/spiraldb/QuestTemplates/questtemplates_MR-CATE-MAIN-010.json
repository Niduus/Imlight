                "m_personaName": "MR-CATE-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There. It is done. Return to the Manor and you will find he is now free of my influence. I just hope we never come to regret this.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_SorcererF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RevMotherMehoim_MIR_16.mp3",
