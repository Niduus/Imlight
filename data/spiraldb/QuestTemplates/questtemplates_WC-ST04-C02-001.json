  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST04-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Any luck with the Minions and Fodders? I hope they haven't scared you off yet.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DuncanGrimwater_QST_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38139,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST04-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Susie says that her brother is missing? Ha! I think he is hiding back at Ravenwood. But I'll check around and see what I can find out.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DuncanGrimwater_QST_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38139,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST04-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In the meantime, I could use some help with my field studies. I need to find out the fighting tactics of the Undead. Knowing how they fight may give me some insight into how we can defeat them.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DuncanGrimwater_QST_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38139,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST04-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I would do it myself, but... uh... I just ran out of Treasure Cards. It shouldn't be too hard.  Just defeat some Haunted Minions and Rotting Fodders. Report back to me afterwards.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DuncanGrimwater_QST_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38139,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST04-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You survived!?! I mean... that was fast! Those Undead are not as tough as they seem, are they? So, what did you learn?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DuncanGrimwater_QST_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST04-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What? The Undead were using Storm Magic? That doesn't make any sense! Where could they have learned that?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DuncanGrimwater_QST_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST04-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hmmmm... Maybe you could ask Susie what she might know about this?  And tell her I'm still trying to find out what happened to her brother.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DuncanGrimwater_QST_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          }
        ]
      }
    ]
