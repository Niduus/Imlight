  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Aye, there has been a change in the air. They say the House of Cups are but parasites; and they showed me the photomances.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Edward_Farmer_DM-MORT_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687159,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Scattered amongst McCreary's hoard was me grandfather's watch. Me father showed me photomances of it, a gorgeous piece polished to a sheen...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Edward_Farmer_DM-MORT_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687159,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...Laden with colored stones. I never met the man, but I felt as if I knew me grandfather from my father's tales. He ascended before I was born.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Edward_Farmer_DM-MORT_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687159,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But he didn't, did he? No. Our fields are special, stranger, our crops yield quickly. Take some of that Garlic and hand it out around town.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Edward_Farmer_DM-MORT_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687159,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No one will be taken by those creatures again.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Edward_Farmer_DM-MORT_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687159,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ha! Garlic. I knew you weren't as useless as Carpenter here.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Luther_Tillman_DM-MORT_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687170,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I say!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_015.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can't wait to shove this down a vampire's throat.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Luther_Tillman_DM-MORT_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687170,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Useless, my eye. Give me the garlic. I'll hurl it at Count Strigoi from here, sprain or no.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*SNIIIIIIFFFF!!!* Is that the scent of garlic on the air? Smells like... *COUGH COUGH COUGH* I am okay. Give me a moment.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hmmm. So we safeguarded the town. Now what?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_094.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now we wait for Strigoi's reprisal.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_017.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC19_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Children of the House of Cups... wait, what is this? Why all this violence? Why this outrage? Why have you so turned on us, your protectors?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Vampire_BaseF_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Cleric_Elezar_DM-MORT_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687184,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What kind of protectors lure men into the woods to nosh on their neck?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Luther_Tillman_DM-MORT_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687170,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We know of your lies, vampire, the people you have taken. They never ascended!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_017.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC19_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "On the contrary. Why, one of our latest additions has just now finished her adaptation. Greet your children, Lady Mina.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Vampire_BaseF_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Cleric_Elezar_DM-MORT_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687184,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello... my friends. It is good to see you again.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Vampire_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Mina_Clarke_DM-MORT_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687185,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mina... my word... it really is you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_018.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And what of John Seward, Quincy Morris, Anne Holm, Maggie Winter, Victoria Evans, Darla Summers? What of all the others you've taken?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_018.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They are well. All are well. And I have come to initiate the Final Ascension. Please, all of you, it is time to embrace immortality.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Vampire_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Mina_Clarke_DM-MORT_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687185,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Misters Tillman and Carpenter, you seem the most... rebellious. Be the first then to join me in the Chapel of Ascension.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Vampire_BaseF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Mina_Clarke_DM-MORT_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687185,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wiz-Kid! Where's Lucy? Did something happen?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_095.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
