            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-URSAI-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh great. Who wants me to shut up now? Ooooh, so now the Bearfolk want hear my song? Well too bad! I hope Killawahoo takes them all!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-URSAI_012.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-URSAI-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I don't mean that. Thing is, I can't play my song at the Ceremony. The Koolakamba hated my music even more than the Bears. They stole my Ukitar!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-URSAI_013.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-URSAI-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As much as I hate to let the Ol' Boi down and condemn Ursai to a violent, fiery death- What? You'll get my Ukitar back? Thanks!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-URSAI_014.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-URSAI-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "My Ukitar! Whew! It looks like the Koolakamba didn't do anything funky to it. Guess we should hurry back to Ursai so I can perform my big song.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-URSAI_015.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-URSAI-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Not for the Bearfolk, by the way. For the Ol' Boi. And I guess a little for my Aunt. Anyway, let's go!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Musician_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tosh_LM-URSAI_016.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520122,
                "m_cameraName": ""
              }
            ]
          }
        ]
