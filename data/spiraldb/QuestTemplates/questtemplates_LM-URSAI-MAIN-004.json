  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I don't care what the lazy Bears said. You had no right to run my dear, sweet, marginally annoying nephew out of the village!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Juju_LM-URSAI_017.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520123,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's okay, Wizard, we know where Tosh is! You can fetch him. Tell them. Tell them!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_LinNoHat_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-URSAI_017.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524717,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*Snaps* Hey, focus. What's that? Tosh is in THE WILDLANDS?!? Why is he- Doesn't matter. You have to rescue him before the G-G-G-Ghost gets him!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Juju_LM-URSAI_018.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520123,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It appears the Ol' Boi wasn't a fan of Tosh's modern spin on the ceremonial hymn. But it's not Tosh's fault. That's on me. This is all on me.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Juju_LM-URSAI_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520123,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-URSAI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've been far too lax with my Hierarchical duties around here. We've all lost sight of the Ol' Boi- uh, the Old One's words.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Hierarchs_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Juju_LM-URSAI_023.mp3",
