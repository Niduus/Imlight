                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There you go! It should work like a charm. I've even powered it up for you to use. Be careful where you discharge that thing!",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/SohomerSunblade_QST_16.mp3",
