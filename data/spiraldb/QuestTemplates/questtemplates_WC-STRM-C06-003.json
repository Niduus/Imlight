                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You've got one of his Patterns? And the Component Parts to go along with it? An Oscillation Overthruster? I think I can help you with that.",
