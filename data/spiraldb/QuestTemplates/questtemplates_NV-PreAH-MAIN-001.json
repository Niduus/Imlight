  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-DEstate-NPC26-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Novus too remains stable, a sanctuary for those seeking to escape the endless politics of their home worlds.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1717127,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-DEstate-NPC26-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I don't suppose you've come seeking refuge from your constant struggles? No, of course not. Your adventures continue, as they should.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1717127,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-DEstate-NPC26-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You seek knowledge of the Old One's people? Hmmm. I fear he knew surprisingly little. He was aware of this Scholomance and afraid of it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1717127,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-DEstate-NPC26-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But his society did not originate in Darkmoor. They came from... hmmm... there is a haze, a fog blocking his earliest memories.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1717127,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-DEstate-NPC26-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps you can help me clear it; and together we can learn what waits beyond.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1717127,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
