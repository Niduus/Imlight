      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-DEstate-NPC26-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Apologies, Wizard, those memories, his memories, are also my own, absorbed into my own mind. Living through them is... painful.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_008.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717127,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-DEstate-NPC26-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It would seem the Old One did not embrace the Scholomance's ways. This Ahmarra though... it could be the clue you sought.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_009.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717127,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-DEstate-NPC26-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Perhaps the Arcanum Scholars know more.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_010.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717127,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-DEstate-NPC26-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I know I cannot dissuade you from continuing this quest, and I would join you if I could.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_011.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717127,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-DEstate-NPC26-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But I am here now, a world now. And worlds do not move nimbly. Just... do not go alone. You are treading into lost and dangerous secrets...",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_012.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717127,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-DEstate-NPC26-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "...Into things even the Old One feared. There are things even the Scion of Bartleby cannot fight. So don't. Take help where you can.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_Dasein_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Dasein_NV-PreAH_013.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1717127,
                "m_cameraName": ""
              }
            ]
          }
        ]
