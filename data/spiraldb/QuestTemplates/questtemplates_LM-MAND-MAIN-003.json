  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mandar, who used to be our king, said that he left you to your doom. Do you haunt us as a ghost?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Warrior_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Amra_LM-MAND_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507627,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The tales of my doom have been greatly exaggerated. You say Mandar used to be your king. What happened to him?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_051.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He has been overthrown! The uncouth, Boar-raised usurper rules us no more. We have a new king. A wiser king. He will wish to meet you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Warrior_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Amra_LM-MAND_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507627,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go to the Palace of Xul-thurun. There he will take the measure of these visitors to Mandoria.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Warrior_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Amra_LM-MAND_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507627,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I know the way, Wizard.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings, mighty travelers. I am Moth-Amon: magician, sage, and Overlord of Mandoria. Tell me, why have you come into my realm?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moth_Sorcerer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Moth_Amon_LM-MAND_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507628,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings, Moth-Amon. I am Doctor Claire Savage, scientist, explorer, and Duck of action. I am here to find the Monitoring Station of the Old One.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You mean the Ancient One! That is a dark name, a name of terror.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moth_Sorcerer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Moth_Amon_LM-MAND_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507628,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Manders destroyed his monuments long ago. Only their valor and strength saved us from that dark demon.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moth_Sorcerer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Moth_Amon_LM-MAND_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507628,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Everybody else reveres the memory of the Old One, but the Manders do not. What happened to make them turn their back on him?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-MAND_103.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507625,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Ancient One's Fane is a place of death and terror. Why would you seek it? Are you worshippers of the Ancient One? Should we fear you?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moth_Sorcerer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Moth_Amon_LM-MAND_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507628,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We mean no harm. I believe your legends are... incomplete. In my home there is another such place. There are powerful secrets inside.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_054.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And you have glimpsed these secrets? Will you teach them to me? I am always eager to learn more of the Magical Arts.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moth_Sorcerer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Moth_Amon_LM-MAND_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507628,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm... not sure how much use they would be to you. I've come to find the Fane so it can help me unravel the mysteries of the one back home.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_055.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I understand. Perhaps I can help you in your search. Let us speak in the Atrium, within.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Moth_Sorcerer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Moth_Amon_LM-MAND_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507628,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They are very strange.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-MAND_106.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507625,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
