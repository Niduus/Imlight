  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The hostages are fine, Mattie's lookin' after 'em. Lots of food. All the comforts of home. While the Judges have sealed themselves inside mine.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dingo_Ned_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ned_Collie_WL-RANCH_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594084,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And they installed a bunch of high-tech defenses from Marleybone. I can help ye get past the Dart Turrets, if you distract them.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dingo_Base_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Liam_Collie_WL-RANCH_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594056,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The robot sentries just need a good thump on the head. If you get one, I'll get the other.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dingo_Base_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Luke_Collie_WL-RANCH_015.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594053,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The security shutters use that newfangled electricity. Fortunately, I've an affinity for that sort of thing. I can help ye trip the breakers.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dingo_Base_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Chris_Collie_WL-RANCH_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594055,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WL-RANCH-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Once the house is open, you and I will go kick out the rats. Alright, boys, let's get to work.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dingo_Ned_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Ned_Collie_WL-RANCH_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1594084,
            "m_cameraName": ""
          }
        ]
      },
      {
