      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you gotten that Flame Crux from Pierre Gallantmane, the amulet shopkeeper here in Wizard City? He should have a few to spare.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_71.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now that you've got four Fire Shards, it's time to make a Dragonstar pendant for you to wear while summoning the Fire Dragon. Without that pendant, the Dragon won't pay any attention to you.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_72.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Don't worry, though! I'm not going to send you out to wreak any havoc or fight anything this time. It's even a local trip!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_73.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You only need to head to the amulet store here in Wizard City and ask Pierre Gallantmane, the proprietor, for a Flame Crux to place the Fire Shards into. He should have a few on hand. Easy peasy!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_74.mp3",
