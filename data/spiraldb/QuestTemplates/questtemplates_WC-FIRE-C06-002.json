          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_ShopArea_AmuletShop_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A Flame Crux? Professor Falmea told you I had them lying around? Is she mad? Was she joking?",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/PierreGallantmane_QST_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 44173,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_ShopArea_AmuletShop_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Dear me, young Wizard. I'm afraid that Professor Falmea has the wrong impression about those... they're extremely rare and valuable magic items that don't exactly grow on trees or fall out of the sky.",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/PierreGallantmane_QST_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 44173,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_ShopArea_AmuletShop_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I only see a Flame Crux once in a blue moon. I've heard that there's a Flame Kiln in the ring shop back in Dragonspyre... you might find one in there.",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/PierreGallantmane_QST_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 44173,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_ShopArea_AmuletShop_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Here are some tongs and gloves to use if you're going to rummage around in that fire. Bring it back here when you're done. Don't burn yourself!",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/PierreGallantmane_QST_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 44173,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_ShopArea_AmuletShop_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Let me take a look at the Flame Crux. Hmmm... That's a nice-looking one indeed! Give me a moment and I'll get it ready for you.",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/PierreGallantmane_QST_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 44173,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_ShopArea_AmuletShop_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That's some nice work, if I may say so myself! Take that back to Miss Falmea, with my fond regards.",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/PierreGallantmane_QST_06.mp3",
