          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-HUB-NPC001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What, the Triton? Why, yes, I am conducting a survey on them. I'm not a naturalist, but I've always found them fascinating.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Engineer_01.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/EdithBenchley_AVA_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 211488,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-HUB-NPC001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In fact, I had just found a Triton egg clutch, when disaster struck! A fearsome Deep Kraken chased me away from the egg.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Engineer_01.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/EdithBenchley_AVA_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 211488,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-HUB-NPC001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The species are fierce rivals, and I fear that the Deep Kraken will consume the tiny Triton once it hatches.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Engineer_01.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/EdithBenchley_AVA_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 211488,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-HUB-NPC001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The safest thing would be for you to rescue the Triton egg and take it out of here, before another Kraken makes it a snack!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Engineer_01.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/EdithBenchley_AVA_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 211488,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-HUB-NPC001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The egg clutch was in Stormriven. Go there, and if the Deep Kraken gives you any trouble... I think you can handle things.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Engineer_01.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/EdithBenchley_AVA_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 211488,
                "m_cameraName": ""
              }
            ]
          }
