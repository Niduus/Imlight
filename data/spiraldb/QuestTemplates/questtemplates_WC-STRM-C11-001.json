            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You're due in Celestia Base Camp, to speak with Edith Benchley! She'll help you get a Triton pet of your own!",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ProfHalstonBalestrom_AVA_07.mp3",
