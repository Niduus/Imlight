            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ayuh, good to see ya, friend! I heard you and the Waterman sisters had quite the competitive Fishing challenge over there in Avalon.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ANV/LuckyHookline_ANV_02.mp3",
