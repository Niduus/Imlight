            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ANV/LuckyHookline_ANV_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206837,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-Pelican-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As it happens, a Fishing buddy of mine tells me he's discovered a new place to Fish that's been quite lucrative for him - Azteca!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ANV/LuckyHookline_ANV_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206837,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-Pelican-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ayuh, he says it's a veritable treasure trove there. If you wanna get in on that, go speak with Alejandro de la Paz in Saltmeadow Swamp.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ANV/LuckyHookline_ANV_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206837,
