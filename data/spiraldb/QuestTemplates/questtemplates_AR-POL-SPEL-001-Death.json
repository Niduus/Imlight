  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Welcome back to the Hall of Necromancy, Initiate. Like me, you clearly have a proclivity for the Dark Arts.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/QismahShasa_POL_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340971,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Some see us as agents of disease and corruption, but it's not so grotesque. Death is solely a function of time. We simply embrace that reality.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/QismahShasa_POL_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340971,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's my personal mission to correct such misperceptions and along those lines, I'd like to share one of my more elegant spells with you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/QismahShasa_POL_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340971,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Unfortunately, proper decorum demands you prove yourself first. The Arbiter Proctis, Cyrio Cassini, will administer the test.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/QismahShasa_POL_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340971,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC06_Persona",
            "m_nameOverride": "",
