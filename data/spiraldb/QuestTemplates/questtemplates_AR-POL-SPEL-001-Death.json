      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well done, Initiate. I understand that Cyrio was impressed with your proficiency elegance of form. He believes you'll fit in well here.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/QismahShasa_POL_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340971,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The knowledge now at your disposal is incomprehensibly vast. The Arcanum will expose a new layer of reality that lies behind all things.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/QismahShasa_POL_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340971,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This spell is but a small token compared to those I hope to share with you in the future. It's a sad spell, but mostly for your enemies.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/QismahShasa_POL_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340971,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You must visit often and keep me updated on your work, as I will keep you updated on mine. Together, we will advance the arts of Necromancy.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/QismahShasa_POL_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340971,
                "m_cameraName": ""
              }
            ]
          }
        ]
