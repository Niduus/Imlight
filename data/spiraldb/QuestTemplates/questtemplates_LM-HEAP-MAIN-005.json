  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And this Golden Lion is the original source of all the gangs' Mana! He's the one that made Heap such a mess! This ain't no flea collar, get me?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dog_Tracy_LM-HEAP_019.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524747,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And what about dinner, Tracy? You can't keep running yourself ragged like this.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Tessa_Truehart_LM-HEAP_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524749,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can't eat when there's gangsters on the loose! Gangsters with Mana. Rats, the lot of them, rats shaped like cows that throw burping goblins!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dog_Tracy_LM-HEAP_020.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524747,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I won't have it! They're all primed on this new Mana to get out from under the Golden Lion's paw. I've gotta stop them before they tear Heap apart!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dog_Tracy_LM-HEAP_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524747,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "These gangs do seem oppressive, like Lucien. It is good Tracy seeks to defeat them. We must talk to Bumbles though to find the Golden Lion's Mana.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-HEAP_153.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524741,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If only we had a way to track them. It is a shame we don't occupy forms with heightened senses of some kind. I wonder if I can't manifest-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-HEAP_156.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524741,
            "m_cameraName": ""
          }
        ]
