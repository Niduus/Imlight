                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Dark Morganthe came here with a Shadow across her heart. She wanted to force the Stars to her whims. That is not our nature.",
                "m_picture": "GUI/NpcPortraits/Portrait_Crab_Celestial_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/CelestialCrab_KH2_06.mp3",
