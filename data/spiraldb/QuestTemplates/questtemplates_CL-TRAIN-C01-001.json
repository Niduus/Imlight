      "m_displayImage1": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Yellow.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
