      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-SHOP-Snacks01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What’s this? “The Special?” Is this a joke?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Yellow.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GordonSumner_CEL_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227095,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-SHOP-Snacks01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh goodness! I remember that Peake fellow! He somehow thought I was a regular cook and this a regular snack shop.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Yellow.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GordonSumner_CEL_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227095,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-SHOP-Snacks01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I would sell him a handful of pet snacks folded between some stale old bread heels, to keep them dry.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Yellow.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GordonSumner_CEL_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227095,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-SHOP-Snacks01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I’m fresh out of the things I used to put in those, though. If you can bring them to me, I’ll make another “sandwich” for Peake.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Yellow.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GordonSumner_CEL_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227095,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-SHOP-Snacks01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I used to put Nettle Root, Medium Fish, Stinky Cheese, and some Golden Squash in those bundles. Good luck finding those!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Yellow.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GordonSumner_CEL_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227095,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-SHOP-Snacks01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well I’ll be! You found it all!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Yellow.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GordonSumner_CEL_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227095,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-SHOP-Snacks01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Let me wrap that up together in this stale old bread. There you go! “The Special!”",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Yellow.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GordonSumner_CEL_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227095,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
