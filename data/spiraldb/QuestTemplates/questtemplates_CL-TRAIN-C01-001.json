  "m_questLevel": 48,
  "m_questRepeat": 0,
  "m_onStartQuestScript": "",
  "m_onEndQuestScript": "",
  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Good day to you! I am Ogden Peake, a fellow of letters. I recognize in you a kindred spirit... a student of esoteric matters!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Lord_Upper_Top_Hat_Purple.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/OgdenPeake_CEL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 268128,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If I may be so bold, I can be of aid to you in your studies, but I must have assistance with my own work. Shall I elaborate?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Lord_Upper_Top_Hat_Purple.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/OgdenPeake_CEL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 268128,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Since arriving in Celestia, I have been unable to focus upon my studies. I require... a sandwich!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Lord_Upper_Top_Hat_Purple.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/OgdenPeake_CEL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 268128,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not just any sandwich will suffice! It must be from a certain maker of sandwiches in Marleybone... a fellow named Gordon Sumner!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Lord_Upper_Top_Hat_Purple.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/OgdenPeake_CEL_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 268128,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Please go to Mister Sumner and procure a sandwich, one endearingly titled “The Special,” and then return here at once!",
