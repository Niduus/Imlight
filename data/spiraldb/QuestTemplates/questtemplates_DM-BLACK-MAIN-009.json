                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I will not stop trying to explode you and why are you handing me- what is this feeling? This pain? This regret? I don't like it.",
