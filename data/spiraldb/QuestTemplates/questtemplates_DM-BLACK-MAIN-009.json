      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Evil School of Evil is calling out to us and that's good? We want that?",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_150.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That is its way. It wants to learn as much as teach. You must evoke its curiosity. You must offer it something.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_090.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-004_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I offered it the future, demonstrated a will to slice through the veil of time and spirit and decipher destiny, my destiny. My horror amused it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_FortuneF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Keziah_DM-BLACK_091.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700036,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Okay then. I guess, Wizard, show those memories to the Apprentices.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_151.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Maybe this will snap them out of their brainwashing.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_152.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Leave at once or I shall spit at you most aggressively!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700040,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A memory, eh? I... oh... I remember this. No, not this. Like this. I could... I could barely remember my name. It was just noises my parents made.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700040,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But the strange giants from the forest, they beckoned me, cajoled me, and took me away.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700040,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then it's just here, the lessons, the scolding, the... lying? I-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700040,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-008_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, I really want to spit at you! Ack!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Wraithbile_DM-BLACK_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
