                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, my. You know I've oft wondered about some of these lessons. And I've asked after our origins multiple times.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Baukclaw_DM-BLACK_006.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700041,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-BLACK-NPC-009_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The instructors just told us storks brought us, but I've never seen a stork here once! I, uh, I must consider this.",
