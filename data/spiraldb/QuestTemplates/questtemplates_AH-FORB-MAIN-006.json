                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I've been watching these Eldritch. They have no fears, no enemies, no crime. I don't doubt the Tritons are long gone from this world.",
