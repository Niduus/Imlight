                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There's another Historium, like the one we found in the archipelago, just over there. I bet that could tell us how the war was won.",
