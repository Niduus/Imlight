          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello, Wizard. Were you successful in overcoming the Shadow over Azteca?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh my. Your tale numbs my heart.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Morganthe has grown more powerful than I could have imagined. But do not lose heart, my child. Even death is not the end.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The good people of Azteca have fallen beneath the fire and Shadow, yes. But all is not lost, no, all is not lost at all.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We will remember their sacrifice. We will tell their stories in the dark of the night, for warmth and for courage.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And soon enough dawn will break. As the sun rises on a new day, the Shadow must recede.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Young Wizard, go and prepare yourself, while I rally the forces of Light.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MerleAmbrose_AZT_17.mp3",
                "m_action": "",
