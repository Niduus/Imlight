                "m_soundFile": "Sound/Dialogue/AH/Geppetto's_Son_AH-EAST_006.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752410,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-EAST-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Y'ar... n'ar... let us just go retrieve our missing baubles and metaphysical attributes now that the octopus is gone.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_B_NPC.dds",
