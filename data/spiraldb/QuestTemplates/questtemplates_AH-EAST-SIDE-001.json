                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It steals concepts? Aye, I have been losing a lot more coin tosses of late.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_B_NPC.dds",
