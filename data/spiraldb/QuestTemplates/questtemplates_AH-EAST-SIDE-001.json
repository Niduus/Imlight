  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, there ye are, the gullible Wizard what let Ishmael escape with both me legs.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Captain_Ahab_AH-EAST_018.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752411,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And who let Freddie Faun make off with me favorite pocket watch.",
            "m_picture": "GUI/NpcPortraits/TurtleFanatic_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/First_Officer_Hook_AH-EAST_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752412,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Golem_Wood_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Geppetto's_Son_AH-EAST_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752410,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hey now! There is no call for that kind of language. I know the Wizard saved you from that Monstro-Whalebird, but we can be civilized here.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Nomad_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Geppetto_Oarsman_AH-EAST_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752409,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As my son said, Wizard, I am sure you will help us all again.",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Nomad_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Geppetto_Oarsman_AH-EAST_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752409,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What? Uh... y'ar! See, we've been jabberin' and we think we know what's been goin' on. The Whalebird you followed into the sea to find Ishmael...",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Captain_Ahab_AH-EAST_019.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752411,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...Ishmael himself, the Krok what attacked Hook, Freddie Faun, the Monstro beast... they're all the same thing... a devilish shapeshifting creature called...",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Captain_Ahab_AH-EAST_020.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752411,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A Mimic Octopus!",
            "m_picture": "GUI/NpcPortraits/TurtleFanatic_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/First_Officer_Hook_AH-EAST_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752412,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-EAST-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Aye. And we know where it nests: deep in that Ishmaelstrom over yonder. All our trinkets and limbs are inside. Will ye help us take them?",
            "m_picture": "GUI/NpcPortraits/Portrait_Turtle_FanaticCaptain_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Captain_Ahab_AH-EAST_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752411,
            "m_cameraName": ""
          }
