                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I don't understand. If the beast steals relatively inanimate objects as representations... why did it kidnap my flesh-and-blood son?",
