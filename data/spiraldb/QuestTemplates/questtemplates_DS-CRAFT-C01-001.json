  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-Shop-Recipe-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am still waiting to see your work. Rings of Apotheosis. Two of them. Do not assume that because I am dead, I have time to waste.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_2_Ghost_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/BalthazarDragonthorn_QST_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 136772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-Shop-Recipe-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am the Master Artisan of Dragonspyre. Do not trouble me with trivialities.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_2_Ghost_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/BalthazarDragonthorn_QST_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 136772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-Shop-Recipe-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've little time for apprentices, so unless you come highly recommended, you're out of luck.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_2_Ghost_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/BalthazarDragonthorn_QST_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 136772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-Shop-Recipe-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Toshio of MooShu sent you? Say nothing more. I respect his work, and his recommendation speaks louder than words.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_2_Ghost_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/BalthazarDragonthorn_QST_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 136772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-Shop-Recipe-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But still, I must see your work for myself. Craft for me two Rings of Apotheosis and we will see if you've got what it takes to be my student.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_2_Ghost_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/BalthazarDragonthorn_QST_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 136772,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-Shop-Recipe-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You certainly took your time, didn't you? I know an eternity when I see one, and that was an eternity. Let's have a look, shall we?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_2_Ghost_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/BalthazarDragonthorn_QST_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 136772,
            "m_cameraName": ""
          }
        ]
      }
    ]
