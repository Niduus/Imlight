            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465266,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Still, it is what we have. You must convince the councilors, Kakenya Brokenfang, Unathi Nightrunner, and Rasik Pridefall.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/InyangaWhitestripes_ZFA_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465266,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go first to the Olyphant, Councilor Rasik Pridefall. The Council Hall is high up in the branches, in the Baobab Crown.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/InyangaWhitestripes_ZFA_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
