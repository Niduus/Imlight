            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The beast is gone, felled by my hand. Return to your lives, all of you. The Malughast will trouble you no longer.",
