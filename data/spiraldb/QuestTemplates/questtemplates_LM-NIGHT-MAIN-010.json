      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This confirms my most dire suspicions. Lucien is behind this. We are not suffering the wrath of an absentee judge, but a puerile old man.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_073.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We shall deal with him in due course. For now, we must return to the Doctor Witch and find the Malughast's weakness.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_074.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The impertinence! You dare return after your banishment!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Hierarch_Lucien_LM-NIGHT_020.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520132,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Cast no aspersions, Lucien. After all, it is not I who unleashed the Malughast.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_076.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Whatever do you mean, sir? I did not unleash the MALUGHAST!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Hierarch_Lucien_LM-NIGHT_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520132,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM_Standin_Malughast_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
