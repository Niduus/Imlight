          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He flees to his home! Pursue him, Wizard. Leave this demon to me.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_077.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
