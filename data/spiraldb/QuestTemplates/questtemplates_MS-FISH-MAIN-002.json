  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MS-FishingNPC-01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is said the mark of greatness is grace in the midst of victory. Clearly, my newest Fishing friend, you are a great angler!",
            "m_picture": "GUI/NpcPortraits/Portrait_Goats_Fisherman_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/Ryoshi_GRV_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391025,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MS-FishingNPC-01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Surely, one so great would not deny a friend the chance to even the score. Better yet, let us raise the stakes - four fish!",
            "m_picture": "GUI/NpcPortraits/Portrait_Goats_Fisherman_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/Ryoshi_GRV_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391025,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MS-FishingNPC-01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Challenge accepted? Glorious! The first Fish on the catch list shall be a Dragon Eel that dwells here in the Jade Palace. Easy.",
            "m_picture": "GUI/NpcPortraits/Portrait_Goats_Fisherman_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/Ryoshi_GRV_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391025,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MS-FishingNPC-01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then, a Kishibe Village Sumo Koi. Less easy. Next, catch a Codfather in the Ancient Burial Grounds. A big Fish in a little pond, ha!",
            "m_picture": "GUI/NpcPortraits/Portrait_Goats_Fisherman_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/Ryoshi_GRV_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391025,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MS-FishingNPC-01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And Fish number four: the elusive Ninja Fish of the Tatakai Outpost. With luck, you will find one before one finds you. Good luck!",
            "m_picture": "GUI/NpcPortraits/Portrait_Goats_Fisherman_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/Ryoshi_GRV_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391025,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MS-FishingNPC-01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ryoshi is going to catch a Dragon Eel, Sumo Koi, Codfather, and a Ninja Fish before you. Then the score will be even!",
            "m_picture": "GUI/NpcPortraits/Portrait_Goats_Fisherman_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/Ryoshi_GRV_14.mp3",
