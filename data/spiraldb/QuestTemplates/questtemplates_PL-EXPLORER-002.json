      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC23_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "How did your Polar Rose hunt go? You found so many! Great work as always. It's no coincidence you graduated with honors!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/EloiseMerryweather_POL_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367054,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC23_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You know, Zeke vehemently disagreed at the time, but I told him you were special your first day. I guess we showed him, huh?!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/EloiseMerryweather_POL_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367054,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC23_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, I'm sure we'll meet again in some exotic locale, but make sure to drop in and say hello to the folks in Wizard City once in a while, OK?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/EloiseMerryweather_POL_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367054,
