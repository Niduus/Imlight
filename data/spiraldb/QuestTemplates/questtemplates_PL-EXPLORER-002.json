  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh! Hello there, Wizard! I'm glad I caught you. You ran off so quickly after your graduation ceremony I didn't get the chance to tell you...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/EloiseMerryweather_POL_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1367054,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Congratulations! What brings you to Polaris? Helping Bartleby? Well isn't that sweet! Say, maybe I could get a little help too?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/EloiseMerryweather_POL_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1367054,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Royal Museum has sent me all the way up here to find Polar Roses, but between you and me, it's simply too cold for me to leave the city!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/EloiseMerryweather_POL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1367054,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Any chance you could keep a look out for Polar Roses while you're here? I'd be ever so grateful!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/EloiseMerryweather_POL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1367054,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They told me Polaris was cold, but I had no idea it would be THIS cold! Could you help me track down Polar Roses while you're out wandering?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/EloiseMerryweather_POL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1367054,
            "m_cameraName": ""
          }
        ]
      }
    ]
