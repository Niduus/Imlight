            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Who am I? Why, dear friend, I am he who should be asking thee who thou art indeed. For I am a hero in this land.",
