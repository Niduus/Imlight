                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No, you may not see the Mana Source gifted us by the Old Judge. The reason it withholds its bounty is all too clear: JUDGEMENT!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_E_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Hierarch_Lucien_LM-NIGHT_008.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520132,
