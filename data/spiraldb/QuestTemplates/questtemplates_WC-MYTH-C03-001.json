          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RVW_MythTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What did you do to Cyrus to warrant him sending you out for those? If I know him, I'm sure that he wants you to collect wings from --<ITALICS>gasp</ITALICS>-- Death Pixies...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ivan.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeIvan_QST_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38275,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RVW_MythTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They were the scourge of Unicorn Way before they were banished from Wizard City. The last I heard they were wreaking chaos in Krokotopia.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ivan.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeIvan_QST_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38275,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RVW_MythTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Try the Library in Krokotopia. Though it was awhile back I'm sure they would have records of the Pixies' escapades.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ivan.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeIvan_QST_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38275,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
