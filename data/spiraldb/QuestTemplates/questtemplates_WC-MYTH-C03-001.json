          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-HUB-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Death Pixies, you say? Yes, they did cause some mayhem back in the day. That is, until they were tricked and imprisoned within the Pyramid.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Red_NPC02.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Zanne_QST_59.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81096,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-HUB-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I believe there is a skull obelisk at the excavation site in the Chamber of Fire that mentions these creatures. Take this papyrus and make a rubbing of the glyphs on it.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Red_NPC02.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Zanne_QST_60.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81096,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-HUB-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, Death Pixies were imprisoned in one of the rooms in the Royal Hall. Their chamber is guarded by obelisks that have the sacred scarab on them.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Red_NPC02.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Zanne_QST_61.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81096,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-HUB-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hmmmm... A door in Royal Hall with two Scarab Obelisks outside. Can't be many of those around. Hope the Pixies are not as bad as everyone says they are...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Red_NPC02.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Zanne_QST_62.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81096,
                "m_cameraName": ""
              }
            ]
          }
        ]
