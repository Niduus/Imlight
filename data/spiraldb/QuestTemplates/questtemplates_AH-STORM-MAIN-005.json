  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And I see the Eldritch Akasha bleeds here as well. Yes, Balaur, the Gray Man, the dragon of the Scholomance, he was of their kind.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-STORM_046.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is rot in every utopia, Wizard, a serpent in every garden. You will see, as you approach the Path of Aggression.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-STORM_047.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Nowhere is safe forever unless everywhere is too afraid to confront us. That is power. That is what I want.",
            "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-STORM_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1753027,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I want to march on empires, to sack palaces, to walk right up to every king in every land and spit in their face. Just because I can.",
            "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-STORM_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1753027,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I don't want to settle a world and be afraid of losing it. I want to be fear itself!",
            "m_picture": "GUI/NpcPortraits/TurtleFanatic_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Phobus_Anchorite_AH-STORM_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1753027,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Try the same approach as before, but along a different path.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-STORM_048.mp3",
