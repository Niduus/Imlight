      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What's that thing? Streamportal, huh? Enables travel through dematerialization, you say? Well, I prefer flying myself. I'm usually better at it.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Josiah_EM2_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447325,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now, about your mission. You say your friend was captured by this Dark Cloud group. Can't say as I know where they are.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Josiah_EM2_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447325,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If they're tied to the ornery Myth Monsters, though, investigating those is a good place to start.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Josiah_EM2_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447325,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've been waiting in Nimbus so long, my information's probably out of date. So talk to Mayor Quill. See what he knows.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Josiah_EM2_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447325,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, the party? Don't worry about that. We do this every week. Quill won't mind the interruption.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Josiah_EM2_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
