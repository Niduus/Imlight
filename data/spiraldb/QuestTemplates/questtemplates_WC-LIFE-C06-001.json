                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Good afternoon, $PLAYER_FIRSTNAME$. It's pleasant to see you back here in Krokotopia, and I'm certainly pleased you thought to head out to my oasis and say hello. I trust everything is going well?",
                "m_picture": "GUI/QuestButtons/Art_Quest_Niles.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/TreeNiles_QST_22.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39388,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-BAL-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You'd like a token of some sort? Tell you what... you can have this small chain I made of twisted vine. It should do well enough.",
                "m_picture": "GUI/QuestButtons/Art_Quest_Niles.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/TreeNiles_QST_23.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39388,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-BAL-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You can consider that a symbol of my respect.",
                "m_picture": "GUI/QuestButtons/Art_Quest_Niles.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/TreeNiles_QST_24.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39388,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-BAL-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Niles rummages around in his leaves, and produces a wooden chain made of twisted vine. It's strong as steel. </ITALICS>",
                "m_picture": "GUI/QuestButtons/Quest_Twisted_Vine_Chain.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Narrator_NAR_418.mp3",
