                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings, $PLAYER_FIRSTNAME$. Once more you honor me with your presence. What can I do for you, esteemed Wizard from afar?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Treant_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MS|WorldData|Sound/Dialogue/Oakheart_QST_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 77351,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MS-DTH3-NPC02_FSB_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You desire a token? Why, it is the least I can do. You've demonstrated your allegiance to me, and I will do what I can to assist you. Let me make a gift to you of a small clasp of heartwood.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Treant_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MS|WorldData|Sound/Dialogue/Oakheart_QST_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 77351,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MS-DTH3-NPC02_FSB_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Once that clasp is closed, only the greatest of the tree-lords can cause it to open.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Treant_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MS|WorldData|Sound/Dialogue/Oakheart_QST_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 77351,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MS-DTH3-NPC02_FSB_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Oakheart opens his huge hand and gives you a small open ring of reddish wood. </ITALICS>",
                "m_picture": "GUI/QuestButtons/Quest_Heartwood_Clasp.dds",
                "m_soundFile": "|Sound_Dialogue_MS|WorldData|Sound/Dialogue/Narrator_NAR_419.mp3",
