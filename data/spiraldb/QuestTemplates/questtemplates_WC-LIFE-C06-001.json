  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you gotten the tokens of favor from Bartleby, Niles, and Oakheart? You won't be able to learn your new spell without those items.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfMoolindaWu_QST_69.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "How wonderful to see you, $PLAYER_FIRSTNAME$. I've heard such magnificent things about your accomplishments around the Spiral. Despite all of the adventure and excitement, it is of the utmost importance to remember your studies.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfMoolindaWu_QST_70.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And that, my young Wizard, includes the learning of new spells. Such great power does not come without cost, and I fear that you will be challenged mightily in the trials to learn this spell.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfMoolindaWu_QST_71.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
