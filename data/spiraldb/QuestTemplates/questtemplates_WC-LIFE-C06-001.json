              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Why hello young Wizard! It's been quite a while since I saw you, hasn't it? I have such a hard time remembering these days...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Bartleby_QST_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38230,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What's that? You've come for a token of some sort? Hmmm... I suppose I can give you a piece of my bark. I think it will have to do. You can put it to use as a pendant or something similar.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Bartleby_QST_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38230,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I hope that suits your purpose, little Wizard.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Bartleby.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Bartleby_QST_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38230,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Bartleby concentrates for a moment, then hands you a small piece of polished bark with a hole near the top. It's surprisingly warm, almost as if it's still alive. </ITALICS>",
