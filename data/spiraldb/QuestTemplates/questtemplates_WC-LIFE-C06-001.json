                "m_requirements": null,
                "m_dialog": "Now we're just getting started...",
                "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfMoolindaWu_QST_75.mp3",
