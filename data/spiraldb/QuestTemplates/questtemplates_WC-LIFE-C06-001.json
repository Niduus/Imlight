                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They each gave you an item, correct? A pendant, a chain, and a clasp? Each of living wood? Serendipity! Those items will serve perfectly! Let me see them...",
                "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
