  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC01A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "'Why' is not the question, silly morsel child. 'Who' is the question. Who is strange Bruno? That is the answer to why.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-HOWL_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634662,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC01A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And the who is... well... a coin flip. On one side we have the face, but on the other side...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-HOWL_024.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634662,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC18A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...We have the tails. And the claws and the teeth. What else would you expect? A wild dog? 'Grr, I want to eat everything.' I want much more.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Barghest_DM-HOWL_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704070,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC18A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Strigoi is not only one to take this cure seriously. But, while he sheltered, I stalked, I watched, I schemed. As he hid, I would seize.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Barghest_DM-HOWL_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704070,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC18A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One by one, I would turn his feeding stock into my soldiers, an army too massive to cure. But then you came and tore his world down.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Barghest_DM-HOWL_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704070,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC18A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The others may miss the significance of your presence, but I see it clearly. Grandfather Tree has sent its Scion at last to purge the Great Houses.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Barghest_DM-HOWL_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704070,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC18A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The ultimate contest: to outwit the one who sees all, who thinks us mere pieces on the board. And how do you outwit an opponent who sees your every move?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Barghest_DM-HOWL_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704070,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC18A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Heh. Your friends, frantic and alone, are scattered about. Find them before my pack does or try not to look at what my pack does.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Barghest_DM-HOWL_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704070,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC18A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I want to see how you hunt, Wizard. Then our game can begin.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Barghest_DM-HOWL_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704070,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, *panting* Give me... I just need... to rest and maybe die. Did you set up camp nearby? We should go there at once!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
