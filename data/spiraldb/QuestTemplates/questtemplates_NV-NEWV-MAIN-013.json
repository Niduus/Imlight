    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Right, yes, focus. The negotiations ever so slightly... deteriorated. Marleybone launched its fleet, as did Valencia and Monquista.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_063.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Pingouin troops have been parachuting down through breaches and \"annexing\" buildings for their revolution.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_064.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*Earthquake*",
            "m_picture": "",
            "m_soundFile": "Sound/Dialogue/SFX_NV-NEWV_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And then there are those. We have to help... somehow. Oh, oh, I have a how. But, no, no, first, there...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_065.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...The Bowl & Biscuit. Pingouins have taken hostages and demanded Rottingham stand down. But he's not here. Save them, then come to my Lab.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_066.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, splendid. Maybe now we can put an end to this saber-rattling ruckus before they blow up the world they wish to conquer.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_067.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1546204,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-NEWV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I mean... a sentient world, Wizard, a being unlike anything in existence. And all they can think of is who owns it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_SteampunkF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Phileas_Dogg_NV-NEWV_068.mp3",
