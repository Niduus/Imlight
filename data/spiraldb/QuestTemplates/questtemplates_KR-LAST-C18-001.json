                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, a book about making cheese? Nope. Never heard of one. Why would you even want that? It's for a CurdWright, huh?",
                "m_picture": "GUI/NpcPortraits/Portrait_Bee_Warrior_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/StingerBell_KHR_27.mp3",
