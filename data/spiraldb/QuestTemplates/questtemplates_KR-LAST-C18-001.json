                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What can I do for the mighty Spellbinder?",
                "m_picture": "GUI/NpcPortraits/Portrait_Bee_Warrior_A_NPC.dds",
