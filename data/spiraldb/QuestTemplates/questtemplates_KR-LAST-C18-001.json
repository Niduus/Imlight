      "m_displayImage1": "GUI/NpcPortraits/Portrait_Mice_Merchant_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC25_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings, Spellbinder! I hear you are able to help people find things. Well I'm in need of something a little different - knowledge.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Merchant_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MoatkinsCurdWright_KHR_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223226,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC25_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The elders tell me that I am the last in a line of famous cheesemakers. I want to fulfill my destiny, but I don't know how!",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Merchant_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MoatkinsCurdWright_KHR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223226,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC25_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The craft of cheesemaking, like most of the mouse arts, has been forgotten because our culture focused its attention toward war.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Merchant_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MoatkinsCurdWright_KHR_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223226,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC25_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'd love to learn how to make cheese, but I can't find any information about it. Could you help me find a book on cheesemaking?",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Merchant_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MoatkinsCurdWright_KHR_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223226,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC25_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What a magnificent book! I feel as though I can feel the spirits of my ancestors in every page. And there are so many!",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Merchant_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MoatkinsCurdWright_KHR_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223226,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC25_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Thank you so much, Spellbinder! The information within the Tome of the Rind will help me fulfill my destiny.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Merchant_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MoatkinsCurdWright_KHR_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223226,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC25_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And all my Mouse brethren will be delighted once I can prepare them delicious cheese!",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Merchant_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/MoatkinsCurdWright_KHR_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223226,
                "m_cameraName": ""
              }
            ]
          }
        ]
