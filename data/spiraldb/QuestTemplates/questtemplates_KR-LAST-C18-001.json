                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Huh, I never pegged you for someone who read cheesy books, but I'm sure I can find something you'll like.",
                "m_picture": "GUI/NpcPortraits/Portrait_Bee_Warrior_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/StingerBell_KHR_26.mp3",
