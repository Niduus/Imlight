            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Look, you tell the Silent Sabers that I gave them what they asked for. Just leav... What? Bobak sent you? How is my sweet big brother?",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_N_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Farzin_MIR_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378124,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You both need my help finding the Grey Ghost before he finds you? Ha! Sorry, I know your life is in danger and all, but this tickles me.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_N_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Farzin_MIR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378124,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Bobak disowned me years ago because he disapproved of my choice of profession, and now he is the one being hunted by a shadowy villain. Ha ha ha!",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_N_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Farzin_MIR_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378124,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I will help you, Wayfarer. But not out of brotherly love. I too have heard that the Grey Ghost aims to reestablish the Qhatnip trade.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_N_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Farzin_MIR_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378124,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And the mysterious cad made the mistake of enlisting the services of the Thuggies to help him. Let's just say I'm no friend of the Thuggies.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_N_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Farzin_MIR_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378124,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC14_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Grey Ghost's base of operations is in a warehouse by the river. If you find him, don't mention my name. Now, go before you ruin my reputation! I gotta get back to skulking.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_N_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Farzin_MIR_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378124,
                "m_cameraName": ""
              }
            ]
          }
