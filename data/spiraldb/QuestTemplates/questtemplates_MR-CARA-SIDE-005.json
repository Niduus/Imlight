            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "To stop the Grey Ghost, we'll need to enlist the help of someone who is familiar with the criminal world. Seek out Farzin in Aggrobah.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Bobak_MIR_22.mp3",
