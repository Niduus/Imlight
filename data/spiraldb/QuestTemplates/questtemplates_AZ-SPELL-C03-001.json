            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A group of ignoble Monquistans came to Three Points while the Aztecosaurs still dwelled in the Cenote, and raided the city.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC_02.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_94.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643253,
