              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "True... certain Monquistans stole the Solar Shards from your Sun Obelisk. But they did not do this on my order.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PoncedeGibbon_AZT_53.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 701130,
