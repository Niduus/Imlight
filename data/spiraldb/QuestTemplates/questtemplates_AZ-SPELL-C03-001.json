                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Solar Shards? On that matter, Wizard, I have only a little to say to you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PoncedeGibbon_AZT_52.mp3",
