                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Those who did this theft fell out of favor. They have taken refuge in the Glade of the Poison Dart Frog, in Mangrove Marsh.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PoncedeGibbon_AZT_54.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 701130,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Their leader is Clemente Moraga, a no-account villain and scoundrel. Defeat him, and you will have your Solar Shards!",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PoncedeGibbon_AZT_55.mp3",
                "m_action": "",
                "m_dialogEvent": "",
