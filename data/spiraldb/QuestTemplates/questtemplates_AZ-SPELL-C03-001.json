            "m_personaName": "AZ-ZOCOLO-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They pried the Solar Shards out of the Sun School Obelisk... now it will not awaken!",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC_02.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_95.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643253,
