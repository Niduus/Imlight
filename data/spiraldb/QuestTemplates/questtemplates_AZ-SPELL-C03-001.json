                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No matter. You must now restore them to the Sun School Obelisk. Be at it now!",
                "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC_02.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_100.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643253,
