            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Tezcat Threestar told me you restored the Star School Obelisk in Three Points. Now we must try to restore the Sun School Obelisk.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC_02.dds",
