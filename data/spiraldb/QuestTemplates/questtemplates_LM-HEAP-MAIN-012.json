                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Golden Lion is a Lemur? Don't see many of them around here. But it figures that's how he got to the Mana. Lemurs and their ancient secrets.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Hero_A_NPC.dds",
