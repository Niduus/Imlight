      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Less than you were expecting, eh? Yeah, I'm used to getting no respect. You, Lemurs, the bosses I uplifted.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Golden_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Golden_Lion_LM-HEAP_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524760,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "All of them are upstairs now, all waiting for me to reveal myself, all waiting to take their shot. How's that for gratitude?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Golden_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Golden_Lion_LM-HEAP_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524760,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I built this city. I came here with nothing and gave them everything; and the first chance they get, they turn on me.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Golden_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Golden_Lion_LM-HEAP_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524760,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now my fuzzy little paws are tied. I got no real grudge against you, so consider this a warning, get out before I take MY shot.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Golden_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Golden_Lion_LM-HEAP_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524760,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC01_Persona",
