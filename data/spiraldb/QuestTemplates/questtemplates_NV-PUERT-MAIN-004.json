      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah good, you are all right, Wizard! I had grown worried. Don de Gibbon raced past us without so much as a <ITALICS>ciao</ITALICS>: I was sure you'd been hurt!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_NobleF_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Contessa_DiNario_NV-PUERT_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562149,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A thousand apologies. Sometimes a Monquistador of Don de Gibbon's... experience, when an idea seizes him, he must race to follow it.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Priest_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Monsignor_Del_Monte_NV-PUERT_007.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562148,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Please, please forgive the breach of etiquette. I assure you, we Monquistans value manners above even compactness. But our soldiers can be coarse.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Priest_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Monsignor_Del_Monte_NV-PUERT_008.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562148,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Apology gratefully accepted, my dear friend. Now what is this you've brought, Wizard? Ah, Maregellan needs soldiers? I shall see to it.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_NobleF_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Contessa_DiNario_NV-PUERT_006.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562149,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now my dear Contessa, by your leave I would finally discuss with this Wizard why I brought them here. Walk with me, into the Banana Jungles.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Priest_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Monsignor_Del_Monte_NV-PUERT_009.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562148,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
