  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, wait! We can't leave yet. Right? That feels wrong. But, no, no, no, it is right. We have to stay and save Tawni.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "By which I mean you have to save Tawni! She was with me when the camp was raided by the Weres. We were dragged across miles and miles to this forest.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And then attacked! By trees that walked and talked and acted like people! They came out of the forest like they were the forest and fought the beasts.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As my captor released me to fight his assailants, I ran. But Tawni... she wasn't so lucky. The tree people took her, dropping sticks and Weres as they went.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_015.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Maybe you can follow their trail and rescue Tawni? I'll stay here and rest. Oh, but be quick. I don't want to rest here alone.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, Dimiti, it is true, you yet live.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC02D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Don't sound so happy about it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Dimiti_DM-HOWL_017.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC03A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am neither happy, nor sad. We all live, we all die. I simply acknowledge that, despite all expectation to the contrary, your life goes on.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_OutsiderSuspectF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tawni_DM-HOWL_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634669,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
