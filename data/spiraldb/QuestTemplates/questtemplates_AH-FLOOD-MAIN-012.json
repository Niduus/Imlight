            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, no, no, it was probably made from the minds of Shellions... so think sane thoughts to counter their craziness. Or throw eggs at it 'til it breaks.",
