  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your sword is ready, Mandar. Use it well.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_101.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I will! Moth-Amon, your reign is at an end!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_071.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now, the place you seek is in the valley of the Boars. He-Mander looks down upon it from his tomb. Be careful - I won't be there to save you!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_072.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm off to raise my army. By nightfall, Moth-Amon will be humbled, and the throne of Mandoria shall be mine. Again!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_073.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Right. You begin the search, Wizard. I'll meet you there.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_102.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Another Stone is yours, my Champion. You've opened three Harmonic Gates to the World Synthesizer. When you use this Stone, only two will remain.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-MAND_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In the beginning I questioned putting a station here. I envisioned a land free of Lemurs, devoid of outside influence. It is my greatest failure.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-MAND_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I wanted to see if the oft-oppressed Manders could develop without interference. They built their own civilization, overcoming the Boars. I was proud.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-MAND_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But when I revealed myself to congratulate them, they turned on me. They forced me to unleash my defenses, which the Manders crushed as well.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-MAND_024.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I hoped this rugged, untamed land would produce my Scion. But after this disaster I see that I must take a stronger hand in Lemuria's development.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-MAND_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm not ready to return home yet. I need to recover my strength and learn more about the Old One and his grand design.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_112.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Telos is the city of the Lemurs, who venerate the Old One. A good place to begin. This Hall of Heroes also sounds intriguing. Lead me to it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_113.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A city? I have little use for them - civilization makes one soft! But I am curious - I would see these Lemurs you speak of.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_078.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC05-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And besides, no Hall of Heroes would be complete without a visit by Mandar the Barbarian, King of Mandoria! I will go with you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mander_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Mandar_LM-MAND_079.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487470,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-Mandoria-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What a wonderfully old-fashioned place.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-MAND_114.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507624,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
