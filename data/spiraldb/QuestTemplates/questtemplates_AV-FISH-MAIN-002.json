  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-FishingNPC-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Maybe my sister is right. Perhaps I'm not meant to be an Angler after all. I suppose there can't be two outstanding Anglers in one family.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/WrenWaterman_FAV_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391393,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-FishingNPC-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Luckily, my Crafting skills cannot be beat! Not like Brooke's... She can't even follow the simplest Recipe!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/WrenWaterman_FAV_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391393,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-FishingNPC-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "*Siiigh* No doubt Brooke will find great joy in my Fishing failures. When you tell her, be gentle, will you?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/WrenWaterman_FAV_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391393,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-FishingNPC-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps tell her it was down to the wire, and you only just beat me by a hair. We wouldn't want to inflate her overblown ego.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/WrenWaterman_FAV_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391393,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-FishingNPC-02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No time to chat, I've got loads of Crafting to do! Go speak with Brooke in Caliburn if you're so hooked on Angling.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/WrenWaterman_FAV_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391393,
