      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-DARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings, young Wizard. You have the dust of many roads on your heels, and I sense you will travel even further.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_HumanDruid_Aodh.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/Aodh_AVA_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-DARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you help in an important matter? We Druids of Avalon use Ravens as messengers, sending them to and fro with secret news.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_HumanDruid_Aodh.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/Aodh_AVA_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-DARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But lately the skies are empty, and our Ravens do not arrive where they are destined. Something is trapping them!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_HumanDruid_Aodh.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/Aodh_AVA_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-DARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is critical to recover those Messenger Ravens before their secrets are made plain to our enemies.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_HumanDruid_Aodh.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/Aodh_AVA_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611129,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-DARA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Travel throughout Avalon and do battle with those who have trapped the Ravens. Then return the Ravens to the Rookery Cages here.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_HumanDruid_Aodh.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/Aodh_AVA_12.mp3",
            "m_action": "",
