      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-3POINTS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Lord of Winter was driven away, hectored from the Spiral by the changing seasons... he is no friend of warmth.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/XipliTailbiter_AZT_27.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643260,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-3POINTS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "He has been gone so long he has forgotten the way back to the Spiral. But there is a thing that can catch his attention, heh heh heh.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/XipliTailbiter_AZT_28.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643260,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-3POINTS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I speak of the magic substance known as Silver Frore, an icy powder so cold it cannot even thaw. I know where some is!",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/XipliTailbiter_AZT_29.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643260,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-3POINTS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The last Silver Frore in Azteca was stored in the Falling Cavern. Get it and bring it back!",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/XipliTailbiter_AZT_30.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643260,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-3POINTS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You found the Silver Frore? Let me prepare it for you... just.. ah... a... moment.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/XipliTailbiter_AZT_31.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643260,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-3POINTS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Here you are! This is the uttermost concentration of pure winter as exists. Be careful with it! Heh heh heh!",
                "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/XipliTailbiter_AZT_32.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643260,
                "m_cameraName": ""
              }
            ]
