                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Lord of Winter? That is a powerful being, one whose like has not been seen in the Spiral for centuries.",
                "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC_02.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_84.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643253,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZOCOLO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you wish Winter's return, speak with Xipli Tailbiter, the alchemist. He can help you lure the Lord of Winter back.",
                "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC_02.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_85.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 643253,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZOCOLO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Xipli Tailbiter is in Three Points. Tell him that you have my goodwill in this task. And good luck!",
                "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC_02.dds",
