            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Morganthe's focus at Ravenwood was the Death School. She excelled, though she never surpassed her teacher, Malistaire Drake.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Emperor_A.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/EmperorofMooShu_KH2_16.mp3",
