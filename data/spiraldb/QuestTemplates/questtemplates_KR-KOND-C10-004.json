            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But she was always fascinated by Death. Enter the Chamber of the Underworld Sun and retrieve the Death Lens.",
