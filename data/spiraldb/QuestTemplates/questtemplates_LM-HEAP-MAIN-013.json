                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So, get this, Junior, Tessa tells me gangsters have motives beyond arbitrarily inflicting pain? Crazy old world, huh?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Hero_A_NPC.dds",
