              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You did alright. Mana is as easy to get as a cold in winter. The big bosses are behind bars. The streets ain't clean, but they'll get there.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Dog_Tracy_LM-HEAP_046.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524747,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We just need to find all the gangsters something more productive to do than walk around all day. But, what's that, you want our help back in Telos?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Dog_Tracy_LM-HEAP_047.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524747,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sure, kid, it's the least we can do. But I've got one stop to make first. I'm meeting Tessa... for dinner.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Hero_A_NPC.dds",
