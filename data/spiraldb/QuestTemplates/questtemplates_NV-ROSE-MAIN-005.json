  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My twin brother - whom I didn't meet until adulthood because of complex family tensions, but with whom I have become very close - is trapped!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_TownieF_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Mathilda_NV-ROSE_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520461,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Specifically, in that house there. With a monster!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_TownieF_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Mathilda_NV-ROSE_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520461,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Am I in the what? Cabal? I ain't never 'eard of no Ca- eh, ahem, oh, very well. You, as they say, got me. I am indeed Cabal. Good show!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_DogOfWarF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Martha_NV-ROSE_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Dogs of War themselves are a Cabal invention used to disguise our presence while we scare everyone off this world.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_DogOfWarF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Martha_NV-ROSE_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Because it's dangerous, that's why! Our leaders brought us here because they know firsthand how corrosive this world is.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_DogOfWarF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Martha_NV-ROSE_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It warps space and magic, changes the fundamental laws of the Spiral, as casually as you change your hat. It must be destroyed, or at least isolated!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_DogOfWarF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Martha_NV-ROSE_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We aren't your enemies this time, Wizard. We want what you want: we want to protect the Spiral as it is.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_DogOfWarF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Martha_NV-ROSE_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Help us. Talk to the leaders of the settlements here, convince them to leave.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Dog_DogOfWarF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Martha_NV-ROSE_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520459,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So the quakes were not caused by Dasein, but by this mysterious Cabal? All of them? Or just here?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-ROSE_037.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520450,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-ROSE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I see, so this Cabal has been watching us, they saw Dasein's tantrum in Conatus and tried to replicate it here. And they say it's for our own good?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Penguin_MaxineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Maxine_Rockhoppierre_NV-ROSE_038.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520450,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
