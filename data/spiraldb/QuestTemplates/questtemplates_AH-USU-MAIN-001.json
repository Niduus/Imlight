      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC12_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Miranda Briar eluded you again, my Scion? Did she find the words to awaken the Star Gator?",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-USU_097.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC12_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Then I know exactly where she is going. The Star Gator is not resting on Ahmarra, but the fastest route to it is on that world, in the ocean depths.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-USU_098.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC12_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You already know where. And Miranda no doubt waits for you there, thinking once again she has outwitted us both. But we will show her otherwise.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-USU_099.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC12_WIZBANG_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Go now to the Dark Water Trench where the Star Gator was born, save the Spiral worlds and your own.",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Bartleby_AH-USU_100.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779136,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
