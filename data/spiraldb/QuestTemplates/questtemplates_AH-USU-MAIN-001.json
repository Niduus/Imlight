            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Even if everyone has to make things difficult.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-USU_066.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1727071,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC11-C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Are you ready to go in, Miranda?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_Earthling_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ethan_Vim_AH-USU_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC11-C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One more day of calibration, I think. Remember, Ethan, you'll be my only way home. I'm counting on you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_MirandaEarth_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_Earth_AH-USU_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC11-C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I won't let you down.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_Earthling_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ethan_Vim_AH-USU_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC11-C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, but people always let you down, Wiz-Kid.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-USU_067.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1727071,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC11-C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In here is the secret to the Usu Kieil... it's what we came for. It's how we save our world. You ready to seize it?",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Miranda_Briar_AH-USU_068.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1727071,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-FORB-NPC11-C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You better be, because you only get <italics>one shot </italics>at this. Don't squander this opportunity.",
            "m_picture": "GUI/NpcPortraits/Portraits_Miranda_C_NPC.dds",
