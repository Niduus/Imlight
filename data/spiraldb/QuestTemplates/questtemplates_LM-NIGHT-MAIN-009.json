            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That is a conundrum. It is drawn to Mana, its chosen diet. Where does the Mana here come from?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_CitizenF_B_NPC.dds",
