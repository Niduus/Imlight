            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Good, saves me some exposition. Basically, I need you to Photomance the Malughast with this new sight I gave you.",
