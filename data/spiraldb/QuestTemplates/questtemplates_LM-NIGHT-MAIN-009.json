            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-NIGHT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Consider a moment the Malughast, a savage beast that feeds on Mana. Why attack a people starved of the stuff?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_066.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-NIGHT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Moreover, why not break into the Font and gorge itself on the abundance there?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_067.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-NIGHT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Mayhap it is not as savage as it seems.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_067_B.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-NIGHT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Mayhap it is indeed a tamed dog, obeying the orders of a master who controls access to that Font and thus its next meal.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_068.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-NIGHT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Mayhap it follows the same leader we all do: a Lemur with plentiful pet peeves, who commands on threat of the Malughast. Thus we return here.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_069.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-NIGHT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If my belief is correct, Lucien must have some evidence hidden from prying eyes. Possibly even the recently evicted monster itself. But where?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_070.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-NIGHT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "His Cellar, I suspect. You must investigate and obtain the picture we need. I shall remain, lest my countrymen take umbrage at my presence.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_071.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1520136,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
