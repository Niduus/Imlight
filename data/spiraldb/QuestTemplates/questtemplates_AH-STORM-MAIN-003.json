                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Great. It appears your affable blundering has entrapped us here.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-STORM_055.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765150,
