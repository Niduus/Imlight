              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC02C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That's what happens when you don't keep up with maintenance. We'll need replacement parts.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-STORM_042.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779132,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC02C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Perhaps that is one such component up there.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-STORM_053.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765150,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC02C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, lassie, I could hug you... if I knew you wouldn't electrocute me. Give me half a jiffy.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-STORM_043.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1779132,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-STORM-NPC02C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No, no, I will retrieve it. You must work on the Control Wall.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-STORM_054.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1765150,
