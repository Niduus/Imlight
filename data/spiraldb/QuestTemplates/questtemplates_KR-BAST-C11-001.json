                "m_personaName": "KR-Bastion-NPC23_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I do not think even you could just knock on the gates to Fort Rachias and have them let you in.",
