                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ZaltannatheMirrorMask_KHR_81.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223156,
