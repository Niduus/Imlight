      "m_displayImage1": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC01-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What? Is Ignus okay? Okay. Good. Tell me everything.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_136.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC01-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Very succinct. I think those strange creatures came from that Akashic Tear. They must have infected the Shellions, showed them what? Nightmares?",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_137.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC01-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Or, if their gibbering is right, those creatures showed the Shellions how the Eldritch destroyed the Tritons...",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_138.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC01-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Could that be what Miranda wants? She showed it to the Shellions, it's the best lead so far. Miranda Briar wants the power that wiped out the Tritons.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_139.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752243,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-FORB-NPC01-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And she's gone into one of three eras of history to find it. So which do you want to try first?",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Baba_Yaga_AH-FORB_140.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752243,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
