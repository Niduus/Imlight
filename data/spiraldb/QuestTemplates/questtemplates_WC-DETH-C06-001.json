      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-NEC3-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I can't believe what I'm hearing... did that mad old hunchback really send you here for a dram of the Quintessence of Fear? He's... well... he's mad, I say. Simply mad. Something must be done... but it's not my place to say.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/DimitriIronchains_QST_19.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126319,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-NEC3-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As for the dram, I'm afraid you're out of luck. There's a small fountain connected to a well deep within the Necropolis. In that fountain flows the Quintessence of Fear, but it's well guarded.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/DimitriIronchains_QST_20.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126319,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-NEC3-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Quintessence of Fear is potent stuff... even a drop of it, splashed on your skin is enough to cause terrible nightmares for a year. Do not for any reason at all drink it. It'll drive you insane with terror.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/DimitriIronchains_QST_22.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126319,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-NEC3-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you choose to brave that dark and terrible place, I wish you all the luck in the Spiral.... you'll certainly need it.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/DimitriIronchains_QST_23.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126319,
                "m_cameraName": ""
              }
            ]
          }
        ]
