  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you brought back the Quintessence of Fear from the Dragonspyre Necropolis? Didn't Dmitri Ironchains tell you what to look for?",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfDworgyn_QST_31.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings, young Wizard! You're puttering around adventuring, but it's time to learn a new and powerful spell. I speak of the Scarecrow, the original from which all lesser copies sprung. He's the lord of night, the king of dread, and a herald of Death. \\n",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfDworgyn_QST_32.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can't just teach you this spell, however. You need to demonstrate your commitment to your school, and to the forces of Death magic.",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfDworgyn_QST_33.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "First you need to venture to Dragonspyre, to the Necropolis, a place of utter darkness and despair, and recover from there a dram of the Quintessence of Fear. Liquid fear itself, from the coldest streams of nightmare.",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfDworgyn_QST_34.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Speak to Dmitri Ironchains in Dragonspyre... he'll explain everything.",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfDworgyn_QST_35.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
