            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A word, if you have the time.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Excavator_Diver_01.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RutherfordWest_CEL_OP_01.mp3",
