    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-Dione_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "When Khonsu changes us, our forgotten selves end up here, like ghosts; we lose all sense of who we were. Only what he made us remains.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Mander_CitizenF_D_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Dione_KT-TOMBS_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-DrakeLockley_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So all six of these Urns are you?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonDrake_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Drake_Lockley_KT-TOMBS_048.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-Dione_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I served Khonsu for lifetimes, until eventually he pushed me too far... I was twisted, mangled into one of those Soul Eaters. Then discarded.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Mander_CitizenF_D_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Dione_KT-TOMBS_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-Dione_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But now, I can move on, and my Urns can serve one last purpose: to allow you to save your friend in the Field of Reeds.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Mander_CitizenF_D_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Dione_KT-TOMBS_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-StandIn-Pork_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard, watch out, something is coming, something big, something trying to beat you to the Field of Reeds!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Pork_KT-TOMBS_018.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634414,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Anubite B",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What? Only the dead may enter the Field of Reeds! Let us accommodate you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Jackal_Anubis_A_MOB.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Anubite_B_KT-TOMBS_001.mp3",
