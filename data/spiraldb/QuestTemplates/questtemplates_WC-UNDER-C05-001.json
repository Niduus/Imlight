      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can't believe the King is an imposter. Yet it explains so much... his huge appetite... How badly his clothes fit...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CrabKings_Cromshell.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/SirThomasCromshell_GH2_21.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This aggression will not stand!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CrabKings_Cromshell.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/SirThomasCromshell_GH2_22.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Something must have happened to the King... the real King... when he went through the breach in the river wall.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CrabKings_Cromshell.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/SirThomasCromshell_GH2_23.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The King took several guards with him. Please go through the breach in the wall... see if you can find the King or any of his guards!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CrabKings_Cromshell.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/SirThomasCromshell_GH2_24.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "First, though, you will need a royal order to get by those guards. That won't be easy!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CrabKings_Cromshell.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/SirThomasCromshell_GH2_25.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you can get the King's Seal from his desk in the Royal Tower, I can fake an order for you.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CrabKings_Cromshell.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/SirThomasCromshell_GH2_26.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358236,
