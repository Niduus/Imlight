      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, sorry. I got caught up. Enjoy my work, you see. And it is satisfying helping people realize they can be better than the world tells them to be.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Shadoe_LM-HEAP_029.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524754,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is strange. These are villains, yes? Like Moth-Amon. But they have the same goals as villagers in Night Forest, the same fears as Ursai.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-HEAP_161.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524741,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They are being compelled, yes? Like the Water Moles. This Golden Lion exploits their hardship for his own profit. He is to blame.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-HEAP_162.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524741,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-HEAP-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You're learning, Wizard. I left Bumbles with my... associate, Tessa Truehart. Go to her lab and we will find where his boss lurks.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Shadoe_LM-HEAP_030.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524754,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
