            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "When the comet Xibalba first appeared in the sky ten cycles past, the Aztecosaur oracles pronounced doom.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
