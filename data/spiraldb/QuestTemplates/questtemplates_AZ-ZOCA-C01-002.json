            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643252,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But when the Shadow Queen arrived, the dead awoke... and they were hungry! Let us speak closer to the city. Meet me in the Zocalo proper.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643252,
