      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-MORT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You want a plant that burns the vampires, the zesty seeds of revolution? So garlic? Obviously, it's garlic. Why speak in such roundabout riddles?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-MORT_017.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687161,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-MORT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of course, I don't have any. To bring such a pungent and forbidden substance would expose me right away.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-MORT_018.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687161,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-MORT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Even the other Great Houses are prohibited from stocking it after the Treaty of the Tipped Cup. The only peoples in Darkmoor who might have garlic...",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-MORT_019.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687161,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-MORT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "...Are the Outsiders, the rumored caravans of surviving humans who wander the days and cower in the night. But alas, no one knows where they are...",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-MORT_020.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687161,
                "m_cameraName": ""
              }
            ]
          }
