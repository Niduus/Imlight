  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Headmistress Crisp sent you? I'm not sure. If you're anything like the students here, I can't see how that will help.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_RabbitGuard_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/CaptainOHare_WYS_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465143,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Still, if she vouches for you, then who am I to argue? Let me explain the problem and you see what you can do.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_RabbitGuard_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/CaptainOHare_WYS_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465143,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Pegasus Place has been taken over by a fierce band of Goblins. We don't know where they came from, or how to send 'em back!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_RabbitGuard_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/CaptainOHare_WYS_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465143,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'd be doing us a favor if you could jump in and thin the Wood Goblins' ranks... make 'em think twice about staying!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_RabbitGuard_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/CaptainOHare_WYS_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465143,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you go into Pegasus Place and defeat six Wood Goblins, and return to me when you're done? Be careful in there!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_RabbitGuard_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/CaptainOHare_WYS_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465143,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
