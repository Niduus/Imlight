                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh my gosh, is that the Weirding Drum? I've been wanting to see one forever! But how does it work? Hmm. No music. I guess it's worthless.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/JakiWhisperwind_MIR_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340972,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, but it's for the spell! Such a great spell. Say, did you know sand on Mirage weighs less? It's crazy... wait, what were we talking about?",
                "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/JakiWhisperwind_MIR_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340972,
