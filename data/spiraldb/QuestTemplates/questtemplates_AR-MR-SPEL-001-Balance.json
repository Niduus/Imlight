  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There you are! I had something... I was just looking for it... oh wait! You advanced, didn't you? Congratulations! That was recent, right?",
            "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/JakiWhisperwind_MIR_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Either way, it is so good to see you. This giant asteroid passed by and I really wished you were here... oh, but there was some other reason too.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/JakiWhisperwind_MIR_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh yeah! It was the Owl Figurine... I found it...! No, that wasn't it either. Oh duh! It was a spell! Yes! Something really cool from Mirage.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/JakiWhisperwind_MIR_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I just need this little... or is it little? I'm not sure. It's called a Weirding Drum. I actually don't know what it is, but it's for the spell.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/JakiWhisperwind_MIR_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'll see - it'll go up and then... well, that's later. Get a Weirding Drum from the Old Mottoman Cave near Caravan in Mirage, and then you'll see!",
            "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/JakiWhisperwind_MIR_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, did you want to talk more? Great, because I was dying to tell you about... oh, what was it? I forgot. I'll try to remember when you get back.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jackalope_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/JakiWhisperwind_MIR_07.mp3",
