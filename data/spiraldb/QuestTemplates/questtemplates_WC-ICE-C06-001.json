      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_RVW_FrostTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So you want to learn more about the Ice Titans, one of the three great races of the Spiral. Before there was such a thing as time, the Titans: Ice, Fire, and Storm, fought bitterly, each unable to get the upper hand.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Kelvin.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeKelvin_QST_21.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 82294,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_RVW_FrostTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Bartleby, the World Tree, and Grandmother Raven sought to calm the Spiral before it was destroyed. Through song, chant, and spell they lulled the Titans into a slumber that has lasted all this time.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Kelvin.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeKelvin_QST_22.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 82294,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_RVW_FrostTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Though most Titans still slumber, a few are awake and active in the Spiral. The Titans of Ice will aid those who show them respect. They dwell in a world of ice called Grizzleheim, linked to the Spiral by a mystic bridge.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Kelvin.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeKelvin_QST_23.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 82294,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_RVW_FrostTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Ice Titans, also called Frost Giants, take delight in defeating Trolls. You must show that you are not afraid of Trolls. Only then will a Frost Giant visit Wizard City and speak with you.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Kelvin.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeKelvin_QST_24.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 82294,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC_RVW_FrostTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In Krokotopia, you must defeat Krag Stonechin. Defeat a Burly Troll of Marleybone, and Grum Foultooth from MooShu. When you've beaten them, return to speak with Professor Greyrose and she will tell you how to summon the Frost Giant.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Kelvin.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeKelvin_QST_25.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 82294,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
