  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you gone to speak to Kelvin, the Ice Tree, yet?",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_78.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38172,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings, my student of Ice! I'm pleased to tell you that it's time for you to learn the most powerful spell yet: the summoning of a Frost Giant!",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_79.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38172,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This is no small thing... the Frost Giant is immensely powerful and to earn its respect, you must complete a mighty task and make an appropriate sacrifice.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_80.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38172,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You must first go and speak to the Ice Tree Kelvin to learn about the Ice Titans before you can learn to summon one.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_81.mp3",
