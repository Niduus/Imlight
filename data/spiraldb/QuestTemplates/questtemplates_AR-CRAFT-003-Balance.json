                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So if you could cobble up another Legendary Weapon, maybe the one for your chosen School, and bring it here, I'd be ever so appreciative.",
