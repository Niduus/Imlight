                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/IgnusFerric_EMP_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340968,
