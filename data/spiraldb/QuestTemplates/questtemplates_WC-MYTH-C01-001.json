                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You talked to the Librarian? Didn't I instruct you not to? He was useless in finding that book, was he not? You disappoint me...",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
