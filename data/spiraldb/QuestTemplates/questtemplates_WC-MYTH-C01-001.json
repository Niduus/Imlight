              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-ST01-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Why does Cyrus keep asking for such things? Tell him that truffula trees are just folklore. They do not exist except in that fertile mind of his.",
                "m_picture": "GUI/NpcPortraits/Portrait_Seraph_Aerial_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/LadyOriel_QST_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38123,
