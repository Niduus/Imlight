                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So, Lady Oriel sent you? Don't tell me Cyrus put you up to the task of collecting Truffula Leaves. You know there isn't such a tree.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ivan.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeIvan_QST_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38275,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RVW_MythTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, that Cyrus. He sends the young students on a quest to gather \"mythic\" items, knowing full well that a student cannot find them.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ivan.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeIvan_QST_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38275,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RVW_MythTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This usually causes students to feel like a failure and to transfer to another school. It is Cyrus's way of \"weeding out the weak.\" But you saw through it!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ivan.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeIvan_QST_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38275,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RVW_MythTree_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Here, take some of my leaves. Tell him they are from the truffula tree. Let's see what happens when you do complete his \"mythic\" quest. Heh!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ivan.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeIvan_QST_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38275,
