            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What are you doing here? Away, before I have you washing windows throughout Wizard City...",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfCyrusDrake_QST_12.mp3",
