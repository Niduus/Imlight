                "m_personaName": "WC-ST01-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Perhaps it would be best if you spoke with Ivan, the Myth Tree. Maybe he can help you deal with Cyrus and your \"mythic\" quest.",
