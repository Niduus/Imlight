                "m_personaName": "WC-RAV-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But, against my better judgement, I will give you one last chance. Go to the Hedge Maze on Unicorn Way and bring back some Truffula Leaves.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfCyrusDrake_QST_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38206,
