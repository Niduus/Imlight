                "m_personaName": "WC-RAV-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Lady Oriel will be of no use. You'll have to rely on your own wits. Remember this, if you don't find any, consider looking for a new school...",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
