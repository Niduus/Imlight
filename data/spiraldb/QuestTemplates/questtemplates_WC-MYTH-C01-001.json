            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So, you want to attend the School of Myth? You look like a troublemaker to me...",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfCyrusDrake_QST_13.mp3",
