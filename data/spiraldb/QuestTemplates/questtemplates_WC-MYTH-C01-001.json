              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I know every book in this Library so I know we don't have one on that. Are you here looking for it for Professor Drake?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/HaroldArgelston_QST_29.mp3",
