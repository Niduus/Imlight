                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "By the way you are looking around, I'm guessing you are seeking the mythical leaves from the truffula tree?",
                "m_picture": "GUI/NpcPortraits/Portrait_Seraph_Aerial_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/LadyOriel_QST_01.mp3",
