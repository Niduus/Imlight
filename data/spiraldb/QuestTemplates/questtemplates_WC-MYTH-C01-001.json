                "m_personaName": "WC-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, that explains it. At least once a week a new Myth student will come in here looking for that book. Personally, I think the Wumpus is just a figment of his imagination...",
