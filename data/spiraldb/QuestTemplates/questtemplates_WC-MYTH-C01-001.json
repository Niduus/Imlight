                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You are searching for a book on the Wumpus? I'm quite sorry but I don't think I can help you with that.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/HaroldArgelston_QST_28.mp3",
