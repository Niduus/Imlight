  "m_questLevel": 110,
  "m_questRepeat": 0,
  "m_onStartQuestScript": "",
  "m_onEndQuestScript": "",
  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I try to maintain something of a more inquisitive outlook. Most Nimbari, the Vicereine included, like to believe we stand alone.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Orlan_EM2_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413348,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But you don't have to look too hard to find evidence to the contrary. Just take our power grid for example. It was built by local Aero Dwarves.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Orlan_EM2_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413348,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We use giant Turbines on the Aero Plains to funnel energy from the Storm strand of the Paradox Chain directly here.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Orlan_EM2_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413348,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But conditions down there have deteriorated, leading to increased problems up here. Even now Storm Turbine D is barely functioning.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Orlan_EM2_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413348,
            "m_cameraName": ""
