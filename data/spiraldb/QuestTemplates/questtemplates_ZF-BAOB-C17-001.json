                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I did not believe my eyes when Vir Goodheart was promoted to councilor! But he has proven to be a good sort.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Unathi_Nightrunner_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/UnathiNightrunner_ZFA_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465423,
