            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You must tell the other councilors, Unathi Nightrunner and Kakenya Brokenfang, what you have told me.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/VirGoodheart_ZFA_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
