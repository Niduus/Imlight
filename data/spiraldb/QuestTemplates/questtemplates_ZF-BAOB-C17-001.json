                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard! It makes me smile to see you again. My people have a newly built peace with Stone Town. This is a reason to celebrate!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Unathi_Nightrunner_NPC.dds",
