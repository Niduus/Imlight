            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Afterwards, seek out Inyanga Whitestripes and seek his counsel, for he is wise in these matters.",
