                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Much better than the black-heart Rasik. The Umbra Queen's servants are everywhere, it seems.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Unathi_Nightrunner_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/UnathiNightrunner_ZFA_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465423,
