                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But do not tremble. Shaka Zebu and Zamunda stand with you!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Unathi_Nightrunner_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/UnathiNightrunner_ZFA_19.mp3",
