            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BLUE-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, we recorded much of the Triton knowledge for our own use. They didn't imprint on the Akasha, so we keep their old relics.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lapona_Lotna_AH-BLUE_002.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752305,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BLUE-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We have books, murals of their history, even living examples of the monsters they created.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lapona_Lotna_AH-BLUE_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752305,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BLUE-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, monsters piqued your interest, I can tell. Tritons created many creatures to serve them. Giants to use as labor and enforcers...",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lapona_Lotna_AH-BLUE_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752305,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BLUE-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "...Beasts to maintain the ecosystem, carriers to travel between worlds. Even some, we think, were created as... jokes.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lapona_Lotna_AH-BLUE_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752305,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BLUE-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Most were actually pretty fearsome though. Shall I show you? Come, come, to my Interactive Gallery!",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lapona_Lotna_AH-BLUE_006.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752305,
                "m_cameraName": ""
              }
            ]
          }
        ]
