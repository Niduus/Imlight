                "m_personaName": "DM-SPELL-DEATH-180-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Vampires are more out and about in Graveholm, so go fight them there. Then come find me in Dun Dara. It's in Avalon, in case you didn't know.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_022.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700145,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-SPELL-DEATH-180-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We have encompassed the meaning of Death reversed, but we need to absorb the meaning of it aright: that of change and moving on and advancing.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_023.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700145,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-SPELL-DEATH-180-NPC01_Persona",
