              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-SPELL-DEATH-180-NPC01b_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Evil Butterflies? I was told there were ghosts. YOU TOLD ME THERE WERE GHOSTS, DAVID!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_027.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700145,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-SPELL-DEATH-180-NPC01b_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Uh, whatever, probably for the best you found those. I'll petition the king to get them cleared out.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_028.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700145,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-SPELL-DEATH-180-NPC01b_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And I guess butterflies work as a representation of change. Now all we need is an infusion of Death energy to make our Death Card.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_029.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700145,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-SPELL-DEATH-180-NPC01b_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There should be a cemetery around here. Go there, think about death, channel all the Death you can and then manifest Death into existence.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_030.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1700145,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-SPELL-DEATH-180-NPC01b_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And if you call Death by mistake, do not let him convince you to play board games; they go on forever.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_031.mp3",
