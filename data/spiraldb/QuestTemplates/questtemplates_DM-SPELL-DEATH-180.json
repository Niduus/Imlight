                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'll do that, you go fight Vampire Guards or whatever.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_024.mp3",
