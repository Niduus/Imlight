                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You found a vampire and let it get away? You needed to fight that so that the multilingual incantation I cast recorded their form.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Duncan_Grimwater_DM-SPELL_020.mp3",
