        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-CLOUD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Magician, I have a great favor to ask of you, one that you are uniquely suited for.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_I_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChanticoBlueAir_AZT_34.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 724123,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-CLOUD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Several of our Younglings have gotten lost in Cloudburst Forest, likely hiding from Shadow Weavers and Splinter Wings.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_I_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChanticoBlueAir_AZT_35.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 724123,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-CLOUD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Worse yet, their Scout Master's courage must have fled, for we have heard no word from him.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_I_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChanticoBlueAir_AZT_36.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 724123,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-CLOUD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I cannot venture into the forest without risking Zultun Dock. But I sense you could bring them home to safety. Please find them!",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_I_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ChanticoBlueAir_AZT_37.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 724123,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
