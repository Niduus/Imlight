      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC04E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Your witch friend came out of the forest like a phantom, with a werewolf by the ear. The cure is administered. They will be fine.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_061.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1624416,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC04E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You do know what that witch is, though, right? Be it on your own head then.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_062.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1624416,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC04E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You are less... off-putting than I expected. You displaced the lords of two Great Houses as easily as I breathe. Don't think I haven't noticed.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_063.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1624416,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC04E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Doesn't it make you wonder then why Bartleby never sent you here before?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_064.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1624416,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC04E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Why are we expendable when so many other worlds are not? We need not be enemies, Scion, but your master is giving us little choice.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_065.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1624416,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC04E_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I hope the next time we meet, it won't be in combat.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_066.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1624416,
                "m_cameraName": ""
              }
            ]
          }
        ]
