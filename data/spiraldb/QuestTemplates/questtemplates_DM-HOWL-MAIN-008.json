  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC04E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If so, we have most of what we need for a cure, except for the Wolfsbane.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_056.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624416,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC09A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Cure? I heard the rumors you could do that. But are you certain it is necessary?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Ignacio_DM-HOWL_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634689,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC04E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No. Still, we have taken the cure ourselves - we don't just experiment on strangers, Scion - and its only effect on humans is temporary exhaustion.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_057.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624416,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC04E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So I can make five doses of the cure and give one to each of you. No need for study or detection. We can just be done with it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_058.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624416,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC09A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Queen Glorina is sheltering at her ancestral estate? I know the way. And, fortunately for you, Wolfsbane blooms in the area.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_OutsiderSuspect_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Ignacio_DM-HOWL_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634689,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-HOWL-NPC04E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He rushed off quickly. But that is what Outsiders do. Let us try and catch up with him.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Runa_DM-HOWL_059.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1624416,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
