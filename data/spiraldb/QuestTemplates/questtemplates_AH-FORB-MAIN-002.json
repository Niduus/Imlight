            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Different buttons to open the gate. Different aisles of the Akashic Library perhaps? Or different eras of Eldritch history?",
            "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
