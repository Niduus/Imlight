            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They must be the eras Miranda has searched thus far. These notes she left behind are... unhelpful.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-FORB_078.mp3",
