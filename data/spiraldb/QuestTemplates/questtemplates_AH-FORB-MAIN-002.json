            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Lucky we didn't bring Fitzhume. Though, perhaps we can translate the symbols next to each note.",
