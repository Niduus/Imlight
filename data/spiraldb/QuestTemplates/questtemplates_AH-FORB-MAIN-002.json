            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "\"Yikes!\" \"Boring!\" \"Wah-Wah\" WHAT KIND OF ORGANIZATIONAL SYSTEM IS THAT?",
