      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are not the first visitor to come and aid my people. Long ago, a wooden box fell from the Spiral sky, and in it was a man.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Inyanga_WhiteStripe_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/InyangaWhitestripes_ZFA_89.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465266,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He called himself the Professor. He taught my people many things, and disappeared without accepting our thanks.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Inyanga_WhiteStripe_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/InyangaWhitestripes_ZFA_90.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465266,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Professor had an incredible device called the Cosmic Caliper, a wondrous tool allowing him to do all manner of things.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Inyanga_WhiteStripe_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/InyangaWhitestripes_ZFA_91.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465266,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Those in the market whisper that the Gorilla Spider Witches in the Drum Jungle have the Cosmic Caliper. We must get it back!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Inyanga_WhiteStripe_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/InyangaWhitestripes_ZFA_92.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465266,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-HUB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you go to the Drum Jungle and win the Cosmic Caliper from the Spider Witches? Bring it back to me when you have it!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Inyanga_WhiteStripe_NPC.dds",
