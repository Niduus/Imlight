          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Welcome, one and all, to the Crafter of Love, where we craft with... care. I was just talking to my fellow loyal citizen here-",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Base_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lovecrafter_AH-YELLOW_011.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752288,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There is no need, they know.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_BaseF_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Uxia_AH-YELLOW_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752694,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, then, as I was saying, I know of seas on other worlds... beasts that still swim between the skies... I can sneak you two aboard.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Base_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lovecrafter_AH-YELLOW_012.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752288,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, thank you! But why would you do this?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Khrulhu_BaseF_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Uxia_AH-YELLOW_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752694,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, I am atypical for my time. But in a world of so much hate, surely, we can find time for love.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Base_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Lovecrafter_AH-YELLOW_013.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752288,
                "m_cameraName": ""
              }
            ]
          }
