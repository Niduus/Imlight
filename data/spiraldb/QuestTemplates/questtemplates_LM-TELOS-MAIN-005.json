  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Was the Old One not the same way? He abducted these people, presented himself as their 'Founder' and twisted their hopes and destinies.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_LinNoHat_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-TELOS_093.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521345,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In his mind, I find such pride in his machinations. And the part of me that is not him, that was sickened with the realization of what I did to him...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_LinNoHat_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-TELOS_094.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521345,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...It is likewise sickened by what he did to these people. I do not wish to be him, Wizard.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_LinNoHat_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-TELOS_095.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521345,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I think... I think I tire of this shape. Proceed to the Harmonic Gate, Wizard.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_LinNoHat_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-TELOS_096.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521345,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "First, what do you think, the Wizard? This place is shaping up into quite the Hall of Heroes, no? But enough boasting. The clue!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Horse_Explorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Stallion_Quartermane_LM-TELOS_038.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521319,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "While you were away, I spoke to the Hierarchs. I think one of the Stations indicated on your map is in a lost region called Mandoria.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Horse_Explorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Stallion_Quartermane_LM-TELOS_039.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521319,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is a legend, no Lemur has ever set paw there, but with your map, the position of the sun, and a séance or two, I think I found it!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Horse_Explorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Stallion_Quartermane_LM-TELOS_040.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521319,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The route goes through the Wildlands, the Night Forest and a place called the Badlands. Don't forget to use the teleporty doo-dad. Off you go.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Horse_Explorer_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Stallion_Quartermane_LM-TELOS_041.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521319,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-TELOS-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, wonderful. I could use some assistance. In exchange, I'll happily guide you wherever you go, for I am Duck Savage, the Duck of Bronze.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_HeroineF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Duck_Savage_LM-TELOS_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1521342,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
