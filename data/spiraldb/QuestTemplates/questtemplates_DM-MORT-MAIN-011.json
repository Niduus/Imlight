  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I expected nothing specific. Just noticed she wasn't here with you. Oh, no, wait, is this OUR dramatic showdown?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_096.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No! You two must cooperate a little longer. Wizard, take this invitation. It will get you into Count Strigoi's Masque.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_031.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, I see. The Wiz-Kid gets in, schmoozes the vampires and finds us a way past the guards...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_097.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then, on receiving a signal, I will lead a mob to ransack the whole vile stronghold. Death will catch the immortals at last.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_032.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Solid plan. As long as the Wiz-Kid doesn't get eaten.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_098.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Count Strigoi knows them; they met at my condemning. He also knows the Gray Man's edict not to harm them. Strigoi will not be so brazen as his underling.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_033.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You will be safe, Wizard. Go to Castle Strigoi, find a way for us to infiltrate and then signal us out here. And we will fight by your side.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_034.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I... see. Miranda Briar never returned from the castle. I know not where she went. But her Broken Branch allies departed quickly not moments ago.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It seems then whatever it is they hoped to learn, they learned it. It is a shame what happened to Miss Easton. But we will always remember her.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "She showed us the truth of our existence and that truth will not be silenced again. We shall soon set Castle Strigoi to the torch.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then we shall grow more garlic and forever fortify our lands against the vampires. The Mortal Plain is ours and I promise you we shall protect it.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_024.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You have your own cause to return to, yes? Then let us not detain you any longer. Good luck to you, stranger. And thank you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Human_Outsider_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Michael_Carpenter_DM-MORT_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard! You're back! Finally, something not awful.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-MORT_040.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "After you left the last time, and I mean, almost right after, the camp was attacked... by Werewolves.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-MORT_041.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
