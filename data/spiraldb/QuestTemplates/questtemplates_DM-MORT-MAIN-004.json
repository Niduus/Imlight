  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, Mina, one of Strigoi's more vaunted- *Cough Cough*",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_051.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Lucy, are you okay?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_048.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, Madam Briar, I am well.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Remember, you're supposed to tell us everything you feel. Any new sensation could be significant.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_049.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, I know, it is nothing. Simply my lungs becoming reaccustomed to air again. We should return to the task at hand. Strigoi must pay for his betrayal.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps we should investigate Mina Clarke's house. I do not know what we might find, but it seems as good a place as- *Cough*",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_054.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You will stay here and rest. The Wiz-Kid and I will check out this house. Come along now. I think I know where it is.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_050.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You have photomances of stolen treasures? My word... I knew Strigoi employed McCreary as a facilitator. But to loot his victims is so... crass.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_055.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And there is so much... it takes barely a pint of blood to sustain a vampire for a night. A single victim, if properly preserved, can last a long time.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_056.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yet all these objects, all these victims, it is as though Strigoi was stocking up. But why?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_057.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And this harp... to take so beautiful an instrument and throw it on a pile to collect dust... we silence humanity's best to enable its worst, it seems.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-MORT_058.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687154,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
