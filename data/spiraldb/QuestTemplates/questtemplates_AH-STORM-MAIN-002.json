      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC01G_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Scholar Ferric and I had more luck searching the other ship holds. We discovered charts that map a potentially safe route through the storm.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-STORM_041.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765150,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC01G_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Safe... er... at any rate. I donnae think these vessels or our wee rowboat will survive it. But I might be able to jerry rig something with the right parts.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ignus_Ferric_AH-STORM_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1779132,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-STORM-NPC01G_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes... well observed. I do not suppose you have a list of said parts?",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Ione_Virga_AH-STORM_042.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1765150,
            "m_cameraName": ""
          },
          {
