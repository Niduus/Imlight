              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZOCOLO-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So the World, when it appears reversed in a fortune, means an unfulfilling ending. Which... yeah, Azteca obviously.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Judge_Veg_DM-SPELL_020.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1634715,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZOCOLO-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This world is still pelted with the detritus of Xibalba. More of it burns every day. Its people either flee or accept their end.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Judge_Veg_DM-SPELL_021.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1634715,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZOCOLO-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The end is nigh! Very nigh! Look up! The sky cries for the end is nigh!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_AZ_Parasaur_drkPriestF_A.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Crying_Sky_Street_Priestess_DM-SPELL_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZOCOLO-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It can't be stopped, can't be reversed, this just is. Come on, there's something we should do in the Mangrove Marsh.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Judge_Veg_DM-SPELL_022.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1634715,
                "m_cameraName": ""
              }
            ]
          }
        ]
