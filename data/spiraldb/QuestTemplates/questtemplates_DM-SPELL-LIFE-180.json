      "m_displayImage1": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC14A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Bauks, eh? Yeah, natural beasties, those. Sounds like you got what you need from this world. But, uh, we should go to a couple more.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Judge_Veg_DM-SPELL_015.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1634715,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC14A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "See, our World spell needs to harness the meanings of the World fortune. Both the good meaning, and the bad, yeah? And the World means unity.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Judge_Veg_DM-SPELL_016.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1634715,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC14A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Or it can, it can be a fusion of the individual and the communal, of mind and matter, of self and other. Fulfillment through belonging.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Judge_Veg_DM-SPELL_017.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1634715,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC14A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I don't know about you, but it sounds like Novus to me. So head back there and fight some of the creatures formed by mortal minds.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Judge_Veg_DM-SPELL_018.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1634715,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-HOWL-NPC14A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "My incantation will record this energy. Then come find me in the Zocalo. There, we will channel the reverse of the World.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Judge_Veg_DM-SPELL_019.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1634715,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
