            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I recorded what we learned about Balaur and the Weapons' programs in the tome. Check that out and then add the Weapons Reports to the correct facilities.",
