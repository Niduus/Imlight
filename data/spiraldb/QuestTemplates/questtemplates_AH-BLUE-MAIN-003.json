                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Ahmarric Threads we study, of course. We currently have three main facilities investigating them:",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_Alasahpa_AH-BLUE_013.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752307,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BLUE-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Abyss studies the chords of Spirit and Destruction.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_Alasahpa_AH-BLUE_014.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752307,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BLUE-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Trench experiments with Creation and Spirit.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_Alasahpa_AH-BLUE_015.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752307,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-BLUE-NPC11_Persona",
