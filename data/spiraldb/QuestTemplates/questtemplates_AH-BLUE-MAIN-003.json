            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Still, with Balaur back where he belongs, the Akashic Records should stay stable for now.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
