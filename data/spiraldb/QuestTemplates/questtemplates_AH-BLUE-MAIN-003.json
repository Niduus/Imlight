                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And the Island investigates aspects of Creation and Destruction.",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_Alasahpa_AH-BLUE_016.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752307,
