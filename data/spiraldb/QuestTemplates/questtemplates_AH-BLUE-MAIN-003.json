                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello, fellow citizen. Your tendrils look extra slimy today. What do you wish to know of our people?",
                "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_PriestF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_Alasahpa_AH-BLUE_012.mp3",
