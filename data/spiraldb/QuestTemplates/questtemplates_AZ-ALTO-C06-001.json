                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, the Shaved Jaguar Cub interferes again! You are looking for the Shadow's Tongue? Hah. I guess that's me.",
