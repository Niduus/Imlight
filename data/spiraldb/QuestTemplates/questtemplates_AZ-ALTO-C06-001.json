                "m_nameOverride": "Yacate Farwalker",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "King Neza always did have a way with words. What message do you have for the Shadow Queen? Does he surrender?",
                "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_F_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/YacateFarwalker_AZT_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
