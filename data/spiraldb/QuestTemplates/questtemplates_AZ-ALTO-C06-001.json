                "m_dialog": "AHHHH!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Morganthe.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/Morganthe_AZT_06.mp3",
