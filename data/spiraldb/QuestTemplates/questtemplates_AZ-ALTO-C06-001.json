                "m_nameOverride": "Yacate Farwalker",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What!? How dare you!?",
                "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_F_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/YacateFarwalker_AZT_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
