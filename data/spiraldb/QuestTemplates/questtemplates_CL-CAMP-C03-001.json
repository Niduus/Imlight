            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I’ve need of some pieces of scrap metal... any will do, really. The metal of the dome is weakening... we need to get it fixed!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Engineer_03.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GraceConrad_CEL_28.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227163,
            "m_cameraName": ""
          },
          {
