            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Pardon me, but could you perhaps lend a hand? I’m working at repairing the leaking dome, and need some help quickly.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Engineer_03.dds",
