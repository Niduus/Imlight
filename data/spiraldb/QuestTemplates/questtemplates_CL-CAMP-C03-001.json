            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There are so many leaks in the dome I’ll be patching them all day, but I’ve run out of supplies already.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Engineer_03.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GraceConrad_CEL_29.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227163,
