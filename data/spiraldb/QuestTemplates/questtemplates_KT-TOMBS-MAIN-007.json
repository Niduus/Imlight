  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-BrotherHelio_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Do you see the challenge? His power changes people so completely their old selves die, the spirits of which haunt these tombs.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Chameleon_Split_D_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Brother_Helio_KT-TOMBS_022.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656109,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-BrotherHelio_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But worse, this means anyone can at any moment be Khonsu's agent, his eyes and voice and sword.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Chameleon_Split_D_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Brother_Helio_KT-TOMBS_023.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656109,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-BrotherHelio_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "How can you build a rebellion when the rebels forget to rebel?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Chameleon_Split_D_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Brother_Helio_KT-TOMBS_024.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656109,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-TheProphet_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hatred can always be stoked, little rebel.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Shadow_Healer_MOB.dds",
            "m_soundFile": "Sound/1.560_Dialogue/The_Prophet_KT-TOMBS_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656126,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-EnkiTheHeretic_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And disparate forces can always be unified in their shared fury.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_WolfGryphon_Warrior_C_MOB.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Enki_the_Heretic_KT-TOMBS_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656113,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-TheProphet_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I was getting to that, dog breath.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Shadow_Healer_MOB.dds",
            "m_soundFile": "Sound/1.560_Dialogue/The_Prophet_KT-TOMBS_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656126,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-EnkiTheHeretic_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Did you say something? It must have been in a tone only dunces can hear.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_WolfGryphon_Warrior_C_MOB.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Enki_the_Heretic_KT-TOMBS_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656113,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-TheProphet_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Fine. Forget unity. We each have our hostage and the Wizard has at last reached deep enough into this pit to face us.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Shadow_Healer_MOB.dds",
            "m_soundFile": "Sound/1.560_Dialogue/The_Prophet_KT-TOMBS_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656126,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-TheProphet_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Come along, little victim, to the Tombs of Light and Night; see if you can save your barnyard companions.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Shadow_Healer_MOB.dds",
            "m_soundFile": "Sound/1.560_Dialogue/The_Prophet_KT-TOMBS_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656126,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-BrotherHelio_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have no clue what those tombs are, but the winged ones went down there, so perhaps look at the end of the hall.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Chameleon_Split_D_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Brother_Helio_KT-TOMBS_025.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656109,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-StandIn-Pork_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So we've got a another mission, eh, Wizard? I knew when these shadow rejects attacked my new ship, you'd show up eventually.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Pork_KT-TOMBS_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634414,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-StandIn-Pork_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, the ship is fine. I went along with them to protect my crew. Beans should be holding it down in my absence. Now what about your friend?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Pork_KT-TOMBS_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634414,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-StandIn-Pork_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Field of Reeds? Never heard of it. But this tomb over here is where they're keeping another hostage. Seemed a bit full of himself for my taste.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Pork_KT-TOMBS_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634414,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-StandIn-Pork_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But, come along, Wizard, once more follow Captain Pork into danger. We can thwart this threat if we work together!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Pork_KT-TOMBS_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634414,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-DrakeLockley_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Huh? Yeah, yeah, right, mac, good to meet you too. Drake Lockley, archaeologist, explorer, puncher of bad things.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonDrake_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Drake_Lockley_KT-TOMBS_032.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656112,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-StandIn-Pork_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings from the <italics>Federation</italics>... that's my new ship. I am Captain James T. Pork, adventurer, explorer, commander of archaeologists.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Pork_KT-TOMBS_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1634414,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KT-SE-DrakeLockley_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Great. Now that we've all made nice-nice, let's talk news. The bad news is the pathway to the Gateway is blocked. By a gate!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Duck_LoonDrake_NPC.dds",
            "m_soundFile": "Sound/1.560_Dialogue/Drake_Lockley_KT-TOMBS_033.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1656112,
            "m_cameraName": ""
          }
        ]
      }
