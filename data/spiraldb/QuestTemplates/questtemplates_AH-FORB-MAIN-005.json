              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As for how to find out what it is... ask.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Qismah_Shasa_AH-FORB_081.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1752246,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Are they not the rebellious brothers from before? Likely, they were the ones who defeated the Tritons. Ask them how.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Qismah_Shasa_AH-FORB_082.mp3",
