                "m_actorTemplateID": 1752248,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-YELLOW-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I wonder what she wants it for? I suppose Snuffles can find out after we capture her.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Qismah_Shasa_AH-FORB_080.mp3",
                "m_action": "",
