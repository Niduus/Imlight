  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is not enough to simply hit the Tritons with the energy of creation. We must turn creativity into an engine that feeds off their will.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_044.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We will make the Tritons afraid, their fear will enflame the Akasha. They will react poorly, attack recklessly. That too will fuel our power.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_045.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The enemy's thoughts will feed our resolve, make us stronger, as they shrivel and die.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_046.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If it works.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_047.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AH-YELLOW-NPC05-A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And I have the means to find out. Come with me... to the Thunder Cage.",
            "m_picture": "GUI/NpcPortraits/Portrait_Khrulhu_Scientist_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/AH/Balaur_AH-YELLOW_048.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1752287,
            "m_cameraName": ""
          }
        ]
      }
    ]
