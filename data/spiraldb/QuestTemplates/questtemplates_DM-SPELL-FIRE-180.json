  "m_questLevel": 1,
  "m_questRepeat": 0,
  "m_onStartQuestScript": "",
  "m_onEndQuestScript": "",
  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard! There you are! You caused quite the panic in the Arcanum rushing off as you did, so they sent the Cabal out to find you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687255,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, I realize you don't require any help, but perhaps a little knowledge wouldn't hurt, huh? As you know, I leave copies of myself on many worlds.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687255,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Including this one. Hello. And in my time here, I have learned things about their peculiar fortunetelling cards.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687255,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The cards are inspired by the abject knowledge of the Scholomance, knowledge of the soul derived from drilling down into its spiritual depths.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687255,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There are perhaps more civilized ways to achieve these results and turn these fortune cards into spell cards. The Chariot for instance.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687255,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A card that means drive, ambition and the will to achieve it, to exert your dreams into the world; what a spell that would make, no?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687255,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But to craft with these ancient magicks requires ritual more than ingredients; you need components gathered through experience.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687255,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-CAMP-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We must give shape to the ineffable, then battle ambition itself - both positive and negative - and at last baptize the spell in elemental Fire.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_008.mp3",
            "m_action": "",
