      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC25-C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The fallen world. A society destroyed not by invaders, but by itself. Dragonspyre's leaders drove forth to raise a Titan, their ambition blinding them.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_028.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687255,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC25-C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But this was no quick process, not an instant flash of fire and the world ended. It took years of planning and research and promising.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_029.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687255,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC25-C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And, well, see for yourself. Dragonspyre is forever haunted by its mistakes. In that hall is where ambition and indolence collided...",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_030.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687255,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
