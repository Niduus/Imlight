      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC25-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Your ambition is unhindered as always, Wizard, but these cards are not simply about the positive implications of a fortune.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_025.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687255,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC25-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There are downsides to ambition and ramifications to its absence. And there is no better place to demonstrate both than on Dragonspyre.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_026.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687255,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-CAMP-NPC25-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I shall see you there.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Cat_WarriorF_F_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Copy_Qhat_DM-SPELL_027.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687255,
                "m_cameraName": ""
              }
            ]
          }
        ]
