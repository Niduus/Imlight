  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm sorry we have to meet like this. Buck brought you here, didn't he? He went to find Duck Savage - do you know where she is? We need her help!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Wilma_Deering_LM-SKY_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524736,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Sky City used to be a utopia, but it's warping into something horrible! After the sky changed and the new Mana cascaded in, something happened.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Wilma_Deering_LM-SKY_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524736,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "People stopped thinking for themselves, and those who didn't embrace the Council started to disappear. We sent Buck for help, but now he's gone.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Wilma_Deering_LM-SKY_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524736,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Lemurs and I have started a Resistance, but I worry it will be crushed before it even begins. Will you help me rally them? Let's go!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Wilma_Deering_LM-SKY_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524736,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings, Wizard. You certainly seem... heroic! It is our highest hope that you can help us save our Community. It so happens we have just had a breakthrough!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Thun_LM-SKY_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524737,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Our brilliant Doctor Varkoz has discovered what is at the root of the disorder in Sky City! Or perhaps I should call it an oppressive order.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Thun_LM-SKY_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524737,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Somewhere in our city, somebody has constructed an Alphatronic Emitter which is subjecting everyone in Sky City... to a Mind Control Ray!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Thun_LM-SKY_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524737,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The stone of the city's foundations shields us from the Ray, but we must stay underground. How can we save the City trapped down here?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Thun_LM-SKY_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524737,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So this is the source of their unity? Mind control? Working together is good, as with Duck and Mandar. Yet this feels... wrong?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-SKY_131.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524717,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Doctor Varkoz - what do your sensors read?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Thun_LM-SKY_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524737,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Remarkable! This Wizard's mind is unlike any I've ever scanned. It must be why the Mind Control Ray hasn't affected them.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Doctor_Varkoz_LM-SKY_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524738,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As with the Crazy Eyes on Madness Mountain, remember?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-SKY_132.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524717,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mongonium! If I can get my hands on Refined Mongonium, I can create Badges that imitate the Wizard's manametric field and protect us from the Ray!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_C_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Doctor_Varkoz_LM-SKY_002.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524738,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Amazing! This Wizard has only been here minutes, and already we have new hope! Mongonium Control Rods are used in the Water Purification Plant.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Thun_LM-SKY_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524737,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-SKY-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I know the way - I'll mark the location on your map. See you there, Wizard!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Wilma_Deering_LM-SKY_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1524736,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
