                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Survivors of Ascension? Feed escaped the trough. An intriguing thought.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-MORT_013.mp3",
