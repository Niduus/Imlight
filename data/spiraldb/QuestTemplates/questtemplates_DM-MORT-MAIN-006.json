                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So they must be in the woods, if they still be at all. Hmmm. *Sniff Sniff*",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-MORT_015.mp3",
