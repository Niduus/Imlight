              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DM-MORT-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But if they so much as showed their faces in town, their fates would be sealed. You have seen how the vampires have enablers, yes?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Bruno_DM-MORT_014.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1687161,
