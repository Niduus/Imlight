  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST02-NPC05-MAW_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello! Thanks for coming. My name's Blaze, and I'm determined to show all of my fellow Wizards the secret to conquering foes: teamwork!",
            "m_picture": "GUI/NpcPortraits/Portrait_Derrick_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/BlazeMAW_EMP_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1435077,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST02-NPC05-MAW_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Magic gives us Wizards lots of power. With the right spells in your deck it's easy to feel like you can do anything! But that's not always true.",
            "m_picture": "GUI/NpcPortraits/Portrait_Derrick_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/BlazeMAW_EMP_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1435077,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST02-NPC05-MAW_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The good news is we can accomplish even more if we work together. I believe there's nothing better than helping out less-experienced Wizards.",
            "m_picture": "GUI/NpcPortraits/Portrait_Derrick_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/BlazeMAW_EMP_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1435077,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST02-NPC05-MAW_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's like we get to be Professors ourselves! I'll show you how - take a look at the Join A Team Kiosk over there.",
            "m_picture": "GUI/NpcPortraits/Portrait_Derrick_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/BlazeMAW_EMP_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1435077,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-ST02-NPC05-MAW_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Look at the Join A Team Kiosk in Olde Town and I'll show you how to help other Wizards out.",
            "m_picture": "GUI/NpcPortraits/Portrait_Derrick_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/BlazeMAW_EMP_06.mp3",
