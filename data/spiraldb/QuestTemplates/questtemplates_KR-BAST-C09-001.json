            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Will you help me rally the rest of the Burrowers? We need a forceful strike against the remaining Umbra Legion forces.",
