                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Goodness... the stench of those pied pastries is nearly overwhelming. You must get them out of here.",
                "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Prophet_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1254382,
