            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm choking on the toxic odor of fluffy, fresh-baked Treats. You must hurry; there isn't much time!",
