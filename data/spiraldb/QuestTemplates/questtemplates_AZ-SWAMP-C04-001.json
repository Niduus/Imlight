            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But first they defeat some Fierce Quetzals to chase them away. What are you waiting for?",
            "m_picture": "GUI/NpcPortraits/Portrait_Monkey_SoldierBoss_A_NPC.dds",
