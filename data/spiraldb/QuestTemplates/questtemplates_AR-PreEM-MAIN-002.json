                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This is the Ark's main machine room, which I've retrofitted with a Sublight Streamdrive engine. Ignus is smoke-testing the Streamdrive now.",
                "m_picture": "",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Sparck_EMP_07.mp3",
