                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "'Bout time! We should've told Sparck to skip the lavatory tour. Listen up, we need to discuss the recruitment of the Sky Captain.",
                "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
