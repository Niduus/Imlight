                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There we are! The homemade World Door is secured and ready for transport. You sure we shouldn't test it first?",
                "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/TarrakHadfield_EMP_08.mp3",
