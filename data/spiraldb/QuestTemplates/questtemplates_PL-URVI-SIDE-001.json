                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It may seem like silly stuff to you, but you've given me back my hopes and dreams, Wizard. I thank you from the bottom of my heart.",
                "m_picture": "GUI/NpcPortraits/Portrait_Bear_Cossack_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Aleksandr_POL_08.mp3",
                "m_action": "",
