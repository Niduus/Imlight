                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings, young Wizard! My... you've matured so much since I first met you in the early days of your arrival in Wizard City.",
                "m_picture": "GUI/NpcPortraits/Portrait_Seraph_Aerial_B_NPC.dds",
