                "m_dialogEvent": "",
                "m_actorTemplateID": 38123,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-ST01-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You've come for Pure Loam? I can only imagine that it's for crafting a ceremonial instrument, like a Horn of Eternal Winter.",
                "m_picture": "GUI/NpcPortraits/Portrait_Seraph_Aerial_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/LadyOriel_QST_28.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38123,
