            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bury the Wedding Chalice near the waterfalls in Bastion. I can't bear to live with the memories it represents.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Merchant_K_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/TristamYoungBlood_KHR_06.mp3",
