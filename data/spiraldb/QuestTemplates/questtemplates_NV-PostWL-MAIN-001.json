                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608226,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-CON-NPC34_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Or they convinced themselves that blowing up Novus would somehow just anger Dasein and send him into a frenzy. Either way, they'll help.",
