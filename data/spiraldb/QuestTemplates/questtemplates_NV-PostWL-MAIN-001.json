                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But... I'll need some help. Not all those contacts are friends of mine. But they are friends of friends, you know?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
