                "m_personaName": "NV-CON-NPC34_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Quake Charmer and Copy Qhat are in the Basstille, yeah? Help me break them out, we'll shut these drongos down.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Veg_NV-PostWL_112.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608226,
                "m_cameraName": ""
              },
