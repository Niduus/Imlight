                "m_dialogEvent": "",
                "m_actorTemplateID": 1608226,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-CON-NPC34_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Cabal's got contacts in the court of every world. I might be able to reach out, get them to apply some political pressure.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Veg_NV-PostWL_110.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1608226,
                "m_cameraName": ""
              },
