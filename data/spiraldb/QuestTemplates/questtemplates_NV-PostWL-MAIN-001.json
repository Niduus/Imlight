                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Seems like the local governors are stretching their authority. Wonder what the kings and queens would think?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Kangaroo_Cabal_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Judge_Veg_NV-PostWL_109.mp3",
