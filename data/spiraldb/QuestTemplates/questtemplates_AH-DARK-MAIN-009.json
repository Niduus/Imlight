                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I don't know, were they the ghostly whispers of the doomed?",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleFanaticBoss_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Shellcrafter_AH-DARK_031.mp3",
