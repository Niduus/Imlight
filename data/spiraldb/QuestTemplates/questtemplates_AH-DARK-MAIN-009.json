          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-DARK-NPC06-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard! We have held the rally point against numerous Kraken aggressors, but mission objectives currently seem unattainable.",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_Trooper_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Cooper_Trooper_AH-DARK_013.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756123,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-DARK-NPC06-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What? Why?",
                "m_picture": "GUI/NpcPortraits/Portrait_Turtle_NomadF_C_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Phillis_Windstone_AH-DARK_069.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756151,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-DARK-NPC06-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We're out of imagination! I have begun working with this Regeneratrix, but we aren't going to have enough pieces.",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleFanaticBoss_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Shellcrafter_AH-DARK_029.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756175,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-DARK-NPC06-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We're done and coming in. Just hold the blink on!",
                "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Use_AH_Conch_A.dds",
                "m_soundFile": "Sound/Dialogue/AH/Soulik_en_Shellion_Terra_AH-DARK_060.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756185,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-DARK-NPC06-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It doesn't matter. You, me, Phobus... even if your teacher friend finds anything else... it isn't enough. We need more Tritons.",
                "m_picture": "GUI/NpcPortraits/Portrait_TurtleFanaticBoss_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Shellcrafter_AH-DARK_030.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1756175,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AH-DARK-NPC06-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, we did find that big skull place earlier with all the whispers wafting out from within. Could that help?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_FanaticF_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/AH/Shellion_Trench_A_AH-DARK_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
