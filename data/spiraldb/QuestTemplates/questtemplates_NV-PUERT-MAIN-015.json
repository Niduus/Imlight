  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A strange fellow, this Dasein of yours. He kept... changing his shape into all manner of people. I found the Chicken particularly disturbing.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_048.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He lacked even the most basic understanding of economics. He could not grasp that giving the Monquistans bananas for nothing was a bad thing.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_049.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He, on the other hand, thought I was strange because I did not to simply give everything to everyone. Such an alien viewpoint.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_050.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Still, we managed to make a compromise. I asked for something of my own: Valencian Steel! Not Iron, but refined Steel, straight from the ground.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_051.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He agreed! And now all that remains is for us to find where he put-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_052.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My lord! Something is happening in the Monquistan valley. The Banana Grove, it is full of metal veins!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_SpyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Valencian_Spy_NV-PUERT_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562170,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What is this? Quickly, we must go see!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_053.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Grove, it is now choked with metal. Surely this cannot be good for the soil!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Priest_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Monsignor_Del_Monte_NV-PUERT_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562148,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not just metal - STEEL! Valencian Steel! The fool Dasein manifested our metal here. Which makes this Valencian Land!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_054.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now, now - esteemed Principe, that is not what we agreed to when we settled this Shard together. Surely, such a betrayal-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_035.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You speak to me of betrayal? HA! Not since the Turtle King kidnapped Princess Pesca has there been treachery so vile as this!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_055.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You undermine the trade contracts that are the basis of our friendship. Stand down or we will be forced to duel!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_056.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Dueling is your way. Ours is the way of the Banana and you have slipped up. Guards! Seize him!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_036.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wait, what? Save me!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_057.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You cannot do this! Our armies will respond. You will feel the wrath of Valencia!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_NobleF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Contessa_DiNario_NV-PUERT_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562149,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Valencia's army is not the only one on this Shard. Do not feel so sure of your victory.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_037.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562153,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "<ITALICS>*Earthquake*</ITALICS>",
            "m_picture": "GUI/QuestButtons/Art_Quest_Complete.dds",
            "m_soundFile": "Sound/Dialogue/SFX_NV-PUERT_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard! This needless conflict is poised to rend Puerto Nuovo. Please, please, rescue the Principe, while I reason with the Valencians",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Priest_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Monsignor_Del_Monte_NV-PUERT_027.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562148,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC14_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Round one to Valencia! Ha-ha!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Unicorn_Prince_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Principe_Mario_di_Mario_NV-PUERT_064.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562164,
            "m_cameraName": ""
          }
        ]
      }
    ]
