            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My Toasty-Toes Tincture is a miracle cure for frostbite, if I do say so myself. Unfortunately, I'm running out of its key ingredient.",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Prisoner_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/DocWallgreen_POL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346231,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-BLEAK-NPC11_Persona",
