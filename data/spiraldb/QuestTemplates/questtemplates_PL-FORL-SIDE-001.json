            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello, Traveler. I'm Thomas, but everyone here calls me Doc. Technically, I'm a healer, but I can't seem to shake the nickname.",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Prisoner_C_NPC.dds",
