            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could I impose upon you to collect Tufted Saxifrage for me, please? Think of all the frostbitten fingers and toes you'll save!",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Prisoner_C_NPC.dds",
