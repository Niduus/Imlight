            "m_personaName": "PL-BLEAK-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I use the resources the land provides to keep the Rangers healthy. But for the most part, I help weary travelers survive in this bitter cold.",
