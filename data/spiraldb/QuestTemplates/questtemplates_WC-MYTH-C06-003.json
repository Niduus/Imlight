            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I assume you've got something <ITALICS>far more important</ITALICS>  to do than going to get a special bone from Dworgyn down in Nightside? No? Well then... off with you!",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfCyrusDrake_QST_120.mp3",
