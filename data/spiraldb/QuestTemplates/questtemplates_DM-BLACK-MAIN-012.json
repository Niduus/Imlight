            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wraithbile and I thought a lot about those memories you showed us and then talked a lot about memories we have never shared.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Baukclaw_DM-BLACK_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-009_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We saw the Sisters for what they really are, not powerful Immortals, but lost scavengers, using us to learn what they have forgotten.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Baukclaw_DM-BLACK_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-009_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We tried to warn others, but the Hierophant interceded. I got away, but Wraithbile is still in her wicked clutches. We have to do something!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Player_ScholomariF_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Apprentice_Baukclaw_DM-BLACK_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-BLACK-NPC-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We will, right, Wizard? Where are they now?",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-BLACK_158.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1700033,
