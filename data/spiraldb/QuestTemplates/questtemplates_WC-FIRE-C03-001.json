                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oooooh! I know where this is! A treasure of Fire Gems was stored in the Krokosphinx during the Iman era, and now they are trapped in the frost.",
