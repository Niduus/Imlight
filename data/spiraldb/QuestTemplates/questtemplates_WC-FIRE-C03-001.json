                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings, student of Fire! You say you need help with finding a Frozen Fire Gem? Not too much is frozen here in Krokotopia.",
