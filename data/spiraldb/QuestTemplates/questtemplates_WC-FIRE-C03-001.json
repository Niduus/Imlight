                "m_personaName": "KT-HUB-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Take this and make some rubbings of the Bird Obelisk down there. I should be able to advise you better after that.",
