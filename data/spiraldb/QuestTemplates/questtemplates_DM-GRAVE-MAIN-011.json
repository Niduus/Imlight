  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC12A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now you say the Gray Man hangs out in the Parliament of-",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-GRAVE_055.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675533,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Gargoyle Blade",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The traitorous mortal! You who toppled the House of Cups! The Gray Man demands your head!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_Base_A_MOB.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Gargoyle_Blade_DM-GRAVE_003.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC12A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So much for protection. You hold them off, I'll head inside.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-GRAVE_056.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675533,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC21B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My failed assassin, come to accept punishment? You toppled a Great House, destroyed Count Strigoi and-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Mutant_Robe_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Gray_Man_DM-GRAVE_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675584,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC12A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And you don't actually care, do you?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-GRAVE_058.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675533,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC21B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "An impertinent witch, how uncommon. I would return you to your keepers, but as you say, I don't care. Not for them. Not for the Houses or their politics.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Mutant_Robe_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Gray_Man_DM-GRAVE_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675584,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC21B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I constrain them for the greater stability of Darkmoor, a stability undermined by our shared enemy, an enemy-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Mutant_Robe_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Gray_Man_DM-GRAVE_015.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675584,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC12A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That has something you want, right?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-GRAVE_059.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675533,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC21B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hmmmm?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Mutant_Robe_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Gray_Man_DM-GRAVE_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675584,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC12A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Broken Branch can cure the curse, something the greatest magical scholars couldn't do.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-GRAVE_060.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675533,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC12A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "All of which suggests they have a deeper knowledge of that curse than anyone, even you, which suggests access to the curse's source: the Scholomance.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-GRAVE_061.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675533,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC21B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And what do you know of the Scholomance?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Mutant_Robe_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Gray_Man_DM-GRAVE_017.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675584,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC12A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I might know how to find it. Or at least I know someone who does. But she was taken from us by the House of Coins.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-GRAVE_062.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675533,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC21B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So you come to me seeking the route to the Howling Lands to recover your knowledgeable friend? Very well. Take these maps to guide you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Mutant_Robe_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Gray_Man_DM-GRAVE_018.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675584,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC21B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But know this, Scion, I am watching. I have many eyes and they are all focused on you.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Mutant_Robe_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Gray_Man_DM-GRAVE_019.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675584,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC21B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If your path leads to the Scholomance, we will walk it together. If it does not, it will end quite swiftly.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Mutant_Robe_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Gray_Man_DM-GRAVE_020.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675584,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC12A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well, he's fun. Strangely tired though, didn't you think? Not the fearsome figure of legend who brought order to the warring clans of monsters.",
            "m_picture": "GUI/NpcPortraits/Portrait_VampireHunterF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Velma_von_Venkman_DM-GRAVE_063.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675533,
            "m_cameraName": ""
          }
        ]
      }
    ]
