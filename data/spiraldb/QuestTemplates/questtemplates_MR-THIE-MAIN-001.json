                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hehehe! Walrusk Empress! Hehehe!",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_J_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/HairyQhrum_MIR_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391065,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But the good news is that Ali Baboon is always up for more entertainment. Perhaps you failed to notice - you're standing on a trap door...",
                "m_picture": "GUI/NpcPortraits/Portrait_Baboon_Boss_A_NPC.dds",
