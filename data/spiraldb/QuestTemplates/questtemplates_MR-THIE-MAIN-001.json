                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Um... Thank you, of course, Mister Baboon. I hope we can perform for you again some time...",
                "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Merchant_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DevinnTheDrifter_MIR_21.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391063,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sorry, my friend. I hope this goes well. We will await you out in the Main Hall.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Merchant_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DevinnTheDrifter_MIR_22.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391063,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "My, my. Here I thought I left all my troubles behind in Aggrobah. I am surprised. I didn't expect to see you again, certainly not so soon.",
                "m_picture": "GUI/NpcPortraits/Portrait_Baboon_Boss_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/AliBaboon_MIR_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391064,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Come now, you didn't actually think Ali Baboon would be fooled by a disguise? Such tricks will not work on me. I am not a Walrusk Empress.",
                "m_picture": "GUI/NpcPortraits/Portrait_Baboon_Boss_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/AliBaboon_MIR_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391064,
