                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well done. Your Dromel Dancers are very talented, and so lovely too, especially the third one.",
                "m_picture": "GUI/NpcPortraits/Portrait_Baboon_Boss_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/AliBaboon_MIR_13.mp3",
