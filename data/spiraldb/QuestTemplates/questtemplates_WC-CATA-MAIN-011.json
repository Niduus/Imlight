  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "When the Spiral was young I began my watch over this place. I am charged to destroy all who trespass, but I sense Tree Magic in you. Welcome.",
            "m_picture": "GUI/NpcPortraits/Druid_GhostF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ages ago we crafted the Amber Orbs, enchanted to imprison the essences of evil things. We kept them here, in our hidden prison.",
            "m_picture": "GUI/NpcPortraits/Druid_GhostF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Orbs were held aloft, suspended in a web of binding magic. But a great tremor shifted the Menhirs that bound the web, and the Orbs fell.",
            "m_picture": "GUI/NpcPortraits/Druid_GhostF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am but a ghost: I cannot shift the stones into place. Right the Menhirs and the Prison will be restored. I ask you in the Great Oak's name.",
            "m_picture": "GUI/NpcPortraits/Druid_GhostF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Until the great Stone Menhirs are set right, the Prison Binding will be broken. You must repair it.",
            "m_picture": "GUI/NpcPortraits/Druid_GhostF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
