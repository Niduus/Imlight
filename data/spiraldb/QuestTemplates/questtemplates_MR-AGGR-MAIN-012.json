  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC04-D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Tell your friends in Caravan that Aggrobah will stand with them against Xerxes. Then join Istar to negotiate with House Tabbi.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/SultanaSharzad_MIR_69.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397102,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Swan, it seems you took back the Palace with minimal difficulty. I cannot express my gratitude for your part in all of this.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/SultanaSharzad_MIR_63.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Hoods and I were honored to do our part, and as you requested, we are further honored to serve as your security forces from now on.",
            "m_picture": "GUI/NpcPortraits/Portrait_FennecFox_Boss_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Swan_MIR_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381232,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Excellent! Wizard, Ozzy, you came here seeking assistance for Caravan in defending Mirage from the Overlord Xerxes. I have not forgotten.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/SultanaSharzad_MIR_64.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I fear, however, that even with the combined might of Caravan and Aggrobah, we may be outmatched. We will need the help of the House Qhats.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/SultanaSharzad_MIR_65.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The noble houses were the first rulers of Mirage, and they still retain great power. The Qhats' petty squabbling won't make this easy, however.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/SultanaSharzad_MIR_66.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381236,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh oh oh... I know! I can handle negotiations! I can go through the House Djinni who serve each of the House Qhat Lords!",
            "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_39.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381237,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC04-D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hmm. It's fine to open negotiations that way, but the Wizard should be lead negotiator. In fact, Istar, treat the Wizard as your Master for now.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/SultanaSharzad_MIR_67.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397102,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC05-E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh ok! Smart thinking, as always... You're so wise, Master... I mean... Sultana. I think this will actually be quite enjoyable.",
            "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_40.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1404008,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC05-E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "All right, my new Master. I'll go on to the Agouti Rift and open negotiations with Murdak, the Djinni to House Tabbi. I'll see you there.",
            "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_41.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1404008,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC08-E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If she's going, how about I sit the Qhat bit out? Allergies, you know... and with these dry sinuses, I'd rather just stay here with the Sultana.",
            "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_50.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1404009,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC04-D_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'd like that. Wizard, inform your friends in Caravan of our plans, and then join Istar in Caterwaul Canyons. My hopes go with you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/SultanaSharzad_MIR_68.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397102,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
