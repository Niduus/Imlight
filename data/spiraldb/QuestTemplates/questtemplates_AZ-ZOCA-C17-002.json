        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have long studied the Xibalba Codex, but even after all this time, its mysteries still elude me! It was written in a clever code!",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TezcatThreestar_AZT_38.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643254,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My friend Zaylin Reedwalker may be able to help. She understands codes and ciphers better than Pacal or myself.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TezcatThreestar_AZT_39.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643254,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Speak to Zaylin here in the Zocalo and see if you might find some way to decode the Xibalba Codex.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TezcatThreestar_AZT_40.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643254,
