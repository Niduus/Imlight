            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, good, you will help with the Cotton Candy. Giddy to the up, mein partner. I must plant the Candy Corn for Nana, but the Cotton Candy, ah, she is my soul.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_FarmerF_A_NPC.dds",
