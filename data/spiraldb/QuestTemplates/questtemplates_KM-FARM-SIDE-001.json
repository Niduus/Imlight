            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Nana, she does not like me wasting the field space on the product she will not use, so I must keep it hidden and I do not get much time to tend it.",
