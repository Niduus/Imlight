  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "For centuries, they treated me like family, while making me into a monster. And when I rediscovered my humanity, they cast me out.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They were afraid. And they were right to be. I will wield this cure like a scythe and cut them down.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I thought the goal was to save the villagers.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_085.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can do both.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Storming the castle does sound a bit tricky, but if we threaten their food supply...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_DM-MORT_086.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then they will come running into the light. Yes, I think it is time for the grazing to end and the revolution to begin.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Listen to me, you have seen the evidence yourselves. Your neighbors, your families, they are not living in a palace in the clouds...",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...They are gone, fed upon and discarded by the House of Cups. Vampires, we call them! Parasites is another word. Naught but haughty mosquitos!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Will you help me swat them?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_010.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Angry Villagers Crowd",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We must! Death to the Vampires! Death to the Vampires!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Human_AngryMob_A_MOB.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Angry_Villagers_Crowd_DM-MORT_001.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Angry Villagers",
            "m_picture": "",
            "m_soundFile": "",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then tear down their statues, draw out their collaborators, show them you will no longer be their victims!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_BranchBoss_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Red_Death_DM-MORT_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1687178,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-MORT-NPC18_Persona",
