                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Kestrel Blackstorm, Taylor Froghead, Carson Spritethief, Declan Wyrmdust, Quinn Legendbreaker, and Bentley Daysong.",
                "m_picture": "",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/BorisTallstaff_EVE_05.mp3",
                "m_action": "",
