                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There are six students in the group. Let's see...",
                "m_picture": "",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/BorisTallstaff_EVE_04.mp3",
                "m_action": "",
