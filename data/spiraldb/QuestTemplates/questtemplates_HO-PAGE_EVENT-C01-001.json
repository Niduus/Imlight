        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Thank the Spiral you arrived so quickly. I need a hand with a crisis that could become an epidemic!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/HaroldArgleston_EVE_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Carpe Diem Society gathers here to work on their lessons after classes: a six student study group. Normally well-behaved.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/HaroldArgleston_EVE_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Today, however, one of the students stumbled upon <ITALICS>The Book of Lost Pages</ITALICS>. This accursed tome is to be locked away at all times!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/HaroldArgleston_EVE_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But it was misfiled by my assistant Boris and placed in the open stacks by mistake. When they opened it, the Pages were unleashed!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/HaroldArgleston_EVE_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Speak to Boris Tallstaff and hear the story of the <ITALICS>Lost Pages</ITALICS> firsthand, then come back to me!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/HaroldArgleston_EVE_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
