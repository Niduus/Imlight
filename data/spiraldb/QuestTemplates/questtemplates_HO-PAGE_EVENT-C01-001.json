                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I feel bad that the whole Carpe Diem Society was taken over by the book.",
                "m_picture": "",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/BorisTallstaff_EVE_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
