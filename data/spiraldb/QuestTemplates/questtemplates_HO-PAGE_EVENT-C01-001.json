                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What? I didn't do anything. Well, okay, I guess I did put <ITALICS>The Book of Lost Pages</ITALICS> out in the main stacks.",
