  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Tarry not, for the Malughast may strike at any moment.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well done, my champion, my hero, my... dare I say it? My Scion.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-NIGHT_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Old Judge! But he is immaterial... dead.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_026.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Lemuria's purpose, as I've told you, is to restore the First World, but according to Druidic legend, a being known as the Scion of Bartleby is required.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-NIGHT_017.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Said being is foretold to unify Light and Shadow, to be the glue that binds a fragmenting world. I can't guess who that would be, so I made one.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-NIGHT_018.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Rather, I created in this world the ability to fabricate heroes based on the template of a man named Stallion Quartermane.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-NIGHT_019.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "",
            "m_nameOverride": "Old One Screen",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Statistically, one of the resultant adventurers would advance beyond their peers, find my true secrets and become my Scion. Now, take your reward.",
            "m_picture": "|_Shared|WorldData|GUI/QuestButtons/Art_Portrait_Screen_Keyboard.dds",
            "m_soundFile": "Sound/Dialogue/LM/Old_One_Screen_LM-NIGHT_020.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 0,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You have profaned the monument to the Old Judge? 'Tis a criminal offense. 'Tis... against the rules! You shall be punished for this affront!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Hierarch_Lucien_LM-NIGHT_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520132,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Quiet thy thunder and listen, Lucien, for this matter is not what you have imagined it to be.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Crane_Hero_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Solomon_Crane_LM-NIGHT_032.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520136,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "LM-NIGHT-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Imagined! Accuse me of wild fancies, will you? I tire of your defiance. The rules of the Old Judge are clear: Do not challenge the Hierarch.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Lemur_Resistance_E_NPC.dds",
            "m_soundFile": "Sound/Dialogue/LM/Hierarch_Lucien_LM-NIGHT_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1520132,
            "m_cameraName": ""
          }
        ]
      }
    ]
  },
