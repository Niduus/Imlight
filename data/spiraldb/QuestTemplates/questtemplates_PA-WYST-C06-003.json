                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Congratulations on your victory. You should tell Mrs. Dowager what has transpired. And deliver this to her, will you?",
