                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We will see about finding the Cup in due course, but now it is time for your duel!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_14.mp3",
