                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Mrs. Dowager is right. The Spiral Cup is but a prize... what is important is the skill and courage that wins it!",
