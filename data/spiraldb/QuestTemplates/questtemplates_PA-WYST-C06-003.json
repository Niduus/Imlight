                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You are the victor? I am surprised. Young Shugenja is quite the duelist. Perhaps Diego taught you something after all...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "On the matter of the disappearance of the Spiral Cup, I have examined the area, and made an important finding.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
