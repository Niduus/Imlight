                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You are matched against Kisai Shugenja, our representative from MooShu. You must face one another in the Hall of the Hydra.",
