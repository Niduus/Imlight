            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Do not worry overmuch. I am certain that the Spiral Cup will turn up sometime soon. It must just be a terrible mistake.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Mrs_Dowager.dds",
