            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'll need to fight some Scurvy Skirkers before you can get the flower. Please beat them up, and then get the Moonflower for me!",
