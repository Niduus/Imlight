            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/CassiethePonycorn_AVA_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470340,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
