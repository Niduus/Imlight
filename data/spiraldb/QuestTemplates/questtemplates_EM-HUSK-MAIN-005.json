  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC01-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You've so done well, my Scion. Just as I knew you would. Now, hurry along to the Arcanum. Go tell everyone what happened here!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Bartleby_EM2_50.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448120,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC01-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I knew you would prevail, my Scion!",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Bartleby_EM2_59.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448120,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ugggh... What... what happened?",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandfatherSpider_EM2_38.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448115,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Spider! I'm so happy you're alive! I didn't know it until I thought I'd lost you. I'm so sorry for this. Please don't hate me.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_GH_GrandmotherRaven_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandmotherRaven_EM2_25.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448117,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You ripped my Heart out, locked me in a hole, then used my Heart to create a world in which I was the personification of evil.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandfatherSpider_EM2_39.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448115,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am beyond angry with you, Raven. But, I could never hate you. I love you too much. With every fiber of my chaotic Heart.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandfatherSpider_EM2_40.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448115,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm sorry I hurt you, Spider. And I'm so, so very sorry for what I've done to our Titans.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_GH_GrandmotherRaven_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandmotherRaven_EM2_26.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448117,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC01-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Do not forget the things you did correctly, Sister. Despite your misteps, the other life you created never strayed from your original plan.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Bartleby_EM2_53.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448120,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC01-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "None of this would've existed had you not acted exactly as you did. There is still time for your dream for the Spiral to be realized.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Bartleby_EM2_54.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448120,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Thank you, Brother. And thank you, Mellori, for not abandoning me the way I abandoned you. I hope you can find it in your heart to forgive me.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_GH_GrandmotherRaven_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandmotherRaven_EM2_27.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448117,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC02-H_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yeah, sure. I'm just happy it all worked out, you know. I've learned a lot. Ugh, I'm not good with this mushy stuff. Just skip me.",
            "m_picture": "GUI/NpcPortraits/Human_Mellori_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Mellori_EM2_111.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I knew there was something special about you, Mellori. That's why I entrusted my most capable son to watch over you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandfatherSpider_EM2_41.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448115,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC03-H_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's no declaration of infinite and undying love, but I'll take it.",
            "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Bat_EM2_82.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448122,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your brothers were born of my nightmares, but you were my one and only dream, Bat. I knew you'd deliver me here, to this moment, thank you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandfatherSpider_EM2_42.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448115,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC03-H_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh... well... Whooo, it sure is dusty in here! Hehe. Just skip me too! *Sniffle*",
            "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Bat_EM2_83.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448122,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC01-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Thanks to my Scion, Existence has been returned to its rightful order, with the appropriate amount of chaos sprinkled throughout.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Bartleby_EM2_55.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448120,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps it's time the mortals steered their own destinies. Raven, all I've ever wanted was to be here, in our Forest, with you. Let us stay.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandfatherSpider_EM2_43.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448115,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Absolutely, my love. We'll bind each other to this place to protect the Spiral. With a little help from Bartleby, to keep us honest, of course.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_GH_GrandmotherRaven_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandmotherRaven_EM2_28.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448117,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC01-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My pleasure!",
            "m_picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Bartleby_EM2_56.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448120,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What an ending to such a bitter chapter. Thank you all for never giving up on this World. Especially you, Wizard. I love you all!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_GH_GrandmotherRaven_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/GrandmotherRaven_EM2_29.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1448117,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-HUSK-NPC02-H_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
