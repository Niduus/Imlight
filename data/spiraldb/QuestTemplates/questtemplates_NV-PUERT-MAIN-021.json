            "m_actorTemplateID": 1562179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not a full Shard, more a large platform I'm told we discovered through one of the breaches. It contains another Leyline to New Vicorgia.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Unicorn_NobleF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Princess_Pesca_NV-PUERT_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One can walk an army across it right into the heart of Marleybone's settlement, establish a beachhead and take the fight to Regent's Square.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Unicorn_NobleF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Princess_Pesca_NV-PUERT_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Forget Novus, this could spark a war across the Spiral! You must stop him. I'll arrange transport to the Contested Shard.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Unicorn_NobleF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Princess_Pesca_NV-PUERT_008.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1562179,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
