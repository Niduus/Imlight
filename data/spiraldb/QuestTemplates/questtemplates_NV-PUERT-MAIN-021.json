      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "NV-PUERT-NPC28_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He had one job: don't ruin things before I arrive. And now he leads our forces in a backdoor invasion of New Vicorgia, across an unclaimed rock.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Unicorn_NobleF_A_NPC.dds",
