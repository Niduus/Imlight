            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well, Wizard? You better go.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TeddyHairkonnen_MIR_24.mp3",
