            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Underwing? You wish to defend this broken vessel?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Gargoyle_CommanderF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Commander_Ahk_To_DM-GRAVE_100.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675597,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC17C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "House of Swords, do you mean to say you know this impudent vampire?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bat_Vampire_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Reeves_DM-GRAVE_006.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675618,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC18A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Vampire? That is as meager a Werewolf as I have ever seen. Smells like one too.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lord_Barghest_DM-GRAVE_004.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1704070,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC17C_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "House of Coins, you look at that creature there and see a werewolf? I see a vampire. House of Wands, what do you see?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Bat_Vampire_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Reeves_DM-GRAVE_007.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1675618,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DM-GRAVE-NPC20A_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I see many things. I see a glamour. I see a mortal. I see a feast!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Scholomari_PriestessF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/The_Hierophant_DM-GRAVE_002.mp3",
