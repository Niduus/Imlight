            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You really should not be here. For your own sake-",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Player_LucyF_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Lucy_Easton_DM-GRAVE_029.mp3",
