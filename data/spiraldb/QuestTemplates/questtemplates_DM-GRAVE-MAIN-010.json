            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hey, I was going to eat that!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Werewolf_Lord_A_NPC.dds",
