      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, you have returned. Let us discuss- Oooo...",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Are you feeling alright, Douglas? You look as though you have seen a ghost.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, see, what had happened, Mr. the Boss Sir, was I was all but done digging the rubble out when I accidentally dug through the floor a little.",
                "m_picture": "GUI/NpcPortraits/Dog_Contractor_Crew_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LandscaperDoug_CAT_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Then, this barmy chap appears outta nowhere, moaning that I woke him up and starts in on me! I'd be dead if'n it weren't for the Wizard.",
                "m_picture": "GUI/NpcPortraits/Dog_Contractor_Crew_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LandscaperDoug_CAT_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh Douglas. Not only are you an expert digger, but you are also an expert comedian. Your completely implausible ghost story amuses me. Ha. Ha.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Haha. Yeah, well, alright then, since the Tunnel's mostly cleared, I was wondering if I could go back up topside. Me lunch is getting cold.",
                "m_picture": "GUI/NpcPortraits/Dog_Contractor_Crew_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LandscaperDoug_CAT_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of course, Douglas. You've more than earned that lunch. You and your Wizard friend are always welcome down here in my Drains.  <ITALICS>Arrivederci!</ITALICS>",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
