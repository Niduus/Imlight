      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Molto bene</ITALICS>. The Walls are practically good as new. Thank you. Now that I know you can be trusted, let us discuss our mutual acquaintance...",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As you may know, Douglas possesses prodigious digging skills, surpassed only by his loyalty and desire to prove himself as the goodest of good boys.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "At present, Douglas is clearing the rubble from a collapsed Service Tunnel; a feat my other Workers could not even dream of endeavoring to do.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "He's been hard at work for days now and should be close to finished. Go fetch Douglas from Service Tunnel C, and then we can discuss next steps.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              }
            ]
          }
        ]
