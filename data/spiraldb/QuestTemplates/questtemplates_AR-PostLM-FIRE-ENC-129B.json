      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now, let me see if I have this straight: You trespass in my Drains, assault me and my associates, and you wish to abscond with my best worker?",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You got moxie, Kid. I like that.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I am willing to negotiate for Douglas' services, but, of course, I will require compensation in return.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The various renovation projects that you Topsiders have conducted up in Wizard City have caused significant structural damage to my Drains.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488040,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "My Workers have tried to fix things, but they are but humble sanitation engineers, not builders. Fix the Structural Damage, and then we'll talk.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/BugBoss_CAT_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
