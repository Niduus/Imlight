            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "My Tools! Now I can finally get back to work. Thanks, Tops- er... Wizard.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Worker_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/MannyDibbles_CAT_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488000,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I seen your Dog pal a while back. Poor pooch was running around whimpering, scratching at every door he could find.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Worker_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/MannyDibbles_CAT_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488000,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Then he made the mistake of scratching at that door over there - the one to the Boss' Office. Ain't seen hide nor hair of him since.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Worker_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/MannyDibbles_CAT_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488000,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I don't recommend entering the Boss' Office uninvited, but if ya tells 'em that Manny Dibbles sent ya, ya should be OK. Probably. Good luck!",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Worker_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/MannyDibbles_CAT_07.mp3",
                "m_action": "",
