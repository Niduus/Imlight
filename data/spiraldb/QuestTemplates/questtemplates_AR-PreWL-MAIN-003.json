  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, yes, the inhabitants of Novus have grown quite agitated since the Breaches in the sky turned to black holes.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Zander_AR-PreWL_011.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340970,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "According to our agents, the Spiral Powers have banded together in the unified goal of blaming you. Scholar Ione can tell you more.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Zander_AR-PreWL_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340970,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you wish, return to me later and I may be able to use my share of Novus' soil to create something to help you in my homeland.",
            "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Zander_AR-PreWL_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340970,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Complete",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC36_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard... have you soil from Novus and the branch from Sybil? I have the Spiral Key, so we are at last ready to venture to Wallaru.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_AR-PreWL_012.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1575100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC36_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It has been many a year since my own Walkabout. It was... an eventful time. Wallaru was a very different world back then.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_AR-PreWL_013.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1575100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC36_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But there aren't many left who have completed a full Walkabout. It has grown more difficult, as you will see. I will guide you as best I can.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_AR-PreWL_014.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1575100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC36_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This metropolis bustles with ambition, with aspirations for a new way of life. See what can emerge from this world's wellspring of inner truth.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dromel_Wizard_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/Sandiago_AR-PreWL_016.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1575100,
            "m_cameraName": ""
          }
        ]
