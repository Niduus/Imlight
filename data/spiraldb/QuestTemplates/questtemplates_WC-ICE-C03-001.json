                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Glad to see you made it back! Let me see what you have retrieved. Mmmmm... Looks like the Medallion suffered some damage during combat.",
