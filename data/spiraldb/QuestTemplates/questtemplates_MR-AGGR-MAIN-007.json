                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "How come I never catch a break? Look, I can't afford a war with the Sultana. I got enough problems with the Thuggies and the Fangs.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Warrior_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/AchmadPeece_MIR_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1381258,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC05-C_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Sultana does not want a war. She wants peace - between ALL the gangs. We are here to invite you to attend the Sultana's Truce Talks.",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_27.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1381257,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I suppose I got nothing to lose at this point. If Ali Baboon and Loother Ray will attend, then tell the Sultana I'll come too.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Warrior_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/AchmadPeece_MIR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1381258,
