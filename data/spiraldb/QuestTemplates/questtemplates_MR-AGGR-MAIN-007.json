            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This is the moment of truth. The gangs are at each others' throats. If we can convince Peece to attend truce talks, the others will follow.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/SultanaSharzad_MIR_33.mp3",
