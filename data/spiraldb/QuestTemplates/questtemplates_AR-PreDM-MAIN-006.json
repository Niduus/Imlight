                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The lift will take us straight there. Brace yourself... the Pilot's a little strange.",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Qyburn_Stellargaze_AR-PreDM_012.mp3",
