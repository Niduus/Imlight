                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yeah? Good. Looks like the Bridge is open now that Briar's gone. So we can go talk to the Pilot.",
                "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/DM_1.590/Qyburn_Stellargaze_AR-PreDM_011.mp3",
