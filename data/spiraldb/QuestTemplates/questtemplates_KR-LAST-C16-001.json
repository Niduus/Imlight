  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-LastWood-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You're the great and powerful Spellbinder, aren't you? The Burrowers here have many good things to say about you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EoinGentleWind_KHR_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223224,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-LastWood-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No one ever has good things to say about me. I'm horrible at making burrows, and I've always been too afraid to fight.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EoinGentleWind_KHR_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223224,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-LastWood-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If only I had the Helm of Rodoric, then I'd be a courageous warrior. What, don't you know what the Helm of Rodoric is?",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EoinGentleWind_KHR_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223224,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-LastWood-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "According to legend, there was once a cowardly mouse named Rodoric who was so terrified of combat, he went to a Summoner for help.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EoinGentleWind_KHR_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223224,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-LastWood-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "She gave him an enchanted helmet that turned him into a fearless knight. He went on to become the hero of numerous battles.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EoinGentleWind_KHR_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223224,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-LastWood-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Before he died, Rodoric buried the Helm because he was afraid of what could happen if it were worn by an immoral Mouse knight.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EoinGentleWind_KHR_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223224,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-LastWood-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Unfortunately, I heard the Flame Legs found it when they burned the forest. Do you think you could retrieve it for me?",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EoinGentleWind_KHR_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223224,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
