            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Battle the Flame Legs in the Burn and retrieve the legendary Helm of Rodoric!",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Guard_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EoinGentleWind_KHR_08.mp3",
