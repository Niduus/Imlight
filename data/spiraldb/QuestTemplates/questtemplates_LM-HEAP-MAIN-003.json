      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, hello there. Did Tracy send you? Busy boy, isn't he? My name is Tessa Truehart. How can I help?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tessa_Truehart_LM-HEAP_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524749,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ask her about the Old One - the frescos and murals that have indicated his Monitoring Stations in past adventures.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-HEAP_143.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524741,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sorry, there's nothing like that here. We're not big on artistic flourishes. You've seen this place; not exactly a thriving society, are we?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tessa_Truehart_LM-HEAP_002.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524749,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Story goes a tentacle monster plucked our ancestors from Lemuria and abandoned them here, cut off from Mana and Lifeforces of other regions.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tessa_Truehart_LM-HEAP_003.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524749,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Why would he do that? Surely, he must have some way of monitoring this experiment.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-HEAP_144.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524741,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Listen, would you do me a favor? Poor Tracy's working himself up about the Gangs. Could you remind him that he still owes me dinner?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tessa_Truehart_LM-HEAP_004.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524749,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "He's skipping dinner again? Sometimes I wish I were a criminal cow or secret font of Mana, then maybe I could get some attention from Mr. Dog Tracy.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tessa_Truehart_LM-HEAP_005.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524749,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Secret font of Mana?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-HEAP_145.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524741,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, yes, Wizard. Years ago, one of the gang bosses - we to this day still don't know which - found one and used it to power up loyal lieutenants.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tessa_Truehart_LM-HEAP_006.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524749,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "All the gangs descended, hurling Firecats like stones, and dividing up the town, enforcing their own corrupt order.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Deer_Scientist_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Tessa_Truehart_LM-HEAP_007.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524749,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "LM-HEAP-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Interesting. Perhaps this mystery boss also discovered secrets of the Old One, like the Water Moles. Let us inquire further with Dog Tracy.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Khrulhu_Nothing_NPC.dds",
                "m_soundFile": "Sound/Dialogue/LM/Dasein_LM-HEAP_146.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1524741,
                "m_cameraName": ""
              }
            ]
          }
        ]
