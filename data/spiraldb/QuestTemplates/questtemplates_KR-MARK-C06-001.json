            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'll honor my brother Aemon by placing his Music Box under the Harmony Tree in Pepper Grass Nook, no?",
            "m_picture": "",
