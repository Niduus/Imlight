            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No, I agree with the Wizard. We can't let the Broken Branch escape with anything. This place here, this hole's how they got in, it's how they'll get out.",
