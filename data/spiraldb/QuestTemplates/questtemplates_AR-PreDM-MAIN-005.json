            "m_soundFile": "Sound/Dialogue/DM_1.590/Tarak_Hadfield_AR-PreDM_021.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So the three of us guard it, like the kid says, and stop any of them from escaping.",
            "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Tarak_Hadfield_AR-PreDM_022.mp3",
