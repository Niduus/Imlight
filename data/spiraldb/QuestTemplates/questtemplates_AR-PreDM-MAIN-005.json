            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Leave the Cursed Repository to me and Mr. Stone.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Miranda_B_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Miranda_Briar_PA_AR-PreDM_005.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not the Cursed Repository! That's where we keep only the most devious, haunted and deadly enchantments.",
            "m_picture": "GUI/NpcPortraits/Portrait_Celestian_Professor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Qyburn_Stellargaze_AR-PreDM_009.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Whatever the lass wants there, it cannae be good. We should get to it at once!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dwarf_Porfessor_A_NPC.dds",
            "m_soundFile": "Sound/Dialogue/DM_1.590/Ignus_Ferric_AR-PreDM_033.mp3",
