        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Galloping Grapefruits! Are those... No, it cannot be!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_016.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562153,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC13_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You there! Come to see your handiwork, Monquistan? What is the meaning of this?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portraits_Unicorn_Guard_A_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Captain_Argento_NV-PUERT_001.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562160,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "How am I to respond to such a rude greeting! How dare you accuse Monquista of treachery!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_017.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562153,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "My good captain, I am as horrified as you! Wizard, go forth and stop these abominations!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_018.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562153,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Los Monos Perdidos</ITALICS> - unholy abominations! No Monquistan would summon them, not even a plantain-worshiping apostate!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_020.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562153,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I forgive your accusation of treason. No apology is required: the stress of seeing these terrors was too much for you to bear.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_021.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562153,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "NV-PUERT-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Silver, my good ally, the most holy of metals! Silver blades will drive them out of this world. But we need silver to coat your weapons!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Monkey_Noble_B_NPC.dds",
                "m_soundFile": "Sound/Dialogue/Don_Manzana_NV-PUERT_022.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1562153,
                "m_cameraName": ""
              }
            ]
          }
        ]
