// /mnt/project-files/imlight/quests/main-quests-arc1/fixgen.py (thread "Check main quests: Arc 1", Niduus 2026-10-31).
// lines: dialog added to a quest ("goal" missing) or a step, under "tag"; "replace" swaps the whole dialog.
// count: how many creatures a defeat step needs. See src/Imlight.CoreLib/WizardData/QuestFixes.cs.
[
  {"quest": "WC-UNICORN-MAIN-003", "tag": "Underway", "lines": [{"persona": "WC-ST01-NPC01_Persona", "text": "Please go speak to Lady Oriel in the Hedge Maze at the end of Unicorn Way.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/CerenNightchant_001_15.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds", "actor": 38121}]},
  {"quest": "WC-UNICORN-MAIN-004", "tag": "Underway", "lines": [{"persona": "WC-ST01-NPC02_Persona", "text": "There is little time to waste. Dispel the Bone Cages and carefully collect Fairy Dust from the Dark Fairies.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/LadyOriel_001_08.mp3", "picture": "GUI/NpcPortraits/Portrait_Seraph_Aerial_B_NPC.dds", "actor": 38123}]},
  {"quest": "WC-UNICORN-MAIN-007", "tag": "Underway", "lines": [{"persona": "WC-ST01-NPC01_Persona", "text": "That evil old tyrant, Rattlebones, has to be in the Archives. Go stop him. Quick!", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/CerenNightchant_001_20.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds", "actor": 38121}]},
  {"quest": "WC-UNICORN-MAIN-008", "tag": "Underway", "lines": [{"persona": "WC-ST01-NPC01_Persona", "text": "If Rattlebones wanted that Tome, you should get it to Argleston in the Library immediately!", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/CerenNightchant_001_26.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Life02.dds", "actor": 38121}]},
  {"quest": "WC-COMMONS-MAIN-003", "tag": "Underway", "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "Go to Olde Town and talk to Sergeant Muldoon about the unrest in Wizard City - there's no time to waste!", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/MerleAmbrose_001_14.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds", "actor": 38168}]},
  {"quest": "WC-OLDE-MAIN-001", "tag": "Underway", "lines": [{"persona": "WC-ST02-NPC01_Persona", "text": "Talk to the Pet and enter the Caretaker's Tower.", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/SeargeantMuldoon_002_04.mp3", "picture": "GUI/NpcPortraits/Human_WCGuard_G.dds", "actor": 38218}]},
  {"quest": "WC-OLDE-MAIN-002C", "tag": "Underway", "lines": [{"persona": "WC-ST02-NPC01_Persona", "text": "Find Nolan Stormgate - if that is his real name - to sort out this business on Cyclops Lane.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/Muldoon_005_06.mp3", "picture": "GUI/NpcPortraits/Human_WCGuard_G.dds", "actor": 38218}]},
  {"quest": "WC-CYCLOPS-MAIN-001", "tag": "Underway", "lines": [{"persona": "WC-ST03-NPC01_Persona", "text": "Hurry! Hurry! Fight the Trolls!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/NolanStormgate_005_08.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Myth02.dds", "actor": 38249}]},
  {"quest": "WC-CYCLOPS-MAIN-002", "tag": "Underway", "lines": [{"persona": "WC-ST03-NPC01_Persona", "text": "I'm sure to make Best Boy after you tell Professor Drake all I've done. Best Boy Myth Wizard Nolan Stormgate, has a ring to it.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/NolanStormgate_005_15.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Myth02.dds", "actor": 38249}]},
  {"quest": "WC-CYCLOPS-MAIN-004", "tag": "Underway", "lines": [{"persona": "WC-ST03-KID01_Persona", "text": "If you don't fight the Warhorns to a standstill, they'll all tackle you when you approach Akilles' Tower.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/ElectraStormcloud_005_06.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Girl_Storm.dds", "actor": 81274}]},
  {"quest": "WC-OLDE-MAIN-002B", "tag": "Underway", "lines": [{"persona": "WC-ST02-NPC01_Persona", "text": "Private Quinn on Firecat Alley may need help, but I don't have any Guards to send as reinforcements. Please go see if he needs any help.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/SeargeantMuldoon_005_03.mp3", "picture": "GUI/NpcPortraits/Human_WCGuard_G.dds", "actor": 38218}]},
  {"quest": "WC-FIRECAT-MAIN-002", "tag": "Underway", "lines": [{"persona": "WC-FIRECAT-NPC01_Persona", "text": "Poor Lizzo FireSpitter is still caught up in the chaos of Firecat Alley. Please, Wizard, you have to find her!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/PrivateQuinn_005_11.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Guard00.dds", "actor": 1521040}]},
  {"quest": "WC-FIRECAT-MAIN-003", "tag": "Underway", "lines": [{"persona": "WC-FIRECAT-NPC02_Persona", "text": "Have you asked that Shelus fellow if he knows how to find the old witch? She's our only hope for saving the Fire Elves.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/LizzoFireSpitter_005_11.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_Lizzo_A_NPC.dds", "actor": 1521043}]},
  {"quest": "WC-FIRECAT-MAIN-004", "tag": "Underway", "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "What's the hold up? Go get a Herkimer Stone from the Rotting Fodder. Or do you prefer the Fire Elves' brains to turn to boiling jelly?", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_14.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}]},
  {"quest": "WC-FIRECAT-MAIN-005", "tag": "Underway", "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "Quit your dawdling! Go get the Equipment from Gloria Krendell. And whatever you do, don't tell her I sent you. I'm SUPPOSED to be banished.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_25.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}]},
  {"quest": "WC-OLDE-MAIN-002A", "tag": "Underway", "lines": [{"persona": "WC-ST02-NPC01_Persona", "text": "There are three wizards on Triton Avenue dealing with the undead incursion. See if you can find them and get them out of there!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/SeargeantMuldoon_002_10.mp3", "picture": "GUI/NpcPortraits/Human_WCGuard_G.dds", "actor": 38218}]},
  {"quest": "WC-TRITON-MAIN-001", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC02_Persona", "text": "I need you to attack the Haunted Minions so I can make a run for the river and find my sister. Please, hurry!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/ArturGryphonbane_002_07.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Boy_Storm02.dds", "actor": 1451938}]},
  {"quest": "WC-TRITON-MAIN-002", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC02-B_Persona", "text": "We've got to find my sister! If you get her Wand from the Lightning Eels, Duncan Grimwater may be able to use it to find Suzie.", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/ArturGryphonbane_002_12.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Boy_Storm02.dds", "actor": 1451951}]},
  {"quest": "WC-TRITON-MAIN-003", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC01-B_Persona", "text": "Bring me Storm Amulets from the Rotting Fodder across the river, and I can do my ritual to find Suzie.", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/DuncanGrimwater_002_12.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds", "actor": 1451941}]},
  {"quest": "WC-TRITON-MAIN-004", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC01-B_Persona", "text": "I need a Lumina Crystal to power my ritual. Blad Raveneye at the Mill can give you one.", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/DuncanGrimwater_002_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds", "actor": 1451941}]},
  {"quest": "WC-TRITON-MAIN-005", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC03_Persona", "text": "My Mill's broken down - go gather up the Cogs and get my Primary Coil back from the Scarlet Screamers, and I'll make you a Lumina Crystal.", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/BladRaveneye_002_05.mp3", "picture": "GUI/NpcPortraits/Human_WCShopKeep_E_NPC.dds", "actor": 1451939}]},
  {"quest": "WC-TRITON-MAIN-006", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC03_Persona", "text": "You have your Lumina Crystal, go do whatever you're going to do with it!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/BladRaveneye_002_11.mp3", "picture": "GUI/NpcPortraits/Human_WCShopKeep_E_NPC.dds", "actor": 1451939}]},
  {"quest": "WC-TRITON-MAIN-007", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC01-B_Persona", "text": "The Harvest Lord has Suzie Gryphonbane imprisoned in Galvanost Tower. It's time for you to rescue her!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/DuncanGrimwater_002_22.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds", "actor": 1451941}]},
  {"quest": "WC-TRITON-MAIN-008", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC05-C_Persona", "text": "Go tell Professor Balestrom the Tempest Nexus is going to explode! He's our only hope!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/SuzieGryphonbane_002_10.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Girl_Storm02.dds", "actor": 1451968}]},
  {"quest": "WC-HAUNTED-MAIN-001", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC06_Persona", "text": "I think you're going to fight Lord Nightshade? Don't know why. You must be curious what death feels like, I guess.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/DaisyWillowmancer_005_07.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_DaisyW_A_NPC.dds", "actor": 1520044}]},
  {"quest": "WC-HAUNTED-MAIN-002", "tag": "Underway", "lines": [{"persona": "WC-TRITON-NPC06_Persona", "text": "You go fight Field Guards. I'll study all the things.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/DaisyWillowmancer_005_13.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Player_DaisyW_A_NPC.dds", "actor": 1520044}]},
  {"quest": "WC-COMMONS-MAIN-004", "tag": "Underway", "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "Look deep down within yourself. The Ghost Energy will guide you to Nightside.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/MerleAmbrose_005_22.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds", "actor": 38168}]},
  {"quest": "WC-COMMONS-MAIN-005", "tag": "Underway", "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "Don't worry about Bartleby. He's stable, just confused. I will take care of him. You focus on reaching Krokotopia.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/MerleAmbrose_005_29.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds", "actor": 38168}]},
  {"quest": "KT-MAIN-C01-001", "tag": "Underway", "lines": [{"persona": "KT-HUB-NPC01_Persona", "text": "If you want to learn about the Order of the Fang, you need to go see Professor Winthrop inside the Pyramid.", "sound": "|Krokotopia|WorldData|Sound/Dialogue/SegeantMajorTalbot_QST_07.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Seargent_Major.dds", "actor": 38224}]},
  {"quest": "KT-PYMHub-C01-001", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC02_Persona", "text": "Can you please go to the Dig Site in the Royal Hall and make rubbings of the Ancient Obelisk there? With them, I can learn more about the Order of the Fang.", "sound": "|Krokotopia|WorldData|Sound/Dialogue/ProfWinthrop_QST_13.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator.dds", "actor": 39228}]},
  {"quest": "KT-PYMHub-C01-002", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC02_Persona", "text": "Biti Nirini's chamber has the ancient tablet we need, and you're the only one who can defeat Kroks in battle to claim the Chamber Key.", "sound": "|Krokotopia|WorldData|Sound/Dialogue/ProfWinthrop_QST_19.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator.dds", "actor": 39228}]},
  {"quest": "KT-PYMHub-C01-003", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC02_Persona", "text": "You must find Biti Nirini, defeat him in battle, and reclaim the missing ancient tablet.", "sound": "|Krokotopia|WorldData|Sound/Dialogue/ProfWinthrop_QST_25.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator.dds", "actor": 39228}]},
  {"quest": "KT-PYMHub-C01-004", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC02_Persona", "text": "Go find my assistant, Malcolm Danforth, and help him find a way to get inside the Palace.  He's in the Excavation Room in the Chamber of Fire.", "sound": "|Krokotopia|WorldData|Sound/Dialogue/ProfWinthrop_QST_30.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator.dds", "actor": 39228}]},
  {"quest": "KT-PYM3-C01-001", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC03_Persona", "text": "Find my partner Robert Lancaster to see if he's found the Key Stone needed to unlock the Palace.", "sound": "|Krokotopia|WorldData|Sound/Dialogue/AssistantDanforth_QST_05.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator06.dds", "actor": 39230}]},
  {"quest": "KT-PYM3-C01-002", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC03_Persona", "text": "If we want to get inside the Palace, we need the Key Stone. Go to the Dig Site in the Royal Hall and search for the missing piece.", "sound": "|Krokotopia|WorldData|Sound/Dialogue/AssistantDanforth_QST_11.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator06.dds", "actor": 39230}]},
  {"quest": "KT-PYM3-C01-003", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC03_Persona", "text": "The Nirini Quartermaster has the other piece of the Key Stone. Without both pieces, we can't get inside the Palace. Go and get it from him!", "sound": "|Krokotopia|WorldData|Sound/Dialogue/AssistantDanforth_QST_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator06.dds", "actor": 39230}]},
  {"quest": "KT-PYM3-C01-004", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC03_Persona", "text": "Go and tell Professor Winthrop that we recovered both pieces of the Key Stone and we can unlock the Palace now.", "sound": "|Krokotopia|WorldData|Sound/Dialogue/AssistantDanforth_QST_22.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator06.dds", "actor": 39230}]},
  {"quest": "KT-PYMHub-C01-007", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC02_Persona", "text": "Head into the Palace.  Meet up with Lieutenant Standish and help him out.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ProfWinthrop_QST_44.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator.dds", "actor": 39228}]},
  {"quest": "KT-PYM2-C01-001", "tag": "Underway", "lines": [{"persona": "KT-PYM2-NPC01_Persona", "text": "Have you found all my soldiers yet? Hurry! Give them the Artifacts or we won't be able to hold off the Kroks.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/LieutenantStandish_QST_06.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Seargent_Major.dds", "actor": 39238}]},
  {"quest": "KT-PYM2-C01-002", "tag": "Underway", "lines": [{"persona": "KT-PYM2-NPC01_Persona", "text": "There are still many Nirini Warriors and Nirini Flame Guardians that need a sound beating. Go and battle more of them.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/LieutenantStandish_QST_11.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Seargent_Major.dds", "actor": 39238}]},
  {"quest": "KT-PYM2-C01-003", "tag": "Underway", "lines": [{"persona": "KT-PYM2-NPC01_Persona", "text": "The attack is on! Defeat Edo Nirini, Nebit Nirini, Shai Nirini, and Akori Nirini.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/LieutenantStandish_QST_15.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Seargent_Major.dds", "actor": 39238}]},
  {"quest": "KT-PYM2-C01-004", "tag": "Underway", "lines": [{"persona": "KT-PYM2-NPC01_Persona", "text": "Report to the Professor. He'll be happy to know of our success and will tell us how to proceed.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/LieutenantStandish_QST_22.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Seargent_Major.dds", "actor": 39238}]},
  {"quest": "KT-PYMHub-C01-005", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC02_Persona", "text": "Head to the Map Room. I'll gather some notes and meet you there. I'm a fast runner, so don't worry about me.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ProfWinthrop_QST_35.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator.dds", "actor": 39228}]},
  {"quest": "KT-PYMHub-C01-006", "tag": "Underway", "lines": [{"persona": "KT-PYMHub-NPC02_Persona", "text": "We can't explore the secret lair of the Order of the Fang without permission from Sergeant Major Talbot. Go speak with him, please.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ProfWinthrop_QST_40.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Excavator.dds", "actor": 39228}]},
  {"quest": "KT-MAIN-C01-002", "tag": "Underway", "lines": [{"persona": "KT-HUB-NPC01_Persona", "text": "Take the boat to Krokosphinx and see if you can find the secret lair of the Order of the Fang.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/SegeantMajorTalbot_QST_10.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Seargent_Major.dds", "actor": 38224}]},
  {"quest": "KT-BAL-C02-001", "tag": "Underway", "lines": [{"persona": "KT-SPHub-NPC02_Persona", "text": "Go to the Krokosphinx and find Shalek the Wise. Do exactly as he says and he will set you on the path to great knowledge.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Alhazred_QST_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Professor_Balance.dds", "actor": 39302}]},
  {"quest": "KT-SPHub-C01-001", "tag": "Underway", "lines": [{"persona": "KT-SPHub-NPC01_Persona", "text": "The Mander Rami awaits you in the Hall of Champions. Go and help him seek General Khaba.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ShalekTheWise_QST_07.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Balance_Professor_Green.dds", "actor": 39285}]},
  {"quest": "KT-SPH2-C01-001", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC01_Persona", "text": "Defeat Sphinx Sokkwi. They must not find General Khaba or our cause will be lost.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Rami_QST_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Yellow_NPC.dds", "actor": 39294}]},
  {"quest": "KT-SPH2-C01-002", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC01_Persona", "text": "Battle Nekhbet in his chamber down the hall for the Seal of the Fang... if you can.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Rami_QST_06.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Yellow_NPC.dds", "actor": 39294}]},
  {"quest": "KT-SPH2-C01-003", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC01_Persona", "text": "Quickly now, $PLAYER_FIRSTNAME$! Run to the Treasure Room and tell General Khaba we must rise up and fight again!", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Rami_QST_10.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Yellow_NPC.dds", "actor": 39294}]},
  {"quest": "KT-SPH2-C02-002", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "I'd bash that Soul Scavenger if I could, but I'm out of strength. Please recover the Coin of Destiny for me from the Soul Scavenger nearby.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_06.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPH2-C02-003", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "Go to Rami and get my sword from him. I will need it in battle.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_12.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPH2-C02-005", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "Collect the Ice Shards from the Glacial Avengers.  I need them for my new weapon.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_19.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPH2-C02-006", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "I need you to win four Spider Carapaces from the Ice Weavers in the Grand Arena.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_23.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPH2-C02-007", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "Collect gemstones in the area.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_26.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPH2-C02-008", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "I need the Leather Straps that the Hall Servants carry.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_29.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPH2-C02-009", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "Defeat the Sokkwi Crushers for a key to the Frozen Forge.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_32.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPH2-C02-001", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "We must confuse the Tut army. Eliminate the Odji Sokkwi and use the Frozen Forge. Then when I have my blade, we can crush the Tuts.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPH2-C02-004", "tag": "Underway", "lines": [{"persona": "KT-SPH2-NPC02_Persona", "text": "Tell Shalek the Wise that I am once again ready to lead the fight against the Tuts.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GeneralKhaba_QST_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Storm_Cloth_Hat_NPC.dds", "actor": 39296}]},
  {"quest": "KT-SPHub-C01-002", "tag": "Underway", "lines": [{"persona": "KT-SPHub-NPC01_Persona", "text": "We must find another member of our Order: Khai Amahte the Great. Please help Ako in the Grand Arena locate this legendary warrior.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ShalekTheWise_QST_12.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Balance_Professor_Green.dds", "actor": 39285}]},
  {"quest": "KT-SPH3-C01-001", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC01_Persona", "text": "Battle Sphinx Gladiators for the Mark of the Gladiator. Then return to me to complete your disguise.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Ako_QST_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Red_NPC.dds", "actor": 39298}]},
  {"quest": "KT-SPH3-C01-002", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC01_Persona", "text": "Enter the Grand Arena and tell Merikara the Arena Master you want to fight Khai Amahte the Great. It's the only way you'll be able to see Khai Amahte.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Ako_QST_07.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Red_NPC.dds", "actor": 39298}]},
  {"quest": "KT-SPH3-C02-001", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "Show me what you have and maybe I'll let you have a go at the Sunbird. But first things first! Defeat a Sokkwi Ripper.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C02-006", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "Seek out the Wild Sunbird and see if you can defeat him! Go to the Bird Gate right away!", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_22.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C02-007", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "Don't worry, those Ice Weavers are usually pretty merciful. Usually...", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_26.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C02-002", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "You're up, short stuff. Get over there and fight Krag Stonechin. To the Sun Gate!", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_07.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C02-008", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "Okay, show us what you have against some of these Stalkers and you'll be ready for the big league! If not, you'll be ready for the undertaker. Either way, the crowd would have loved this show!", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_30.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C02-003", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "If you don't go after Bort Malletmane right now, he might just come over and pulverize you. Do you want that? Then get over there and fight! To the Snake Gate!", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_11.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C02-009", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "Go get those Sokkwi Gougers before they chicken out and run off!", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_34.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C02-004", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "Don't wimp out now! Get over there and fight the Amazing Itennu Sokkwi. The crowd would be cheering for you. To the Moon Gate!", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_15.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C02-005", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC02_Persona", "text": "Find Khai Amahte through that door on the right and put that old Krok out of his misery. It'll be real entertaining! And then you'll have the title and I'll have my coffers filled, well...I would if I had a living audience.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ArenaMaster_QST_19.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Pharoh_Fire_Band_Hair_NPC.dds", "actor": 39300}]},
  {"quest": "KT-SPH3-C03-001", "tag": "Underway", "lines": [{"persona": "KT-SPH3-NPC03_Persona", "text": "Tell Shalek the Wise that the Tuts will cower before Khai Amahte! When I have gathered my allies, I will meet with Shalek, comrade to comrade.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/KhaiAmahte_QST_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Burly_Storm_NPC.dds", "actor": 39366}]},
  {"quest": "KT-SPHub-C01-003", "tag": "Underway", "lines": [{"persona": "KT-SPHub-NPC01_Persona", "text": "We must retrieve the Golden Fang before the Tuts discover its location. Meet me inside the Vault of Ice.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ShalekTheWise_QST_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Balance_Professor_Green.dds", "actor": 39285}]},
  {"quest": "KT-SPHub-C01-004", "tag": "Underway", "lines": [{"persona": "KT-SPHub-NPC01_Persona", "text": "Go to the Emperor's Retreat. I'll be waiting for you there.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ShalekTheWise_QST_23.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Balance_Professor_Green.dds", "actor": 39285}]},
  {"quest": "KT-SPHUB-C01-005", "tag": "Underway", "lines": [{"persona": "KT-SPHub-NPC01_Persona", "text": "Join us in the Balance School, $PLAYER_FIRSTNAME$. There is much to discuss.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/ShalekTheWise_QST_31.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Balance_Professor_Green.dds", "actor": 39285}]},
  {"quest": "KT-MAIN-C01-003", "tag": "Underway", "lines": [{"persona": "KT-HUB-NPC01_Persona", "text": "Go and find Hetch Al'Dim. He is the only one who knows how to get into the Tomb of Storms.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/SegeantMajorTalbot_QST_14.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Seargent_Major.dds", "actor": 38224}]},
  {"quest": "KT-CRYHub-C01-001", "tag": "Underway", "lines": [{"persona": "KT-CRYHub-NPC01_Persona", "text": "Have you found the first Cipher? You need to take it from the head of the Ahnic family deep in their tomb.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GhostOfKrokhotep_QST_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Tut_Ice_Ghost.dds", "actor": 39345}]},
  {"quest": "KT-CRYHub-C01-002", "tag": "Underway", "lines": [{"persona": "KT-CRYHub-NPC01_Persona", "text": "Find the head of the Djeserit family and take the second part of the Cipher.  As a spirit, I can't take it myself.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GhostOfKrokhotep_QST_07.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Tut_Ice_Ghost.dds", "actor": 39345}]},
  {"quest": "KT-CRYHub-C01-003", "tag": "Underway", "lines": [{"persona": "KT-CRYHub-NPC01_Persona", "text": "You must go through the Karanahn Barracks and into the palace to get the Temple Key.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GhostOfKrokhotep_QST_11.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Tut_Ice_Ghost.dds", "actor": 39345}]},
  {"quest": "KT-CRYHub-C01-004", "tag": "Underway", "lines": [{"persona": "KT-CRYHub-NPC01_Persona", "text": "The Gatekeeper inside the Temple of Storms will guide you to Krokopatra. Defeat her and the Krokonomicon will be yours!", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GhostOfKrokhotep_QST_19.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Tut_Ice_Ghost.dds", "actor": 39345}]},
  {"quest": "KT-CRYHub-C01-005", "tag": "Underway", "lines": [{"persona": "KT-CRYHub-NPC01_Persona", "text": "Return to the surface and report your success.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/GhostOfKrokhotep_QST_25.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Krok_Tut_Ice_Ghost.dds", "actor": 39345}]},
  {"quest": "KT-MAIN-C01-004", "tag": "Underway", "lines": [{"persona": "KT-HUB-NPC01_Persona", "text": "If you want to follow the Krokonomicon to where it was taken, you must travel to Marleybone and speak with Private Kinchley.", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/SegeantMajorTalbot_QST_19.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Seargent_Major.dds", "actor": 38224}]},
  {"quest": "WC-MAIN-C01-011", "tag": "Underway", "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "Use the Spiral Key to travel to MooShu and warn the Emperor  to guard the Key to Dragonspyre.", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_57.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds", "actor": 38168}]},
  {"quest": "WC-MAIN-C01-012", "tag": "Underway", "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "Talk to Professor Drake at the Myth School. He can advise you on how to stop Malistaire.", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_61.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds", "actor": 38168}]},
  {"_": "The Cure: the offer had Which Craft?s lines", "quest": "WC-FIRECAT-MAIN-006", "tag": "Prep", "replace": true, "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "The Curative Intonation Potion will work similarly to the initial curse, so you'll need to administer it to an influential Fire Elf.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_30.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}, {"persona": "WC-FIRECAT-NPC04_Persona", "text": "Alicane SwiftArrow is the most famous Fire Elf actor alive. Once he's cured, just explain to him that it's up to him to pass the cure on to his people.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_31.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}, {"persona": "WC-FIRECAT-NPC04_Persona", "text": "You'll find Alicane in the Fire Globe Theater. I've imbued your wand with the Curative Potion. Now go give Alicane a good thwacking!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_32.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}]},
  {"quest": "WC-FIRECAT-MAIN-006", "tag": "Underway", "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "Alicane SwiftArrow is in the Fire Globe Theater, practically begging for you to hit him with that Curative Intonation. Break a leg! Oh, just not his.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_33.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}]},
  {"_": "Firecats In The Bag: the offer had Which Craft?s lines", "quest": "WC-FIRECAT-MAIN-007", "tag": "Prep", "replace": true, "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "Finally! This whole ordeal has made me realize that I don't miss working with students as much as I'd previously thought. No offense.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_35.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}, {"persona": "WC-FIRECAT-NPC04_Persona", "text": "Run along then, dear. And if you would be so kind as to omit my name from your official reporting to the City Guard, I'd appreciate it. Ta-ta!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_36.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}]},
  {"quest": "WC-FIRECAT-MAIN-007", "tag": "Underway", "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "Aw, c'mon now kid. I helped you out. Return the favor and kindly leave me alone forever.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_37.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}]},
  {"_": "Which Hunt?: Gretta meets you in the Hermits House", "quest": "WC-FIRECAT-MAIN-003", "goal": "4_WizardQuestGoals_Explore", "tag": "Completion", "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "Gah-wha?!? How dare you interrupt an old woman from her stories? Did Ambrose send you to banish me? Well I'm not going without a fight!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_01.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 0}, {"persona": "WC-FIRECAT-NPC04_Persona", "text": "What's that? Corrupted Fire Elves? Murderous Magmamen? The Undead have spilled from Dark Cave? They need the Witch's help?", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_02.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 0}, {"persona": "WC-FIRECAT-NPC04_Persona", "text": "First off, I'm one hundred percent not that Witch. Or any witch for that matter. I'm an Alchemist. Secondly, this sounds like a City Guard job.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_03.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 0}, {"persona": "WC-FIRECAT-NPC04_Persona", "text": "The Guard is pinned down? *Siiigh*. Typical. Alright then, I'll help. But I need to know exactly what we're dealing with here.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_04.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 0}, {"persona": "WC-FIRECAT-NPC04_Persona", "text": "Take this special vial and collect a sample of Magma from those Magmamen you mentioned for me to analyze. We'll go from there.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_05.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 0}]},
  {"quest": "WC-FIRECAT-MAIN-005", "goal": "3_WizardQuestGoals_00000678", "tag": "Completion", "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "Ooo, that equipment is nice enough for an amateur like you to perform the transmutation. Go on. Just place the Herkimer Stone on the crucible.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_27.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}]},
  {"quest": "WC-FIRECAT-MAIN-005", "goal": "4_WizardQuestGoals_UseItem", "tag": "Completion", "lines": [{"persona": "WC-FIRECAT-NPC04_Persona", "text": "There we are. Now bring me the potion and let me check your work.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GrettaDarkkettle_005_28.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_GrettaDK_A_NPC.dds", "actor": 1521048}]},
  {"quest": "WC-OLDE-MAIN-002B", "goal": "Goal", "tag": "Completion", "lines": [{"persona": "WC-FIRECAT-NPC01_Persona", "text": "HALT! Oh, you're that Unicorn Way Hero Wizard, aren't you? What? Sergeant Muldoon sent you? WHEW! I need all the help I can get.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/PrivateQuinn_005_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Guard00.dds", "actor": 0}]},
  {"quest": "WC-OLDE-MAIN-002A", "goal": "Goal", "tag": "Completion", "lines": [{"persona": "WC-TRITON-NPC02_Persona", "text": "You there! HELP!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/ArturGryphonbane_002_01.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Boy_Storm02.dds", "actor": 0}]},
  {"quest": "WC-TRITON-MAIN-005", "goal": "4_WizardQuestGoals_Explore", "tag": "Completion", "lines": [{"persona": "WC-TRITON-NPC03_Persona", "text": "Alright we're ready! Here, just pull this lever and we'll charge that Lumina Crystal right up!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/BladRaveneye_002_07.mp3", "picture": "GUI/NpcPortraits/Human_WCShopKeep_E_NPC.dds", "actor": 1451939}]},
  {"quest": "WC-TRITON-MAIN-005", "goal": "5_WizardQuestGoals_UseItem", "tag": "Completion", "lines": [{"persona": "WC-TRITON-NPC03_Persona", "text": "Ha! Well done, Wizard!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/BladRaveneye_002_08.mp3", "picture": "GUI/NpcPortraits/Human_WCShopKeep_E_NPC.dds", "actor": 1451939}]},
  {"quest": "WC-COMMONS-MAIN-004", "goal": "Goal", "tag": "Completion", "lines": [{"persona": "WC-RVW-DeathTree_Persona", "text": "A Wizard? It has been so long. Have you come seeking the School of Death Magic? You have found it. And much more.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/TreeMortis_005_01.mp3", "picture": "GUI/NpcPortraits/Portrait_Tree_Mortis_A_NPC.dds", "actor": 0}]},
  {"_": "Nightside: Malistaire in the Death School", "quest": "WC-COMMONS-MAIN-004", "goal": "Goal 2", "tag": "Completion", "lines": [{"persona": "WC-NIS-NPC01_Persona", "text": "Master, what about this book: \"The Order of the Fang was born of... um...\" some word that starts with K...", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/ProfDworgyn_005_01.mp3", "picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds", "actor": 0}, {"persona": "WC_Malistaire_NPC_Persona", "text": "Give me that! \"Krokotopia,\" you dunce. And I knew that already. I've been scouring the place for ages. I came back here to find WHERE in Krok...", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/Malistaire_005_01.mp3", "picture": "", "actor": 0}, {"persona": "WC_Malistaire_NPC_Persona", "text": "Oh... I see. Yes, this book does indeed have the answer I seek.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/Malistaire_005_02.mp3", "picture": "", "actor": 0}, {"persona": "WC_Malistaire_NPC_Persona", "text": "So you're too late, Wizard! Yes, I remember you. You fought my minions, thwarted all my diversions, but it doesn't matter. I've already won.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/Malistaire_005_03.mp3", "picture": "", "actor": 0}, {"persona": "WC-NIS-NPC01_Persona", "text": "That was very dramatic. It's just a book. Hello, there. I'm Dworgyn, Caretaker of the Death School. What's your name?", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/ProfDworgyn_005_02.mp3", "picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds", "actor": 0}]},
  {"quest": "DS-LIB1-C01-008", "goal": "Goal 4", "tag": "Completion", "lines": [{"persona": "DS-LIB1-NPC05_Persona", "text": "You defeated him! Good show, there! I'm Aurek Blazeburner... I built this place. I was rooting for you... but couldn't do anything to help. Not that you needed any assistance? Ha!", "sound": "|DragonSpire|WorldData|Sound/Dialogue/AurekBlazeburner_QST_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_2_Ghost_NPC.dds", "actor": 126757}, {"persona": "DS-LIB1-NPC05_Persona", "text": "What a system I designed... with one fatal flaw. It kept enemies out, but for those summoned inside the city! We had all these gates, but were defenseless.", "sound": "|DragonSpire|WorldData|Sound/Dialogue/AurekBlazeburner_QST_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_2_Ghost_NPC.dds", "actor": 126757}, {"persona": "DS-LIB1-NPC05_Persona", "text": "If you still want a Portal Stone, the Stone Keeper should have one. I've been out of touch for too long... you must ask someone else where to find him.", "sound": "|DragonSpire|WorldData|Sound/Dialogue/AurekBlazeburner_QST_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_2_Ghost_NPC.dds", "actor": 126757}]},
  {"quest": "DS-NEC1-C02-002", "goal": "Goal 3", "tag": "Completion", "lines": [{"persona": "DS-NEC1-NPC02_Persona", "text": "Dragon Rider Skyblade! It is Kimerith Windhammer, here in this crystal. I brought your old reins! My thanks to $PLAYER_FIRSTNAME$, who made it possible.", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/KimerithWindhammer_QST_12.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_drake_Ghost_NPC.dds", "actor": 126313}, {"persona": "DS-NEC1-NPC04_Persona", "text": "Well met, Kimerith Windhammer! It has been too long, and I have missed you greatly. You see, $PLAYER_FIRSTNAME$, it's never quite clear who holds the reins when you're a Dragon Rider.", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/TomarSkyblade_QST_06.mp3", "picture": "", "actor": 126315}, {"persona": "DS-NEC1-NPC04_Persona", "text": "Thank you for reuniting me with my oldest, dearest friend Kimerith!", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/TomarSkyblade_QST_07.mp3", "picture": "", "actor": 126315}]},
  {"quest": "DS-ACAD2-C01-007", "goal": "Goal", "tag": "Completion", "lines": [{"persona": "DS-ACAD2-NPC01_Persona", "text": "That's how to do it! Now ignite the forge and it'll begin to heat up.", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/VidorDrakesmith_QST_34.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_M_warrior_soldier_3_Ghost_NPC.dds", "actor": 126326}]},
  {"quest": "MS-WAR1-C01-003", "goal": "Goal 3", "count": 3},
  {"quest": "MS-WAR2-C02-002", "goal": "Goal", "count": 4},
  {"quest": "DS-ACAD1-C02-002", "goal": "Goal", "count": 4},
  {"_": "Boss lines from the rebuilt quest, for Bastilla Gravewynd (the zone trigger only has the old quest's speech)", "quest": "WC-FIRECAT-MAIN-004", "goal": "3_WizardQuestGoals_Explore", "tag": "Completion", "lines": [{"persona": "", "name": "Bastilla Gravewynd", "text": "At last! I've been eagerly awaiting a review of the performance I gave for the Fire Elves. What, are you not a fan? Well, Malistaire is.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/BastillaGravewynd_005_01.mp3", "picture": "GUI/NpcPortraits/Portrait_Banshee_Stepsister_A_Ghost_MOB.dds", "actor": 0}, {"persona": "", "name": "Bastilla Gravewynd", "text": "None of you wretched living creatures' opinions will matter once the Dark Master's plan is fulfilled. And there's nothing you can do about it!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/BastillaGravewynd_005_02.mp3", "picture": "GUI/NpcPortraits/Portrait_Banshee_Stepsister_A_Ghost_MOB.dds", "actor": 0}]},
  {"quest": "WC-FIRECAT-MAIN-004", "goal": "4_WizardQuestGoals_Kill", "tag": "Completion", "lines": [{"persona": "", "name": "Bastilla Gravewynd", "text": "Brrrwaaaaaaaaaaaaahh!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/BastillaGravewynd_005_05.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Banshee_Stepsister_A_NPC.dds", "actor": 0}, {"persona": "", "name": "Bastilla Gravewynd", "text": "How dare you upstage my comeback performance? It was going so well too! I laughed. I cried. It was better than <ITALICS>Firecats!</ITALICS>", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/BastillaGravewynd_005_03.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Banshee_Stepsister_A_NPC.dds", "actor": 0}, {"persona": "", "name": "Bastilla Gravewynd", "text": "Enjoy this day, whelp. For when you bear witness to Malistaire's malum opus, then you will be sorry. This entire wretched city will be sorry!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/BastillaGravewynd_005_04.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Banshee_Stepsister_A_NPC.dds", "actor": 0}]},
  {"_": "Boss lines from the rebuilt quest, for Alicane Swiftarrow (the zone trigger only has the old quest's speech)", "quest": "WC-FIRECAT-MAIN-006", "goal": "1_WizardQuestGoals_Explore", "tag": "Completion", "lines": [{"persona": "", "name": "Alicane Swiftarrow", "text": "Firefrorefriddle! The greatest magicians have something to learn. Firefrorefriddle! Wizard City must BURN! Firefrorefriddle! Whoohoo! Aahaha!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/AlicaneSwiftarrow_005_01.mp3", "picture": "GUI/NpcPortraits/Portrait_Elf_Fire_B_MOB.dds", "actor": 0}]},
  {"_": "Boss lines from the rebuilt quest, for the Harvest Lord (the zone trigger only has the old quest's speech)", "quest": "WC-TRITON-MAIN-007", "goal": "1_WizardQuestGoals_Explore", "tag": "Completion", "lines": [{"persona": "", "name": "Harvest Lord", "text": "Ah, another soul to harvest! I knew my little prisoner would draw more to me, like flies to honey.", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/HarvestLord_002_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Scarecrow.dds", "actor": 0}, {"persona": "", "name": "Harvest Lord", "text": "Wait! My dark Master warned me about you. Ha! Imagine the reward he will give me when I present him your very soul!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/HarvestLord_002_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Scarecrow.dds", "actor": 0}]},
  {"quest": "WC-TRITON-MAIN-007", "goal": "2_WizardQuestGoals_Kill", "tag": "Completion", "lines": [{"persona": "", "name": "Harvest Lord", "text": "Ahhh, I am beaten, but my Master's grand design is nearly complete! Triton Avenue is doomed! Hahahahaha!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/HarvestLord_002_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Scarecrow.dds", "actor": 0}]},
  {"_": "Boss lines from the rebuilt quest, for Sergeant Skullsplitter (the zone trigger only has the old quest's speech)", "quest": "WC-TRITON-SIDE-008", "goal": "Goal", "tag": "Completion", "lines": [{"persona": "", "name": "Sergeant Skullsplitter", "text": "So, you've come for the scrapbook that belonged to Malistaire's wife, eh? Pity she caught that cold and died...", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/SergeantSkullsplitter_ZN_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_SkeletonHooded_Orange.dds", "actor": 0}, {"persona": "", "name": "Sergeant Skullsplitter", "text": "Well, I won't allow you to have it! I will deny him any kindness after what he denied me in life!", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/SergeantSkullsplitter_ZN_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_SkeletonHooded_Orange.dds", "actor": 0}, {"persona": "", "name": "Sergeant Skullsplitter", "text": "As for you, Wizard... prepare to join the ranks of the Undead and serve me!", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/SergeantSkullsplitter_ZN_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_SkeletonHooded_Orange.dds", "actor": 0}]},
  // Creature lines the capture missed (Wizard City audit, Niduus 2026-11-02): what a boss or creature says when you walk in, or after the fight.
  {"quest": "WC-CYCLOPS-MAIN-001", "goal": "1_WizardQuestGoals_Kill", "tag": "Completion", "lines": [{"persona": "", "name": "Lumbering Troll", "text": "You fight good. You not as easy to capture as other students were. Now, General Akillies let Trolls go hungry.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/LumberingTroll_005_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Troll_Green.dds", "actor": 0}]},
  {"quest": "WC-CYCLOPS-MAIN-003", "goal": "Goal", "tag": "Completion", "lines": [{"persona": "", "name": "Cyclopes Legionnaire", "text": "All right, the students are in the Dark Cave. We had the Trolls deliver them... cause there's nightmares in there no sane Cyclops can endure.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/Cyclops_005_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Cyclops_Blue.dds", "actor": 0}]},
  {"quest": "WC-CYCLOPS-MAIN-003", "goal": "Goal 2", "tag": "Completion", "lines": [{"persona": "", "name": "Rotting Fodder", "text": "Fine, take the Talisman. Free the miscreants. But you will all be chow for the Great One, whose gaze enthralls and whose teeth destroy.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/RottingFodderB_005_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Ghoul_Purple.dds", "actor": 0}]},
  {"quest": "WC-CYCLOPS-MAIN-004", "goal": "1_WizardQuestGoals_Kill", "tag": "Completion", "lines": [{"persona": "", "name": "Warhorn", "text": "Hmm. You won't get past Colonel Romulus anyway. You just wasted your time.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/Warhorn_005_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Minotaur.dds", "actor": 0}]},
  {"quest": "WC-FIRECAT-MAIN-002", "goal": "2_WizardQuestGoals_Kill", "tag": "Completion", "lines": [{"persona": "", "name": "Fire Elf Hunter", "text": "Firefrorefiddle! Burnt out ends of smoky days. The stale cold smell of morning! Firefrorefiddle! Aaaaahhh!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/FireElfA_005_01.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Fire_Elf.dds", "actor": 0}]},
  {"quest": "WC-FIRECAT-MAIN-003", "goal": "2_WizardQuestGoals_Kill", "tag": "Completion", "lines": [{"persona": "", "name": "Fire Elf Pathfinder", "text": "Firefrorefiddle! As he loves to tell. Firefrorefiddle! The Fiend of the Fell! Firefrorefiddle! Firefrorefiddle! Waaaaahhh!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/FireElfB_005_01.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Fire_Prince_NPC.dds", "actor": 0}]},
  {"quest": "WC-FIRECAT-MAIN-004", "goal": "1_WizardQuestGoals_KillCollect", "tag": "Completion", "lines": [{"persona": "", "name": "Rotting Fodder", "text": "Ooo! Ahh! Take our Herkimer Stone. We'll dig up another to record our sickened beats upon.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/RottingFodderA_005_01.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Ghoul_Base_C_NPC.dds", "actor": 0}]},
  {"quest": "WC-STRM-C03-003", "goal": "1_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "name": "Typhoon Kraken", "text": "You are a worthy opponent and becoming more powerful.  May your training go well.", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/Kraken_QST_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Kracken.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C02-001", "goal": "2_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "name": "Tower Constable", "text": "Trespasser! Get them!", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/RiverclawGuard_GH2_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Crab_Guard_Mob.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C03-001", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "name": "Captain Jonah", "text": "What’s this? There’s a curfew on, by royal decree of the King. Guards, arrest this wizard!", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/CaptainJonah_GH2_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_03.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C03-002", "goal": "1_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "name": "Riverclaw Guard", "text": "Arrrghghgh! No more! I’ll talk. The King holds the key to the prison in the White Tower.", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RiverclawGuard_GH2_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Sea_monster_05.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C04-001", "goal": "1_WizardQuestGoalsKillCollect", "tag": "Completion", "lines": [{"persona": "", "name": "Riverclaw Guard", "text": "No! We love our crumpets!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RiverclawGuard_GH2_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Sea_monster_05.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C06-003", "goal": "1_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "name": "Riverclaw Guard", "text": "Arrrghghgh! No more! The Crab King is held beyond the Alcazar, in the depths of the Wailing Cavern.", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RiverclawGuard_GH2_04.mp3", "picture": "GUI/NpcPortraits/Portrait_Seamonster_Base_A_MOB.dds", "actor": 0}]},
  {"quest": "WC-UNICORN-MAIN-002", "goal": "1_WizardQuestGoals_Kill", "tag": "Completion", "lines": [{"persona": "", "name": "Skeletal Pirate", "text": "Yarrrrgh! Parley! Parley! Ye got guts, little Wizard, more'n us to be sure, but ye be no match for that which rattles in the Darkness! Bwaharhar!", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/SkeletalPirate_001_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Skeletal_Pirate.dds", "actor": 0}]},
  {"quest": "WC-UNICORN-MAIN-004", "goal": "5_WizardQuestGoals_KillCollect", "tag": "Completion", "lines": [{"persona": "", "name": "Dark Fairy", "text": "Oh, I could feel the Darkness down in my bones, but now that terrible cloud has been lifted! Oh, thank you, thank you, thank you!", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Fairy_001_01.mp3", "picture": "GUI/NpcPortraits/Fairy_DarkMinion_MOB.dds", "actor": 0}]},
  {"quest": "WC-OLDE-MAIN-002B", "goal": "Goal 2", "tag": "Completion", "lines": [{"persona": "", "name": "Haunted Minion", "text": "Truce! We'll keep to this corner of the street. But we're not going back in the Dark Cave. It's spooky in there.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/HauntedMinion_005_01.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Golem_Wood_B_NPC.dds", "actor": 0}]},
  {"quest": "WC-TRITON-MAIN-005", "goal": "2_WizardQuestGoals_KillCollect", "tag": "Completion", "lines": [{"persona": "", "name": "Scarlet Screamer", "text": "Ah, bebother this soggy place, and bebother you! If this Coil's so precious to you, take it!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/Banshee_002_01.mp3", "picture": "GUI/NpcPortraits/Portrait_Banshee_Screamer_A_MOB.dds", "actor": 0}]},
  {"quest": "WC-DETH-C02-002", "goal": "2_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "name": "NightStalker", "text": "What is this?  A visitor?  You'll never get the Scroll of the Elder Seer!", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/NightStalker_QST_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_GhoulGrave_Green.dds", "actor": 0}]},
  {"quest": "WC-MidEM-MAIN-002", "goal": "10_WizardQuestGoals00000253", "tag": "Completion", "lines": [{"persona": "", "name": "The Pestilence", "text": "*Sniiiiff* How's this? You've the smell of a delicious Tree, but not the look of one. Perhaps a bite or two of your bark will help me understand.", "sound": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Pestilence_EM2_01.mp3", "picture": "GUI/NpcPortraits/Portrait_Vapor_Monster_B_MOB.dds", "actor": 0}]},
  {"quest": "WC-MidEM-MAIN-002", "goal": "11_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "name": "The Pestilence", "text": "Aahh! What kind of Tree fights back?!?", "sound": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Pestilence_EM2_02.mp3", "picture": "GUI/NpcPortraits/Portrait_Vapor_Monster_B_MOB.dds", "actor": 0}]},
  {"quest": "WC-PreMR-MAIN-001", "goal": "6_WizardQuestGoals00000790", "tag": "Completion", "lines": [{"persona": "", "name": "Duncan Grimwater", "text": "So it's you - the Headmaster's little pet. Been a long time, but I always knew we'd cross paths again. You've grown in power... I have too.", "sound": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DuncanGrimwater_MIR_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02_MOB.dds", "actor": 0}, {"persona": "", "name": "Duncan Grimwater", "text": "My associates now make Ambrose look like a hedge wizard. Perhaps you've heard of... the Cabal? They have agents everywhere - even Wizard City.", "sound": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DuncanGrimwater_MIR_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02_MOB.dds", "actor": 0}, {"persona": "", "name": "Duncan Grimwater", "text": "After this, I'll be a full-fledged member. See, they detected an intruder here and sent me. That journal's not going anywhere... neither are you!", "sound": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DuncanGrimwater_MIR_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02_MOB.dds", "actor": 0}]},
  {"quest": "WC-PreMR-MAIN-001", "goal": "7_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "name": "Duncan Grimwater", "text": "Oh, now you've really done it. You think you won here? You have no idea. You crossed the Cabal! Oh yeah. You'll hear from us again!", "sound": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DuncanGrimwater_MIR_04.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Boy_Death02.dds", "actor": 0}]},
  {"quest": "WC-ICE-C02-001", "goal": "6_LocateStatue", "tag": "Completion", "lines": [{"persona": "", "name": "Giant", "text": "You have proven that you are worthy to be in the School of Ice!", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/FrostGiant_QST_07.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Frost_Giant.dds", "actor": 0}, {"persona": "", "name": "Ice Blade", "text": "I will now freeze your Water Athame to aid you in your quest.", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/FrostGiant_QST_08.mp3", "picture": "GUI/QuestButtons/Quest_Ice_Blade.dds", "actor": 0}, {"persona": "", "name": "Giant", "text": "Now, you must take it to one who knows the ancient arts. Go now to Kelvin.", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/FrostGiant_QST_09.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Frost_Giant.dds", "actor": 0}]},
  // Arc 1 dialog smoke test (Niduus 2026-11-02): story lines the capture missed, placed by
  // /mnt/project-files/imlight/quests/main-quests-arc1/dialog-audit/gen.py from spec.txt. "replace" keeps the captured
  // lines it lists (camera, animations) and puts them in the listed order.
  {"quest": "CL-CAMP-C01-004", "goal": "1_WizardQuestGoals00000018", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You find a small piece of shell that looks like it came from a crab. </ITALICS>", "sound": "|Celestia|WorldData|Sound/Dialogue/Narrator_CEL_40.mp3", "picture": "GUI/QuestButtons/Quest_CL_crab_shell.dds", "actor": 0, "name": "Broken Piece of Shell"}]},
  {"quest": "CL-CAMP-C01-004", "goal": "2_WizardQuestGoals00000018", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You find a golden pocket watch. It looks strangely familiar. Have you seen this before? </ITALICS>", "sound": "|Celestia|WorldData|Sound/Dialogue/Narrator_CEL_41.mp3", "picture": "GUI/QuestButtons/Quest_CL_golden_watch.dds", "actor": 0, "name": "Gold Pocket Watch"}]},
  {"quest": "CL-CAMP-C01-004", "goal": "3_WizardQuestGoals00000018", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You find a tiny piece of rubble with a stone carving on it, part of a larger stone building. </ITALICS>", "sound": "|Celestia|WorldData|Sound/Dialogue/Narrator_CEL_42.mp3", "picture": "GUI/QuestButtons/Quest_CL_carved_rubble.dds", "actor": 0, "name": "Carved piece of rubble"}]},
  {"quest": "CL-CAMP-C01-004", "goal": "7_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "Who’s this? An intruder! Let me get my claws around you!", "sound": "|Celestia|WorldData|Sound/Dialogue/OptioAgenor_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_02.dds", "actor": 0, "name": "Optio Agenor"}]},
  {"quest": "CL-CAMP-C01-004", "goal": "8_WizardQuestGoalsKillCollect", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The Crustacean drops a big piece of stone. It looks familiar... like it belongs to the portal back in the Celestia Base Camp. </ITALICS>", "sound": "|Celestia|WorldData|Sound/Dialogue/Narrator_CEL_43.mp3", "picture": "GUI/QuestButtons/Quest_CL_astral_portal_relic_star.dds", "actor": 0, "name": "First Portal Piece"}]},
  {"quest": "CL-CAMP-C01-006", "goal": "2_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You replace the missing pieces of the broken portal. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_44.mp3", "picture": "GUI/QuestButtons/Use_StarTemple_Gate.dds", "actor": 0}]},
  {"quest": "CL-CAMP-C04-001", "goal": "1_TakeRubbing", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You follow West’s instructions and make a rubbing of the inscriptions on the strange stone tablet. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_54.mp3", "picture": "GUI/QuestButtons/Quest_CL_Waterbreathing_Artifact.dds", "actor": 0, "name": "Water Breathing Device"}]},
  {"quest": "CL-CAMP-C04-002", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You speak the Celestian words, and as you do so, you feel a strange change coming over you. The feeling soon passes and you feel normal again. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_55.mp3", "picture": "GUI/QuestButtons/Quest_CL_Waterbreathing_Artifact.dds", "actor": 0, "name": "Water Breathing Device"}]},
  {"quest": "CL-CRAB-C01-004", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "Who’sa that? Iffa the Crustaceansa sent’cha, I’ma gonna senda you home... inna can!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Nuncio_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Angler_Boss.dds", "actor": 0, "name": "Nuncio"}]},
  {"quest": "CL-CRAB-C02-003", "tag": "Prep", "lines": [{"persona": "", "text": "<ITALICS>You eat the sea-mold. It smells terrible, and you feel a little sick... and now you feel a lot sick. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_61.mp3", "picture": "GUI/QuestButtons/Quest_CL_sea_mold.dds", "actor": 0, "name": "Sea Mold"}, {"persona": "CL-CRAB-NPC04_Persona", "text": "Great! I can see from your face that you’re ready to rumble! My men will sound the shell horns to announce you’re on your way!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/SenatorXanthus_CEL_14.mp3", "picture": "", "actor": 225851}]},
  {"quest": "CL-CRAB-C02-003", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "What’sa that smell? I heared sumna puny little Wizard froma da surface is a gonna defeat me. Lets a see ‘em try!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Glauco_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Angler_Boss.dds", "actor": 0, "name": "Glauco"}]},
  {"quest": "CL-CRAB-C02-003", "goal": "2_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "Ya got the wrong guy! I was set up by the Shadow Weavers. Dey was a callin’ the shots! I was a just a patsy!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Glauco_CEL_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Angler_Boss.dds", "actor": 0, "name": "Glauco"}]},
  {"quest": "CL-CRAB-C03-003", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>No sign of Acastus Hexfin here. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_62.mp3", "picture": "GUI/QuestButtons/Quest_CL_Terrace.dds", "actor": 0, "name": "Terrace"}]},
  {"quest": "CL-CRAB-C03-003", "goal": "2_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS> Acastus Hexfin isn’t here, either. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_63.mp3", "picture": "GUI/QuestButtons/Quest_CL_CrystalTower.dds", "actor": 0, "name": "Mezzanine"}]},
  {"quest": "CL-CRAB-C03-003", "goal": "3_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>No sign of Acastus Hexfin here. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_64.mp3", "picture": "GUI/QuestButtons/Location_CL_Senate_Door.dds", "actor": 0, "name": "Concourse"}]},
  {"quest": "CL-CRAB-C03-003", "goal": "4_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "Did those waterlogged old buccaneers send you after their compass? I’ll send you back where you came from!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/AcastusHexfin_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Shark_Warrior_01.dds", "actor": 0, "name": "Acastus Hexfin"}]},
  {"quest": "CL-CRAB-C04-002", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "The scent of wizardry is on the current... soon there will be blood in the water!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PraetorMako_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Shark_King.dds", "actor": 0, "name": "Praetor Mako"}]},
  {"quest": "CL-CRAB-C04-002", "goal": "2_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>On his defeat, Praetor Mako drops a piece of stone embossed with the Sun... a piece of the Solarium portal stone! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_65.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Shark_King.dds", "actor": 0, "name": "Praetor Mako"}]},
  {"quest": "CL-CRAB-C05-001", "goal": "2_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The Pisceans confess that they’ve been locked out themselves. A group of strange pirates has taken the Barbican! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_66.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Shark_Warrior_02.dds", "actor": 0, "name": "Piscean"}]},
  {"quest": "CL-CRAB-C05-001", "goal": "3_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>This pirate doesn’t know much. He tells you to talk to his leader, Lieutanant Dafoe. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_67.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Undead_Skinny_Pirate.dds", "actor": 0, "name": "Undead Pirate"}]},
  {"quest": "CL-CRAB-C05-002", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The portal is finally complete. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_68.mp3", "picture": "GUI/QuestButtons/Use_StarTemple_Gate.dds", "actor": 0, "name": "Sun Portal"}]},
  {"quest": "CL-DIST-C01-001", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The monolith is ancient, but upon closer examination, the broken edges look fairly fresh. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_69.mp3", "picture": "GUI/QuestButtons/Quest_CL_broken_monolith.dds", "actor": 0, "name": "Damaged Monolith"}]},
  {"quest": "CL-DIST-C01-003", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You treat the power motes within the Star Forge. In short order, they’re ready for use. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_70.mp3", "picture": "GUI/QuestButtons/Quest_CL_star_forge.dds", "actor": 0, "name": "Star Forge"}]},
  {"quest": "CL-DIST-C01-004", "goal": "2_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The lesson continues for quite a while, teaching you about the nature of the worlds of the Spiral, the stars, and the Sun. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_73.mp3", "picture": "GUI/QuestButtons/Quest_CL_Device_port.dds", "actor": 0, "name": "Configuration Preceptor"}, {"persona": "", "text": "<ITALICS>So much to learn... and then the lesson ends. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_74.mp3", "picture": "GUI/QuestButtons/Quest_CL_Device_port.dds", "actor": 0, "name": "Configuration Preceptor"}]},
  {"quest": "CL-DIST-C01-004", "goal": "3_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The Preceptor has a great deal to say about all manner of conflict, from wars to magic duels. Eventually, the lesson ends. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_72.mp3", "picture": "GUI/QuestButtons/Quest_CL_war_port.dds", "actor": 0, "name": "Preceptor of Conflict"}]},
  {"quest": "CL-DIST-C01-004", "goal": "4_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>This goes on for a while. All manner of schematics, plans, and diagrams flash before your eyes, until at last the lesson ends. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_71.mp3", "picture": "GUI/QuestButtons/Quest_CL_Magic_port.dds", "actor": 0}]},
  {"quest": "CL-DIST-C01-005", "goal": "1_WizardQuestGoalsExploreZone", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You examine the Observatory, using the powers of observation Mister Lewis taught you. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_75.mp3", "picture": "GUI/QuestButtons/Quest_CL_observatory_spiral_puzzle.dds", "actor": 0, "name": "Observatory"}, {"persona": "", "text": "<ITALICS>The mosaic on the floor appears important, based on the architectural emphasis. Perhaps a closer look... </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_76.mp3", "picture": "GUI/QuestButtons/Quest_CL_observatory_spiral_puzzle.dds", "actor": 0, "name": "Observatory"}]},
  {"quest": "CL-DIST-C01-005", "goal": "2_WizardQuestGoalsExploreZone", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The mosaic is clearly the key to understanding the secret message. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_28.mp3", "picture": "GUI/QuestButtons/Quest_CL_observatory_spiral_puzzle.dds", "actor": 0, "name": "Mosaic"}, {"persona": "", "text": "<ITALICS>Unfortunately, it looks like many of the mosaic plates are missing. If they were there, the meaning would be clear. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_78.mp3", "picture": "GUI/QuestButtons/Quest_CL_observatory_spiral_puzzle.dds", "actor": 0, "name": "Mosaic"}]},
  {"quest": "CL-DIST-C01-006", "goal": "2_WizardQuestGoals00000008", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You find a small mosaic tile wedged into the gears of the Orrery. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_79.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestia_puzzle_piece.dds", "actor": 0, "name": "Grand Orrery"}]},
  {"quest": "CL-DIST-C01-006", "goal": "3_WizardQuestGoals00000008", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>A shark must have used this place to hide a small cache of mosaic tiles, perhaps to barter with. You take them. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_80.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestia_puzzle_piece.dds", "actor": 0, "name": "Shark Hut"}]},
  {"quest": "CL-DIST-C01-009", "goal": "2_Recover", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You remove the Star of Celestia from the Stellarium. It glimmers with astral power. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_81.mp3", "picture": "GUI/QuestButtons/Quest_CL_Astrolabe_Star.dds", "actor": 0, "name": "Star of Celestia"}]},
  {"quest": "CL-DIST-C01-009", "goal": "3_Install", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You slot the Star of Celestia into the Grand Astrolabe. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_82.mp3", "picture": "GUI/QuestButtons/Use_Astrolabe_01.dds", "actor": 0, "name": "Grand Astrolabe"}]},
  {"quest": "CL-DIST-C02-001", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>There is an extremely long lecture about Celestian philosophy, astronomy, and magic theory. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_83.mp3", "picture": "GUI/QuestButtons/Quest_CL_magic_object.dds", "actor": 0, "name": "Configuration Station"}, {"persona": "", "text": "<ITALICS>At the end of the lecture, the Preceptor produces a small metal token for you. Shiny! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_84.mp3", "picture": "GUI/QuestButtons/Quest_CL_magic_object.dds", "actor": 0, "name": "Configuration Station"}]},
  {"quest": "CL-DIST-C02-001", "goal": "2_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The Preceptor lectures for a little while about identifying and resolving disagreements of all sort. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_85.mp3", "picture": "GUI/QuestButtons/Quest_CL_war_object.dds", "actor": 0, "name": "Conflict Station"}, {"persona": "", "text": "<ITALICS>When the lecture is complete, the Preceptor produces a small metal token for you. Congratulations! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_86.mp3", "picture": "GUI/QuestButtons/Quest_CL_war_object.dds", "actor": 0, "name": "Conflict Station"}]},
  {"quest": "CL-DIST-C02-001", "goal": "3_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The Preceptor speaks at length about the creation of devices with magical properties. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_87.mp3", "picture": "GUI/QuestButtons/Quest_CL_device_object.dds", "actor": 0, "name": "Contrivance Station"}, {"persona": "", "text": "<ITALICS>When it is finished lecturing you, the Preceptor produces a small metal token for you. Good job! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_88.mp3", "picture": "GUI/QuestButtons/Quest_CL_device_object.dds", "actor": 0, "name": "Contrivance Station"}]},
  {"quest": "CL-DIST-C02-001", "goal": "4_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You fit the three course completion tokens into slots on the security plinth. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_89.mp3", "picture": "GUI/QuestButtons/Quest_CL_security_plinth.dds", "actor": 0, "name": "Security Plinth"}]},
  {"quest": "CL-DIST-C02-002", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The pedestal appears to be missing a small section of metal... a key of some kind. Perhaps Thornton Lewis knows about it. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_90.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestian_pedestal_04.dds", "actor": 0, "name": "Stellarium Pedestal"}]},
  {"quest": "CL-DIST-C02-002", "goal": "3_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "This is no place for a surface dweller! Come on, boys! Fresh meat!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/BrutusStarkwave_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Shark_Warrior_01.dds", "actor": 0, "name": "Brutus Starkwave"}]},
  {"quest": "CL-DIST-C02-002", "goal": "4_WizardQuestGoalsKillCollect", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The Piscean leader drops a piece of curiously-shaped metal. It must be the missing key! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_91.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Shark_Warrior_01.dds", "actor": 0}]},
  {"quest": "CL-LAND-C02-001", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "You will not take magic stick from me! Gahlwok using it to break open shells!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Gahlwok_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Sea_monster_04.dds", "actor": 0, "name": "Gahlwok"}]},
  {"quest": "CL-LAND-C02-003", "goal": "3_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "You do not belong here. You have no roots. I will bury you!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Tangleroot_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Treant_Palm_Tree_01.dds", "actor": 0, "name": "Tangleroot"}]},
  {"quest": "CL-LAND-C03-002", "goal": "1_WizardQuestGoalsTalkNPC", "tag": "Completion", "replace": true, "lines": [{"persona": "CL-LAND-NPC02_Persona", "text": "Waterfall spirit Coruscade send you? I make bowl for you!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/TupaTaua_CEL_23.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Platypus_Chief_NPC.dds", "actor": 211525}, {"persona": "", "text": "<ITALICS>In a very short time, Tupa Taua crafts a bowl for you out of the sacred bark. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_143.mp3", "picture": "GUI/QuestButtons/Quest_CL_carved_bowl.dds", "actor": 0}, {"persona": "CL-LAND-NPC02_Persona", "text": "Now take back to Coruscade so he can fix water!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/TupaTaua_CEL_25.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Platypus_Chief_NPC.dds", "actor": 211525}]},
  {"quest": "CL-LAND-C03-003", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You pour the purified water into the lake. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_56.mp3", "picture": "GUI/QuestButtons/Quest_CL_bowl_with_water.dds", "actor": 0}]},
  {"quest": "CL-REALM-C01-003", "goal": "1_WizardQuestGoals00000058", "tag": "Completion", "lines": [{"persona": "", "text": "You have found the second portal piece!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_OP_16.mp3", "picture": "GUI/QuestButtons/Quest_CL_astral_portal_relic_star.dds", "actor": 0, "name": "Second Portal Piece"}]},
  {"quest": "CL-REALM-C01-004", "goal": "1_WizardQuestGoalsKillCollect", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>All the Crustacean Pincers are following the same path from the Starfish Door... maybe you should look further. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_47.mp3", "picture": "GUI/QuestButtons/Location_CL_Starfish_Door_Big.dds", "actor": 0}]},
  {"quest": "CL-REALM-C01-004", "goal": "2_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>A giant armored starfish holds the gate closed. It won’t be easy to open. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_48.mp3", "picture": "GUI/QuestButtons/Location_CL_Starfish_Door_Big.dds", "actor": 0, "name": "Starfish Door"}]},
  {"quest": "CL-REALM-C01-005", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "What's the big idea?! You just bought yourself a thrashing for bothering me!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/OptioMisemos_CEL_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_03.dds", "actor": 0, "name": "Optio Misemos"}]},
  {"quest": "CL-REALM-C01-005", "goal": "2_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "Don’t hurt me! I’ll tell you anything you want to know!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/OptioMisemos_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_03.dds", "actor": 0, "name": "Optio Misemos"}, {"persona": "", "text": "The starfish likes to eat algae! When we feed it algae it relaxes and opens the door!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/OptioMisemos_CEL_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_03.dds", "actor": 0, "name": "Optio Misemos"}]},
  {"quest": "CL-REALM-C01-006", "goal": "2_WizardQuestGoals00000015", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You feed the algae to the starfish on the gate. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_13.mp3", "picture": "GUI/QuestButtons/Location_CL_Starfish_Door_Big.dds", "actor": 0}]},
  {"quest": "CL-REALM-C01-006", "goal": "3_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "So this is the intruder who dares enter our realm? What a jest! You don’t even have a soft shell!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GovernorNereus_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_02.dds", "actor": 0, "name": "Governor Nereus"}]},
  {"quest": "CL-REALM-C01-006", "goal": "4_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "Argh! You’ve cracked my shell but good! Take the wretched stone! It’s never brought me any luck!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/GovernorNereus_CEL_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_02_NPC.dds", "actor": 0, "name": "Governor Nereus"}]},
  {"quest": "CL-REALM-C01-006", "goal": "5_WizardQuestGoals00000058", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The Governor drops the other piece of the Stellarium portal. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_50.mp3", "picture": "GUI/QuestButtons/Quest_CL_astral_portal_relic_star.dds", "actor": 0, "name": "Second Portal Piece"}]},
  {"quest": "CL-RIVEN-C01-001", "goal": "3_WizardQuestGoalsTalkNPC", "tag": "Completion", "lines": [{"persona": "CL-RIVEN-NPC01_Persona", "text": "Are they teaching Plumbing101 there at Wizard City?", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/LelandHawkins_CEL_09.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator02.dds", "actor": 225824}]},
  {"quest": "CL-RIVEN-C01-002", "goal": "2_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>Now you will have to go outside to throw the lever that activates the generator. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_96b.mp3", "picture": "GUI/QuestButtons/Quest_CL_mb_relay_box.dds", "actor": 0}]},
  {"quest": "CL-RIVEN-C01-002", "goal": "4_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You throw the lever, and the Celestian power generator begins working once more. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_97.mp3", "picture": "GUI/QuestButtons/Quest_CL_mb_relay_box.dds", "actor": 0}]},
  {"quest": "CL-RIVEN-C02-001", "goal": "1_WizardQuestGoals00000018", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You find a piece of what might be the Shadowseeker medallion. Maybe Alaric Moonsunder knows what happened to the rest. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_98.mp3", "picture": "GUI/QuestButtons/Quest_CL_Shadowseeker_Medallion_Part01.dds", "actor": 0, "name": "Medallion Segment"}]},
  {"quest": "CL-RIVEN-C02-002", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "CL-RIVEN-NPC03_Persona", "text": "You have restored my Shadowseeker medallion, and with it, my power is restored!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/KarolakNightspinner_CEL_09.mp3", "picture": "", "actor": 225832}, {"persona": "CL-RIVEN-NPC03_Persona", "text": "You think you seek the missing portal pieces... but you are wrong! If you came to this sunken place... it must be in search of your doom!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/KarolakNightspinner_CEL_10.mp3", "picture": "", "actor": 225832}, {"persona": "CL-RIVEN-NPC03_Persona", "text": "Did you really think I would put aside centuries of hate to help you!?!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/KarolakNightspinner_CEL_11.mp3", "picture": "", "actor": 225832}, {"persona": "CL-RIVEN-NPC03_Persona", "text": "The irony is thick. You have given me what I sought most... my own destruction!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/KarolakNightspinner_CEL_12.mp3", "picture": "", "actor": 225832}]},
  {"quest": "CL-RIVEN-C02-002", "goal": "2_WizardQuestGoalsKillCollect", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>When Karolak Nightspinner falls, he drops a piece of the Celestian portal! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_99.mp3", "picture": "GUI/QuestButtons/Quest_CL_astral_portal_relic_moon.dds", "actor": 0}]},
  {"quest": "CL-RIVEN-C03-001", "tag": "Prep", "lines": [{"persona": "", "text": "<ITALICS>The Archivist teaches you an incantation in the ancient Celestian language. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_104.mp3", "picture": "GUI/QuestButtons/Quest_CL_archivist.dds", "actor": 0}]},
  {"quest": "CL-RIVEN-C03-001", "goal": "3_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You say the words of the incantation, and the portal stone gleams, as if filled with moonlight. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_105.mp3", "picture": "GUI/QuestButtons/Quest_CL_Moon_Shield.dds", "actor": 0}]},
  {"quest": "CL-RIVEN-C03-002", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You restore the pieces of the Lunarium portal, and soon it shines... invitingly. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_106.mp3", "picture": "GUI/QuestButtons/Use_StarTemple_Gate.dds", "actor": 0}]},
  {"quest": "CL-SCI-C01-003", "tag": "Prep", "lines": [{"persona": "CL-CAMP-NPC04_Persona", "text": "Can you go and collect the Leiden jars and use them to jump-start the galvanic towers? Be careful not to shock yourself!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/PiperMelville_CEL_18.mp3", "picture": "", "actor": 0}]},
  {"quest": "CL-SCI-C02-002", "goal": "2_WizardQuestGoals00000256", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>Following Engineer Montgomery’s instructions, you repair the generator. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_26.mp3", "picture": "GUI/QuestButtons/Location_CL_Power_Generator.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-003", "goal": "4_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You switch the power relays on, sending galvanic energy through the circuits back to the Arboretum. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_27.mp3", "picture": "GUI/QuestButtons/Quest_Galvanic_Tower_on.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-004", "goal": "1_WizardQuestGoalsKillCollect", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You study the cogitator circuit. It’s difficult to read, but you think the instructions lead back to the Conservatory. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_28.mp3", "picture": "GUI/QuestButtons/Quest_CL_CogitatorCircuit.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-004", "goal": "2_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You examine the doors. They’re sealed, but you can see the signs of Hydro-Bot tracks leading outward. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_29.mp3", "picture": "GUI/QuestButtons/Location_CL_Senate_Door.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-005", "goal": "2_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You place the power cores into the alcoves for the Sun, Moon, and Stars. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_30.mp3", "picture": "GUI/QuestButtons/Quest_CL_fish_fountain.dds", "actor": 0}, {"persona": "", "text": "<ITALICS>A moment later, a key materializes above the fountain. You take it, but something about it doesn’t look right. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_31.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestian_key.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-007", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The repaired key works like a charm. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_32.mp3", "picture": "GUI/QuestButtons/Location_CL_Senate_Door.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-008", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You examine this hydraulic channeler, it uses the type of fuses installed in the Water-Matons. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_09.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestian_relay_control.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-008", "goal": "3_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You install the fuses into the hydraulic channeler, but the power is still only half what it should be. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_07.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestian_relay_control.dds", "actor": 0}, {"persona": "", "text": "<ITALICS>You should also check the hydraulic channeler on the far side of the reactor!  </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_08.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestian_relay_control.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-008", "goal": "4_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You examine the hydraulic channeler, but realize it needs a new set of fuses like those used by the Aqua-Bots. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_06.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestian_relay_control.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-008", "goal": "6_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You install the second set of fuses into the hydraulic channeler, restoring the telluric flow to the gate control.</ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_10.mp3", "picture": "GUI/QuestButtons/Quest_CL_celestian_relay_control.dds", "actor": 0}, {"persona": "", "text": "<ITALICS>Now you can use the gate control to get access into the Crystal Reactor! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_11.mp3", "picture": "GUI/QuestButtons/Quest_CL_Celestian_Lever.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-008", "goal": "7_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You throw the switch, and can immediately hear the gate unlock at the entrance to the Crystal Reactor! </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_PU_12.mp3", "picture": "GUI/QuestButtons/Quest_CL_Celestian_Lever.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-008", "goal": "8_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "Who you be?! You not welcome down here! My fish-bots weak, but Maglump no weak! Maglump strong!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Maglump_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Fishbot_Boss.dds", "actor": 0, "name": "Maglump"}]},
  {"quest": "CL-SCI-C02-008", "goal": "9_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>As Maglump is defeated, he drops a piece of the portal to the Solarium. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_37.mp3", "picture": "GUI/QuestButtons/Quest_CL_astral_portal_relic_sun.dds", "actor": 0}]},
  {"quest": "CL-SCI-C02-009", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The pieces of the portal snap into place, as if they had never been missing. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_38.mp3", "picture": "GUI/QuestButtons/Quest_CL_astral_portal_relic_sun.dds", "actor": 0, "name": "Sun Portal"}]},
  {"quest": "CL-STORM-C01-002", "goal": "1_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You charge the Storm Shards by placing them on the Moon Dial. They soon glow with power. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_100.mp3", "picture": "GUI/QuestButtons/Quest_CL_moondial.dds", "actor": 0}]},
  {"quest": "CL-STORM-C01-002", "goal": "2_WizardQuestGoalsUseItem", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You fit the Storm Shards into the altar. Electricity starts to build in the air around you. </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_101.mp3", "picture": "GUI/QuestButtons/Quest_CL_storm_altar.dds", "actor": 0}, {"persona": "", "text": "Who dares summon the Avatar of the Storm Lord? I will destroy you for this insult!", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/TempusStormfist_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Storm_Titan_Avatar.dds", "actor": 0, "name": "Tempus Stormfist"}]},
  {"quest": "CL-STORM-C01-002", "goal": "3_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>Tempus Stormfist disappears, leaving in his place the final piece of the portal to the Lunarium. But it is cracked... </ITALICS>", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Narrator_CEL_102.mp3", "picture": "GUI/QuestButtons/Quest_CL_Cracked_Star_Portal.dds", "actor": 0}]},
  {"quest": "DM-CAST-C02-001", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "G14-DM-HubNPC02_Persona", "text": "Young Wizard. I did not expect you to have the courage or strength of character to come this far on your own.", "sound": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/Malistaire_BAA_03.mp3", "picture": "", "actor": 0}, {"persona": "G14-DM-HubNPC02_Persona", "text": "That will be a fitting epitaph, and serve as a warning to all whose ego is unchecked.", "sound": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/Malistaire_BAA_04.mp3", "picture": "", "actor": 0}, {"persona": "G14-DM-HubNPC02_Persona", "text": "There are always things in the dark that are bigger and scarier than we think we are. Let us see how long your light lasts.", "sound": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/Malistaire_BAA_05.mp3", "picture": "", "actor": 0}]},
  {"quest": "DM-CAST-C06-001", "goal": "3_WizardQuestGoalsTalkNPC", "tag": "Completion", "lines": [{"persona": "WC-RAV-NPC02_Persona", "text": "Wizard, I am glad to see you returned home. You are the first to engage in the Law of <ITALICS>Kan Davasi</ITALICS> in a great age. Tell us everything.", "sound": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ProfCyrusDrake_BAA_08.mp3", "picture": "", "actor": 0}, {"persona": "WC-RAV-NPC02_Persona", "text": "Perhaps after all this time, my brother will finally be at rest. Thank you, Wizard, for all you have done.", "sound": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ProfCyrusDrake_BAA_09.mp3", "picture": "", "actor": 0}]},
  {"quest": "DS-LIB1-C01-002", "goal": "Goal 2", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You activate the crystal and it shimmers to life.</ITALICS>", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/Narrator_NAR_26.mp3", "picture": "GUI/QuestButtons/Quest_ActivationCrystalYellow.dds", "actor": 0, "name": "Crystal"}]},
  {"quest": "DS-LIB1-C01-004", "goal": "Goal 2", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You activate the crystal and it shimmers to life.</ITALICS>", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/Narrator_NAR_26.mp3", "picture": "GUI/QuestButtons/Quest_ActivationCrystalOrange.dds", "actor": 0, "name": "Crystal"}]},
  {"quest": "DS-LIB1-C01-006", "goal": "Goal 2", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You activate the crystal and it shimmers to life.</ITALICS>", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/Narrator_NAR_26.mp3", "picture": "GUI/QuestButtons/Quest_ActivationCrystaGreen.dds", "actor": 0, "name": "Crystal"}]},
  {"quest": "DS-LIB1-C01-008", "goal": "Goal 2", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You activate the crystal and it shimmers to life.</ITALICS>", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/Narrator_NAR_26.mp3", "picture": "GUI/QuestButtons/Quest_ActivationCrystaBlue.dds", "actor": 0, "name": "Crystal"}]},
  {"quest": "KT-PYMHub-C01-001", "goal": "Goal", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You make the rubbings.</ITALICS>", "sound": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Narrator_NAR_760.mp3", "picture": "GUI/QuestButtons/Art_Quest_Glyphs.dds", "actor": 0, "name": "Glyph"}]},
  {"quest": "KT-PreCel-MAIN-001", "goal": "1_WizardQuestGoals00000196", "tag": "Completion", "lines": [{"persona": "KT-SE-SELE-NPC-01_Persona", "text": "Welcome, Wizard, to the home of the Lunamaries - the followers of the Moon - Selenopolis.", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Raafat_KT-PreCel_007.mp3", "picture": "", "actor": 0}, {"persona": "KT-SE-SELE-NPC-01_Persona", "text": "Many years ago, Manders and Kroks disinterested in the constant warring with the Tuts escaped here under the auspices of the mysterious Moon King.", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Raafat_KT-PreCel_008.mp3", "picture": "", "actor": 0}, {"persona": "KT-SE-SELE-NPC-01_Persona", "text": "Using the blended magicks of this unique nexus, they remained protected, but isolated, building a community and traditions all their own.", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Raafat_KT-PreCel_009.mp3", "picture": "", "actor": 0}, {"persona": "KT-SE-SELE-NPC-01_Persona", "text": "Oh, worry not for the stares. The Children of the Moon are wary, but peaceful. Visitors are allowed, just rare. Now, follow me to the Blended Grove.", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Raafat_KT-PreCel_010.mp3", "picture": "", "actor": 0}]},
  {"quest": "MB-YARD2-C01-005", "goal": "Goal 2", "tag": "Completion", "lines": [{"persona": "", "text": "Sacre bleu! We have been discovered! Hmmm... The master told us we cannot be found. It seems we must be sure you will tell no one about us, Wizard!", "sound": "|Sound_Dialogue_MB|WorldData|Sound/Dialogue/DeadlyScratcher_QST_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Scratchers_Red.dds", "actor": 0, "name": "Deadly Scratcher"}, {"persona": "", "text": "<ITALICS>You find a crumpled glove with the initials 'XX' on the floor.</ITALICS>", "sound": "|Sound_Dialogue_MB|WorldData|Sound/Dialogue/Narrator_NAR_271.mp3", "picture": "GUI/QuestButtons/Art_Quest_White_Glove.dds", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-002", "goal": "2_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "WC-DRAINS-NPC08_Persona", "text": "You did it! We're saved! Thank you so much! Um... do you think we could Photomance a quick selfie?", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/AlchemistValerieThunderfist_CAT_01.mp3", "picture": "", "actor": 0}, {"persona": "WC-DRAINS-NPC06_Persona", "text": "Your heroics make it even harder to break it to you that we've decided to disband the Alchemy Club. I'm so sorry, your Scion-ness.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/AlchemistMycinBlueFlame_CAT_01.mp3", "picture": "", "actor": 0}, {"persona": "WC-DRAINS-NPC08_Persona", "text": "I think they'll live, Mycin. More importantly, we need to get the Book back to the Library before important people start connecting dots.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/AlchemistValerieThunderfist_CAT_02.mp3", "picture": "", "actor": 0}, {"persona": "WC-DRAINS-NPC06_Persona", "text": "We stole an Alchemy book, not a connect-the-dots book, ya goof.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/AlchemistMycinBlueFlame_CAT_02.mp3", "picture": "", "actor": 0}, {"persona": "WC-DRAINS-NPC08_Persona", "text": "*Sigh* You've already done so much, but could you please return this Alchemy Book to the Library? If we're caught with it, we'll be expelled.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/AlchemistValerieThunderfist_CAT_03.mp3", "picture": "", "actor": 0}, {"persona": "WC-DRAINS-NPC06_Persona", "text": "It goes in the 'Forbidden Magics' section. Argleston'll show you where. Wait. Don't ask him. You'll figure it out. You're the Scion. Thanks!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/AlchemistMycinBlueFlame_CAT_03.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-003", "goal": "1_HelpCast", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC01_Persona", "text": "Quellum varna ohsi, quellum varna eesi! Cona burra gatta, usa ellaboaza greezi!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_11.mp3", "picture": "", "actor": 1487008}, {"persona": "WC-CATA-NPC01_Persona", "text": "It worked!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_12.mp3", "picture": "", "actor": 1487008}, {"persona": "WC-DRAINS-NPC03_Persona", "text": "Ehh, the Goo is gone! Me and the boys should be able to sweep up the rest of these Trash Monsters, no problem. Oh, but looky there...", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DumpForeman_CAT_08.mp3", "picture": "", "actor": 0}, {"persona": "WC-DRAINS-NPC03_Persona", "text": "Hey, your magic-y mumbo jumbo put a crack in the wall. The Boss ain't gonna be happy about this!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DumpForeman_CAT_09.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01_Persona", "text": "Sssss... Ummm... perhaps we can fix it. Wizard, light masonry is part of your Scion bag of tricks, right? Whew. Fix that wall!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_13.mp3", "picture": "", "actor": 1487008}]},
  {"quest": "WC-CATA-MAIN-003", "goal": "2_WizardQuestGoals00000256", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC01_Persona", "text": "Oh no! Um... it's OK. Nobody panic. Renee Wooften is a friend of mine. She'll help us - wait a minute. Is that a... a hallway? We must investigate!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_14.mp3", "picture": "", "actor": 1487008}]},
  {"quest": "WC-CATA-MAIN-004", "goal": "1_WizardQuestGoalsExploreZone", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-CATA-NPC01-B_Persona", "text": "Fascinating! Beneath the Drains, there seems to be Catacombs. How intriguingly morbid!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_19.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-B_Persona", "text": "GHOSTS!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_20.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-B_Persona", "text": "It's okay, it's okay, I don't think they've seen us. Calm down, Wizard, we'll be fine. Just breathe deep and evaluate.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_21.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-B_Persona", "text": "How odd. These fellows appear to be from Dragonspyre. But there's no historical record of Dragonspyre visiting Ravenwood. I wonder...", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_22.mp3", "picture": "", "actor": 0}, {"persona": "", "text": "Troops, ours is a dark age. Dragonspyre suffers from Rydall's plague, its streets fill with mobs of the unwashed. Our way of life is ending.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/GeneralGreyflame_CAT_01.mp3", "picture": "GUI/NpcPortraits/Portrait_DSCrusaderF_B_MOB.dds", "actor": 0, "name": "General Greyflame"}, {"persona": "", "text": "But we here will not accept that fate. We will not cower before the tyranny of change. We will see Dragonspyre, true Dragonspyre, preserved.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/GeneralGreyflame_CAT_02.mp3", "picture": "GUI/NpcPortraits/Portrait_DSCrusaderF_B_MOB.dds", "actor": 0, "name": "General Greyflame"}, {"persona": "", "text": "Here in this hidden land, this ancient forest, we will make our stand - for our prince, our true king. This will become Dragonspyre Reborn!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/GeneralGreyflame_CAT_03.mp3", "picture": "GUI/NpcPortraits/Portrait_DSCrusaderF_B_MOB.dds", "actor": 0, "name": "General Greyflame"}, {"persona": "", "text": "But we will not accept this fate... we.... We will not, not, not, not... you not... you new... you don't... don't... you...", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/GeneralGreyflame_CAT_04.mp3", "picture": "GUI/NpcPortraits/Portrait_DSCrusaderF_B_MOB.dds", "actor": 0, "name": "General Greyflame"}, {"persona": "", "text": "YOU DON'T BELONG HERE!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/GeneralGreyflame_CAT_05.mp3", "picture": "GUI/NpcPortraits/Portrait_DSCrusaderF_B_MOB.dds", "actor": 0, "name": "General Greyflame"}, {"persona": "WC-CATA-NPC01-B_Persona", "text": "Oh dear me, that Ghost looked this way! It looked right at me - right through me! With menace in its eyes. Fight it, fight it! I'll just go hide.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_23.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-004", "goal": "3_WizardQuestGoals00000253", "tag": "Completion", "lines": [{"persona": "", "text": "Okay, okay, okay. Breathe Hargrove, breathe. Remember what your mother said: don't feel your emotions, write them. So... AAAAAAAAAAAAAHHHHHHHHHHHHHH!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_24.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Hargrove's Note"}, {"persona": "", "text": "The Wizard is dealing with the frightful Dragonspyre ghosts, leaving me ample time to record my findings. For example, I just found this Crypt.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_25.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Hargrove's Note"}, {"persona": "", "text": "I'm of two minds on this discovery. I do desperately want to know what historic secrets rest within, but this is also how horror stories start.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_26.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Hargrove's Note"}, {"persona": "", "text": "I wish I knew how they ended. And oh my word, what a startling noise! I dare say if it happened again, I'd drop this note...", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_27.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Hargrove's Note"}]},
  {"quest": "WC-CATA-MAIN-004", "goal": "6_Examine", "tag": "Completion", "lines": [{"persona": "", "text": "Oh my! As soon as I left that other chamber, a Knowledge Crystal grew back in the doorway. What's causing them to spread like this?", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_85.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Hargrove's Note"}, {"persona": "", "text": "Is it the same thing disrupting the projections? The recordings are all fragmented, blended over many years.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_86.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Hargrove's Note"}, {"persona": "", "text": "And worse, they seem... aware. And when they become aware that they're aware... they lash out.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_31.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Hargrove's Note"}, {"persona": "", "text": "Uh-oh! That one seems aware that I'm aware that it's aware, so now it's aware! And I must away! Stop writing, Hargrove, and hide some...", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_32.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Hargrove's Note"}]},
  {"quest": "WC-CATA-MAIN-004", "goal": "8_Examine", "tag": "Completion", "lines": [{"persona": "", "text": "My hiding place, it turns out, was a tunnel. Fortunately, there were no Crypt Spiders. Dreadful things.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_33.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Another Hargrove Note"}, {"persona": "", "text": "Oh, look another ghost! A very different kind of ghost in fact. Perhaps a friendly ghost?", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_34.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Another Hargrove Note"}, {"persona": "", "text": "He's beckoning me, pointing toward a door. I'll just place this notebook here for safekeeping and go take a look.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_35.mp3", "picture": "GUI/NpcPortraits/Portrait_Bear_Hargrove_A_NPC.dds", "actor": 0, "name": "Another Hargrove Note"}]},
  {"quest": "WC-CATA-MAIN-005", "goal": "1_WizardQuestGoals00000253", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC01-C_Persona", "text": "Oh, sweet fancy Mander, you arrived just in time, Wizard. And you found my notes? Excellent! This day is looking up.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_36.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-C_Persona", "text": "I know I shouldn't have come down here alone, but intellectual curiosity. And when I did, I saw all these fragmented memories, these projections...", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_37.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-C_Persona", "text": "And then they saw me and chased me down here, where Viggor cornered me. Oh, and there's so much more to tell you.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_38.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-C_Persona", "text": "But first let's go back the way we came to the relative safety of anywhere else.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_39.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-005", "goal": "3_WizardQuestGoals00000349", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC08_Persona", "text": "So this is what we have become. Villains, warriors, as violent as those we sought to repel. But at least now, the war is ended.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Treeminder4_CAT_01.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC09_Persona", "text": "At too great a cost. The Trees all burned and the Great Oak has turned his gaze from us in shame.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Treeminder5_CAT_01.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC09_Persona", "text": "And our people flee across the skies. Back to the Wyrd Wood, to a forest not littered with nightmares.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Treeminder5_CAT_02.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-D_Persona", "text": "The Wyrd? In Avalon? Oh my, I think I know who these Treeminders are, or rather were.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_40.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC08_Persona", "text": "We'll convert the old halls to lay them all to rest and plant what new Trees we can. Then we too shall travel to the Wyrd. Our time here is done.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Treeminder4_CAT_02.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC08_Persona", "text": "So please, Wizard, destroy the Knowledge Crystal. Let us stop reliving this nightmare.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Treeminder4_CAT_03.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-D_Persona", "text": "Druids. That's what they were, I think. You can still find a few in Avalon, but I suspect they have little in common with this lot.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_41.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-D_Persona", "text": "Not much is known about ancient Druids. But it was thought they had a special affinity for magic, for the unseen forces of the Spiral.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_42.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-D_Persona", "text": "Such as the forces that govern the Knowledge Crystals of Dragonspyre. Which is why these Druidic Treeminders seem more aware of us.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_43.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-D_Persona", "text": "It would be exciting, if it weren't so horrifying. Quickly, now, let's get outside and regroup.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_44.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-006", "goal": "2_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "WC-StandIn-PrinceViggor-02_Persona", "text": "You fight like the Treeminders. The secrets of magic really did reach the masses, didn't they?", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_07.mp3", "picture": "", "actor": 0}, {"persona": "WC-StandIn-PrinceViggor-02_Persona", "text": "But, why, how can I know this? I am an image stored on a Knowledge Crystal. I should no more change than a portrait upon a wall.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_08.mp3", "picture": "", "actor": 0}, {"persona": "WC-StandIn-PrinceViggor-02_Persona", "text": "Can you tell me? Can you solve this? Can you put my followers to rest? I feel a pull constantly to the next Chamber. I think... I think the cause is there.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_09.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-006", "goal": "3_WizardQuestGoals00000349", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC07_Persona", "text": "I see now. This is my crystal. But what is this substance upon it? The last vestige of a failed alchemical formula, you say?", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_10.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC07_Persona", "text": "A coterie of students created it without permission and dumped it down the Drains? Just like Rydall and his plague.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_11.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC07_Persona", "text": "The potion must have altered the state of the Knowledge Crystal, and its effects radiated out to the others. All this madness from an errant spill.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_12.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC07_Persona", "text": "If you remove the Crystal and clean it off, the others should quiet down over time and the memories of my army can rest.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_13.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC07_Persona", "text": "I have a courtesy to ask, if I may. This crystal holds the last will of the real Prince Viggor. Lay it to rest in his homeland, in Dragonspyre.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_14.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-006", "goal": "6_Bury", "tag": "Completion", "lines": [{"persona": "DS-StandIn-PrinceViggor-01_Persona", "text": "The war is costing us much. Victory is not as assured as when we started. If these be my last thoughts, may they make it home.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_15.mp3", "picture": "", "actor": 0}, {"persona": "DS-StandIn-PrinceViggor-01_Persona", "text": "I know our world is changing. I know the people seek the power they feel is being kept from them. And I know which way the wind is blowing.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_16.mp3", "picture": "", "actor": 0}, {"persona": "DS-StandIn-PrinceViggor-01_Persona", "text": "But I also know that only the elite, the royalty, can be trusted with knowledge. Only we can use it well. And I know history will prove me right.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/PrinceViggor_CAT_17.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-009", "goal": "2_WizardQuestGoalsTalkNPC", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-RAV-NPC17-Bartleby_Persona", "text": "Beware, my Scion! A dire danger has arisen here in the deep!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Bartleby_CAT_01.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC10-A_Persona", "text": "Dark forces are at work.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Bartleby_CAT_02.mp3", "picture": "GUI/NpcPortraits/Portrait_Tree_BartlebyProjection_A_NPC.dds", "actor": 1451830}]},
  {"quest": "WC-CATA-MAIN-010", "tag": "Prep", "lines": [{"persona": "WC-CATA-NPC01-G_Persona", "text": "So the builders of these tunnels <italics>were</italics> Druids! Remarkable! I will accompany you into the chamber beyond, Wizard.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_73.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-010", "goal": "1_WizardQuestGoalsExploreZone", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC01-H_Persona", "text": "Look at this place - how wondrous! There are more carvings in here. We should examine them.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_74.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-010", "goal": "2_Examine", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC01-H_Persona", "text": "I've seen symbols like these in ancient texts. If I'm right, this is a diagram of Ley Lines - they're a legend among historians!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_75.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-H_Persona", "text": "According to some sources, ancient wizards used Ley Lines to travel between the worlds of the Spiral before World Doors were invented.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_76.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-H_Persona", "text": "These inscriptions here... they say the Druids wove the Ley Lines! They extend along Bartleby's roots, touching every world in the Spiral!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_77.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-H_Persona", "text": "This proves the theories are true! The Ley Lines must be how the Druids brought their prisoners here. But how did they bind them? Where are they?", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_78.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-011", "goal": "1_Repair", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC01-H_Persona", "text": "Excellent! Keep going!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_79.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-CATA-MAIN-012", "goal": "1_WizardQuestGoals00000196", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC011_Persona", "text": "The next chamber is the heart of our web of Ley Lines - the prisoners used them to escape into the Spiral. Follow them, and do not tarry!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_17.mp3", "picture": "", "actor": 1451817}]},
  {"quest": "WC-CATA-MAIN-012", "goal": "5_WizardQuestGoals00000146", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC011_Persona", "text": "The Prison is restored, and the prisoners are returned. Bartleby has chosen a mighty champion. It is time for you to take up the watch we once held.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_18.mp3", "picture": "", "actor": 1451817}, {"persona": "WC-CATA-NPC011_Persona", "text": "May your roots grow deep and your branches tall.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_19.mp3", "picture": "", "actor": 1451817}]},
  {"quest": "WC-CATA-MAIN-012", "goal": "6_WizardQuestGoalsTalkNPC", "tag": "Completion", "lines": [{"persona": "WC-CATA-NPC01-H_Persona", "text": "This is positively overwhelming! What we've discovered here will revolutionize our understanding of the history of the Spiral.", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_80.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-H_Persona", "text": "The secret history of the Druids... confirmation of the existence of Ley Lines... I could write a dozen books about it all! Tenure, here I come!", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_81.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-H_Persona", "text": "Oh, and I'll definitely need you to write me in-depth descriptions of all three of the entities you captured. Ten pages each, shall we say?", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_82.mp3", "picture": "", "actor": 0}, {"persona": "WC-CATA-NPC01-H_Persona", "text": "Incredible. So much history, discovered in a single chamber! What other secrets could be lying down here, just waiting to be found?", "sound": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_83.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-BALANCE", "goal": "Goal 1", "tag": "Completion", "lines": [{"persona": "WC-RAV-NPC09_Persona", "text": "Stick around a spell, as it were, after this lot has dispersed and I shall tell you what I've learned of Balance Magic while in ancient Krokotopia.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ArthurWethersfield_001_02.mp3", "picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-BALANCE", "goal": "Goal 2", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-RAV-NPC09_Persona", "text": "Fascinating place, Krokotopia. Home to a kingdom of mystic reptiles. Their ancient Sorcerers invented a composite of primal magics called Balance.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ArthurWethersfield_001_03.mp3", "picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC09_Persona", "text": "It's still a little unofficial though, so I'm out here teaching under the clouds. Check by regularly to train new Balance spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ArthurWethersfield_001_04.mp3", "picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC09_Persona", "text": "As your proficiency level increases, I'll call you here to learn unique spells only the most practiced of Sorcerers can master.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ArthurWethersfield_001_05.mp3", "picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC09_Persona", "text": "Train yourself in the Scorpion spell, then tell Mr. Lincoln you're ready to finish your enrollment. Toodles!", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ArthurWethersfield_001_06.mp3", "picture": "GUI/NpcPortraits/Dog_Wethersfield_A_NPC.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "You're already learning multi-Pip spells? Splendid. At the beginning of each round of combat you gain a Pip. You use these, like Mana, to power spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "Some spells, like this one, take more than one Pip to cast. To use it, pass a turn or cast a 0-Pip spell to build up your Pip supply.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-DEATH", "goal": "Goal 1", "tag": "Completion", "lines": [{"persona": "WC-RAV-NPC08-B_Persona", "text": "As the official Interim Teacher of Death magic, I can get you started as a Necromancer. Let's just get out of the way.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/MalornAshthorn_001_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Malorn_Ashthorn.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-DEATH", "goal": "Goal 2", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-RAV-NPC08_Persona", "text": "Welcome to the crater where the Death School used to be. Until Headmaster Ambrose finds a replacement for Malistaire, you can come to me to train.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/MalornAshthorn_001_04.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Malorn_Ashthorn.dds", "actor": 0}, {"persona": "WC-RAV-NPC08_Persona", "text": "I can even teach you advanced Death Spells when you reach the right level of experience... Probably. I'll let you know when that is.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/MalornAshthorn_001_05.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Malorn_Ashthorn.dds", "actor": 0}, {"persona": "WC-RAV-NPC08_Persona", "text": "For now, I've got one spell for you: Ghoul. Train it, then head back to Mr. Lincoln.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/MalornAshthorn_001_06.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Malorn_Ashthorn.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "You're already learning multi-Pip spells? Splendid. At the beginning of each round of combat you gain a Pip. You use these, like Mana, to power spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "Some spells, like this one, take more than one Pip to cast. To use it, pass a turn or cast a 0-Pip spell to build up your Pip supply.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-FIRE", "goal": "Goal 1", "tag": "Completion", "lines": [{"persona": "WC-RAV-NPC04_Persona", "text": "Ah, yes, I sense a spark inside you; with the right training, it will become an inferno. Let's go to the Fire School.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfDaliaFalmea_001_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-FIRE", "goal": "Goal 2", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-RAV-NPC04_Persona", "text": "Welcome, Wizard, to Mistress Dalia Falmea's School of Pyromancy. You must return here often to learn new spells and expand your talents.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfDaliaFalmea_001_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds", "actor": 0}, {"persona": "WC-RAV-NPC04_Persona", "text": "And as the fires within you burn to even greater heights, I will call you back to teach you spells too hot for non-Fire Wizards to handle.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfDaliaFalmea_001_04.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds", "actor": 0}, {"persona": "WC-RAV-NPC04_Persona", "text": "For now, I have the Fire Elf spell to get you started. Train swiftly, then return to Mr. Lincoln to finalize your enrollment.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfDaliaFalmea_001_05.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "You're already learning multi-Pip spells? Splendid. At the beginning of each round of combat you gain a Pip. You use these, like Mana, to power spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "Some spells, like this one, take more than one Pip to cast. To use it, pass a turn or cast a 0-Pip spell to build up your Pip supply.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-ICE", "goal": "Goal 1", "tag": "Completion", "lines": [{"persona": "WC-RAV-NPC03-B_Persona", "text": "Now, young Thaumaturge, I'll take you to the Ice School, so I can properly induct you into our wonderful wintry world.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfLydiaGreyrose_001_02.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-ICE", "goal": "Goal 2", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-RAV-NPC03_Persona", "text": "\"Ice\" of you to join us, Wizard. Oh, Lydia, you are such a card! I am Lydia Greyrose, and it's my honor to teach you the secrets of Ice magic.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfLydiaGreyrose_001_03.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC03_Persona", "text": "Come back here regularly to learn new spells. I'll also summon you periodically to teach you powerful spells only available to Ice Wizards.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfLydiaGreyrose_001_04.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC03_Persona", "text": "For your first lesson, train the Snow Serpent spell, then return to Mr. Lincoln to confirm that your enrollment is complete.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfLydiaGreyrose_001_05.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "You're already learning multi-Pip spells? Splendid. At the beginning of each round of combat you gain a Pip. You use these, like Mana, to power spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "Some spells, like this one, take more than one Pip to cast. To use it, pass a turn or cast a 0-Pip spell to build up your Pip supply.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-LIFE", "goal": "Goal 1", "tag": "Completion", "lines": [{"persona": "WC-RAV-NPC01_Persona", "text": "You have chosen to embrace Life Magic. Good. Ours is a magic that resonates with the Song of Creation itself. Let's go begin your studies.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfMoolindaWu_001_02.mp3", "picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-LIFE", "goal": "Goal 2", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-RAV-NPC01_Persona", "text": "Allow me to formally introduce myself, young Wizard, I am Moolinda Wu. You may come to me often to learn new Life Spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfMoolindaWu_001_03.mp3", "picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC01_Persona", "text": "As your skill level grows, I will call upon you to come learn unique spells that will help your mastery of the Theurgical arts blossom.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfMoolindaWu_001_04.mp3", "picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC01_Persona", "text": "For now, try training the Leprechaun spell, then return to Mr. Lincoln. We will speak again when the time is right.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfMoolindaWu_001_05.mp3", "picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "You're already learning multi-Pip spells? Splendid. At the beginning of each round of combat you gain a Pip. You use these, like Mana, to power spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "Some spells, like this one, take more than one Pip to cast. To use it, pass a turn or cast a 0-Pip spell to build up your Pip supply.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-MYTH", "goal": "Goal 1", "tag": "Completion", "lines": [{"persona": "WC-RAV-NPC02-C_Persona", "text": "So you think you can master Myth without being crushed by your own Minotaur? Very well, I'll humor you. Come along.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfCyrusDrake_001_02.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds", "actor": 0}]},
  {"quest": "WC-COMMONS-MAIN-002-MYTH", "goal": "Goal 2", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-RAV-NPC02_Persona", "text": "This is the School of Myth. Don't get used to it, I doubt you'll be here long. But, while you're enrolled, this is where you'll learn new spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfCyrusDrake_001_03.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC02_Persona", "text": "And on the off chance your skill level improves, I'll send for you. You will report promptly and learn to summon more mythic creatures.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfCyrusDrake_001_04.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds", "actor": 0}, {"persona": "WC-RAV-NPC02_Persona", "text": "For now, learn this easy spell: Troll. Then go bother Lincoln. I have important research to complete.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/ProfCyrusDrake_001_05.mp3", "picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "You're already learning multi-Pip spells? Splendid. At the beginning of each round of combat you gain a Pip. You use these, like Mana, to power spells.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "Some spells, like this one, take more than one Pip to cast. To use it, pass a turn or cast a 0-Pip spell to build up your Pip supply.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0}]},
  {"quest": "CL-MAIN-C01-002", "tag": "Prep", "lines": [{"persona": "CL-HUB-NPC001_Persona", "text": "Go and speak to Thornton Lewis in the District of the Stars. He’ll be ever-so-grateful to see you!", "sound": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_16.mp3", "picture": "", "actor": 211488}]},
  {"quest": "CL-RIVEN-C01-005", "goal": "1_WizardQuestGoalsTalkNPC", "tag": "Completion", "lines": [{"persona": "CL-STORM-NPC01_Persona", "text": "You don’t look Marleybonian, and you’re no Celestian.", "sound": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/VassekShadowspite_CEL_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Morgantine_Ghost_03_NPC.dds", "actor": 0, "name": "Vassek Shadowspite"}]},
  {"quest": "WC-CYCLOPS-MAIN-005", "goal": "Goal", "tag": "Completion", "replace": true, "lines": [{"persona": "WC_StandIn_GeneralAkilles_Persona", "text": "One of you comes to face me at last. Know this: I seized Cyclops Lane, but it was not my choice.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GeneralAkilles_005_01.mp3", "picture": "", "actor": 0, "name": "General Akilles"}, {"persona": "", "text": "It was mine. No... down here, near the ground.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GreatOne_005_01.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Bunny_Vampire_A_NPC.dds", "actor": 0, "name": "Great One"}, {"persona": "", "text": "Yes, me. Fear me! For I am a Prince of Darkmoor, cursed to be a bunny, bitten by a vampire, then trapped between Physical and Spiritual Planes.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GreatOne_005_02.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Bunny_Vampire_A_NPC.dds", "actor": 0, "name": "Great One"}, {"persona": "", "text": "I am a ghostly vampire bunny! And I once tried to control Wizard City with my hypnotic gaze. Alas, I was sealed in the caves with the other Undead.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GreatOne_005_03.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Bunny_Vampire_A_NPC.dds", "actor": 0, "name": "Great One"}, {"persona": "", "text": "But Malistaire destroyed our prison, sent us to cause chaos. And then his brother provided an easily swayed army of trolls and cow things.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GreatOne_005_04.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Bunny_Vampire_A_NPC.dds", "actor": 0, "name": "Great One"}, {"persona": "", "text": "Sadly, yours is too keen an intellect to fall for my diabolical cuteness. So instead... sic them, General!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GreatOne_005_05.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Bunny_Vampire_A_NPC.dds", "actor": 0, "name": "Great One"}]},
  {"quest": "WC-CYCLOPS-MAIN-005", "goal": "Goal 1", "tag": "Completion", "replace": true, "lines": [{"persona": "", "text": "So you brought Akilles to heel, doesn't matter. As long as my influence remains over Cyclops Lane, I will never fade!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GreatOne_005_06.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Bunny_Vampire_A_NPC.dds", "actor": 0, "name": "Great One"}, {"persona": "WC_StandIn_GeneralAkilles_Persona", "text": "He's right, you know. His thralls keep him tethered to the physical world. But if he lost them... he'd fade back to the nexus twixt life and death.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GeneralAkilles_005_02.mp3", "picture": "", "actor": 0, "name": "General Akilles"}, {"persona": "WC_StandIn_GeneralAkilles_Persona", "text": "I'm telling you this because I never liked that bunny. I took Cyclops Lane as a distraction for Malistaire's plan - whatever that is.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GeneralAkilles_005_03.mp3", "picture": "", "actor": 0, "name": "General Akilles"}, {"persona": "WC_StandIn_GeneralAkilles_Persona", "text": "We Cyclopes are an honorable people and I was honor-bound to Malistaire for saving my life from a rogue optometrist. Now, I'm honor-bound to you.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GeneralAkilles_005_04.mp3", "picture": "", "actor": 0, "name": "General Akilles"}, {"persona": "WC_StandIn_GeneralAkilles_Persona", "text": "The Great One seized the Watching Eyes, our security system, turning them into Hypno Eyes to lull all the minions on the street all at once.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GeneralAkilles_005_05.mp3", "picture": "", "actor": 0, "name": "General Akilles"}, {"persona": "WC_StandIn_GeneralAkilles_Persona", "text": "Even now, these Crystal Balls maintain his bewitching gaze. Destroy them and his influence over this street will dissipate.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GeneralAkilles_005_06.mp3", "picture": "", "actor": 0, "name": "General Akilles"}]},
  {"quest": "WC-CYCLOPS-MAIN-005", "goal": "Goal 2", "tag": "Completion", "replace": true, "lines": [{"persona": "", "text": "This isn't the end of me, Wizard! I'll be back. Ours will be a rivalry for the ages. You'll see, one day the Great One will return!", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GreatOne_005_07.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Bunny_Vampire_A_NPC.dds", "actor": 0, "name": "Great One"}, {"persona": "WC_StandIn_GeneralAkilles_Persona", "text": "He probably won't return. And his thralls should slowly return to normal. I vow I will honor my word and restore order to this street.", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/GeneralAkilles_005_07.mp3", "picture": "", "actor": 0, "name": "General Akilles"}]},
  {"quest": "WC-FIRECAT-MAIN-006", "goal": "2_WizardQuestGoals_Kill", "tag": "Completion", "lines": [{"persona": "WC-FIRECAT-NPC06_Persona", "text": "Lo, the dark resonance hath been driven from my brain. By the hand of this gentle Wizard, I am again stark raving sane! How can I ever repay you?", "sound": "|Sound_Dialogue_005|WorldData|Sound/Dialogue/AlicaneSwiftarrow_005_02.mp3", "picture": "GUI/NpcPortraits/Portrait_Elf_Fire_B_NPC.dds", "actor": 0}]},
  {"quest": "WC-GRZ-C01-001", "goal": "2_WizardQuestGoalsTalkNPC", "tag": "Completion", "replace": true, "lines": [{"persona": "GH-HUB-NPC01_Persona", "text": "Ho there, outlander. What brings you to Grizzleheim?", "sound": "|Grizzleheim|WorldData|Sound/Dialogue/BjornIronclaw_QST_27.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_BearWarrior_Boss_Black_NPC.dds", "actor": 164449}, {"persona": "GH-HUB-NPC01_Persona", "text": "<ITALICS>You explain that you've been sent to speak with the king of Grizzleheim. </ITALICS>", "sound": "|Grizzleheim|WorldData|Sound/Dialogue/Narrator_NAR_733.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_BearWarrior_Boss_Black_NPC.dds", "actor": 164449}, {"persona": "GH-HUB-NPC01_Persona", "text": "You want to speak with our king? Not today... little Wizard. Our king doesn't just speak with any young cub who asks.", "sound": "|Grizzleheim|WorldData|Sound/Dialogue/BjornIronclaw_QST_28.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_BearWarrior_Boss_Black_NPC.dds", "actor": 164449}]},
  {"quest": "WC-GRZ-C01-002", "tag": "Prep", "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "<ITALICS>Merle hands you a message tube, covered with runes. A letter is rolled up inside. </ITALICS>", "sound": "|Sound_Dialogue_GH|WorldData|Sound/Dialogue/Narrator_NAR_835.mp3", "picture": "", "actor": 38168}, {"persona": "WC-HUB-NPC01_Persona", "text": "<ITALICS>\"$PLAYER_FIRSTNAME$, this is your friend Bjorn. Again I must ask for your help. Ill times have befallen Grizzleheim, and you are a great ally and loyal friend. If you would help us, return to Grizzleheim and find me. </ITALICS>", "sound": "|Sound_Dialogue_GH|WorldData|Sound/Dialogue/Narrator_NAR_836.mp3", "picture": "", "actor": 38168}, {"persona": "WC-HUB-NPC01_Persona", "text": "Trouble in Grizzleheim? You should go and lend what aid you can. As they say in that world, \"The bond of loyalty is stronger than any chain of iron.\"", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_141.mp3", "picture": "", "actor": 38168}]},
  {"quest": "WC-GRZ-C01-002", "goal": "1_WizardQuestGoalsTalkNPC", "tag": "Completion", "replace": true, "lines": [{"persona": "GH-HUB-NPC01_Persona", "text": "Welcome, little Wizard! You show great courage coming to aid us in our struggle. You have my gratitude, no matter what the outcome.", "sound": "|Sound_Dialogue_GH|WorldData|Sound/Dialogue/BjornIronclaw_QST_31.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_BearWarrior_Boss_Black_NPC.dds", "actor": 164449}]},
  {"quest": "WC-GRZ-C01-004", "tag": "Prep", "replace": true, "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "Thank you for coming, young Wizard. Your ally in Grizzleheim sent a message that your presence is wanted.", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_149.mp3", "picture": "", "actor": 38168}, {"persona": "WC-HUB-NPC01_Persona", "text": "I don't think I've ever seen a single student receive so much attention from another world.", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_150.mp3", "picture": "", "actor": 38168}, {"persona": "WC-HUB-NPC01_Persona", "text": "You've proven to be an excellent ambassador to Grizzleheim... I'm pleased my instincts served me well in selecting you.", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_151.mp3", "picture": "", "actor": 38168}, {"persona": "WC-HUB-NPC01_Persona", "text": "And now... to Grizzleheim!", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_152.mp3", "picture": "", "actor": 38168}]},
  {"quest": "WC-GRZ-C01-004", "tag": "Underway", "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "Are you on your way to Grizzleheim? You remember the way, right?", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/MerleAmbrose_QST_147.mp3", "picture": "", "actor": 38168}]},
  {"quest": "WC-GRZ-C01-004", "goal": "1_WizardQuestGoalsTalkNPC", "tag": "Completion", "replace": true, "lines": [{"persona": "GH-HUB-NPC01_Persona", "text": "Welcome, $PLAYER_FIRSTNAME$, great ally of Grizzleheim! I speak to you as your friend, and I regard you as my equal.", "sound": "|Sound_Dialogue_GH|WorldData|Sound/Dialogue/BjornIronclaw_QST_33.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_BearWarrior_Boss_Black_NPC.dds", "actor": 164449}, {"persona": "GH-HUB-NPC01_Persona", "text": "You have earned the respect and loyalty of our people, and shown us that your heart is that of a fierce warrior.", "sound": "|Sound_Dialogue_GH|WorldData|Sound/Dialogue/BjornIronclaw_QST_34.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_BearWarrior_Boss_Black_NPC.dds", "actor": 164449}, {"persona": "GH-HUB-NPC01_Persona", "text": "Though your presence in our land is always an honor, there is dark business at hand...", "sound": "|Sound_Dialogue_GH|WorldData|Sound/Dialogue/BjornIronclaw_QST_35.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_BearWarrior_Boss_Black_NPC.dds", "actor": 164449}]},
  {"quest": "WC-MAIN-C01-013", "tag": "Underway", "lines": [{"persona": "WC-HUB-NPC01_Persona", "text": "Have you gone through the Spiral Door to Celestia? The magic of the stars awaits you... and those poor explorers may be in peril!", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MerleAmbrose_CEL_06.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds", "actor": 38168}]},
  {"quest": "WC-MAIN-C01-013", "goal": "1_WizardQuestGoals_Explore", "tag": "Completion", "lines": [{"persona": "CL-HUB-NPC001_Persona", "text": "Oh, hello there! Did you get our distress call?", "sound": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/EdithBenchley_CEL_01.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-OLDE-MAIN-001", "goal": "Goal 5", "tag": "Completion", "lines": [{"persona": "", "text": "Meow!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/CaptivePet_002_02.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Firecat_NPC.dds", "actor": 0, "name": "Captive Pet"}]},
  {"quest": "WC-PreCel-MAIN-001", "goal": "1_WizardQuestGoals00000662", "tag": "Completion", "lines": [{"persona": "WC-RAV-NPC07_Persona", "text": "Young Wizard, you have done well to thwart the thief of my Eye. It was a shame he no longer had the Eye itself. What became of it... I can't remember...", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Bartleby_WC-PreCel_001.mp3", "picture": "", "actor": 0}, {"persona": "WC-RAV-NPC07_Persona", "text": "But I do remember - or I imagined - there was more to your quest than one rogue Necromancer. A chill wind is blowing... but I can't... quite grasp...", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Bartleby_WC-PreCel_002.mp3", "picture": "", "actor": 0}, {"persona": "WC-RAV-NPC07_Persona", "text": "You must prepare. You must harness magicks beyond that of the average student. You must study the practice of Archmastery.", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Bartleby_WC-PreCel_003.mp3", "picture": "", "actor": 0}, {"persona": "WC-RAV-NPC07_Persona", "text": "So far, you have wielded the power of one of the seven Schools, but with diligence, with skill, with mastery, you can harness them all.", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Bartleby_WC-PreCel_004.mp3", "picture": "", "actor": 0}, {"persona": "WC-RAV-NPC07_Persona", "text": "The Duelmaster in Unicorn Way, Diego, he can teach you the finer points. And Wizard...", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Bartleby_WC-PreCel_005.mp3", "picture": "", "actor": 0}, {"persona": "WC-RAV-NPC07_Persona", "text": "...Beware the Shadow.", "sound": "|Sound_Dialogue_KT_SL_and_SpellWeaving|WorldData|Sound/1.560_Dialogue/Bartleby_WC-PreCel_006.mp3", "picture": "", "actor": 0}]},
  {"quest": "WC-TRITON-MAIN-008", "goal": "Goal 2", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-TRITON-NPC05-C_Persona", "text": "You did it, Wizard! Triton Avenue is saved.", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/SuzieGryphonbane_002_11.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Girl_Storm02.dds", "actor": 1451968}, {"persona": "WC-TRITON-NPC05-C_Persona", "text": "You didn't happen to run into my little brother Artur anywhere, did you?", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/SuzieGryphonbane_002_11b.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Girl_Storm02.dds", "actor": 1451968}, {"persona": "WC-TRITON-NPC05-C_Persona", "text": "He's all right? Thank goodness. Take me to him - it'll be so good to see him again!", "sound": "|Sound_Dialogue_002|WorldData|Sound/Dialogue/SuzieGryphonbane_002_12.mp3", "picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Girl_Storm02.dds", "actor": 1451968}]},
  {"quest": "WC-UNDER-C02-001", "goal": "1_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You find a key marked with the image of a white tower. </ITALICS>", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/Narrator_GH2_125.mp3", "picture": "GUI/QuestButtons/Quest_DS_Key.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C03-001", "goal": "2_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>Why would they attack you? Cromshell should hear about this! </ITALICS>", "sound": "|Sound_Dialogue|WorldData|Sound/Dialogue/Narrator_GH2_126.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CrabKings_Cromshell.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C03-003", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "What are you doing there? The King is receiving no visitors today. He is awaiting his tea and the royal crumpets.", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RoyalGuard_GH2_06.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_03_NPC.dds", "actor": 0, "name": "Royal Guard"}, {"persona": "", "text": "Away with you!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RoyalGuard_GH2_07.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_03_NPC.dds", "actor": 0, "name": "Royal Guard"}]},
  {"quest": "WC-UNDER-C04-002", "goal": "1_WizardQuestGoals00000274", "tag": "Completion", "lines": [{"persona": "", "text": "You have the tea and the crumpets? It’s about time. His Majesty was getting very hungry. Go on in.", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RoyalGuard_GH2_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_03_NPC.dds", "actor": 0, "name": "Royal Guard"}]},
  {"quest": "WC-UNDER-C04-002", "goal": "2_WizardQuestGoalsTalkNPC", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The King dismisses you with a curt nod. You've seen what you needed to see, though. </ITALICS>\\n", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_127.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_King_NPC.dds", "actor": 0}, {"persona": "", "text": "<ITALICS>The Riverclaw called Amadeo is dressed in King Thermidor’s royal garb.</ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_166.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_King_NPC.dds", "actor": 0}, {"persona": "", "text": "<ITALICS>The disguise is cunning, but it was obvious to you that the King is an impostor! </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_128.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_King_NPC.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C05-001", "goal": "1_WizardQuestGoals00000018", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You find the King's Seal in a drawer filled with letters and CDs. Sir Thomas will need that! </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_129.mp3", "picture": "GUI/QuestButtons/Quest_Royal_Order.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C05-001", "goal": "3_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You show the guards the royal seal. They let you pass. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_130.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_02_NPC.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C05-001", "goal": "4_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You pass through the breach in the river wall and enter the Deep Warrens. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_131.mp3", "picture": "GUI/QuestButtons/Art_Quest_Location_SunkTritonAvenue.dds", "actor": 0}, {"persona": "", "text": "<ITALICS>You should look for any clues to the whereabouts of the King or any of his Royal Guard. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_132.mp3", "picture": "GUI/QuestButtons/Art_Quest_Clue_Search.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C06-004", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>A small passageway into the Alcazar is hidden back here, but it's too dark to navigate. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_133.mp3", "picture": "GUI/QuestButtons/Location_CL_Angler_Cave.dds", "actor": 0}, {"persona": "", "text": "<ITALICS>Maybe Captain Roderick will have an idea what to do next. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_134.mp3", "picture": "GUI/QuestButtons/Location_CL_Angler_Cave.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C06-005", "goal": "1_WizardQuestGoals00000058", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You now have a school's worth of Glowfish. You should take them to the dark passage by the Alcazar. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_135.mp3", "picture": "GUI/QuestButtons/Art_Quest_Glowfish.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C06-005", "goal": "2_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You release the Glowfish. They swim into the dark, lighting the passage. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_136.mp3", "picture": "GUI/QuestButtons/Art_Quest_Glowfish.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C06-005", "goal": "3_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You enter the secret passage. You wonder where it leads. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_137.mp3", "picture": "GUI/QuestButtons/Location_CL_Angler_Cave.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C06-005", "goal": "4_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You have entered the Wailing Cavern! Now to find the King! </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_138.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_NPC.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C07-001", "goal": "1_WizardQuestGoals00000018", "tag": "Completion", "lines": [{"persona": "", "text": "Ah... thank you for freeing us! I thought we were boiled for sure!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RoyalGuard_GH2_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_02_NPC.dds", "actor": 0, "name": "Missing Guard"}, {"persona": "", "text": "Is the King safe? One of those Riverclaws claimed that their super-smart science guy started this whole problem!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RoyalGuard_GH2_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_02_NPC.dds", "actor": 0, "name": "Missing Guard"}, {"persona": "", "text": "He was mucking about with something called a Storm Battery. Can you believe that? I've never heard such nonsense!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RoyalGuard_GH2_04.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_02_NPC.dds", "actor": 0, "name": "Missing Guard"}]},
  {"quest": "WC-UNDER-C07-002", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>An electrified gate! Someone doesn't want you getting inside. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_139.mp3", "picture": "GUI/QuestButtons/Quest_WC_ElectricGate.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C07-003", "goal": "1_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>You think you have enough Telluric Eels to try to overload the gate. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_140.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Electric_Eel_01.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C07-003", "goal": "3_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>This must be the Storm Chamber. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_141.mp3", "picture": "GUI/QuestButtons/Quest_WC_StormChamber.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C08-002", "goal": "1_WizardQuestGoals00000256", "tag": "Completion", "lines": [{"persona": "", "text": "<ITALICS>The Storm Batteries look like they have been restored to working order. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_142.mp3", "picture": "GUI/QuestButtons/Quest_WC_StormBattery.dds", "actor": 0}]},
  {"quest": "WC-UNDER-C09-001", "goal": "1_WizardQuestGoalsExplore", "tag": "Completion", "lines": [{"persona": "", "text": "Hmm, the Royal Seal, huh? Of course... go right in.", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/RoyalGuard_GH2_05.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_03_NPC.dds", "actor": 0, "name": "Guardsman"}]},
  {"quest": "WC-UNDER-C09-001", "goal": "3_WizardQuestGoalsKill", "tag": "Completion", "lines": [{"persona": "WC-TU-NPC03_Persona", "text": "Arrggh! I am undone! To be defeated, in such a strange and foreign land... For shame!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/KingAmadeo_GH2_10.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_King.dds", "actor": 459073, "name": "King Amadeo"}]},
  {"quest": "WC-UNDER-C10-001", "goal": "2_WizardQuestGoalsTalkNPC", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-TU-NPC05_Persona", "text": "You did it! How is King Thermidor? I pray he's not too shaken up by his ordeal?", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Catherine_GH2_16.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Katherine_NPC.dds", "actor": 358243}, {"persona": "WC-TU-NPC05_Persona", "text": "A poem? For me? Oh yes, yes... please read it aloud!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Catherine_GH2_17.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Katherine_NPC.dds", "actor": 358243}, {"persona": "", "text": "<ITALICS>You take out the poem and begin to read. </ITALICS>", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Narrator_GH2_144.mp3", "picture": "GUI/QuestButtons/Quest_GH_CensusRack.dds", "actor": 0}, {"persona": "", "text": "Lo! In my darkest times away from this place, You were my light... my beacon, my grace!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/KingThermidor_GH2_33.mp3", "picture": "GUI/QuestButtons/Quest_GH_CensusRack.dds", "actor": 0, "name": "King Thermidor"}, {"persona": "", "text": "Though I paid you no heed, You stayed loyal in time of need!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/KingThermidor_GH2_34.mp3", "picture": "GUI/QuestButtons/Quest_GH_CensusRack.dds", "actor": 0, "name": "King Thermidor"}, {"persona": "", "text": "Your claws, how dainty, as they mold your sweet tarts, Your kindness has cracked this crab's shell apart!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/KingThermidor_GH2_35.mp3", "picture": "GUI/QuestButtons/Quest_GH_CensusRack.dds", "actor": 0, "name": "King Thermidor"}, {"persona": "WC-TU-NPC05_Persona", "text": "That was lovely! Please show the King my deepest gratitude!", "sound": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/Catherine_GH2_18.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Katherine_NPC.dds", "actor": 358243}]},
  {"quest": "WC-UNICORN-MAIN-008", "goal": "1_WizardQuestGoals_TalkNPC", "tag": "Completion", "replace": true, "lines": [{"persona": "WC-HUB-NPC03_Persona", "text": "Well, hello there. I don't think I've seen you in the Library before. I'm Harold Argleston, master librarian extraordinaire.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/HaroldArgleston_001_01.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds", "actor": 0}, {"persona": "WC-HUB-NPC03_Persona", "text": "You say you recovered this Tome from an Underworld tyrant who was going to give it to his Dark Master, Malistaire?", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/HaroldArgleston_001_02.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds", "actor": 0}, {"persona": "WC-HUB-NPC03_Persona", "text": "My, my, I do believe this is a matter for Headmaster Ambrose. You should take the Tome to him at once!", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/HaroldArgleston_001_03.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds", "actor": 0}, {"persona": "WC-HUB-NPC03_Persona", "text": "Ehh, but before you go, allow me to reward you for your heroics. Please accept this Treasure Card on behalf of the denizens of Wizard City.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/HaroldArgleston_001_04.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds", "actor": 0}, {"persona": "WC-HUB-NPC07_Persona", "text": "Treasure Cards are special one-use spells of various schools. You can purchase Treasure Cards from vendors or Craft them yourself.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_12.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0, "name": "Gamma"}, {"persona": "WC-HUB-NPC07_Persona", "text": "Press \"P\" to open your Spell Deck. Treasure Cards are listed under a special tab and are placed into the Sideboard of your Deck.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_13.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0, "name": "Gamma"}, {"persona": "WC-HUB-NPC07_Persona", "text": "During combat, right-click a regular card to discard it, then select DRAW to bring out a Treasure Card from your Sideboard.", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_14.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0, "name": "Gamma"}, {"persona": "WC-HUB-NPC07_Persona", "text": "Remember, unlike regular Spell Cards, Treasure Cards can only be used once. So use them wisely!", "sound": "|Sound_Dialogue_001|WorldData|Sound/Dialogue/Gamma_001_15.mp3", "picture": "GUI/NpcPortraits/Art_Portrait_Gamma.dds", "actor": 0, "name": "Gamma"}]},
