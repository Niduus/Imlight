<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads the game's own quest files (CSR.wad QuestData/*.xml) into the server's quest types: repairs the quests rebuilt
       from Wizard404 and writes the ones the server lacks. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Imlight.CoreLib\Imlight.CoreLib.csproj" />
  </ItemGroup>
</Project>
