{
  "Format": "Ahziael overlay add-on",
  "Name": "Quest Team Spectator",
  "Author": "Niduus",
  "Description": "Watch the Quest Team, one wizard at a time: its own minimap follows that wizard and draws the team's quest way, a quest box shows the team's quest and step, in battle a spells box shows that wizard's hand, pips and what it casts, the map's border takes the watched wizard's school colour, the Next member button switches between Freya (Ice), Terra (Life), Anubis (Death) and Chaac (Storm), the four name buttons (or a click on a name in the quest box) go straight to the wizard you want to watch and it is remembered next time, and Go to takes you right next to that wizard. The quest box also shows which main world they are in (World 3 of 19), which story quest of it they are on (like Quest 14/52 in Marleybone), about how long until the next world at their own pace, and a red line when a quest takes much longer than usual. Only the four team members can be watched. Needs the Minimap add-on downloaded and the Quest Team on.",
  "Version": "4",
  "Requires": [ "Minimap" ],
  "Widgets": [
    {
      "Name": "Quest Team Spectator (map, quest, spells and Next member)",
      "Elements": [
        {
          "Kind": "UltimusMap", "Watch": "QuestTeam", "Name": "Quest Team Minimap", "Anchor": "TopRight", "X": 12, "Y": 70, "Width": 180, "Height": 180,
          "Background": { "Kind": "Radial", "Color1": "#C8203040", "Color2": "#C80A141C" },
          "BorderColor": "#D07CC8FF", "BorderWidth": 2, "CornerRadius": 16, "Shadow": true, "ShadowBlur": 8,
          "Map": { "Zoom": 2500 }
        },
        {
          "Kind": "UltimusQuest", "Watch": "QuestTeam", "Name": "Quest Team Quest", "Anchor": "TopRight", "X": 12, "Y": 330, "Width": 220, "Height": 0, "Size": 13,
          "Fill": { "Kind": "Solid", "Color1": "#FFFFFFFF" },
          "Background": { "Kind": "Solid", "Color1": "#B40C1622" }, "Padding": 10,
          "BorderColor": "#A07CC8FF", "BorderWidth": 1, "CornerRadius": 12, "Shadow": true, "ShadowBlur": 8
        },
        {
          "Kind": "Button", "Action": "TeamNext", "Name": "Quest Team: next member", "Text": "Next member", "Anchor": "TopRight", "X": 74, "Y": 258, "Width": 118, "Height": 30,
          "Size": 13, "Fill": { "Kind": "Solid", "Color1": "#FFFFFFFF" },
          "Background": { "Kind": "Solid", "Color1": "#D00C1622" },
          "BorderColor": "#D07CC8FF", "BorderWidth": 1, "CornerRadius": 8
        },
        {
          "Kind": "Button", "Action": "TeamWatch", "Command": "Freya", "Name": "Quest Team: watch Freya", "Text": "Freya", "Anchor": "TopRight", "X": 147, "Y": 294, "Width": 43, "Height": 28,
          "Size": 11, "Fill": { "Kind": "Solid", "Color1": "#FFFFFFFF" },
          "Background": { "Kind": "Solid", "Color1": "#D00C1622" },
          "BorderColor": "#D06EC8FF", "BorderWidth": 1, "CornerRadius": 8
        },
        {
          "Kind": "Button", "Action": "TeamWatch", "Command": "Terra", "Name": "Quest Team: watch Terra", "Text": "Terra", "Anchor": "TopRight", "X": 102, "Y": 294, "Width": 43, "Height": 28,
          "Size": 11, "Fill": { "Kind": "Solid", "Color1": "#FFFFFFFF" },
          "Background": { "Kind": "Solid", "Color1": "#D00C1622" },
          "BorderColor": "#D05CD65C", "BorderWidth": 1, "CornerRadius": 8
        },
        {
          "Kind": "Button", "Action": "TeamWatch", "Command": "Anubis", "Name": "Quest Team: watch Anubis", "Text": "Anubis", "Anchor": "TopRight", "X": 57, "Y": 294, "Width": 43, "Height": 28,
          "Size": 11, "Fill": { "Kind": "Solid", "Color1": "#FFFFFFFF" },
          "Background": { "Kind": "Solid", "Color1": "#D00C1622" },
          "BorderColor": "#D0A8AEB4", "BorderWidth": 1, "CornerRadius": 8
        },
        {
          "Kind": "Button", "Action": "TeamWatch", "Command": "Chaac", "Name": "Quest Team: watch Chaac", "Text": "Chaac", "Anchor": "TopRight", "X": 12, "Y": 294, "Width": 43, "Height": 28,
          "Size": 11, "Fill": { "Kind": "Solid", "Color1": "#FFFFFFFF" },
          "Background": { "Kind": "Solid", "Color1": "#D00C1622" },
          "BorderColor": "#D0B46EFF", "BorderWidth": 1, "CornerRadius": 8
        },
        {
          "Kind": "Button", "Action": "SpectateGoTo", "Command": "questteam", "Name": "Quest Team: go to the member watched", "Text": "Go to", "Anchor": "TopRight", "X": 12, "Y": 258, "Width": 58, "Height": 30,
          "Size": 13, "Fill": { "Kind": "Solid", "Color1": "#FFFFFFFF" },
          "Background": { "Kind": "Solid", "Color1": "#D00C1622" },
          "BorderColor": "#D07CC8FF", "BorderWidth": 1, "CornerRadius": 8
        },
        {
          "Kind": "UltimusSpells", "Watch": "QuestTeam", "Name": "Quest Team Spells", "Anchor": "TopRight", "X": 204, "Y": 70, "Width": 300, "Height": 0, "Size": 13,
          "Fill": { "Kind": "Solid", "Color1": "#FFFFFFFF" },
          "Background": { "Kind": "Solid", "Color1": "#C80C1622" }, "Padding": 10,
          "BorderColor": "#D0FFD24A", "BorderWidth": 1, "CornerRadius": 12, "Shadow": true, "ShadowBlur": 8
        }
      ]
    }
  ]
}
