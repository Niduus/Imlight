<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Every zone loads its objects on many threads at once after a start. The one-heap workstation clean-up stopped
         the whole server thousands of times every few seconds then (70% of the time paused); the server one keeps a
         heap per core and sizes itself to the load. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hand memory the server no longer uses back to the PC sooner: the clean-up packs the big-object area when
         it has gaps instead of keeping them (Niduus, 2026-11-15: the server at 9.4 GB of a 32 GB PC). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="config\akka.conf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\akka.conf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Content\serverdata" />
    <Content Include="Config\Imlight.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Certificates\base" />
    <Content Include="Certificates\base">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Config\Imlight.ini" />
    <Content Include="spiraldb-cache\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Our own data, laid over SpiralDB's (see data/README.md). Both folders of the repo's data/ land in the
      server's spiraldb-extra folder, exactly where they always did, so installed servers and Ahziael see no change:
      - data/spiraldb: server-agnostic records in SpiralDB's own folders and format (quests, drop tables, ...).
      - data/imlight:  this server's own data (boss cheats, shops, Crown Shop, ...).
    -->
    <Content Include="..\..\data\spiraldb\**\*.json" Link="spiraldb-extra\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\imlight\**\*.json" Link="spiraldb-extra\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.33" />
    <PackageReference Include="Akka.Logger.Serilog" Version="1.5.25" />
    <PackageReference Include="Akka.Remote" Version="1.5.33" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Imlight.Common\Imlight.Common.csproj" />
    <ProjectReference Include="..\Imlight.CoreLib\Imlight.CoreLib.csproj" />
    <!-- The bots (bots/): built with the server but never referenced by it. The server loads them on its own from its bots
         folder (Game/BotDoor/BotLoader.cs), so a published bot update can replace them without a new Ahziael. -->
    <ProjectReference Include="..\..\bots\Imlight.Bots.csproj" ReferenceOutputAssembly="false" Private="false" OutputItemType="BotsAssembly" />
  </ItemGroup>

  <Target Name="CopyBotsToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(BotsAssembly)" DestinationFolder="$(OutDir)bots" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BotsAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" DestinationFolder="$(OutDir)bots" SkipUnchangedFiles="true"
          Condition="Exists('@(BotsAssembly->'%(RootDir)%(Directory)%(Filename).pdb')')" />
  </Target>

  <!-- Live patches (Game/LivePatches): how this server was built, for Ahziael ("patchable" or "fast"; Ahziael starts a
       patchable one ready for patches), and, for a patchable one, the server part's code it was built from. -->
  <Target Name="LivePatchesToPublish" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)live-patches/build.txt" Lines="patchable" Overwrite="true" Condition="'$(LivePatches)' == 'true'" />
    <WriteLinesToFile File="$(PublishDir)live-patches/build.txt" Lines="fast" Overwrite="true" Condition="'$(LivePatches)' != 'true'" />
    <ItemGroup Condition="'$(LivePatches)' == 'true'">
      <_LiveBaseline Include="..\Imlight.CoreLib\obj\live-patch-baseline\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)live-patches/baseline" Condition="'$(LivePatches)' == 'true'" />
    <Copy SourceFiles="@(_LiveBaseline)" DestinationFiles="@(_LiveBaseline->'$(PublishDir)live-patches/baseline/%(RecursiveDir)%(Filename)%(Extension)')" Condition="'$(LivePatches)' == 'true'" />
  </Target>

  <Target Name="CopyBotsToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(BotsAssembly)" DestinationFolder="$(PublishDir)bots" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BotsAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" DestinationFolder="$(PublishDir)bots" SkipUnchangedFiles="true"
          Condition="Exists('@(BotsAssembly->'%(RootDir)%(Directory)%(Filename).pdb')')" />
  </Target>

</Project>
