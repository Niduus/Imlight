<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Every zone loads its objects on many threads at once after a start. The one-heap workstation clean-up stopped
         the whole server thousands of times every few seconds then (70% of the time paused); the server one keeps a
         heap per core and sizes itself to the load. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="config\akka.conf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\akka.conf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Content\serverdata" />
    <Content Include="Config\Imlight.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Certificates\base" />
    <Content Include="Certificates\base">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Config\Imlight.ini" />
    <Content Include="spiraldb-cache\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Our own data, laid over SpiralDB's (see data/README.md). Both folders of the repo's data/ land in the
      server's spiraldb-extra folder, exactly where they always did, so installed servers and Ahziael see no change:
      - data/spiraldb: server-agnostic records in SpiralDB's own folders and format (quests, drop tables, ...).
      - data/imlight:  this server's own data (boss cheats, shops, Crown Shop, ...).
    -->
    <Content Include="..\..\data\spiraldb\**\*.json" Link="spiraldb-extra\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\imlight\**\*.json" Link="spiraldb-extra\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.33" />
    <PackageReference Include="Akka.Logger.Serilog" Version="1.5.25" />
    <PackageReference Include="Akka.Remote" Version="1.5.33" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Imlight.Common\Imlight.Common.csproj" />
    <ProjectReference Include="..\Imlight.CoreLib\Imlight.CoreLib.csproj" />
  </ItemGroup>

</Project>
