            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Would you like to see them? They are very cute. They are in the Hatchery Nest near the Hall of Plumage. Tell me what you think!",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/AcanWinefeather_AZT_32.mp3",
