            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello again, Outsider. I was curious if you might be able to assist me.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_C_NPC.dds",
