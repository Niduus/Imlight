                "m_picture": "GUI/NpcPortraits/Portrait_Ghost_Pirate_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/Yadullah_KH2_19.mp3",
