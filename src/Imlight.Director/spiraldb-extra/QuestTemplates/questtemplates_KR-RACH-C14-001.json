                "m_requirements": null,
                "m_dialog": "So many priceless recipes collected from all over the Spiral.",
                "m_picture": "GUI/NpcPortraits/Portrait_Ghost_Pirate_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/Yadullah_KH2_21.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283113,
