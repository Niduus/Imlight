            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you search Weirwood for the scrolls... they would be somewhere in the Wild or the Wyrd.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Otter_Scribe_Francis.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FrancisLux_AVA_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617241,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Return the scrolls and I will bestow upon you special training so you may learn more magic... if that is of interest to you.",
