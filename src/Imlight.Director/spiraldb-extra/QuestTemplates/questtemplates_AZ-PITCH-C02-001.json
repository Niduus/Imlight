            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You want to get into the Pyramid of Mother Moon? I might be able to help with that. But... oh, man, I'm so hungry!",
