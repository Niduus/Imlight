                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Strategy is not my area. It is Piper's area. And she says we obviously need to expose Nana and end the Happiness Initiative.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_SisterF_A_NPC.dds",
