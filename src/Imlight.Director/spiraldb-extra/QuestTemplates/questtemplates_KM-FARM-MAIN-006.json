                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Who is Prudence? My familiar is Piper. But first, she says, we need to counteract the Gobbler Antijoys, sweeten Nana's army and make it harmless.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_SisterF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Samantha_003_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1513106,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-BLACK-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, Piper, I know they can follow the Bread Crumb Trail. But it is invisible. They would need superior senses or a Pet to find it.",
