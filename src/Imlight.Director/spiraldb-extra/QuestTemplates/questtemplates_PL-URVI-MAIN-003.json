            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can't really talk about that, of course, but that's not why you came, is it? No. You want to change your name, don't you? Wait. No? Really?",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Oldman_A_NPC.dds",
