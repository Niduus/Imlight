            "m_dialogEvent": "",
            "m_actorTemplateID": 1346289,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-URVI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh yes. You want to free the prisoners. Of course. I knew that. I was just testing you to make sure. Freeing the prisoners. Yes. Hm.",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Oldman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Nostradonimus_POL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346289,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-URVI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mayor Lassard is who you want. I have foreseen it. I don't know where they're holding him but he's the key to freeing the village.",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Oldman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Nostradonimus_POL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346289,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-URVI-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'll have to convince the Gulag Guards to talk. Rough them up a bit, and they'll tell you where to find the Mayor. Yes. That should work.",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Oldman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Nostradonimus_POL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346289,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
