      "m_displayImage1": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Wizard and I will deal with them. Your focus will be on the Command Console. The key is preventing Medulla from remotely overriding you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_63.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We'll do the same for the Left and Right Eyes, leaving a Crewman behind each time to run the Control Consoles.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_64.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Eventually, Medulla will be forced to investigate personally, allowing the Wizard to sneak into his Headquarters and rescue Mellori.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_65.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-004_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That sounds like a practical plan to me.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Crewman_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Sparck_EMP_94.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401199,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-003_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, I particularly like the teamwork angle, but... what about Medulla?",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_194.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401198,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Medulla is mine.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_66.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You're up first, Beans. Let's go!",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_67.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-001_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yar! Er... sorry. It's been awhile since I've heard a good battle plan. Don't mind me. Hehe. Have fun storming the Squid fortress!",
                "m_picture": "GUI/NpcPortraits/Portrait_Pirate_Cabalist_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Dynt_EMP_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401196,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Slowing the Heart went better than I'd expected. Beans has everything under control. Now for part two of the plan...",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_75.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Alright, Doc, the Wizard and I will signal you when the Sector is clear.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_69.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-NPC005_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Gotcha. Go!",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Crewman_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Beans_EMP_40.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401208,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Qhatlady",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Meeoow! Stop! Why didn't you tell me you were the Bat? Wait... You are the Bat, right? Oh no! Did I just imagine this whole thing? MEEOOWW!",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_CabalistF_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Qhatlady_EMP_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Quiet! Please. Medulla's mind-meddling is what's making you question your thoughts. You're not crazy. Just... spirited.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_70.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401213,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Qhatlady",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yeah? Yeah! You're right! Thank you. Now, if you'll excuse me, I think I need a nap. Just lock up when you're done, K?",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_CabalistF_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Qhatlady_EMP_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "*WHISTLES* All clear, Beans! Get in here!",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_71.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401213,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-NPC005-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Somebody call for a doctor? Sorry, I've always wanted to say that. Wizard, show me how to work the Command Console.",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Crewman_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Beans_EMP_41.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401230,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Excellent, I can already feel our pace slowing. Beans, you stay vigilant at that Console. Don't let Medulla remotely override your command.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_72.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-NPC005-A_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This isn't my first cardiac procedure. I never lost a patient and I've no intention of breaking that streak now.",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Crewman_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Beans_EMP_42.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401230,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-002_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Good. Wizard, let's get back to the others in the Stomach. Quickly!",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_73.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401197,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-SEP-003_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, Bat, I believe congratulations are in order. It feels like we've slowed down considerably.",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_195.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401198,
