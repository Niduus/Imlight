        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are not even the first one to come looking for it. A Fairy came by a while ago. Weird one, she is. Name of Charlene Ward.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_Miner_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Gunter_003_27.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506493,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Kept coming and going between the Mines and the Town and each time she was different. Like she was changing inside and out.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_Miner_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Gunter_003_28.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506493,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "She was transforming, Wizard. Into what, I do not know. But it is not of this world.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_Miner_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Gunter_003_29.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506493,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Ball fell into Mineshaft C. Go take a look if you want, but maybe do not get too close to the thing.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_Miner_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Gunter_003_30.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506493,
            "m_cameraName": ""
          }
        ]
      },
