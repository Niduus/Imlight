            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now, what is it you wanted from Ivan? Oh, you seek old witch, Baba Yaga? This is not so simple. She lives deep in Forlorn Tayg.",
