      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-DARA-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A pestilence is upon this land where ruffians can threaten an honest shrubber. Nothing is sacred!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Water_Mole_Roger.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/RogertheShrubber_AVA_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 617292,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-DARA-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Thank you for your aid. I am a shrubber. My name is Roger the Shrubber, and I arrange, sell, and tend to shrubberies.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Water_Mole_Roger.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/RogertheShrubber_AVA_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 617292,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-DARA-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I am trapped in this region, for there are rude beasts who threaten me. Could you defeat the Handsome Fomori to help me?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Water_Mole_Roger.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/RogertheShrubber_AVA_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 617292,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-DARA-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Those creatures will not let me leave this region... so savage are their feelings about shrubbery and shrubbers in general.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Water_Mole_Roger.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/RogertheShrubber_AVA_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 617292,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-DARA-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Defeat a handful of them, and return to me when the path is less perilous.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Water_Mole_Roger.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/RogertheShrubber_AVA_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 617292,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-DARA-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you think it is safe, I will make my way back to Caliburn and speak to Sumner Fieldgold.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Water_Mole_Roger.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/RogertheShrubber_AVA_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 617292,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-DARA-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I will see that you receive a badge for your interest in gardening, and your aid to me. You can collect it from Sumner.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Water_Mole_Roger.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/RogertheShrubber_AVA_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 617292,
