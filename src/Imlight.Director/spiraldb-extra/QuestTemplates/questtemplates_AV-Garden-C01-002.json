      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You've done wonders for the décor around here, but I am afraid I have no time for gardening. I must ask another favor.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Badger_Merchant_SumnerFieldgold_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SumnerFieldgold_AVA_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 602076,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is a famed gardener, a man named Roger. He is a fair hand with tree and leaf, and can care for my shrubberies.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Badger_Merchant_SumnerFieldgold_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SumnerFieldgold_AVA_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 602076,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Roger has been absent from these parts, after tending to a delivery in Dun Dara. I fear he's run into trouble.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Badger_Merchant_SumnerFieldgold_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SumnerFieldgold_AVA_18.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 602076,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HUB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you find Roger and help him get back to Caliburn? See to it that nothing stands in his path, barring his return.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Badger_Merchant_SumnerFieldgold_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SumnerFieldgold_AVA_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 602076,
            "m_cameraName": ""
          }
        ]
