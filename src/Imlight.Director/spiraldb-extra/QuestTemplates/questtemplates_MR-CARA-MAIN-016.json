                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings and salutations, my fine friend! You are new to the city - are you not? Ah, then come closer! There are things you must know.",
