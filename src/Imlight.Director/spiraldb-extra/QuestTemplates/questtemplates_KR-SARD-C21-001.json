            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Please speak with my daughter, Zharellia. You're the only person who can convince her not to join the Umbra Legion.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_MerchantF_J_NPC.dds",
