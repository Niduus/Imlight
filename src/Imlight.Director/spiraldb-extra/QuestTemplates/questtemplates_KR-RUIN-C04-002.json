                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greeting, Wizard. I have been reduced by the Shadow for an age. I owe you a great debt.",
                "m_picture": "GUI/NpcPortraits/Portrait_Crab_Celestial_A_NPC.dds",
