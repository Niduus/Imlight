                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I retrieved this extinguished Starstuff from the bottom of the deep. This is what I can give you. I hope it will help.",
                "m_picture": "GUI/NpcPortraits/Portrait_Crab_Celestial_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/CelestialCrab_KH2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283108,
                "m_cameraName": ""
              },
