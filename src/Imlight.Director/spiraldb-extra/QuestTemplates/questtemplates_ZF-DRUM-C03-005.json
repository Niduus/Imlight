            "m_dialogEvent": "",
            "m_actorTemplateID": 466194,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-DRUM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But I don't know how to find it!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Assistant_Professor_Umlilo_Sunchaser.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/UmliloSunchaser_ZFA_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466194,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-DRUM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is a shadow-touched Elephant barge at the docks, filled with these evil black bricks from the quarry.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Assistant_Professor_Umlilo_Sunchaser.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/UmliloSunchaser_ZFA_20.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466194,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-DRUM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The barge captain, Aksil Blacktrunk, likely knows the way. Rap his trunk!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Assistant_Professor_Umlilo_Sunchaser.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/UmliloSunchaser_ZFA_21.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466194,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-DRUM-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Also... take a shard of the Eternal Flame. Use it to put the barge out of commission. Keep those bricks away from Stone Town!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Assistant_Professor_Umlilo_Sunchaser.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/UmliloSunchaser_ZFA_22.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466194,
            "m_cameraName": ""
          }
        ]
      },
