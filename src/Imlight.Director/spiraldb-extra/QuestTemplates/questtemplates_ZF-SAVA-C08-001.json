            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KakutaDarkmane_ZFA_26.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466164,
