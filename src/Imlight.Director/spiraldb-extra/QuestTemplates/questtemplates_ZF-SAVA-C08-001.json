            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It was long held by King Mansa of the Ghostmane tribe. But he was killed by his brother, Nergal, a mad sorcerer.",
