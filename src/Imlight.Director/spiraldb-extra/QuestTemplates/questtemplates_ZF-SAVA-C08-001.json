            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Ghostmane Lions around Nemean Rock are all wild now. If your pride went there, I fear they have met their doom.",
