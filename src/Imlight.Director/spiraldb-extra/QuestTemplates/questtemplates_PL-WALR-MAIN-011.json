          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I am glad you are the ones who volunteered for this operation. I can think of no one better suited for the job.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_46.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340496,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Look there, across the city. You see that ugly flag? That's the flag of Walruskberg flying high, the Empress's crown looming over us all.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_47.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340496,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You must fight your way into that tower and use the Flag Control Pulley to raise the proud flag of Penguinonia in its place.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_48.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340496,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That's the signal to Patriôtes across the city to attack. We will subdue the Enforcers and the city will be ours!",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_49.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340496,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I would ask how you fared, but it's plain to see!",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_50.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340496,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "For the first time in many seasons, the flag of Penguinonia flies over the city once again! It is a proud moment!",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_A_NPC.dds",
