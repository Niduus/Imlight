          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-GUM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is another fiend about. A maniac and pugilist by the name of Treemugger. He's wanted in three forests for punching trees.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gnome_Ranger_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GnomeRanger_003_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-GUM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You see, Valued Customer, the man has an anger to him. Long has he harbored a grudge against arboreal life ever since a tree fell on his father.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gnome_Ranger_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GnomeRanger_003_20.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-GUM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "His father was fine, but the Treemugger was incensed. Now he travels Karamelle, punching trees to avenge the slight inconvenience of his father.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gnome_Ranger_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GnomeRanger_003_21.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1507193,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-GUM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You did so well with the Gobblers, perhaps you are the one at last to make Treemugger see reason, to help him learn Gumdrop Trees are not his enemies.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gnome_Ranger_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GnomeRanger_003_22.mp3",
            "m_action": "",
