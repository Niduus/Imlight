              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-TRITON-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "He's likely working out at the Oasis. You could always ask one of the Manders there... I think he may be working for the Athame vendor, Keiser Hal'am. Pitter kept muttering something about the slow knife...",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/SohomerSunblade_QST_13.mp3",
