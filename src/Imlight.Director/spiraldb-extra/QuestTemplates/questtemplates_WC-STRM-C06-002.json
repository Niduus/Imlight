                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings, young Wizard! It's a banner day for me here... so many visits when I was forsaken for so long. What can I do for you?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_38.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Pitter Daybreeze? Now that's a name I haven't heard in quite a few years. He came here some time ago... my memory fails me as to when, and asked about a good place to set up a workshop.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_39.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I believe he settled upon the Labyrinth as his optimal destination. I'd search there... that's your best chance of finding what you're after.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MilosBookwyrm_QST_40.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
