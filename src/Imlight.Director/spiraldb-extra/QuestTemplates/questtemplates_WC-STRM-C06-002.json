                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Pitter Daybreeze? Oh, no... young Wizard. Can't help you there. He departed a while ago. Headed over to Krokotopia. You should go ask about him there.",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/SohomerSunblade_QST_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38147,
