  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm crackling with anticipation for the Pattern. Have you retrieved it from Pitter Daybreeze? He works at the Storm Mill for Sohomer Sunblade, over on Triton Avenue.",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfHalstonBalestrom_QST_73.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now that we've got the Component Parts, the next step is to assemble the Oscillation Overthruster. We need a specialized diagram called a Pattern for that. This is unfortunately a task beyond any I know how to do.",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfHalstonBalestrom_QST_74.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But don't fret! I know just the fellow who can help you! Pitter Daybreeze is his name! He's a reclusive, eccentric fellow, but very much the mental giant.",
            "m_picture": "GUI/NpcPortraits/Portrait_Frog_Balestrom_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfHalstonBalestrom_QST_75.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
