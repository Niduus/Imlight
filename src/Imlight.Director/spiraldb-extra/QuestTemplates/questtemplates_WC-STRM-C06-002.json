          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-HUB-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Welcome to my shop! How can I help you today?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Yellow_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/KeisarHalam_QST_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39510,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-HUB-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Pitter Daybreeze? I am afraid that I cannot be of much assistance in that matter. Mr. Daybreeze only worked in my shop for a brief time. He found that the desert climate was too much for him... he kept complaining about the dunes.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Yellow_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/KeisarHalam_QST_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39510,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-HUB-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I suspect he met his fate in Dragonspyre. He found a nice tower amongst the ruins, but once the Dragon Titan's army ventured into that place, he was never heard from again.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Yellow_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/KeisarHalam_QST_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39510,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KT-HUB-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you seek any of his papers, you will find them amongst the ruins of Dragonspyre. Your best hope is to check the Atheneum, and ask Milos Bookwyrm there where Pitter's workshop is to be found.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Yellow_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/KeisarHalam_QST_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39510,
                "m_cameraName": ""
              }
            ]
          }
        ]
