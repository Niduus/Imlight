                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hrum. A fine weapon. It could be a help in the upcoming battles, for many of your foes will be well-versed in Shadow magic.",
                "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/OldCob_KH2_49.mp3",
