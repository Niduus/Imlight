            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Night Orb is a drop of Shadow magic frozen in physical form. It is night, and dark, and chaos you can hold in your hand.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/OldCob_KH2_42.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1233438,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Night Orb is a conduit to the Shadow Web. On its own, it could give an individual the gift of Shadow magic without study.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/OldCob_KH2_43.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1233438,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hrum. But we can instead embed it here, to allow others to tap into the river of magic.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/OldCob_KH2_44.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1233438,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC25_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard, use the Night Orb to make the Fountain of Night flow. Then speak to Azealia the ArmsMaster.",
            "m_picture": "GUI/NpcPortraits/Portrait_Spider_Grandfather_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/OldCob_KH2_45.mp3",
            "m_action": "",
