            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am ashamed to say, I don't even know what ails him. Maybe Bartleby himself knows what's wrong. Would you be a dear and go ask him?",
