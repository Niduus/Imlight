            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bartleby's been standing here, strong and healthy, ever since... well, ever since the dawn of time. To see him sick... it worries me.",
