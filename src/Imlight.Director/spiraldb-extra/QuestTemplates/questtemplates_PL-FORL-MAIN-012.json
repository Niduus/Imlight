  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-BLEAK-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As if we didn't have enough to worry about, now we've got some madman mining Borealis Gemstones! Those gems are supposed to be a secret!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/BabaYaga_POL_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346220,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-BLEAK-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mellori and I re-read every tome here, but we still can't decipher the Auroracle's riddles. Useless wisp gave us more questions than answers!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/BabaYaga_POL_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346220,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-BLEAK-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's madness! Loathe as I am to admit it, I need to consult the Arcanum. Wizard, you'll accompany me. Ivan and Mellori can stay here.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/BabaYaga_POL_18.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346220,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-BLEAK-NPC07-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No fair! I never get to go anywhere! And you're taking the Wizard to the Arcanum? I thought only advanced scholars were allowed there!",
            "m_picture": "GUI/NpcPortraits/Human_Mellori_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Mellori_POL_35.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346213,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-BLEAK-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's not your concern, girl. You can't come. The Osky's sick and needs your help. Besides, I need you to look after the house.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/BabaYaga_POL_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346220,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-BLEAK-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard, let's go. Use the Snow Globe to get to Walruskberg. Then I'll open the World Door to the Arcanum. Well, what are you waiting for?",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/BabaYaga_POL_20.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346220,
            "m_cameraName": ""
          }
        ]
      }
    ]
