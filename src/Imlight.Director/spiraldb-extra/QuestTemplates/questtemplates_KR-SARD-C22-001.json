        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Spellbinder, one of our Fifth Column warrior-sisters, Zoudica the GreenClaw, has become overzealous in her thirst for revolution.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_J_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZeldaPhantomKnight_KH2_30.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Her aim reaches higher than just over-throwing the Shadow Queen. She means to become the new queen of Khrysalis herself.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_J_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZeldaPhantomKnight_KH2_31.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "For us to have any hope against the Shadow, we must be at our full strength. We need Zoudica and her followers.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_J_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZeldaPhantomKnight_KH2_32.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Unfortunately, she misinterprets our pleas for unity as us belittling her. But you pose no threat to her.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_J_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZeldaPhantomKnight_KH2_33.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283121,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you go to her domicile and convince Zoudica and her followers to reinvest their loyalty in the Fifth Column?",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_J_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZeldaPhantomKnight_KH2_34.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283121,
            "m_cameraName": ""
          }
        ]
