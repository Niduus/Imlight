                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "King Shaka Zebu wants to meet you immediately. But he is in the middle of a war council. We must wait until he is free.",
