                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/TseTseSnaketongue_ZFA_42.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465285,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-ZAM-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Show us that the Longdreamer Shamans and Greyhorn Mercenaries are no match for your strong medicine. This will impress Shaka Zebu.",
