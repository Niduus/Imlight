                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I have heard legends of the greatness of you Wizards. It would inspire our warriors greatly to know you fought with them.",
