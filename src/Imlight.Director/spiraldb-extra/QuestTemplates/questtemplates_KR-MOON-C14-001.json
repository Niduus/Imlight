            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Spellbinder, when you faced Ravik Dreamscape you surely noticed a unique form of magic that he used in the duel?",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Summoner_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/SofiaDarkSide_KHR_05.mp3",
