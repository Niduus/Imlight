                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Howdy-do, Wizard? Did you happen to catch any Khrycket concerts? You did? Quick, tell me where they are...",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_Zeke_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ProspectorZeke_KHR_06.mp3",
