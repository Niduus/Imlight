                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, boy! I can't wait to hear all of their sweet stridulations too. Thanks for locating 'em fer me!",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_Zeke_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ProspectorZeke_KHR_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1249027,
                "m_cameraName": ""
              },
