            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Would you be kind enough to keep an ear out for the Khryckets so Ol' Zeke can hear their sweet songs?",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Zeke_A_NPC.dds",
