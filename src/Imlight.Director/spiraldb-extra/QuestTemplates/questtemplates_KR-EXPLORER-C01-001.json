                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Maybe I'll bring my gut bucket, and Ol' Zeke and the Khryckets can give Khrysalis a real show. Shooo-wee! That'll be the day!",
