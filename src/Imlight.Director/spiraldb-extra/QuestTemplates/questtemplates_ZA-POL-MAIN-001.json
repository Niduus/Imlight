      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-SAVA-NPC20-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I say. Good show, Wizard! Come closer now. These Cave Paintings are sure to be less hostile and more informative.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Excavator03.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/AirdaleGuthrie_POL_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367026,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-SAVA-NPC20-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Fascinating! As I suspected, these Paintings reveal just how superstitious the ancient Zafarians were!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Excavator03.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/AirdaleGuthrie_POL_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367026,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-SAVA-NPC20-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Not only did they believe an old, evil spider was imprisoned underground, they thought his children would someday rise and destroy the Spiral!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Excavator03.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/AirdaleGuthrie_POL_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367026,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-SAVA-NPC20-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Here we have the Scorpion, a master Alchemist and ruthless Warlord, prophesied to rise from the desert sands and steal the sun!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Excavator03.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/AirdaleGuthrie_POL_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367026,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-SAVA-NPC20-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This, this is the Bat, a brilliant shapeshifting Vampire, a master of illusion and subterfuge, and with a heart as black as night.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Excavator03.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/AirdaleGuthrie_POL_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367026,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-SAVA-NPC20-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And last, the Rat, eldest of Spider's children, a mad creature of corrupting influence! He steals into men's minds and makes them his puppets!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Excavator03.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/AirdaleGuthrie_POL_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367026,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-SAVA-NPC20-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Can you imagine they actually believed in this hogwash? What-what? Was it something I said? That's all you needed? All right. Give Jaki my regards!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Excavator03.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/AirdaleGuthrie_POL_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1367026,
                "m_cameraName": ""
              }
            ]
          }
