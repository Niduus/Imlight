            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Shadow Queen has not suffered setbacks like these in generations.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ZaltannatheMirrorMask_KHR_43.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223156,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well, not here at the center of her power, at any rate.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ZaltannatheMirrorMask_KHR_44.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223156,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "How have the Burrowers been able to do so much in so little time? You have heard rumors of a spy in the Umbra Legion?",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ZaltannatheMirrorMask_KHR_45.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223156,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Who would risk so much for so little hope, hmmm? It raises the question: \"Why are you here?\"",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ZaltannatheMirrorMask_KHR_46.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223156,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Moon's Crown? The ancient seer, Tymen WhiteFlame, who dwells in Bastion, might know. But take care - he is often thorny.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ZaltannatheMirrorMask_KHR_47.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223156,
            "m_cameraName": ""
          }
        ]
      },
      {
