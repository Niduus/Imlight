            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Seek out Tymen WhiteFlame, an ancient seer, in Bastion. Ask him your questions about the Moon's Crown, but expect a thorny reception.",
