                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Perhaps she disturbed something in those fathomless depths, for neither she nor the Moon's Crown was ever seen again.",
