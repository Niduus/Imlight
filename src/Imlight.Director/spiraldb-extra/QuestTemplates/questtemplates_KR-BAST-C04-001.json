                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Alyssa StarGazer hid in the Winter Halo Caverns. An ancient cave, once home to epic power.",
                "m_picture": "GUI/NpcPortraits/Portrait_Moth_Priest_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/TymenWhiteFlame_KHR_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205103,
