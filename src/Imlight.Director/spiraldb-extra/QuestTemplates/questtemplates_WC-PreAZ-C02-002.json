            "m_personaName": "AZ-PreQuest-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It says, \"Great Magicians of Bartleby, Azteca trembles in the Shadow of Xibalba. Please come at once for our salvation!\"",
