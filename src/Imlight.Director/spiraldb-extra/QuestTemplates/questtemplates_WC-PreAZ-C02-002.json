            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, you got the message, and didn’t lose any fingers. Good, good. Nice Quetzal. Clever girl.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Archologist_A_NPC.dds",
