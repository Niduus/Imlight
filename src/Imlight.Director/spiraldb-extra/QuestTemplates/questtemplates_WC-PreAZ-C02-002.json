            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/EdwardHalley_AZT_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 683138,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-PreQuest-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is signed by three names: Pacal Redmask, Tezcat Threestar, and Zaylin Reedwalker.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Archologist_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/EdwardHalley_AZT_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 683138,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-PreQuest-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why, there’s a Spiral Key here! I thought they were all lost when Azteca was destroyed by a great comet a decade ago.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Archologist_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/EdwardHalley_AZT_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 683138,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-PreQuest-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But perhaps we were all wrong and Azteca persists! Quick, let us look through the telescope at the top of the Observatory!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Dog_Archologist_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/EdwardHalley_AZT_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 683138,
            "m_cameraName": ""
          }
        ]
