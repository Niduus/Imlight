        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh my dear! I’ve translated the text of that stone tablet, and it has an incantation of some sort on it.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_50.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It’s a ritual for summoning some horrible sea-monster, a giant creature that apparently lies dead or dreaming beneath the waves.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_51.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Its name is hard to make out... something with a C.. Cablooey? How strange! Sort of silly and dreadful all at once!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_52.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That sounds risky! The Water Lurkers reside in a cavern not too far from here. Could you go and stop them?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_53.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
