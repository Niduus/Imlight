            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am Pacal Redmask, young Magician. I am one of the three mystics who wove the spells that guided our Messenger to you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC.dds",
