            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The comet Xibalba brought the Shadow Queen to Azteca, and she has laid waste with her Umbra Legion. My allies are gone!",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Shaman_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/PacalRedmask_AZT_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643252,
