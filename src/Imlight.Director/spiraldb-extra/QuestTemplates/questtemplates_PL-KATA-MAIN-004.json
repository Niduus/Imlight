                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS> Meet Ivan the Greater! He's a tribute to you, Ivan. Without you, I could have never finished my work in the Frigid Maw. </ITALICS>",
                "m_picture": "GUI/NpcPortraits/Portrait_Titan_Large_A_MOB.dds",
