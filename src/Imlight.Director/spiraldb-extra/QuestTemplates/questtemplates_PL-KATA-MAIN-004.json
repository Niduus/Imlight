                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I am Jock Coosto, defender of the environment, and now, ironically I fear, an unconscious agent in the Spiral's destruction.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Dockworker_A_NPC.dds",
