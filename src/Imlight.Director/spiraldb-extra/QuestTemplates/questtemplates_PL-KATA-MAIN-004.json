            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I thought Rasputin was just searching for the Sky Anchor Gemstone. Something about this isn't adding up.",
            "m_picture": "GUI/NpcPortraits/Human_Mellori_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Mellori_POL_50.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1370024,
