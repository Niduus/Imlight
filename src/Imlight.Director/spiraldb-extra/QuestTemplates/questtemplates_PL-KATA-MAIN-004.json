                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh no! My big brother! Rasputin is... evil man. Poor Ivan. I take it back. He is Ivan the Greatest. We must avenge him!",
