                "m_personaName": "",
                "m_nameOverride": "Voice of Rasputin",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS> I am confident that he will prove true to his name, but we shall see, shan't we? </ITALICS>",
                "m_picture": "GUI/NpcPortraits/Portrait_Titan_Large_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Rasputin_POL_13.mp3",
