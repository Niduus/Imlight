                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now who is greater? Haha! Ivan is! That's who! No longer am I Ivan the Great; I am now Ivan the Greatest!",
                "m_picture": "GUI/NpcPortraits/Portrait_Bear_Strongman_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IvanTheGreat_POL_82.mp3",
