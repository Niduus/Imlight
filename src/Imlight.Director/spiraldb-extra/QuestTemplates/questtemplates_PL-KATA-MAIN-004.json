            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Meantime, we should gather some Crystal Cores from the golems to study. I'll stay by the Snow Globe. You and Ivan can get the Cores.",
            "m_picture": "GUI/NpcPortraits/Human_Mellori_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Mellori_POL_51.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1370012,
