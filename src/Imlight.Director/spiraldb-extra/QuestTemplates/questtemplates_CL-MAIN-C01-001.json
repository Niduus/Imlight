  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As I said, you should go speak to Dalton Prescott in the Promenade, near the Survey Camp. He can get you squared away!",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Our leader is Sir Thurston Plunkett... but he’s disappeared! He went missing even before the Crustaceans attacked!",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We found this place the long way, by sailing our airship across the Spiral in an attempt to reach ancient, lost Celestia.",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Our airship is on the surface, and we’ve been building air-filled domes so we can explore the sunken ruins.",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Plunkett believes that if we restore the Grand Astrolabe, we can learn the Celestian schools of magic... Stars, Moon, and Sun!",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The missing artifacts that power it are stored in the three Astral galleries... the Stellarium, Lunarium, and Solarium!",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We had almost deciphered the inscriptions on the major portal, when the Crustaceans attacked!",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The ways into each of those places, though, are through the gateway portals, and the portal stones were broken apart and taken!",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you’re here to help us, you should really go speak to Dalton Prescott in the Promenade. He’ll know what needs doing!",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Promenade is connected via one of the access tunnels leading to the Survey Camp. Dalton should be easy to spot.",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_09b.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Prescott is the acting lead of the expedition, until we get Sir Plunkett back.",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Be careful! There are strange things afoot in this place!",
            "m_picture": "",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/EdithBenchley_CEL_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 211488,
