            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Shadow has crawled into the heart of Mother Moon! You must slice out this black stain, Azure Shining One.",
