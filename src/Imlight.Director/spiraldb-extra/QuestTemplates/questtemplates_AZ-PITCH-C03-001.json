            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You need to get into the Pyramid of Mother Moon? Hrrrrrrrrmm.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TonatiuhSunkenMoon_AZT_02.mp3",
