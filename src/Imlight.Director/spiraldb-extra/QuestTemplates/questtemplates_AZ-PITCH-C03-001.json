            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TonatiuhSunkenMoon_AZT_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470560,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-LAKE-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "All the priests are dead and gone. Wait. You need Ozel Underwater Cat. He is dead, and not a priest, but also not gone.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TonatiuhSunkenMoon_AZT_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470560,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-LAKE-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He should know the way in. How do you find Ozel Underwater Cat? I don't know. Ask the Kronosaurs. Forcefully.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TonatiuhSunkenMoon_AZT_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
