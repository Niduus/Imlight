            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TonatiuhSunkenMoon_AZT_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470560,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-LAKE-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You need to enter the Pyramid of Mother Moon as her children used to do. You must walk the path of priests. But I am a humble statue.",
