            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/EvandyrHalfEar_KH2_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283231,
