            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC19_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Really? Nalia has lost her wand? It's a miracle she noticed at all. What kind of Wizard loses their wand?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Pa_Student_B_02_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/RandolfSpellshine_WYS_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465152,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC19_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sure, she dropped it in Tanglewood Way, when she fled in fear. I suppose I could have said something... but why would I?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Pa_Student_B_02_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/RandolfSpellshine_WYS_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465152,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC19_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If she can't keep track of her wand, and it harms her in the tournament, more power to the rest of us, eh?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Pa_Student_B_02_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/RandolfSpellshine_WYS_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465152,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC19_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Go and tell Nalia her wand is still there in Tanglewood Way, if she's brave enough to go get it on her own.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Pa_Student_B_02_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/RandolfSpellshine_WYS_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465152,
                "m_cameraName": ""
              }
            ]
          }
