      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm ruined! My wand... I lost it somewhere, and I can't compete without it! I know we're competitors, but can you help me?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Nalia_Dunestrider_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/NaliaDunestrider_WYS_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465151,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I was with Randolf Spellshine when I lost it. My world of Mirage has few plants, and I wanted to see Tanglewood Way.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Nalia_Dunestrider_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/NaliaDunestrider_WYS_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465151,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Randolf agreed to help me sneak in to see the street, but it was full of strange and scary tree-people. I had to flee!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Nalia_Dunestrider_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/NaliaDunestrider_WYS_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465151,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Maybe Randolf Spellshine knows where my lost wand might be. Could you speak to him and see if he saw where I lost it?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Nalia_Dunestrider_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/NaliaDunestrider_WYS_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465151,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It's on Tanglewood Way? Oh no! I can't go back there!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Nalia_Dunestrider_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/NaliaDunestrider_WYS_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465151,
                "m_cameraName": ""
              }
            ]
