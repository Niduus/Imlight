                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, you've returned... with <ITALICS>one </ITALICS> Kookaburra Egg? Were you too late to save the other one?",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Zander_MIR_20.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340970,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Briar wouldn't give him up? Named him Kiki? I'm so stoked to hear that! It means my words got through to him. As for the other Egg...",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Zander_MIR_21.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340970,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What kind of conduit of wisdom would I be if I didn't urge you to use the majestic little Kookaburra as an exercise in nurturing Life?",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Zander_MIR_22.mp3",
