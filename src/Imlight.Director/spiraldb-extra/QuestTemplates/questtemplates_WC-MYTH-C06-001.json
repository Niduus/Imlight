                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That volume was one of a rotating selection recently sent along to the Royal Museum in Marleybone. Speak to Clancy Pembroke at the Museum... he should be able to get the volume to you. My sincerest apologies for the inconvenience.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Red_NPC02.dds",
                "m_soundFile": "|Sound_Dialogue_KT|WorldData|Sound/Dialogue/Zanne_QST_65.mp3",
