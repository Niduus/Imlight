                "m_personaName": "KT-HUB-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A volume about Orthrus, the two-headed brother to Cerberus? Indeed such a volume is familiar to me... but alas, I have bad news for you.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Salamander_Shopkeeper_Red_NPC02.dds",
