                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You're looking for a book about two-headed dogs? What an amazing coincidence! I just packed up those books a few hours ago and sent them back to the Library in Wizard City.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_MB|WorldData|Sound/Dialogue/ClancyPembroke_QST_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-MUSEHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Normally I'd have needed to take them and mail them myself, but since you helped out at the Marleybone Post Office, they were picked up and sent almost immediately!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_MB|WorldData|Sound/Dialogue/ClancyPembroke_QST_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-MUSEHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So you've come all this way for nothing, I'm afraid. At least you didn't have to go to MooShu, eh? Check back at the Wizard City Library for your book... that rascal Argleston should have it by now.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_MB|WorldData|Sound/Dialogue/ClancyPembroke_QST_19.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              }
            ]
