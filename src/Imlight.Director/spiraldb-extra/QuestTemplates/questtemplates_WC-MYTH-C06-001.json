              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm afraid that the book you seek is likely one of those to have made its way to Krokotopia's Library. Speak to Zan'ne there, and he should be able to assist you in getting the book you need. \\n",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/HaroldArgelston_QST_41.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38214,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello there... you're just the Wizard I wanted to see! I'm embarrassed to note that the book you wanted just arrived. I've got it right here. I set it aside for you, in case Drake sent any more students after it.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/HaroldArgelston_QST_42.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38214,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello there, young Wizard. It's always good to see even our more advanced students paying more attention to the fundamental of education... reading! How can I help you?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/HaroldArgelston_QST_43.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38214,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hmmm... a book about two-headed Orthrus, brother to Cerberus? That'll be a challenge indeed. You see, all of the bestiaries dealing with multi-headed creatures are part of a rotating interlibrary program.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Librarian.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/HaroldArgelston_QST_44.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38214,
                "m_cameraName": ""
              }
            ]
          }
        ]
