                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You've come a long way from Wizard City, young Wizard. How can I help you today?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_MB|WorldData|Sound/Dialogue/ClancyPembroke_QST_16.mp3",
