              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-PARK-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Chimera is a hybrid of dragon, lion, and goat! A creature whose power comes from the struggle between three natures!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Doctor_Purreau.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DoctorPurreau_ZFA_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 175495,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-PARK-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It blends three magic schools: the dragon represents Myth, the goat a symbol of Death, and the Lion is a sign of Life.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Doctor_Purreau.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DoctorPurreau_ZFA_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 175495,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-PARK-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The sight of a Chimera was once thought to be an omen of doom, and it surely will bring doom to the foe you set it against!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Doctor_Purreau.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DoctorPurreau_ZFA_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 175495,
