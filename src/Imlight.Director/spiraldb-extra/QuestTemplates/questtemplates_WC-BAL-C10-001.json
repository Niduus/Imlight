            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "To learn more, you should speak to the expert on such hybrids: Doctor Purreau, in the Pet Pavilion in Wizard City.",
