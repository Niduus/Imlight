            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Greetings, my student! I suspect you know what I've called you here for: a new spell!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Professor_Balance.dds",
