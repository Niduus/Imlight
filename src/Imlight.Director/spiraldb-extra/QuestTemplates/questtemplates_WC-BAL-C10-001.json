                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello! My colleague Alhazred informed me you'd be coming by, so I could refresh my notes on the Chimera.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Doctor_Purreau.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DoctorPurreau_ZFA_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 175495,
