            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you gone to the Fire Dwarves? These Furies are going crazy, oh yah!",
            "m_picture": "GUI/NpcPortraits/Dwarf_IceCitizenF_C_NPC.dds",
