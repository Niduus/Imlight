                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So, Malorn Ashthorn wants me to rate your fighting skills? Okay, I've done that many times for him before. I talk to him because I was once a Death student. Problem was, I was too scared of ghosts.",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_A_NPC.dds",
