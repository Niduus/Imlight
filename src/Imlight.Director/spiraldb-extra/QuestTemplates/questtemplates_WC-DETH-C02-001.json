                "m_actorTemplateID": 38178,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-ST06-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "How about you go and defeat some Gobblers? They are pretty tough for the Wizard City area. I would not want to go up against any...",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/KirbyLongspear_QST_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38178,
