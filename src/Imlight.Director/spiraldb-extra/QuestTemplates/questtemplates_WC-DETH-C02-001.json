                "m_personaName": "WC-ST06-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Impressive indeed. You seem to be living up to your reputation as a Death student. I just wish I could have made it as a student when I was young...",
                "m_picture": "GUI/NpcPortraits/Human_WCShopKeep_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/KirbyLongspear_QST_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38178,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-ST06-NPC04_Persona",
