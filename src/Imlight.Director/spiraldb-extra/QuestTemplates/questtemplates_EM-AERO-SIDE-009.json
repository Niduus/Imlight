                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A Big Bad Wolf? In my little homestead? Nah, I don't think that's the case. 'Fraid your information's a bit off.",
