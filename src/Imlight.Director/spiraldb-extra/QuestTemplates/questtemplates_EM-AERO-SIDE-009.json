                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, well, I reckon you can check inside if you insist. But all you'll find is some fresh-baked biscuits.",
                "m_picture": "GUI/NpcPortraits/Porrait_Human_SeamstressF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Grandma_EM2_03.mp3",
