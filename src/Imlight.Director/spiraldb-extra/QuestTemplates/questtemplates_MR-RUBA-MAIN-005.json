      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Here we are - the Serpentine Gate. The Serpentines built Istanboa to escape the surface, but now, many instead seek to escape Istanboa.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mongoose_Warrior_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TikiMongu_MIR_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397079,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Their leader - Kobra Kommander - maintains a ruthless regime. No one allowed in and no one allowed out of the Gate, except his loyal Vipers.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mongoose_Warrior_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TikiMongu_MIR_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397079,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Fortunately, Taffy is very sneaky. He went in to make contact with our man on the inside. Getting you in will be more difficult.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mongoose_Warrior_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TikiMongu_MIR_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397079,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Gate Captain keeps the Gatehouse locked. Defeat enough Viper Soldiers to lure him out, and I'll sneak in and unlock the door for you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mongoose_Warrior_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TikiMongu_MIR_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397079,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You silly Snakes never watch your backs. Don't worry. We're not here to invade your city. My friend will be in and out before you know it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mongoose_Warrior_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TikiMongu_MIR_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397079,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Don't let his words concern you. The Serpentines' venom is strong, but their threats are often empty. You will be fine.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mongoose_Warrior_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TikiMongu_MIR_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397079,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ISTA-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Throw the Gate Switch and then go through and find Taffy. I'll stay to keep the gate open. Taffy will help you get into the Prison.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mongoose_Warrior_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TikiMongu_MIR_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397079,
                "m_cameraName": ""
              }
            ]
          }
