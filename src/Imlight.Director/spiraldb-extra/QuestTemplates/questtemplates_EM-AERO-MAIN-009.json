      },
      "m_displayImage1": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Thank Raven you're here, Wizard. The Aerobots are going crazy! It seems something's got in there and overrode their dadgum circuits.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MayorQuill_EM2_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447326,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It all started when that cow thing stormed into town, red as a berry patch in summer and meaner than a hornet before breakfast.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MayorQuill_EM2_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447326,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Never seen anything like it... well, come to think of it, I used to have nightmares like this, but never you mind that.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MayorQuill_EM2_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447326,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The bull and the bots have people pinned in their Houses. You gotta help 'em, Wizard.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MayorQuill_EM2_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447326,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You done us a good turn, Wizard, and I'd lend you an Aeroship to Nimbus... but there is the small matter of the Mythies you were to help with.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MayorQuill_EM2_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447326,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Son, that is the single cheesiest thing I have ever heard. You listening to this, Josiah?",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MayorQuill_EM2_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447326,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As a fondue party. Still, Paradox Chain being what it is, it ain't impossible. And if we're the cause, by gum, we'll be the solution.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MayorQuill_EM2_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447326,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Aero Dwarves solve Aero Dwarf problems. Thanks, Wizard. We got it from here. I'll send word to the Aero Pad. Your Aeroship will be waiting.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizen_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/MayorQuill_EM2_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447326,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
