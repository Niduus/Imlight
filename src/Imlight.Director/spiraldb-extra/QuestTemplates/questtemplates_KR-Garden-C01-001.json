            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now that you have restored Bastion to the Burrowers, their health and morale would improve from the presence of a Gardener.",
