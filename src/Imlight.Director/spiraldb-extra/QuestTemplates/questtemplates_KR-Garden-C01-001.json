                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What can I do for you, Spellbinder? First the Bees are willing to talk, and now a Mantis asks a favor? These are strange times.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_C_NPC.dds",
