            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Vegetation is essential for camouflage. Of course, others fancy it for things like decoration and food and whatnot.",
