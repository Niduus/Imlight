            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One of the effects of the Shadow Queen's curse upon Bastion was great harm to the plant life of the area.",
