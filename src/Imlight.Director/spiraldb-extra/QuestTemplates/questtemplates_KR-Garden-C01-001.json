                "m_dialogEvent": "",
                "m_actorTemplateID": 1223168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But since it is you who is asking for her, I'll oblige. I do know of a Gardener, but I doubt he'll want to relocate to Bastion.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ElizarFireBlade_KHR_40.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Barley has been a great friend to us, and we consider him a Burrower. We keep him safe, and he helps us keep the Last Wood alive.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ElizarFireBlade_KHR_41.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1223168,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-LastWood-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You'll find Barley in his garden just round the corner. And Spellbinder, be patient. Barley can be... prickly. But he grows on you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ElizarFireBlade_KHR_42.mp3",
