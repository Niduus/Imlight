            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you examined the damaged monolith over by the entry stairs? Return here with your findings!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator02.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/ThorntonLewis_CEL_09.mp3",
