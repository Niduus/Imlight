            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What do you want? In the depths of your ignorance, what do you want? I sent you to get revenge... er, win a very real, actual war, didn't I?",
