                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Maybe I can fashion another conflict to avenge my old sled. But against which foes? The Shadow Foes!",
                "m_picture": "GUI/NpcPortraits/Portraits_Alphoi_Warrior_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Kane_EMP_07.mp3",
