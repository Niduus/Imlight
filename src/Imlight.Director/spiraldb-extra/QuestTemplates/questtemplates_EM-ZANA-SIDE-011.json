                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You say there actually was a Sani-Bot invasion? I mean... of course there was. I am Ben'ana Foster Kane. Yes, always yes.",
