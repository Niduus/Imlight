                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There you are! I was worried you'd gathered my body parts and just run off and sold them on the black market! Kidding. Trust you, of course.",
