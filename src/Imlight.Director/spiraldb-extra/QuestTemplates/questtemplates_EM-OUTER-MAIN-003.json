                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We pump water into the Core to keep Lava Elementals from rising. The Fire Dwarves vent steam to us to keep the Ice Creatures under control.",
