                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We and our Fire Dwarf cousins in the Core work tirelessly to keep Athanor in balance.",
                "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/GunnarIcebeard_EMP_03.mp3",
