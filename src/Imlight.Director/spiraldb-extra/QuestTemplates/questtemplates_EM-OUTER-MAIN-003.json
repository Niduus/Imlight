                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Bat, Child of Spider, has come to Athanor and is working to destroy us? Ancient legends warn of a time Spider would try to break the Chain.",
