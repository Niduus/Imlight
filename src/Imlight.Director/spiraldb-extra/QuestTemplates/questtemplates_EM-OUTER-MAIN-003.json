                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If we turn off the Pumps the Fire Dwarves burn. If they turn off the Steam Vents, we freeze.",
                "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_D_NPC.dds",
