                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/GunnarIcebeard_EMP_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391504,
