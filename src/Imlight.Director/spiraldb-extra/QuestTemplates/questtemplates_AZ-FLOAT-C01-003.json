      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-FLOAT-NPC01_Persona",
                "m_nameOverride": "Maguey Century Cat",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "When I heard you arrive, my ears became happy. And when you kicked his tailfeathers, my eyes became happy!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MagueyCenturyCat_AZT_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 470551,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-FLOAT-NPC01_Persona",
                "m_nameOverride": "Maguey Century Cat",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Please, Magician, meet me outside!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MagueyCenturyCat_AZT_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 470551,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-FLOAT-NPC01_Persona",
                "m_nameOverride": "Maguey Century Cat",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That vile pigeon Hozanek demanded an offering for the Shadow Queen to give to the Oracle! I would do no so such thing!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MagueyCenturyCat_AZT_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 470551,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-FLOAT-NPC01_Persona",
                "m_nameOverride": "Maguey Century Cat",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But for you, noble Magician, I would be honored. Let me craft a New Day Charm for you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MagueyCenturyCat_AZT_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 470551,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-FLOAT-NPC01_Persona",
                "m_nameOverride": "Maguey Century Cat",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Oracle needs this to be able to read your destiny. Here, breathe onto the Charm to enchant it. Well done!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MagueyCenturyCat_AZT_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 470551,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-FLOAT-NPC01_Persona",
                "m_nameOverride": "Maguey Century Cat",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Here, take this New Day Charm to give the Oracle. Make sure it doesn't fall into the wrong hands!",
                "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MagueyCenturyCat_AZT_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 470551,
