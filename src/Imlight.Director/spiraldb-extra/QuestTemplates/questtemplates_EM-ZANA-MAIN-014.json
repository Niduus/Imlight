                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Captain Thuria, this Beacon was a gift from Raven herself, the light to inspire Empyrea against the Shadow. Please try not to blow it up.",
