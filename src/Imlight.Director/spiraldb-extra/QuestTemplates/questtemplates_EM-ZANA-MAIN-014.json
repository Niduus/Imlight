                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Relax, I won't. Only thing I'm bringing is a Light Net. Hope you don't mind, Wizard, but I recruited your Technologist to handle it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_CaptainF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/CaptainThuria_EM2_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
