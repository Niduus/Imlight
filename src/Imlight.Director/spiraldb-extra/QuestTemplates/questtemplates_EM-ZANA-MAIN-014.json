                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Latest thing off the line from the boys in the Academy. Should stop a Shadow Creature in its tracks. Now, let's go Bat hunting.",
