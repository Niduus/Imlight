                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But tell me, were you able to find the Illuminated Manuscript pages? Wait, BAT DID WHAT? Left them strewn about the floor?",
