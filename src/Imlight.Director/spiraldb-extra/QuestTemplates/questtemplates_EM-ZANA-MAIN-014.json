                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, were you successful? Fantastic! So Thuria is securing the Bat? Wonderful. Hopefully this brings an end to Zanadu's dark chapter.",
