            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've been trying to calm the Rebels down, but they won't hear me out. Being a Bumbai myself, they see me as a traitor, of course.",
