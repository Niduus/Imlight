            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirPerryGilliam_AVA_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617088,
