            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In recent times, when the Froudling army attacked, I was vexed by the thought of the Sword of Kings falling into their hands.",
