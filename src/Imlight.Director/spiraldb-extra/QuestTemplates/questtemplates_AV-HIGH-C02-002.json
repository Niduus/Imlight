            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Years ago I was given charge of the Sword of Kings. Though a squire when King Artorius died, I proved myself a worthy knight.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_DogKnight_Gilliam.dds",
