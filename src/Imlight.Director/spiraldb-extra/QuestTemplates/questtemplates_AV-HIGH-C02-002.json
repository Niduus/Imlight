            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I entrusted it to Sir Brennan Onehand. Last I heard he was battling Red Thorn Knights. Defeat some to find his whereabouts!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_DogKnight_Gilliam.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirPerryGilliam_AVA_13.mp3",
            "m_action": "",
