            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This challenge is from the Aztecosaurs? They claim we have no right to Tula Village!? They abandoned this area!",
            "m_picture": "GUI/NpcPortraits/Portrait_Parrot_Hunter_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/AcanWinefeather_AZT_02.mp3",
