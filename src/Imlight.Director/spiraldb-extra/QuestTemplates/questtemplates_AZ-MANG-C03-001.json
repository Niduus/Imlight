            "m_personaName": "AZ-MANG-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is we Avians who took care of it these past ten cycles, while they were convinced the comet Xibalba would fall upon their heads!",
