            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Still, as much as this Challenge is rightly brought, and we'd fight beak and talon for our rights, I must refuse with shame.",
