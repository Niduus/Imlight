            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It was full of amazing carvings, but before I could examine them, there was a tremor, and heaps of bones rose up to attack me!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_62.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487041,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC01-E_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The confounded things took my notes! Without them I won't be able to translate the carvings. Please, help me retrieve them!",
