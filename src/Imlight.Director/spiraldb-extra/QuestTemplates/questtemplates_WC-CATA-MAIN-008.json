            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/ProfessorHargrove_CAT_61.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1487041,
            "m_cameraName": ""
          },
          {
