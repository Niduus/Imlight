            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I just couldn't help myself; these tunnels are so fascinating! Anyway, I discovered the entrance to a new Chamber.",
