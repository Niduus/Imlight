            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "While you were taking care of things in Dragonspyre, I'm afraid I went off and did some more exploring.",
            "m_picture": "",
