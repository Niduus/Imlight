            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The good news is I know where we are: this is Aeriel. We landed here on my last trip, with Captain Coleridge.",
