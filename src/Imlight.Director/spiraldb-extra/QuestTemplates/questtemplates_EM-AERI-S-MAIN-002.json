                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of course not! The master is our protector and provider. He keeps the Beastmen away so that we are safe.",
                "m_picture": "GUI/NpcPortraits/Portrait_Kalamar_Elder_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Presporo_EMP_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397530,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "From his Tower in the Jungle he sees all. He saw your ship crash, and will no doubt come to greet you. Ah, here he is now!",
                "m_picture": "GUI/NpcPortraits/Portrait_Kalamar_Elder_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Presporo_EMP_04.mp3",
