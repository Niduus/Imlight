            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_28.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397523,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERI-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You tell me we need to repair the Cyclolabe, but first thing's first. Let's see if the World Door we brought made it through the crash.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_29.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397523,
            "m_cameraName": ""
          }
        ]
      },
      {
