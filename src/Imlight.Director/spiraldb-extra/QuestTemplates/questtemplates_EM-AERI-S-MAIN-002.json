                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In the melee, Khan fell into a rocky crevice. I was sure he was dead. I somehow evaded the beastly attackers and retreated to the ship.",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_44.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397523,
