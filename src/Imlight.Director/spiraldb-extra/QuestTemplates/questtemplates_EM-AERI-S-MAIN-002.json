                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We have recovered all of the Windstones from the shipwrecks and given them to the Master. He had need of them.",
                "m_picture": "GUI/NpcPortraits/Portrait_Kalamar_Elder_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Presporo_EMP_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397530,
