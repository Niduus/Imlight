            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The bad news: it's not a very hospitable place. The Jungles inland are very dangerous. Last time we... ran into trouble. Not all of us made it.",
