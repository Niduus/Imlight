                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Welcome, newcomers, to your new home. You need Windstones? They are gone.",
                "m_picture": "GUI/NpcPortraits/Portrait_Kalamar_Elder_A_NPC.dds",
