  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC30_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": ":tik: Tyrian Gorge? :tik: I want to help you, Spellbinder, but it is not within my power.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1205141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC30_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But :tik: Zaltanna the MirrorMask can open the way for you. She can be frosty :tik: so you should play to her tastes.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1205141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC30_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Zaltanna is fond of tea :tik: a strange delicacy from the Spiral. Have you heard of it? Collect these things to impress her.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1205141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC30_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Look around Silent Market for a Sack of Black Salt :tik: and a Bowl of Turmeric Powder. :tik:",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1205141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC30_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'll need an ornate Tea Set. I've seen one in Bastion. The Tea will be the hard part, however. :tik:",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1205141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC30_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Shadow Weaver Veken LimeBlight smuggled in a crate of MooShu Tea. He's here in the Market. You have to make him give it up. :tik:",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1205141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Bastion-NPC30_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Take those things to Zaltanna the MirrorMask. :tik: Then ask her nicely.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1205141,
            "m_cameraName": ""
          }
        ]
