            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You seem to have no end of use. Perhaps I can ask you for another task I am unable to perform...",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ItzcoTwistedObsidian_AZT_30.mp3",
