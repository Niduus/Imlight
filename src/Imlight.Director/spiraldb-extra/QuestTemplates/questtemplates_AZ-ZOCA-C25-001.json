          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I sent a runner to the Gold Frills in Tierra de Brea to remind them of the fealty they owe the new King, Axaya Knifemoon.",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ItzcoTwistedObsidian_AZT_31.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643258,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We have not forgotten their oath...  perhaps they have. Could you seek out the Letter of Fealty? One of them must have it!",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ItzcoTwistedObsidian_AZT_32.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643258,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ask their leader Tlali Long Cave if he has seen the Letter of Fealty, though I fear it never reached his eyes.",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ItzcoTwistedObsidian_AZT_33.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643258,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If this is the case, then find it among the Gold Frills and deliver it to Tlali, to remind them of what they swore.",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ItzcoTwistedObsidian_AZT_34.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643258,
