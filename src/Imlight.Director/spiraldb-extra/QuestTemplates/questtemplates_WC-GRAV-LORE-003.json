                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Aha! Yes. Nothing! You see? Nothing! Nothing at all! That's exactly what I was hoping for! THIS is what counters the impossible possibility!",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_57.mp3",
