                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We still need more research, but I believe we're finally making progress. Keep checking in for your daily assignment. Until tomorrow, then!",
