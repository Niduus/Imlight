      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There you are! I was hoping you would check in today. I think all our work is on the verge of paying off. I have a theory!",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_49.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes. I think I know the reason why some areas of the Spiral have a greater concentration of Pekrons than others.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_50.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I cannot tell you just yet. I need your help with an experiment to test my theory and I want to make sure you remain unbiased.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_51.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If I am right, then this Shadow Magic I've been hearing about might even amplify the powerful dynamic I believe is at work.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_52.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I hesitate to ask this of anyone, visiting Khrysalis is no small matter, but I need you to collect a piece of bark from Moros, the Doom Tree.",
            "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_53.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1378050,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
