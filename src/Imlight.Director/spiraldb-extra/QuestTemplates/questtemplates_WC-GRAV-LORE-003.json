                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You did it? You have the bark? Excellent! Cursed with shadow magic? Well of course it is! That's what makes it the perfect specimen.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
