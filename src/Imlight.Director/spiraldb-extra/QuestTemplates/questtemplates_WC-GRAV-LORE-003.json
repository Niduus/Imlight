              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But, more relevant than the Shadow Magic is the type of being from whom it came. Let's see how these Pekrons react...",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_56.mp3",
                "m_action": "",
                "m_dialogEvent": "",
