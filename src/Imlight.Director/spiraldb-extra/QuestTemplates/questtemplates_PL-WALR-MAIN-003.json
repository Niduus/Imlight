    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Innkeeper Gorbeau sent you? Hmmph! I don't know why. You have a friend in the Basstille, but who doesn't?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340496,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "All right. Tell you what. There's a place in the harbor, La Nettoyage, it's where we cleaned fish... well, until fishing was outlawed.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340496,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Maybe you come down to La Nettoyage, and maybe we talk some more. No promises, but maybe.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340496,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PL-WAL-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, and watch out for the Inspectors Brigade. With the curfew, no one is supposed to be on the street in the harbor.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340496,
            "m_cameraName": ""
          }
        ]
      },
      {
