                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We can't drive them back - Wizard, you've got to help us! Put a dent in their numbers and I'll get you in to see the Council.",
                "m_picture": "GUI/NpcPortraits/Dwarf_IceSoldier_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/EinarIceaxe_EMP_04.mp3",
                "m_action": "",
