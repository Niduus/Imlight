                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Good job, Wizard! The Fire Dwarves sent you? Well, let's get you to the Council, and quick! Here - this Key gonna open the Bunker Doors.",
