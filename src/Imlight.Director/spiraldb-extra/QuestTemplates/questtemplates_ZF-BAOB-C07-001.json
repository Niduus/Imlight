                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It's lucky you showed up before that horrible bug ate me! I knew this place was dangerous the moment we arrived.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Student_Simone_Brightlance_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/SimoneBrightlance_ZFA_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465421,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-CROWN-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I thought I'd be safe by skipping the Savannah trip and staying in Baobab. I never knew they had such giant bugs here!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Student_Simone_Brightlance_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/SimoneBrightlance_ZFA_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465421,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-CROWN-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The other students? No, I haven't seen anybody since they left. I've been hiding... er, studying... here.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Student_Simone_Brightlance_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/SimoneBrightlance_ZFA_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465421,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "ZF-CROWN-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A map? Sure, I have a map of the Savannah. You can have it. I'm getting out of this place!",
