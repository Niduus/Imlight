                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh my stars and garters! That was close.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Student_Simone_Brightlance_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/SimoneBrightlance_ZFA_02.mp3",
