                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>The back halls of the home have been transformed into a sanctum of undeath. They now smell of corpse candles and a deep, frustrated emptiness. </ITALICS>",
                "m_picture": "GUI/QuestButtons/Location_MR_MalistairesSanctumRoom.dds",
