                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Portraits and keepsakes remind you that this was not just Malistaire's house, but Sylvia Drake's as well.  </ITALICS>",
                "m_picture": "GUI/QuestButtons/Location_MR_MalistairesHouseInside.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Narrator_MIR_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
