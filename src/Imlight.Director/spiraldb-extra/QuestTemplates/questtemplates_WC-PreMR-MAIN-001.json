                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>You feel an eerie sense of foreboding when you look at the door at the back of the hall. It's probably worth investigating. </ITALICS>",
                "m_picture": "GUI/QuestButtons/Location_MR_MalistairesHouseInside.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Narrator_MIR_07.mp3",
