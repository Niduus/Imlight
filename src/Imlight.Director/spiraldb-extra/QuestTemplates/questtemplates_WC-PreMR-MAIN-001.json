                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Across the room, you see Malistaire's desk. Here he sat, feverishly searching old tomes for a way to bring Sylvia back. </ITALICS>",
                "m_picture": "GUI/QuestButtons/Location_MR_MalistairesJournal.dds",
