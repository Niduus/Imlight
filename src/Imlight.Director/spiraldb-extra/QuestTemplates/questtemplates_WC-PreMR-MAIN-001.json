                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Memories of tragedy and triumph wash over you as you enter the home of your former nemesis. </ITALICS>",
                "m_picture": "GUI/QuestButtons/Location_MR_MalistairesHouseInside.dds",
