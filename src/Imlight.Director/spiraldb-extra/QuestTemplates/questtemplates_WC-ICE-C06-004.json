  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you gone to the courtyard in front of the Gobbler King's castle in Colossus Boulevard? You need to go and use the Horn of Eternal Winter there.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_96.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38172,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now that you've made yourself a Horn of Eternal Winter, and I've placed an enchantment upon it to ready it for use, it is time for you to use the Horn to summon a Titan of Ice and demonstrate your allegiance.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_97.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38172,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You should go to a cold place. The most suitable one I can think of is along Colossus Boulevard. Try Hildreth Perch, near the Gobbler King's castle... that should be enough space for an Ice Titan. When you get there, blow your Horn and wait.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_98.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38172,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I see you've returned unscathed, so I can only assume things went well. With their permission, you may now summon a Frost Giant to aid you in battle. Do be careful out there! \\n",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_99.mp3",
