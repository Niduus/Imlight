            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go down to the Cenote and defeat the Moon Skull Zombies to find a clue to their master. I'm sure it is a cult of Thunder Horns!",
            "m_picture": "GUI/NpcPortraits/Portrait_Raptor_Warrior_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ItzcoTwistedObsidian_AZT_07.mp3",
