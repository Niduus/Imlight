            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Once she groked all there was, she burned down the Kondha Forest and sealed off the Solar Arc.",
