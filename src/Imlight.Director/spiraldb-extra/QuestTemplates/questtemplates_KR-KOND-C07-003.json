            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Listen. The Spellbinder was led to the Solar Arc by the Spider Magi, for where the sun is brightest, the shadows are darkest.",
