      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-SWEET-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That is a big hole. What do you think makes a hole like that? Someone called the Quake Charmer, you say? You don't sound sure.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488222,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-SWEET-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Or it could be Copy Qhat, Judge Veg or Witches. Quite a lot of suspects you have there. Have you considered a kitchen sink might be to blame?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488222,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-SWEET-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It is strange though. Like the earth itself just rotted away, dissolved under... what? This Plant has a lot of problems.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488222,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-SWEET-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You must convince Nana not to reopen it. Photomancing the dangers should be the proof she needs.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488222,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-SWEET-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And if you get me some Gummy Samples from the Sour Worms, perhaps I can help you unravel what corrupted them. Call me Greta. I will wait outside.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488222,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-SWEET-NPC06_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They really eat it up, do they not? Almost like her words were smothered in syrup.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488222,
