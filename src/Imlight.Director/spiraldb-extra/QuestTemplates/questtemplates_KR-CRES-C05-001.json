  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You wish to ship-sail the Starfall Sea? That journey is filled with risk. We barely kept our heads out of water.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StiegQuickSand_KH2_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283103,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We hijacked one of the Giant Sea Bugs. The Umbra Legion uses them to send soldiers and supplies from the City of Sardonyx.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StiegQuickSand_KH2_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283103,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It took us near a month to ship-sail, hugging the coast to avoid the Maelstrom. I grok how that wouldn't suffice for you.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StiegQuickSand_KH2_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283103,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There are yarns of a mad Rat who ship-sailed the Starfall Sea once and again. He's said to be a ghost or a beastly spirit.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StiegQuickSand_KH2_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283103,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But you'll need to harrow the Driftwood Branches to learn if they grok more than rumors and half-heard whispers.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/StiegQuickSand_KH2_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283103,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC12_Persona",
            "m_nameOverride": "",
