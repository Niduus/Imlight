  "m_questLevel": 58,
  "m_questRepeat": 0,
  "m_onStartQuestScript": "",
  "m_onEndQuestScript": "",
  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-WATER-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wizard, I have heard you are courageous. But are you brave enough to break the curse on four warriors branded as cowards?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Zeddgan_Spellfeather.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ZeddganSpellfeather_ZFA_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 527100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-WATER-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Jata Brokenspear, a Thornpaw Hunter; Nathi Yellowstripe, an Iklaw Warrior...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Zeddgan_Spellfeather.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ZeddganSpellfeather_ZFA_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 527100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-WATER-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...Amedras Lightstep, a disgraced Darajani Guard; and Bolu Bigfist, a Blackback Soldier.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Zeddgan_Spellfeather.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ZeddganSpellfeather_ZFA_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 527100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-WATER-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They all fled from battle at one time or another. For their cowardice they were each burdened with a cursed Flameingo feather.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Zeddgan_Spellfeather.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ZeddganSpellfeather_ZFA_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 527100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-WATER-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The curse traps them, unable to leave their prisons, until they can stand tall against a true foe. Will you break their curse?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Zeddgan_Spellfeather.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ZeddganSpellfeather_ZFA_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 527100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-WATER-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
