            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You've been a great help to us Pingouins, Wizard. Any chance you'd be willing to lend your talents to help clean up the Inspectors Brigade?",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Townie_B_NPC.dds",
