                "m_personaName": "MB-MUSEHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Migratory Patterns of the Great Mammals: Volume M</ITALICS>, a real page-turner to be certain.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ClancyPembroke_AVA_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-MUSEHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Read it and return when you're done.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ClancyPembroke_AVA_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-MUSEHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "How's that for some light reading? Very well then, I'll cut right to the chase.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ClancyPembroke_AVA_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-MUSEHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I've consulted some maps from a recent survey of Grizzleheim, done by a fellow named Ulvang Landstrider.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ClancyPembroke_AVA_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-MUSEHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Compared with the migratory data, the most likely spot to find a Mammoth egg is a deserted cave in the Vigrid Roughlands.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ClancyPembroke_AVA_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
