                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Welcome back to Marleybone! If I had to guess... you're here looking to learn about Woolly Mammoths, correct?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ClancyPembroke_AVA_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-MUSEHub-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Excellent! I have taken the liberty of putting our most recent reference work on that book pedestal over yonder...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Lord_Upper06.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ClancyPembroke_AVA_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39725,
