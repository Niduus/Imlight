      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh hello there! You got my message, yes? Wonderful! Once more, I have exciting news for you!",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/ProfLydiaGreyrose_AVA_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38172,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
