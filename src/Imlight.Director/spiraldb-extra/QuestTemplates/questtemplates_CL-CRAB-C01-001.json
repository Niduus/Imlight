            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Your reputation precedes you! The Piscean Guard from the Carved Caverns spoke in fear of the strange Wizard who defeated them.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_Hermit_02.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Nestor_CEL_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 225847,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CRAB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am your ally if you will aid my people against the Pisceans and the Lophians, two tribes of savage barbarians.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_Hermit_02.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Nestor_CEL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 225847,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CRAB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My name is Nestor, and I am the advisor to Pontus, Emperor of the mighty Crustacean Empire.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_Hermit_02.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Nestor_CEL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 225847,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CRAB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Crustacean Empire was once great, and our wisdom was famed throughout the sea, but our allies have betrayed us.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_Hermit_02.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Nestor_CEL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 225847,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CRAB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you go and defeat a number of Pisceans and Lophians. That will send a message that things must change!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_Hermit_02.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/Nestor_CEL_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 225847,
