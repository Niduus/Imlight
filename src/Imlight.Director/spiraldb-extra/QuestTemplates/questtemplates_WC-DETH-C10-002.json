                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But be wise and stay away from that place. I am a ghost, and I would not meddle with the Hoarder!",
