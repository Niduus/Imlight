            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-SilentMarket-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Every Scroll of War is here! How did Stinger Bell manage to get them all?",
                "m_picture": "GUI/NpcPortraits/Portrait_Goliath_Crusher_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_25.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1242050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-SilentMarket-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What? You had to fight Ullek EmberTongue for them? What did he want with them?",
                "m_picture": "GUI/NpcPortraits/Portrait_Goliath_Crusher_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_26.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1242050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-SilentMarket-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, He clearly learned nothing from them if he tried to fight you!",
                "m_picture": "GUI/NpcPortraits/Portrait_Goliath_Crusher_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_27.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1242050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-SilentMarket-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As the very first line of the first Scroll of War says, <ITALICS>The wise warrior avoids battle. </ITALICS>",
                "m_picture": "GUI/NpcPortraits/Portrait_Goliath_Crusher_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_28.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1242050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-SilentMarket-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Scrolls also say no good deed goes unpunished. I owe favors to Stinger and you. Come see me if you ever need tactical advice.",
                "m_picture": "GUI/NpcPortraits/Portrait_Goliath_Crusher_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_29.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1242050,
