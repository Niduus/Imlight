            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": ":tik: Ask Stinger Bell if he can procure the Scroll of War for me. I'll do whatever it takes!",
            "m_picture": "GUI/NpcPortraits/Portrait_Goliath_Crusher_E_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/Kaliklak_KHR_24.mp3",
