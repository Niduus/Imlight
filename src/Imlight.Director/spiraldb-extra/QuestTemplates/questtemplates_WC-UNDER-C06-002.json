      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "King Thermidor? Yes, I did come with him through the breach, but we were separated shortly after we arrived.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/CaptainRoderick_GH2_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 459073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I know the King is still somewhere within these Deep Warrens. I refuse to return to Crab Alley without him!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/CaptainRoderick_GH2_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 459073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've drawn a line in the sand, here, in this No Crab's Land. And I will wait here until you find him.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/CaptainRoderick_GH2_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 459073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But first, can you help me fix my fortifications? That way you can go safely ahead, knowing that I'm watching your back!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/CaptainRoderick_GH2_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 459073,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I need you to collect some of the loose shells scattered about and bring them here. Can you do that for me?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Crab_Warrior_01_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/CaptainRoderick_GH2_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 459073,
