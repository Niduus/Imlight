            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Let me take a look at this Tablet. Hmm. Something, something, something... there be Djinn. Ah, this is the section right here.",
