                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, it's you again! For the love of all that's clean, please tell me you wiped your feet this time. I'm still decontaminating my tent, you know.",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_Scholar_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Dumoozid_MIR_14.mp3",
