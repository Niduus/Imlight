            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I recall seeing some creatures behaving strangely in the Brambles, an area of the Grotto we haven’t mapped much yet.",
