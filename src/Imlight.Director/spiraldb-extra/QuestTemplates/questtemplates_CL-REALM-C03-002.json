            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_PU_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
