            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hallo. I see you have made it to the rustic town of Sweetzburg. How would you rate its many charms?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Hamster_Ambassador_A_NPC.dds",
