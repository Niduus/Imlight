            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh dear, most Valued Customers give us 10 out of 5 possible stars. Your score was significantly lower. Tell me, why?",
