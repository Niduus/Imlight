            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have devised what I think is a rather ingenious plan to steal the Basstille Key. You will take it while she is engrossed by my dancing.",
            "m_picture": "GUI/NpcPortraits/Portrait_Bear_Ballerina_B_NPC.dds",
