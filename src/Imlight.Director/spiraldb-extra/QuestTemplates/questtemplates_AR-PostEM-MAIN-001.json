                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There's a dead Child of Raven in the Infirmary? Bummer. Oh, she's only <ITALICS>mostly</ITALICS> dead? Then she's slightly alive. I have just the thing!",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Zander_EMP_02.mp3",
