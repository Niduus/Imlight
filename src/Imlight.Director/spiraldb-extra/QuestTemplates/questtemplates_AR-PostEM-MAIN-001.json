            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It was a dose of pure Life energy. It should help stabilize her mortal body. But I can't speak to her divine Luminiferous Essence.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Zander_EMP_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401257,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I need to perform a Theurgical examination. Everyone be quiet. Be absolutely still.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Zander_EMP_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401257,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Her body's suffered great trauma, but it's nothing we can't treat. I can't say the same for her Divine spirit. Wizard. I need to talk to you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Zander_EMP_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401257,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Mellori's Divine spirit is being pulled away from her mortal form by an energy unlike any I've ever experienced. She's dying.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Zander_EMP_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401257,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "She's putting up a strong fight, but her only hope is for someone to go to the Astral Plane and help her.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Zander_EMP_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401257,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You're right, Qyburn. Spiral beings cannot enter the Astral plane. But the Wizard isn't from the Spiral. They're from Earth.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Zander_EMP_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401257,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm afraid I'm out of my depth on that one, but an Astral Portal would be a good start.",
                "m_picture": "GUI/NpcPortraits/Portrait_Zander_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Zander_EMP_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401257,
                "m_cameraName": ""
              }
            ]
