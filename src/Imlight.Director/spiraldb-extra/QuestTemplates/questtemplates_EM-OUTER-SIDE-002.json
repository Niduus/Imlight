      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-OUTER-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My word, I don't believe my eyes: a Wizard. We Dwarves were wizards once, 'til we put our stock into steel and engineering.",
            "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_F_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/AlgarSilvereyes_EMP_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391525,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-OUTER-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Take the Steam Vents. We use them to keep the Elementals at bay. They work well, but clearly they have their faults.",
            "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_F_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/AlgarSilvereyes_EMP_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391525,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-OUTER-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In my studies of the ancient chronicles, I discovered we once used magical Sconces to perform this task.",
            "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_F_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/AlgarSilvereyes_EMP_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391525,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-OUTER-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You can use your magic to ignite the remaining Sconces! There aren't enough to replace the Vents, but every little bit helps.",
            "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_F_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/AlgarSilvereyes_EMP_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391525,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
