            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I assume you delivered the Moon's Crown to the satisfaction of the Brood Mother. News from the Apiary has been limited.",
