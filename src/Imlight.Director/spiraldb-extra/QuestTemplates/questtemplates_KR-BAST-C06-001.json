            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Shadow Queen offers unimaginable reward for any Warlord or servant who brings her the Wizard's wand. Or head. Either. Both.",
