        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-FISHING-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The waters of Azteca are an abundant bounty - if you know how to Fish them. I can show you how. But you must first prove that you are worthy.",
            "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ANV/AlejandroDeLaPez_ANV_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1435191,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-FISHING-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Catch Ax-Xolotl in The Zocalo, Pirahptor in Mangrove Marsh, and the infamous Chupacarpe in here in Saltmeadow Swamp for good measure.",
            "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ANV/AlejandroDeLaPez_ANV_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1435191,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-FISHING-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Show me you can catch those prized Aztecan Fish, and I'll be willing to share with you a very valuable of Fishing secret. Buena suerte!",
            "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/ANV/AlejandroDeLaPez_ANV_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1435191,
            "m_cameraName": ""
          }
        ]
      },
