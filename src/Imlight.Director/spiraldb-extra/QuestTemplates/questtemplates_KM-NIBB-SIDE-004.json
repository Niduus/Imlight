  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Say, that Ball is interesting though. For something that came from space, it looks very Karamellion. It seems Sugar-based. I wonder what it is?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Gunter_003_34.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506493,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Maybe Mr. Orson would know. He is a company big wig... or at least the biggest wig down here. If it is a Nana thing, he could tell you.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Gunter_003_35.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506493,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I tell you, that Space Ball of yours looks like it is made of Karamelle Sugars. You should ask Mr. Orson about it.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Gunter_003_36.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506493,
