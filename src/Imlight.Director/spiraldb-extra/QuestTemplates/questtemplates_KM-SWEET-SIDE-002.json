            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hey, you. I know you and you know me. For I am Uwe and I make the plays. I make all the best plays. 'One-Hundred-One Pirates,' you see this play?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Uwe_003_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488291,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-SWEET-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I made this play. I buy rights off famous pirate who have many adventures. My story better than real story. Pirate is space slug. Makes you think.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Uwe_003_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488291,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-SWEET-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And you, you the famous Wizard, the Scion of the Bartleby. Everybody knows your story, everybody loves your story.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Uwe_003_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488291,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-SWEET-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now I make it into play, everybody love it more. You come to my Workshop, you see my play, you love my play, then we talk about the distribution rights.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Uwe_003_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488291,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-SWEET-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now we start the play. As you see, I don't waste gold on expensive sets and costumes. I pass the savings onto me. Buy new hat. Now, Action!",
