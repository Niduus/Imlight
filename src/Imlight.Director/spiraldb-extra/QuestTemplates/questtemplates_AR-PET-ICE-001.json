      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, there you are. There's a disturbing situation brewing, and your personal experience could be crucial in solving the matter.",
            "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TarrakHadfield_MIR_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've received word from Polaris that a deranged Pingouin Inspector named Clovis has scavenged the ruins of the Kataba Iceblock.",
            "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TarrakHadfield_MIR_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's feared that Clovis plans to use Rasputin's abandoned Golem Pods to create his own elite Inspectors Brigade squad of Borealis Golems.",
            "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TarrakHadfield_MIR_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Polaris is finally free from the yoke of tyranny. Return to Walruskberg and stop Clovis and his Borealis Golem Brigade from seizing power!",
            "m_picture": "GUI/NpcPortraits/Portrait_Moose_Professor_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/TarrakHadfield_MIR_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340966,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
