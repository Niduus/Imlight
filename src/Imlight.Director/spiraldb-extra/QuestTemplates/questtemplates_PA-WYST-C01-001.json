      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Excellent! Be sure to put that somewhere safe!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Mrs_Dowager.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/MrsDowager_WYS_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465133,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You're here of course to build a sense of community between the different magic schools, and to try to win the Spiral Cup!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Mrs_Dowager.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/MrsDowager_WYS_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465133,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Go to the Tournament Hall to take a look at it. Then, speak to Benedict Glendemming. He is both Master of Arms and our judge.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Mrs_Dowager.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/MrsDowager_WYS_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465133,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You will probably need to demonstrate your skills in a qualifying match, so be on the ready!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Mrs_Dowager.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/MrsDowager_WYS_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465133,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "When you've passed the qualifying round, return to me and we'll get you sorted out. How exciting!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Mrs_Dowager.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/MrsDowager_WYS_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465133,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Good for you! It's been so long since a Ravenwood student competed. I was worried they'd given up teaching magic there!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Mrs_Dowager.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/MrsDowager_WYS_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465133,
                "m_cameraName": ""
              }
            ]
          }
        ]
