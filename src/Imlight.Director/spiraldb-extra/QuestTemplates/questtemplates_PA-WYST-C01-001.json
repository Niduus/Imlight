      "m_displayImage1": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings, visitor! I am Benedict Glendemming, Master of Arms of Pigswick Academy.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "For years I have taught magic and dueling. With my training, Pigswick students have won the Spiral Cup again and again.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I am also the judge of this fine competition. My decisions are as fair as they are final.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You come from Wizard City, no? You have my sympathy. Let us see if that charlatan Diego has taught you anything of worth.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "To qualify for the tournament, you must step into the Chamber of the Basilisk, if you will, and defeat Bleys Flamerender.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There is no shame in defeat, so do not feel too badly if you do not succeed. Perhaps next year, no?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So Diego has stepped up his game, no? Very well, then. You will not be going home... just yet.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The tournament consists of four rounds of duels, each round against a rival school. You must win each duel to proceed.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PA-HUB-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "See Mrs. Dowager outside. She will see to your accommodations within the Student Dormitory.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Glendemming_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/BenedictGlendemming_WYS_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 465134,
                "m_cameraName": ""
              }
            ]
          }
