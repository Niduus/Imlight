            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Gettin’ inta the Conservatory will be a right bit tricky, and will take a bit of hard work.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_22.mp3",
