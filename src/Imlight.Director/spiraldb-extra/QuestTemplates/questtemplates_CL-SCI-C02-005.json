          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-SCI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So far as I can tell, it needs three different power sources... one from each of the Celestial energy types: Sun, Moon, and Stars.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_23.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
