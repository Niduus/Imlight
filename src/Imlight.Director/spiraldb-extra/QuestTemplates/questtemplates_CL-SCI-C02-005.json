            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ta the best of my knowledge, the best place ta get that kinda energy is in the Celestial fountain, smack dab in the middle of the Arboretum.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_24.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-SCI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Once ya gather three power cores from Water-Matons, take ‘em to the fountain and put ‘em where they seem ta fit. That should do the trick.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_25.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227168,
