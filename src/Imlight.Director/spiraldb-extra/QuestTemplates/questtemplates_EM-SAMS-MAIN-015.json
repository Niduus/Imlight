            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Darn it James, I'm a doctor, not a cartographer! The cave's in the jungle! How am I supposed to know? The whole jungle's...",
