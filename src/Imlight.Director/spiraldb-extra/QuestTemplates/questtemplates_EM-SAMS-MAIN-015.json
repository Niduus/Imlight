            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I was helping people get to the Streamportal when I caught a fragment of a transmission on my communicator - it was Beans!",
