            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Thank you, Cesar... and you, stranger. You should know, however, that there was a massive Borealis gem unearthed on this shift.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Lambert_POL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
