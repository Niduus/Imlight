  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm working... I'm working... Oh, it is you, Valued Customer! Yes, yes, it is me, the Burgomaster of Karamelle City... formerly, I guess.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Burgomaster_003_28.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506495,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "After my, um, recent employee evaluation, it was decided I could better serve Nana here, in the heart of a bold new endeavor.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Burgomaster_003_29.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506495,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I sift and package the Treacle, Customer. Or whatever else Mr. Orson requires of me. And it is grand!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Burgomaster_003_30.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506495,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But I do have one problem. There is a jam in one of the Pipes. If the Treacle ingredients do not reach their destination, the pipes will explode.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Burgomaster_003_31.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506495,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And that would be bad! It could flood Nibbleheim. Could you go to the Pipe Junction outside the Foundry and take a look?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Burgomaster_003_32.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506495,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hurry! Hurry to the Pipe Junction before all of Nibbleheim is drowned in... delicious, nutritious Treacle.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Burgomaster_003_33.mp3",
