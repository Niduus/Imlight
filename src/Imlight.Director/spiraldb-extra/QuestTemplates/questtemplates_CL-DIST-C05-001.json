                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They were mercenaries, hired by the crabs, who are weak and fearful for the most part. They used the Pisceans as their troops.",
