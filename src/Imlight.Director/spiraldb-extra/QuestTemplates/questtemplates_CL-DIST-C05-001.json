                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In recent years, the sharks' ambition has overwhelmed their loyalty, and they indulge their savage instincts in destruction.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Celestian_Protector_02_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/ThuleLandshaper_CEL_08.mp3",
                "m_action": "",
