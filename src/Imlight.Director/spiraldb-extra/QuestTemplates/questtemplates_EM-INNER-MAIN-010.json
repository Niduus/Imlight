      "m_displayImage1": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC28_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Medulla has the upper hand: he can manipulate Mellori into breaking the Chains. But that's not all.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_24.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1435060,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC28_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Medulla stole the idea for weaponizing Mellori's Essence out of my mind. If he builds an Essence Cannon and attaches her to it, the game is up.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_25.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1435060,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC28_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "An Essence Cannon would let him blast the Chains from anywhere. It's not enough to defend the Chains now: we have to take the fight to Medulla.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_26.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1435060,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC28_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I know where Mellori is - I wasn't strong enough to break in on my own, but I'm not on my own anymore.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_27.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1435060,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC28_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
