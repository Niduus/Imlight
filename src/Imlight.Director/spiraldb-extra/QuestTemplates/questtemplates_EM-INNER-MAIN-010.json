      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC07-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We're doomed! The Chain is broken! But this pig says there is a way to stop it?",
                "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/GunnarIcebeard_EMP_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391504,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC07-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I see your idea. Yes... that could work! But without the Steam Vents, what will save us from the Ice Elementals?",
                "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/GunnarIcebeard_EMP_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391504,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC07-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We welcome your help, cousin. I regret the errors of the past, and hope this begins a new era for our people. Let the work begin at once!",
                "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/GunnarIcebeard_EMP_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391504,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-OUTER-NPC07-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No, it is you who cannot be trusted. You are removed from this Council.",
                "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_D_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/GunnarIcebeard_EMP_19.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391504,
