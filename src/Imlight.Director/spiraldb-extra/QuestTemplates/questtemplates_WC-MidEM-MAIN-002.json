      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC15_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "To complete the Ritual, you'll place the seven Springleaves along with a lock of your Hair into the ceremonial bowl upon the Arboreal Altar.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/ProfMoolindaWu_EM2_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1459033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC15_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Unfortunately, the ancient texts do not describe what will follow. Probably because it's never been completed by anyone!",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/ProfMoolindaWu_EM2_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1459033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC15_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "However, we do know that the Scion will be granted access to Bartleby's sacred Root System...",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/ProfMoolindaWu_EM2_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1459033,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC15_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I wish I could accompany you. However, this path is reserved for you alone. Be diligent, but swift. We are all counting on you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Cow_Wu_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/ProfMoolindaWu_EM2_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1459033,
            "m_cameraName": ""
          }
        ]
      },
