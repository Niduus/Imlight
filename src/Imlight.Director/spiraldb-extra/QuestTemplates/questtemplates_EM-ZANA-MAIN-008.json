        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not only have you rescued Zigi, Wizard, but you brought young Greys'in here back to our side. He has been telling a most interesting tale.",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_King_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Khan_EMP_96.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397572,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I know how the Bat made the Shadow Wall: He built a machine called the Negativity Transmutator to channel the fear and hopelessness of the Alphoi.",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Bat_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Greysin_EMP_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254378,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That's why all I could do was shelter them here in the Comfort Zone and inspire them to joy and song and funky, funky dancing.",
            "m_picture": "GUI/NpcPortraits/Portrait_Eagle_MuseF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Alyvia_EMP_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254366,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC16_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bat took the Lodestar from the Beacon of Hope, the very source of Alphoi optimism and happiness, to power the Transmutator.",
            "m_picture": "GUI/NpcPortraits/Portrait_Alphoi_Bat_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Greysin_EMP_02.mp3",
