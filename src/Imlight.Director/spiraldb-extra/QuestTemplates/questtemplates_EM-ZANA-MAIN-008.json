                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, ever since I met Zigi, I've been pondering the construct of time. It appears time may change me, but I cannot trace time... vexing.",
                "m_picture": "GUI/NpcPortraits/Portrait_Robot_Drone_B_NPC.dds",
