  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My... let me take a look at you! You've come so far in your studies. I can scarcely recognize the fresh-faced young student you were when you first arrived in Wizard City.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_66.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As I said, it has come time for you to learn a new and powerful spell to reflect your newfound abilities. I am afraid that gaining this spell won't come easily.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_67.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The spell I have for you is a mighty one indeed! The summoning of a fire dragon, a Titan, is no small thing. A great and hard-won sacrifice must be made to appease the Fire Dragon and show that you're worthy to summon him.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_68.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "First, I need you to collect four Fire Shards from some powerful creatures of flame: Prince Alicane in Wizard City, Biti Nirini in Krokotopia, the Stray Sunbird in Marleybone, and Ember Everburn in MooShu.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_69.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You've returned! I hope you didn't find the Fire Shards too difficult to collect.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_70.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you collected those Fire Shards from Prince Alicane in Wizard City, Biti Nirini in Krokotopia, the Stray Sunbird in Marleybone, and Ember Everburn in MooShu? Return to me when you've got them all.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/DaliaFalmea_QST_80.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
