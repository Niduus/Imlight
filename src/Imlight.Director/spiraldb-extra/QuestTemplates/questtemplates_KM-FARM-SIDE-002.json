  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-FARM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hurry, fight the goats that are devilish and photomance the trolls. You must do this or all the Cotton Candy will be lost.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_FarmerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/FarmerEsther_003_24.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1513080,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-FARM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Devil goats are stealing my Cotton Candy! And now that we have watered it, they will be drawn to it like the flies are drawn to the stinky things.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_FarmerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/FarmerEsther_003_20.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1513080,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-FARM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There are two things we must do. And by we, I mean you. First, you must battle the Sourpatch Goats in the forest. Discourage them with fireballs.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_FarmerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/FarmerEsther_003_21.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1513080,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-FARM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Second, we must put up the Scaregoat. It is like the Scarecrow, but with more of a goat thing. And what are goats most scared of? Yah, trolls!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_FarmerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/FarmerEsther_003_22.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1513080,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-FARM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can rustle the Scaregoat into the upwards position, but I need a model. Go Photomance the Cinnamon Trolls in a nearby cave.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_FarmerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/FarmerEsther_003_23.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1513080,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-FARM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You got my picture? Yippee and the ki yay. Now I will just get to work on making my Scaregoat.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Fairy_FarmerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/FarmerEsther_003_25.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1513080,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-FARM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
