            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Tupa Taua told you that the Rain of Fire spell requires the name of a volcano spirit, right?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DaliaFalmea_ZFA_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have some unfortunate news for you. I had a list of volcano spirits, but it appears to be missing from my archives...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DaliaFalmea_ZFA_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The list was lost when Morganthe's minions came poking around Wizard City. I suspect one of them in particular... the Hoarder!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DaliaFalmea_ZFA_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Hoarder makes its home in Dragonspyre, amidst the ruins. Milos Bookwyrm in the Atheneum can guide you to the Hoarder.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Dalia_Falmea.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DaliaFalmea_ZFA_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38208,
            "m_cameraName": ""
          },
          {
