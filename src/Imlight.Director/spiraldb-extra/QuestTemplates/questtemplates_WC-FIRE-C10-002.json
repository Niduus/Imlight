                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I am reluctant to tell you, but I am certain you will not leave without it. The Hoarder is in the Plaza of Conquests.",
