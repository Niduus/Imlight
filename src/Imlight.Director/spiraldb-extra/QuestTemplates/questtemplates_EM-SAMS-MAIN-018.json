                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah good, you survived the murder-plants! Ehh... You like the new look?",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_C_NPC.dds",
