              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-HAR-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Did you appease the Ghosts? What? No ghosts... just Marleybonians? They're crying because they got stuck trying to discover Polaris?",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/SemolinaPilchard_POL_07.mp3",
