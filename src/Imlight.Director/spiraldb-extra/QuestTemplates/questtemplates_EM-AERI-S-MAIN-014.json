                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "What did Valantis say? We gotta make the Pod look like a Flying Glowfish? I assume it's gotta glow then? And stink? Of course it does.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_36.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397735,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "OK. Wizard, you get Lightning Bug Venom and Stinkreed Nectar. Sparck, you collect scrap for the fish façade. The three of us will ready a Pod.",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_37.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397735,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "About time! The Pod is prepped and ready for its makeover. Did you get the Venom and Stinkr- WHOOOAAAAUGH!",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_38.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397735,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sparck has the scrap 'fish parts' collected. Just put the silly thing together already, would ya, Wizard?",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_39.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397735,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The entire Spiral is doomed if this ruse fails. Wizard, a word?",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_40.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397735,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Look, we don't have to like each other, but we do have to trust each other. At least for now. Are you sure this will get us into Sepidious?",
