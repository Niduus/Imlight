                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm sorry. I had no choice but to come. I know my recent predictions have been flawed; I just couldn't ignore this one.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Townie_A_NPC.dds",
