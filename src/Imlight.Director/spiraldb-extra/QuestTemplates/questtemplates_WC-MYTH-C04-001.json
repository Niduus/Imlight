                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I heard you say you are looking for Lady Sylvan? Oh, I overheard you talking to Dworgyn inside. And yes, I have extremely good ears for a tree...",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_Mortis_A_NPC.dds",
