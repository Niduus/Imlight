                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I heard her talking with someone in the passage way. I think she decided to follow them. By the sounds of it, she was trying to cheer them up...",
                "m_picture": "GUI/NpcPortraits/Portrait_Tree_Mortis_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/TreeMortis_QST_02.mp3",
