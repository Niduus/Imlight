              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-AIR1-SYLVAN_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They were expecting me to make gold out of iron? Some still believe in that myth. I came here because I thought they needed cheering up.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Seraph.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/LadySylvan_QST_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81128,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-AIR1-SYLVAN_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So, you have traveled all this way to find me... You must be in need of some cheering up! Let me tell you all the jokes I know...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Seraph.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/LadySylvan_QST_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81128,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-AIR1-SYLVAN_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, you need a chant for your next Myth spell? I can do that instead.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Seraph.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/LadySylvan_QST_03.mp3",
