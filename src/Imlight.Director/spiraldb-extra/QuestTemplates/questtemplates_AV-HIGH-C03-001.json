            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I await your return. Do not forget the three Sacred Words... as I have!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Badger_KnightOfSecretWords_NPC.dds",
