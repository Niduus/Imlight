  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-SWEET-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I came here to look into the Sour Gummies. That is why I was in the Plant when you found me. I know they are not an isolated problem.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488222,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-SWEET-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The people I represent are getting concerned. We have a theory as to the cause, but we need more data. Thus Gummy Samples from every town.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488222,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-SWEET-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My brother, Hans, went to check on the Gummies in the Chocolate Mines of Nibbleheim. I am going to meet up with him there.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488222,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-SWEET-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Come with if you want, or don't. It does not matter to me. But if you want to end the madness, then you must go to the Gumdrop Forest.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488222,
            "m_cameraName": ""
          }
        ]
      }
