            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GUM-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Decided to come with me, yah? But one cannot just walk into Nibbleheim these days. There are a few essentials we need to gather first.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1507241,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GUM-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It will go much faster if you help me. First, we need to collect some of the Peppermint Posies that grow around here. Should be easy.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1507241,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GUM-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The harder task is acquiring the very special Honey you can only get from Honey Badgers.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1507241,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GUM-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, those are Honey Badgers. What were you expecting, little cute things? No! They are mean! They are monsters! And they will eat your face!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1507241,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GUM-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So be careful. Once we have enough Honey and Posies, I can take you to Nibbleheim.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_15.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1507241,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GUM-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wow, look at you, still have a face. And we have enough Honey and Posies now to get into Nibbleheim.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Mole_WorkerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Greta_003_16.mp3",
