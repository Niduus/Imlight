                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Emperor Pontus, leader of the Crustacean Empire, has spoken! As it is said, so shall it be done!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_NPC.dds",
