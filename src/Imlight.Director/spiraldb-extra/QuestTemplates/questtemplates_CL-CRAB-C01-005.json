                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings, surface dweller! I am the leader of the Crustacean Empire, the mightiest empire to have ever existed!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EmperorPontus_CEL_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 225850,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CRAB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We have been betrayed from within... the Pisceans and Lophians were once our loyal allies, now they have turned against us!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EmperorPontus_CEL_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 225850,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CRAB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As an Emperor, I could order you to aid us, but I will humbly ask this favor of you.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EmperorPontus_CEL_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 225850,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CRAB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Would you speak to Senator Xanthus in the Senatorium and see what aid you might grant to our great empire?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EmperorPontus_CEL_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 225850,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CRAB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Pisceans and the Lophians have seized parts of our great capital city, which we made completely by ourselves.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EmperorPontus_CEL_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 225850,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CRAB-NPC03_Persona",
