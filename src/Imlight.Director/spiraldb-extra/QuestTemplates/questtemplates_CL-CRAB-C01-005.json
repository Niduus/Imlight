                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So good of you to aid these Crustaceans! Poor souls. They’re not much when it comes to empire-building, but they do try!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Thurston_Plunkett.dds",
