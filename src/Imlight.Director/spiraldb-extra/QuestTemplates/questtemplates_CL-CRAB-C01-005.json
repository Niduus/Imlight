                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Someone must be behind this.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Crab_King_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EmperorPontus_CEL_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 225850,
