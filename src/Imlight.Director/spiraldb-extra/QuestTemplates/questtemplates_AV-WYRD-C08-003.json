            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Venture to the Tower of the Blue Dahlia and free her captive, Sir Gerard Monmouth. Remind the Lady of the laws of Hospitality!",
