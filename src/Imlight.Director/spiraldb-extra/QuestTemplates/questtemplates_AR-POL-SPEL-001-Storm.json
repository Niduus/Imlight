      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You don't need to tell me. I already heard. Cyrio says you've got the proper voltage, and I trust his judgment, so that's that.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IoneVirga_POL_24.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340969,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I believe the essence of strong Storm magic is the ability to focus one's talents. You have the potential, you just have to channel it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IoneVirga_POL_25.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340969,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This spell is one of my favorites when I'm feeling particularly angry. It can be... devastating to one's enemies.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IoneVirga_POL_26.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340969,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AR-ARC-NPC04_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I have much research to do, and I'm no teacher, but check back with me time-to-time. I may have new spells to share. For now, you're dismissed.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/IoneVirga_POL_27.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340969,
                "m_cameraName": ""
              }
            ]
          }
