                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Praise the sands! Thank goodness you surprised us... er, those ruffians and ran them off! They were... trying to rob me! I'm so glad you came.",
