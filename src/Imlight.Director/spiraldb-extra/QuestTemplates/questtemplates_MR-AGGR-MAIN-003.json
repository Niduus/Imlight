            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you will help Aggrobah, Wizard, Aggrobah will help you. First, you must convince Vizier Faizal to come to my apartment.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
