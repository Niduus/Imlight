                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "All that said, we do have a plan for restoring order. Perhaps if you help us, Wizard, then we can address the threat of this \"Overlord\".",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_SultanaF_A_NPC.dds",
