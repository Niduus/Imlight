  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERI-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You're not one of the typical castaways we get here, are you? No, I recognize a fellow adventurer when I see one.",
            "m_picture": "GUI/NpcPortraits/Dwarf_FireCitizenF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Sebastia_EM2_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397529,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERI-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I left home years ago to find Raven's Edicts - the guiding principles handed down to the four races of Empyrea at the dawn of time.",
            "m_picture": "GUI/NpcPortraits/Dwarf_FireCitizenF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Sebastia_EM2_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397529,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERI-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Tablets the Edicts were inscribed upon were lost long ago; scattered all over Empyrea. When I crashed here, I thought my quest was over.",
            "m_picture": "GUI/NpcPortraits/Dwarf_FireCitizenF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Sebastia_EM2_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397529,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERI-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But I found one in the Monkey Spider Cave! If I hadn't been so distracted by its majesty I'd have noticed the Mother Monkey Spider lurking behind me.",
            "m_picture": "GUI/NpcPortraits/Dwarf_FireCitizenF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Sebastia_EM2_04.mp3",
            "m_action": "",
