                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hmmph! It's about time you returned, Initiate. You were supposed to check on the Tree, not climb up in its branches and take a nap.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Keeper_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/LibrarianFitzhume_MIR_06.mp3",
