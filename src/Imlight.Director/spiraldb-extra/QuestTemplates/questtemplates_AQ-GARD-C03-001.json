                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Who is this now? A Wizard from Ravenwood? My sister, the dear Aegle, told me that she met you once. I did not truly believe her.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Vesper_AQL_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741227,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I have met but few Wizards from your world. And fewer still have the courage to risk the cold, cruel depths of Atlantea.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Vesper_AQL_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741227,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Atlantea was once a mighty city of Aquila, but they turned their faces from Poseidon and showed him great disrespect.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Vesper_AQL_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741227,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The city was swallowed into the sea one winter's night, vanishing but for a few fragments protruding from the waves.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Vesper_AQL_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 741227,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AQ-HUB-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Poseidon's palace is down there, as are his many powerful servants and strange creatures. I hope you rise again.",
                "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Vesper_AQL_05.mp3",
