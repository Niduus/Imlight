            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then, you'll have to battle a ghoul, Azcal Fire Ant, to get Essentia.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TezcatThreestar_AZT_21.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643254,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
