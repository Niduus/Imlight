            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But the tragedy is not complete. Her crew is still trapped inside the ship. They are sure to drown or be eaten if you do not help.",
            "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Vesper_AQL_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 741227,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
