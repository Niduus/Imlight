            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I wonder, Wizard, are you merciful and kind, too? An aged airship from afar sailed here on her last cruise.",
            "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_B_NPC.dds",
