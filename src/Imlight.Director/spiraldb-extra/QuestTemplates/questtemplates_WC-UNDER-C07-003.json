            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-TU-NPC08_Persona",
                "m_nameOverride": "Doctor Zigmund",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard? Your magical theories and postulates are unwelcome here. This is an era for scientific progress!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_Lab_Coat.dds",
                "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/DoctorZigmund_GH2_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 456081,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-TU-NPC08_Persona",
                "m_nameOverride": "Doctor Zigmund",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I will master the Storm Batteries and the Riverclaw Kingdom will see a revolution like none before!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_Lab_Coat.dds",
                "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/DoctorZigmund_GH2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 456081,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-TU-NPC08_Persona",
                "m_nameOverride": "Doctor Zigmund",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now, prepare to face the fury of applied science!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_Lab_Coat.dds",
                "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/DoctorZigmund_GH2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 456081,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-TU-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now that you've walloped some sense into me, I see that I had gone mad with power.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_Lab_Coat_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/DoctorZigmund_GH2_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 456081,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-TU-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I thought to teach you a science lesson, but it was you who showed me the error of my ways.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Sea_Monster_Lab_Coat_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/DoctorZigmund_GH2_05.mp3",
