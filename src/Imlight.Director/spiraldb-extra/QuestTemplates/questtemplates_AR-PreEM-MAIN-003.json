                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Silence! We've given you multiple warnings, Coleridge, yet we continue to receive reports of rats in this establishment. Clean up, or pay up!",
