            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The mission requires a Sky Captain with experience in Empyrea. I'm sure we don't need to explain how limited that selection is. Ha-ha.",
