                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ye featherbrained fishflingers wouldn't know a rat if it were standing right in front of ye! We ain't bribin' ye without a fight! Yar!",
