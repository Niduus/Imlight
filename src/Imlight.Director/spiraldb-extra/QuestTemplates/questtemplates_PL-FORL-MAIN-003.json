            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of all the nightmares! The Rangers tell me there's been some kind of uprising in Walruskberg! My cousin's been placed under house arrest!",
                "m_picture": "GUI/NpcPortraits/Portrait_Walrus_AristocratF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/DuchessCarwalina_POL_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346204,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Foolish Antuskette! I warned her! You can't trust these Pingouins. Can you imagine the humiliation she must be suffering?",
                "m_picture": "GUI/NpcPortraits/Portrait_Walrus_AristocratF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/DuchessCarwalina_POL_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346204,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC02-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Eww. We certainly can't visit Walruskberg now. We'll just have to return to Walzakistan. Be a dear and tell Lilly to get my luggage ready.",
                "m_picture": "GUI/NpcPortraits/Portrait_Walrus_AristocratF_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/DuchessCarwalina_POL_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346204,
                "m_cameraName": ""
              }
            ]
          }
        ]
