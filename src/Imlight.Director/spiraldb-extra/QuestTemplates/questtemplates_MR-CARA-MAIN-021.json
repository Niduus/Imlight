                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wow! This really is just like old times - you and me looking up at one of the Wonders of the Spiral, fighting the odds to save the day.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
