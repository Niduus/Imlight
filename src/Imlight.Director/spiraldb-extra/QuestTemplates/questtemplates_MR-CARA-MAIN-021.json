                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Things have gotten better for me at Ravenwood. The school's really grown on me, but it still pales in comparison to this.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_20.mp3",
                "m_action": "",
                "m_dialogEvent": "",
