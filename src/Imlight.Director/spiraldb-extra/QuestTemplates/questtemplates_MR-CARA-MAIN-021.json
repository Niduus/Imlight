                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Not to be sappy, but whatever happens up there, I want you to know that adventuring with you is my favorite thing. All right, let's go.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
