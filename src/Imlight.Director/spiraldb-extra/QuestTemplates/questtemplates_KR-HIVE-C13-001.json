      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Spellbinder! You remember me, don't you? You tried to convince me not to join the Umbra Legion, but I didn't listen.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZharelliaRunningOne_KH2_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283189,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well, I realize now I was wrong. Very wrong! I've heard what they do to Tributes, and I don't want that to happen to me!",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZharelliaRunningOne_KH2_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283189,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've got to get out of the Hive and back home to Sardonyx where I belong. Will you help me escape?",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZharelliaRunningOne_KH2_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283189,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC12_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Distract the Tribute Processing Officer, Undrek BlightClaw, so I can escape without anyone noticing me.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mantis_HunterF_H_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/ZharelliaRunningOne_KH2_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283189,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
