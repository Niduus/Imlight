  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As to the truth about the Cabal, you now have clearance for this knowledge. I already told you that they were once part of the Arcanum.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/IoneVirga_MIR_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340969,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I could tell you the entire story, but it would take many hours, and I feel... unprepared to do so.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/IoneVirga_MIR_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340969,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Cabal's work was performed in what we now call the Forbidden Wing, behind the Warded Door. We do not go in there under any circumstances.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/IoneVirga_MIR_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340969,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is a small library, however, where we keep historical records about the Schism. It is simplest for you to learn about the history there.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/IoneVirga_MIR_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340969,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Visit the Schism Reading Room, read about the past there, and then return and we will discuss the future.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/IoneVirga_MIR_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340969,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I confess - the thought of having to tell you entire story about the Schism makes me feel... tired. Visit the Reading Room instead.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_StormTrainerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/IoneVirga_MIR_18.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340969,
            "m_cameraName": ""
          }
        ]
      }
    ]
