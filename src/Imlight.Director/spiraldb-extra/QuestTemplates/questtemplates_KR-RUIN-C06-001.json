                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Holding my Telescope is like lighting candles in my mind. The shadows that envelope my thoughts are fleeing!",
                "m_picture": "GUI/NpcPortraits/Portrait_SuGlider_RougeF_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/AllderanNoMoon_KH2_07.mp3",
