            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My tragedy has been lost to the mists of time. Suffice it to say, I knew joy and sorrow before the time of King Artorius.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirBelenos_AVA_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611091,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-WYRD-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But when the vile Pendragon, Lord of the Wild Hunt, rose to power, his shadow twisted me and my brother ghosts to evil.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirBelenos_AVA_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611091,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-WYRD-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Sword of Kings? Ack. We gave it to the Pendragon's Horned Ones just before you... liberated me.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirBelenos_AVA_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611091,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-WYRD-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They secured it in a Froudling Wagon and went down the path. Hurry, and you might catch them!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirBelenos_AVA_08.mp3",
