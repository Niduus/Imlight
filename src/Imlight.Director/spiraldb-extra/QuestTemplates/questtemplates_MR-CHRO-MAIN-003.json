            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Whatever power my wishes may have, I send them along with you. The fate of Mirage and all the Spiral hangs in the balance. Godspeed, Wizard.",
