            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Take the portal down and do whatever you must to reclaim the Chronoshards and the Eye of History. That should reset the Sands.",
