            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'll remain here to keep the Chronoverge from falling back into the Cabal's Clutches. I'd be little help down there anyhow.",
