      },
      "m_displayImage1": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Really? You'd risk your Master Plan of destroying the Spiral just for the opportunity to rub our noses in it?",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_26.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Was that the guy from Unicorn Way? Wow! When Grandfather Spider said he was digging up the past, I never dreamed he'd go THAT far back!",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_27.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I wonder who's next. Grab that Chronoshard and let's go to the next Dune!",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_28.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So... have you noticed I'm a little more helpful than before? Oh, ok. Good, I kept waiting for you to say something...",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_29.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Not that I'm trying to take all the credit, of course. You still seem to be holding your own... but hey, we're better together, right?",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_30.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sorry. I'm veering into sappy land again, aren't I? Let's just get the Chronoshard and head to the next dune.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_31.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "O frabjous day! Callooh! Callay! Yep, I know all that stuff. Baba Yaga has a thing for fairy tales and weird poems.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_32.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm not complaining though. It comes in handy at times like these. Gives me something clever to say, at least.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_33.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "All right, get that last Chronoshard and then meet me back outside. Then we'll go and finally face Grandfather Spider.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_34.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-CHRO-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It looks like whatever hold the Shadow Magic has on the Sands of Time is weakened, but there's just that one final strand.",
                "m_picture": "GUI/NpcPortraits/Human_Mellori_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Mellori_MIR_35.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1401024,
                "m_cameraName": ""
              }
            ]
          }
        ]
