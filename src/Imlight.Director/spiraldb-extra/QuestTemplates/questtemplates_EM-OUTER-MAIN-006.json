                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Eh, can you blame 'em? They must think we're trying to kill 'em! We have to tell 'em what's happened.",
                "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_E_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/LarsFrostbinder_EMP_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391507,
                "m_cameraName": ""
              },
