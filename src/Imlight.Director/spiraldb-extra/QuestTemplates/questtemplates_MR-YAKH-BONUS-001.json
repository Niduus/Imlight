            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "How are we to function with all this noise? Quiet down the Bumbai Rebels so those of us who actually think around here can get our rest.",
