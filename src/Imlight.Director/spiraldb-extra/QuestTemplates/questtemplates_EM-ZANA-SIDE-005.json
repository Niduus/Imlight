  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We have done well. The Alphoi know the truth and all temptations are secured. This calls for a celebration.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_27.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I will allow myself to eat... a second bran flake. *Nom nom nom nom nom*",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_28.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That flake... it might be the best I've ever had. It swims in the residual flavor of the last one and floods my taste buds with delights!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_29.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What would happen if I had a third flake? Or a fourth or fifth? What if I had ALL THE BRAN FLAKES? Out of my way, I must know!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_30.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why didn't anyone tell me food was so good? On the way here, I tried bran flakes, cakes, Shadow Creatures, chairs, pie.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_31.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "AND I'M STILL HUNGRY! What about you? Are you food?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_32.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ooh, okay, Wizards are not edible. Good to know. But there are still so many new foods for me to try.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_33.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-ZANA-NPC18_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Leave me now to my explorations. But thank you for showing me the truth: Gobblers are our future.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/ScreamingByrin_EMP_34.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1254382,
