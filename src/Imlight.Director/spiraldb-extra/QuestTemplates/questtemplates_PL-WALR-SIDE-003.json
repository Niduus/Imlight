                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Brave Wizard, you have been a wondrous help to me. Your contributions to the Resistance, though small, will not go unnoticed.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Townie_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Toulouse_POL_22.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340499,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, honestly, no one is really going to remember what you did per se, but they're going to cherish my art for centuries!",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Townie_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Toulouse_POL_23.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1340499,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-WAL-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Feel free to consider yourself the Junior Assistant to the Master Artist. It's an honorary title only, of course. But you've earned it!",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Townie_B_NPC.dds",
