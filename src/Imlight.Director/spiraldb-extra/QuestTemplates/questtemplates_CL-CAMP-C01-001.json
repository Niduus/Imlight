        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So much has gone wrong since we arrived! We no sooner made base camp when we met with technical difficulties... likely sabotage!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227125,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Following that were thefts of equipment and stores. Then we lost members of our expedition... including our leader... to strange disappearances!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227125,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The most recent calamity was an assault by some of the indigenous species that have inhabited these ruins.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227125,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It would be a great help if you could find the survivors of the attack. I’ve taken a roll, and Edgar Ableton, Mackenzie Trowel, and Peter Cheswick are still missing.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227125,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Let them know the attack is over and they can come back!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227125,
