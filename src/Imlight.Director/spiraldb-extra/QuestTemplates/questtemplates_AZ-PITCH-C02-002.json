        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-LAKE-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ah, that's much better. I can think properly again. Hmm... to get you to the Pyramid. All right, I have an idea.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MaktheKnife_AZT_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470558,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-LAKE-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This area is a maze of stone and coral and dead ends. But the Vonda Fish know the secret ways.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MaktheKnife_AZT_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470558,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-LAKE-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Catch a School of Vonda Fish. Once you have them, they'll show you the path through the barriers, to a sunken courtyard.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MaktheKnife_AZT_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470558,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-LAKE-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then, you need to clean the still-standing columns to find the stone warrior, Tonatiuh Sunken Moon. Ask him how to get in!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MaktheKnife_AZT_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470558,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-LAKE-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you remember all that? Get the Vonda Fish to show you how to get through to the sunken courtyard.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MaktheKnife_AZT_08.mp3",
