          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC01-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, you're back! You're ready to take that Storm Jewel from Caleban? Let's go get it! Beans, you guard the Ark.",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_48.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397532,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC01-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And these castaways all appear to be in perfect health. So what else have you got to do? Come on, Wizard - let's go!",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_49.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397532,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC01-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "They've found us, Wizard! Look out!",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_50.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397532,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC01-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This is it, Wizard! Engage!",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_51.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397532,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC01-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well done, Wezlee. You Beastmen can overcome your savage past, and build a better destiny. The Jewel will... hold on...",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_58.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397532,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC01-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wait - this isn't a Storm Jewel - it's just worthless quartz! But why did Khan say...",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_59.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397532,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC01-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Khan lied to us! He wanted us to come up here... and leave the Ark unguarded! We have to go, before it's too late!",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_60.mp3",
