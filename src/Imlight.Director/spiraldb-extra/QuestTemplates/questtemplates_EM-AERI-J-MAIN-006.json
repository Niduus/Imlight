      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-JUNG-NPC02-D_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There is a better way, father.",
                "m_picture": "GUI/NpcPortraits/Beastman_Child_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Wezlee_EMP_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397552,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-JUNG-NPC02-D_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sycorax, the evil witch, tricked the Beastmen into believing this Jewel controlled their minds long before I was born. The Beastmen lived as her slaves.",
                "m_picture": "GUI/NpcPortraits/Beastman_Child_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Wezlee_EMP_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397552,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-JUNG-NPC02-D_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You were her favorite, Father, but when you found the one called Khan, you turned against her. Khan rid the island of her once and for all.",
                "m_picture": "GUI/NpcPortraits/Beastman_Child_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Wezlee_EMP_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397552,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-JUNG-NPC02-D_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But after Sycorax fell, what did you do? You took the Jewel and turned it on the Beastmen again - now the tribes were your slaves!",
                "m_picture": "GUI/NpcPortraits/Beastman_Child_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Wezlee_EMP_19.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397552,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-JUNG-NPC02-D_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Let it go, Father. We have let fear and hate rule us for too long. We will work with the outsiders, and live in peace.",
                "m_picture": "GUI/NpcPortraits/Beastman_Child_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Wezlee_EMP_20.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397552,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-JUNG-NPC02-D_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, take this Jewel far away from here.",
                "m_picture": "GUI/NpcPortraits/Beastman_Child_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Wezlee_EMP_21.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397552,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-JUNG-NPC02-D_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No! He will be exiled, just as he exiled my mother and I. Maybe he will bury his hate in the Jungle.",
                "m_picture": "GUI/NpcPortraits/Beastman_Child_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Wezlee_EMP_22.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397552,
