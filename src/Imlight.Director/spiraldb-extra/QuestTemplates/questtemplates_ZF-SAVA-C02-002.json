                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I tried to head back, but I got lost and stumbled into these Thornpaws defending their tents. I guess I surprised them.",
