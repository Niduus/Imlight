          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I appear to owe you again for freein' me from another wakin' nightmare. You're a good sort, Wizard.",
            "m_picture": "GUI/NpcPortraits/Portrait_Rat_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_108.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1233354,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "How did I get here? Ahead of you? Heh heh. I took a shortcut. But that ain' worked out so well for me, huh?",
            "m_picture": "GUI/NpcPortraits/Portrait_Rat_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_109.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1233354,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are tryin' to reach the Shadow Queen? Come quick, come quick! I know this place! I've been here before! I can guide you.",
            "m_picture": "GUI/NpcPortraits/Portrait_Rat_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_110.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1233354,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Hive-NPC23_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'll show you how to beat her. This way! We go down and travel the ways she can't see!",
            "m_picture": "GUI/NpcPortraits/Portrait_Rat_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_111.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1233354,
            "m_cameraName": ""
          }
        ]
      },
