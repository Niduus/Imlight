        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-ACAD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, I did know Viggor when he was alive. I've been in Dragonspyre a lot longer than he was, ever since I was brought here from the Ravenwood.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/TreeAshley_CAT_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 126321,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-ACAD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Treeminders? King Kylgore said we were all gifts between two great peoples. Maybe they were the second one.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/TreeAshley_CAT_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 126321,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-ACAD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You know, I think that statue was built in honor of the Treeminder leader. What was his name? Primrose? Ambrosius! Aurelius Ambrosius... I think.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/TreeAshley_CAT_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 126321,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "DS-ACAD-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you want to know more about Treeminders, you should go back to the Ravenwood. That's really where they got started.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/TreeAshley_CAT_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
