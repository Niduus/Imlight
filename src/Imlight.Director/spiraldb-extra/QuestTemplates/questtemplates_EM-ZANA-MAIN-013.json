            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I gather you received a summons from Captain Pork as well? It seems appropriate then that I accompany you to the Palace.",
