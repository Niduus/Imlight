                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So you're that Wizard I keep hearing about. I'm not impressed. Still you saved me some grunt work by getting those Keys.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_CaptainF_A_NPC.dds",
