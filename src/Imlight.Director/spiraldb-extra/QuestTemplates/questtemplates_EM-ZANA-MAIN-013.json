                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hey, did you just get the Beacon Keys? Good. Now get over here before the Shadows take them back.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_CaptainF_A_NPC.dds",
