      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And I forget what I'm supposed to be doing... oh yeah! I'm supposed to be helping you learn more about Grandfather Spider's Children!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/JakiWhisperwind_POL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I found something! There's a bunch of Cave Paintings in Zafaria. The ancient Zafarians somehow recorded information about Spider's Children.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/JakiWhisperwind_POL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "How did they know, right? Amazing. And I wonder how they drew the paintings. Is it really paint? Or is it chalk? It looks like ink, but...",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/JakiWhisperwind_POL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oops, I'm getting distracted. Zafaria. Look for an archaeologist named Airdale Guthrie. Tell him Jaki will share her secret if he helps you.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/JakiWhisperwind_POL_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340972,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC07_Persona",
