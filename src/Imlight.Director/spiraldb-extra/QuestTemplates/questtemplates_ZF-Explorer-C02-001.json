      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC06_Persona",
            "m_nameOverride": "Kiliman Copperleaf",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello, young Wizard. Are you interested in learning the history of Zafaria? It is a bittersweet story of shadows and light.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Kiliman_Copperleaf_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KilimanCopperleaf_ZFA_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC06_Persona",
            "m_nameOverride": "Kiliman Copperleaf",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The best way to understand Zafaria is to experience it. There are five masterpieces of ancient rock art that survive to date.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Kiliman_Copperleaf_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KilimanCopperleaf_ZFA_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC06_Persona",
            "m_nameOverride": "Kiliman Copperleaf",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The first is in our Library. You'll have to locate the others on your own.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Kiliman_Copperleaf_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KilimanCopperleaf_ZFA_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465437,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC06_Persona",
            "m_nameOverride": "Kiliman Copperleaf",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's been too long since I've seen them, and I've forgotten the way. Once you've seen them all, tell me what you think.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Kiliman_Copperleaf_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KilimanCopperleaf_ZFA_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465437,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-CROWN-NPC06_Persona",
            "m_nameOverride": "Kiliman Copperleaf",
