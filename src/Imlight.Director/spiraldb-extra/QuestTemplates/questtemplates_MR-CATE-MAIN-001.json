  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You see, it's... kind of awkward. The Lord of House Tabbi passed away without an heir, and there's a Qhat fight over who gets the lordship.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_43.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381289,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Lord's cousin, Count Crowl, has seized control of Tabbi Manor to assert his claim, but he was not very friendly when I talked to him.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_44.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381289,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "House Purrzian is House Tabbi's vassal, and they've attacked the Manor, asserting their own claim. So I had an idea that we would support them.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_45.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381289,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But then I remembered they're the ones who resurrected Xerxes... so that's no good for us. I went back to Count Crowl, but now he's really angry.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_46.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381289,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So... I need to teleport back in and try to convince Count Crowl to meet with you. Meantime, try to convince the Gate Guard to let you in.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_47.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381289,
            "m_cameraName": ""
          }
        ]
      }
    ]
