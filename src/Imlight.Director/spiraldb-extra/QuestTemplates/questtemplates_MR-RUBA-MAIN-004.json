                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "To break the enchantment, you will have to convince one of the Dunes Djinni to make an exception. It shouldn't be too hard.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mongoose_Warrior_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/RickyMongu_MIR_09.mp3",
                "m_action": "",
