  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-SilentMarket-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello, Wizard! How nice to run into you here in Khrysalis of all places. What do you mean it's extremely dangerous here?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EloiseMerryweather_KHR_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206088,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-SilentMarket-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh my, that doesn't sound good at all. I was sent here by the Marleybone Royal Museum.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EloiseMerryweather_KHR_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206088,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-SilentMarket-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps you could help me then? The Royal Museum loved my Aztecan flower exhibit so much, they commissioned another!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EloiseMerryweather_KHR_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206088,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-SilentMarket-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you be so kind as to collect any Khrysathemums you see for me? I'll stay out of trouble back here. Thanks, dear!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EloiseMerryweather_KHR_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1206088,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-SilentMarket-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bring me all the Khrysanthemums you find so I can put together the exhibit for the Marleybone Royal Museum!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_ZekeWife.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/EloiseMerryweather_KHR_05.mp3",
