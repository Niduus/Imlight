            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You want to bring Caleban down? I happy to help! Caleban, he cast me out of tribe. And threw our son Wezlee in the Monkey Spider cave! Terrible!",
