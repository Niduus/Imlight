            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Caleban, their leader, rules them with an iron hand. He has a Magic Stone that controls their minds. His fortress is unassailable.",
