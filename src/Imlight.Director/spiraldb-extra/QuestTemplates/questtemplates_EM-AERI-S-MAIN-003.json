            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Beastmen were here before us, before Khan... even before Sycorax, the great Witch the Master defeated. They are terrible enemies.",
