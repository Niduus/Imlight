      "m_displayImage1": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No no, I don't have time for whatever you're selling. Go away! What's that? Disciple Brandon sent you to apply to the Order? Thank the scales! If Brandon sent you, you must be good!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Normally, induction to the Dragonhorn Order is a multi-year process of intense study and training, culminating in the successful completion of the Scales of Judgment Rites.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But we don't have time for all that! Dragonsage Hall, home to all the dragon information the Disciples have collected for over a thousand years has been beset upon by Neberyx, our ancient nemesis!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Draconians have always coveted our research on the Dragon Titan. If they manage to steal the Firebrand Orb and the information coded within it, they'll be capable of unspeakable horrors!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Neberyx simply cannot abscond with the Firebrand Orb. Not just for our Order, but for the good of the Spiral! Please stop him. Consider this your rite of passage exam!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Good work! You saved us. For now anyway. First things first. Return the Firebrand Orb back into the Dragon's Maw where it belongs before its firelight dies out.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Excellent. You've earned your place amongst the Dragonhorn Order, Wizard. May I be the first to say, 'Congratulations, Dragonhorn Disciple'. You've already proved yourself a boon to us!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "When the time comes, the Order will contact you with a mission.  Until then, your first act of duty is to report the good news to your advocate.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-ROOST-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, and tell Brandon to make haste with his Borealis Dragon study. Rumors have reached us that the Didgeri Dragon has resurfaced in Wallaru!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_spikycloak_1BLUE.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/MagisterZilant_GRV_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380014,
                "m_cameraName": ""
              }
            ]
          }
