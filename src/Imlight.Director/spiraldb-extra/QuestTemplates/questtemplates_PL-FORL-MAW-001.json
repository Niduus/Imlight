      "m_displayImage1": "GUI/NpcPortraits/Portrait_Brandon_Storm_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Shouldn't you be studying? What, you're already a Disciple? Awesome! I knew you were special! Too bad it couldn't have been a little sooner though; I just had a run in with the Borealis Dragon. It was EP. IC.",
                "m_picture": "GUI/NpcPortraits/Portrait_Brandon_Storm_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/BrandonK_GRV_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380015,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Anyway, congratulations. Let's talk dragons! What's that? The Didgeri Dragon? Sweet! Then I better finish up here so I can get to Wallaru. But first, I have something I'd like to give you.",
                "m_picture": "GUI/NpcPortraits/Portrait_Brandon_Storm_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/BrandonK_GRV_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380015,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As your advocate, I want you to have this Firebrand Jewel. As you adventure throughout the Spiral - hopefully in search of Dragons - use it to call me, your fellow Dragonhorn Disciple, whenever you need.",
                "m_picture": "GUI/NpcPortraits/Portrait_Brandon_Storm_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/MakeAWish/BrandonK_GRV_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1380015,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
