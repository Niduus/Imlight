                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "When you've finished making the Horn of Eternal Winter, return here to me and I'll lay the final enchantment upon it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_93.mp3",
