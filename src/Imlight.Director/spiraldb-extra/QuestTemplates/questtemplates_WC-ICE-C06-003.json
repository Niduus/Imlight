                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There you go now! This Horn will sound throughout the Spiral and is sure to get the attention of the Titans of Ice.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/ProfLydiaGreyrose_QST_95.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 38172,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "<ITALICS>Professor Greyrose instructs you in the technique of making the Horn of Eternal Winter out of Pure Loam and Everfrost Ice Fragments. When she's finished, you feel like you could do it in your sleep. </ITALICS>",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_Greyrose_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Narrator_NAR_402.mp3",
