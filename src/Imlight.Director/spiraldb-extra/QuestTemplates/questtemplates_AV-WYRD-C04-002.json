            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Take it all to the devil Shane MacGobhann. He can make the Cloak, and in return, I'll vow not to harm a Leprechaun again.",
