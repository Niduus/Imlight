            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-WYRD-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A Cloak of Raven Shadows can free me. First, scavenge Raven Feathers from the Froudling Village.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Giant_Ettin_Rock_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/Billy_AVA_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-WYRD-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then you'll need to battle Wildfire Treants for Ashes, and Tormented Treants for Twisted Branches.",
