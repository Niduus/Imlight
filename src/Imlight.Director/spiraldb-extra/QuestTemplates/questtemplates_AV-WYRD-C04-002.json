            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/Billy_AVA_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 611100,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
