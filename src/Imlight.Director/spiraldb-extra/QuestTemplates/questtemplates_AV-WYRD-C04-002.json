            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Let us bargain, Wizard. The mutton? 'Twas but charity. A devilish Leprechaun lured me here, to be turned to stone by the sun.",
