          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, salutations, Wizard. Or is it, Scion of Bartleby, now? Irregardless, I am most grateful that you have come in this our hour of need.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/BugBoss_CAT_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488012,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As you may know, we Insects of the Subterranean Sanitation Operations have used the Drains to process Topsider garbage for generations.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/BugBoss_CAT_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488012,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Normally, we have no problem dealing with all manner of foul refuse. However, these are not normal times. At present, the trash is revolting.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/BugBoss_CAT_19.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488012,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And I do not mean that the trash is malodorous. I mean the trash has developed sentience, organized, and taken over the Dump in a violent coup.",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/BugBoss_CAT_20.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488012,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-DRAINS-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Please, Scion, go conversate with the Dump Foreman and devise a plan to quash this Trash Monster rebellion before it spills over to Wizard City!",
                "m_picture": "GUI/NpcPortraits/Portrait_Roach_Don_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/BugBoss_CAT_21.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1488012,
                "m_cameraName": ""
              }
            ]
          }
        ]
