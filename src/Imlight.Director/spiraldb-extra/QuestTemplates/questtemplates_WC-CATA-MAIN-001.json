                "m_picture": "GUI/NpcPortraits/Portrait_Fly_Forman_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DumpForeman_CAT_02.mp3",
