                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you preoccupy the Trash Monsters wit' some of that fancy spell-slinging you do, I'll sneak around and sees if I can find the root cause.",
                "m_picture": "GUI/NpcPortraits/Portrait_Fly_Forman_A_NPC.dds",
