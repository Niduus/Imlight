            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Thanks for coming, Wizard. Subterranean Sanitation Operations reports there's some kind of problem in the Drains.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Ren_CAT_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488013,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC10-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I offered to check it out myself, but the Sanitation Boss claims that you are the only 'Topsider' he trusts to handle the matter. Will you help?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Ren_CAT_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488013,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-HUB-NPC10-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Great! The Boss is right below us waiting for you. You can use that Manhole right there. Good luck!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/Ren_CAT_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1488013,
            "m_cameraName": ""
          }
        ]
      },
