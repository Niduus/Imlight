  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am not forcing anyone to work here. This Treacle Foundry is good for Nibbleheim, my friends. Yah, yah, the smell. It is the cost of doing business.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Orson_003_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506489,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This place used to be a hub of Whatchamagolems and Gummies, but the Nibbelung - not Nana - left it to sunset on the vine.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Orson_003_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506489,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It is just progress. Gummies are faster. Ore-sorting jobs are few and unrewarding. So the Moles left for the surface.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Orson_003_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506489,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But they don't like it up there; it is too bright. So I saw a Corportunity. I brought Treacle here to leverage Nibbleheim, bring the Nibbelung home...",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Orson_003_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506489,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "...And let them in on the ground floor of the disruptive new innovation in candy. Which will be ruined if you do not find my Recipe, my friend.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Orson_003_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506489,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KM-NIBB-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Mmmmm, yah, I need you to be like 20% more engaged in finding my Treacle Recipe right now. HAOFDD.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/Orson_003_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1506489,
