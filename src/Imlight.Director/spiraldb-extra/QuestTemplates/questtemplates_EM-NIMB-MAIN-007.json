      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why does no one answer their communicator? Wizard, Sparck told me what happened. There's no time to waste. We have to find Beans and Mellori.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Pork_EM2_89.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413242,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, yes, go. We'll be fine here.",
            "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Noble_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Vanitus_EM2_49.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413241,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC08_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Quiet, toad! Your days of manipulating Neumia from the shadows are over. Isn't that right, Your Highness?",
            "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_HelenaF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Helena_EM2_87.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413252,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Sweet Vicereine, surely you must understand. You wouldn't turn your back on poor Vanitus now?",
            "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Noble_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Vanitus_EM2_50.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413241,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Praetor Helena, take this vermin to the dungeons. Let him rot as we dedicate our life and rule to atoning for the crimes he led us to commit.",
            "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_RulerF_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Vicereine_EM2_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413250,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My mother, my duty, is here. I'll use my knowledge to guide our people to a less violent path. Wizard, Captain, tell Ione for me.",
            "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Crewman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Sparck_EM2_81.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413243,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-NIMB-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We will, Mr. Sparck, and good luck. Show your people peace isn't to be feared. It is to be aspired to. Now, Wizard, to the Streamportal!",
            "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Pork_EM2_90.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1413242,
            "m_cameraName": ""
          }
        ]
