            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Ask Sir Pike if he has seen Innes Idle, my loyal minstrel. I gave him the Sword of Kings to keep it away from the Froudlings.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirRobinBravely_AVA_03.mp3",
