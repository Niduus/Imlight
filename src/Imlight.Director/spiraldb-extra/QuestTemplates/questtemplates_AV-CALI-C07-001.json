            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "When I heard the Fire Elves were fighting Froudlings, I came to see if I could help. I was, uh, anxious about losing the Sword of Kings.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirRobinBravely_AVA_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 602077,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HUB-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Instead, I gave it to my loyal minstrel, Innes Idle, and told him to hie away to safety. Perhaps Sir Pike has seen him?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/SirRobinBravely_AVA_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 602077,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
