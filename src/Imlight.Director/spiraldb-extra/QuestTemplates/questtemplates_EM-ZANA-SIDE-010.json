            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "By the endless storms of Empyrea, these Sani-Bots don't know when to quit. They just classified me as a \"Hostile Unsanitary Lifeform.\"",
            "m_picture": "GUI/NpcPortraits/Portraits_Alphoi_Warrior_A_NPC.dds",
