            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Let me think here, jot down some notes... Okay, I've got some Recipes to upgrade those weapons to something beyond Legendary.",
