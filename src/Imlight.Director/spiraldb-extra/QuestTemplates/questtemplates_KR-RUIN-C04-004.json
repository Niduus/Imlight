                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The dream wasss dark and cold. Who bringsss me into thisss light? A Wizard? Here? Why?",
                "m_picture": "GUI/NpcPortraits/Portrait_Snake_Celestial_A_NPC.dds",
