            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My warrior-sister, Roze the MouseHunter, recently captured a spy. This Mouse is an agent of the Burrowers, those that oppose us.",
