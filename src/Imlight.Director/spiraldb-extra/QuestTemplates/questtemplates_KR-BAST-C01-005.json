            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go to Roze the MouseHunter and determine what she has gleaned from questioning the spy. She holds him atop the Broken Tower.",
