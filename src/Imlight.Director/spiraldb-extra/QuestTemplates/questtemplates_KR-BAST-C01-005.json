            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This spy holds critical information about their defenses. If he breaks, the Umbra Legion could wipe them out to the last.",
