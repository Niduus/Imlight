            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Burrowers are a weak and scattered force, but they have enough weapons and warriors to pose an occasional nuisance.",
