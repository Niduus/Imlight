            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello there! Could you help me? I'm in charge of a group of brand new students, and they've gone missing!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Pa_Student_G_05_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/EloiseClockwarden_WYS_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465163,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC22_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I was providing the students a guided tour of Pigswick... then I turned around and noticed they were nowhere to be found!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Pa_Student_G_05_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/EloiseClockwarden_WYS_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465163,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
