            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We toured several classrooms, including those of Professor Velma Pepper, Professor Ankhu, and Professor Edna Fuligin.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Pa_Student_G_05_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/EloiseClockwarden_WYS_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465163,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC22_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you help retrace our steps, speaking to each of those professors, and see if you can find where they went to?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Pa_Student_G_05_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/EloiseClockwarden_WYS_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465163,
