            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That Rattlestick is critical to cross the Xoxocti River. But to reach it we need to enter the sacred Nesting Grounds.",
