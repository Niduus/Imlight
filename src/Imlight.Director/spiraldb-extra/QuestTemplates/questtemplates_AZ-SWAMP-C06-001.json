            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Recover the Ocarina wind flute he stole. Take this to the leader of the priests, Huix Saltwater, and beg forgiveness.",
