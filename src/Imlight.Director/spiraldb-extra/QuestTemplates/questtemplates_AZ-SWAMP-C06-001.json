            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We'll ask the Moon Skull Priestesses for a blessing, so as not to disturb the Nesting Grounds. You met them already? You fought them!?",
