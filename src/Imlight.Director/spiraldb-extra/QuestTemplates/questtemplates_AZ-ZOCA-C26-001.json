  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Magician, I fear we may be a doomed people, destined to be wiped out by the falling sky, or the Hungry Dead.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TezcatThreestar_AZT_43.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643254,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It would be tragic if our history was lost forever. I charge you to help us preserve it, if I may be so bold.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TezcatThreestar_AZT_44.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643254,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There are six great Tzolk'in Stones, or Sacred Rounds, that tell our story. Over the ages they have been scattered.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TezcatThreestar_AZT_45.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643254,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZOCOLO-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I need you to find the six Tzolk'in Stones and bring them back to the Teocalli of Sacred War, in Three Points.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_C_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TezcatThreestar_AZT_46.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 643254,
            "m_cameraName": ""
          }
        ]
      },
