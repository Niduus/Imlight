            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have heard of you, young Wizard. I hope we can help each other. Tell me your story.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Queen_Amahle_NPC.dds",
