            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The king's magician, Tse-Tse Snaketail, said he was also looking for a herd of Wizards. For nefarious purposes, no doubt.",
