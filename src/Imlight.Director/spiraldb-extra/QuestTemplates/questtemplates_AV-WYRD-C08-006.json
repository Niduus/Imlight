            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Gwendolyn can help you complete your knowledge of the Sword of Kings. She must be hiding at the ring fort, Dun Dara!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Human_Knight_Malory.dds",
