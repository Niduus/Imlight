      "m_displayImage2": "",
      "m_clientTags": [
        "MR-MagicLamp_Istar"
      ],
      "m_genericEvents": [],
      "m_autoQualify": true,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Am I ever glad to see you! After I refused to grant Ali Baboon's wish, I thought I'd be stuck in my Lamp forever!",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_120.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378183,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm sorry, Wizard. I feel so dumb. This is all my fault! When we were negiotiating with the House Qhats, I had what seemed to be a great idea...",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_121.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378183,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "To get the House Djinn to support us, I agreed to help them steal the Chronoshards from their Masters. The Shards we gave them were fakes.",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_122.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378183,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I stashed the real Chronoshards away in the Palace Vault. Then, during the Battle, the deal was, I had to let Ali Baboon in to take them.",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_123.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378183,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ALKA-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wait. Let me get this straight. You made a secret deal involving Ali Baboon and didn't expect to be betrayed? You really are daft.",
                "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_92.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1381172,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I know. The House Djinn were working with Eerkala all along. She got the Chronoshards and Ali Baboon got my Lamp as payment for his help.",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_124.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378183,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC07_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, I hope you'll forgive me, Wizard. And the Sultana! Oh dear, I should go and tell her the truth right away. Meet me back at Kasra Palace.",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_125.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378183,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
