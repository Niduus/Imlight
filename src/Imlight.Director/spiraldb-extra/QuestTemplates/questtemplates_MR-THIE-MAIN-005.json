                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ooh... I bet there are some goodies in here. It'd be okay to steal from Ali Baboon and the Fortee Thieves, wouldn't it?",
                "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_89.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1381172,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ALKA-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, but what would the Sultana say? Great sands, she's giving me a conscience! Fine though. Not like I have pockets anyhow.",
                "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_90.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1381172,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-ALKA-NPC05-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There's Istar's lamp right there. Let's just grab it and get out of here, right? Yes. Make the Sultana proud. Right.",
                "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_91.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1381172,
