                "m_nameOverride": "Goofang",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I can't believe this - the nerve of you people to just storm into my Laboratory. Have you no respect for Sayameez tradition? Of course not!",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_G_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Goofang_MIR_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
