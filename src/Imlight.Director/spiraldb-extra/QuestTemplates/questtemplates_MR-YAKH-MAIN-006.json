                "m_personaName": "",
                "m_nameOverride": "Goofang",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You are outsiders, unworthy in every aspect. We shouldn't even let people like you inside the walls. You only bring discord and violence.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_G_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Goofang_MIR_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
