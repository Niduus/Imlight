                "m_nameOverride": "Goofang",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In fact, I suspect it's your influence that's encouraged the Rebels. And it's just as well. When I bring you down, the Rebellion will fall too.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_G_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Goofang_MIR_04.mp3",
