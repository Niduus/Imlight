            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Higher and higher every day, till over the sea at noon, the Great Beast had no moment's rest, for he heard the loud bassoon.",
            "m_picture": "GUI/NpcPortraits/Portrait_Rat_Captain_A_NPC.dds",
