            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We need to send a loud, clear call to the Great Beast. There is a Mustering Horn in Fort Rachias. I've heard it too often.",
            "m_picture": "GUI/NpcPortraits/Portrait_Rat_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_44.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283092,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go and fetch it. While you're about, search for a case of Nautics Stones. We'll need them, too.",
            "m_picture": "GUI/NpcPortraits/Portrait_Rat_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_45.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283092,
