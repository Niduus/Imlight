            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Spirit of Crescent Beach must be put to rest! I cannot think nor sleep nor eat with her hauntin' me!",
            "m_picture": "GUI/NpcPortraits/Portrait_Rat_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_08.mp3",
