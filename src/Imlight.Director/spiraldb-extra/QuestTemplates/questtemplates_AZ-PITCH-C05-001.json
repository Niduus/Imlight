            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is an ancient pathway the priests used. Listen closely to these notes: Hum, hum, hum, hum, hum.",
