            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Shadow Queen has polluted Mother Moon? Hmm. The Aztecosaurs are my hated enemies, from sun birth to sun death, but still...",
