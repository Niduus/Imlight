            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Why do you pester me, Wizard? There is but one who is due my full fury, and his name is Captain Taylor Coleridge!",
            "m_picture": "GUI/NpcPortraits/Portrait_Minotaur_Pirate_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/Kosmas_KH2_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283114,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-FortRachias-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Captain sent you to disturb me? I will rend you with my axe and horns, and the scent of your spilled blood will be my perfume!",
            "m_picture": "GUI/NpcPortraits/Portrait_Minotaur_Pirate_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/Kosmas_KH2_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283114,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-FortRachias-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Eh, you wish to make reparations for the Captain? Hrmph. Very well. It is difficult for me to strike you, anyway.",
            "m_picture": "GUI/NpcPortraits/Portrait_Minotaur_Pirate_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/Kosmas_KH2_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283114,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-FortRachias-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My Golden Horns of Asterion have been taken by Leaf Shields. As a spirit, I cannot seem to touch them. Retrieve the horns, and I may listen.",
            "m_picture": "GUI/NpcPortraits/Portrait_Minotaur_Pirate_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/Kosmas_KH2_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283114,
            "m_cameraName": ""
          }
        ]
      },
      {
