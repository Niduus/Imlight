                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Fire Wizard! You seek know-how about Rain of Fire spell? Water-Moles of old suffer much when volcanoes wake and roar!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Platypus_Chief_NPC.dds",
