                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizards who want to summon Rain of Fire must learn to listen to ground, sense a vein of fire, bring it up to ground.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Platypus_Chief_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/TupaTaua_ZFA_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 211525,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-LAND-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Best advice... if volcano comes, you should be on the other side. Maybe do like Water-Moles and move out of way.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Platypus_Chief_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/TupaTaua_ZFA_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
