                "m_dialogEvent": "",
                "m_actorTemplateID": 211525,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-LAND-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Long ago, Water-Moles did not know how or when volcanoes were born. Bad times! When we learned to sense them... better times!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Platypus_Chief_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/TupaTaua_ZFA_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 211525,
                "m_cameraName": ""
              },
              {
