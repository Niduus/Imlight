            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You have absorbed a great deal of Morganthe's stolen power. Too much, in fact. Should you not shed it, it would consume you.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/OldCob_KH2_108.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283142,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-ShadowPalace-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Luckily, the answer is simple. Give it back to the land. Go to Zha-Te-:Ke:-Zang-Zeeyun and restore the Zealous Colossus.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/OldCob_KH2_109.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283142,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-ShadowPalace-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Then return to Bastion and revitalize the Rubicund Colossus. I will watch for you there.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/OldCob_KH2_110.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283142,
