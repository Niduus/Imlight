                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wizard, it is so good to see you hale and hearty. I must tell you we were all concerned for your safety.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Ambrose.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/MerleAmbrose_KH2_16.mp3",
