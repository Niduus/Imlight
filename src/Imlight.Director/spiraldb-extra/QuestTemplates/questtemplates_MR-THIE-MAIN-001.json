      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oops! Forgot my dancing shoes! Not like I'd need them, I suppose, but I'd give us away anyhow. I'll stay out here. You go on. Break a leg!",
                "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_73.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397162,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Look who dropped in! When I said \"break a leg\", I meant it as a figure of speech, you know? So, we both got made. Bit of a bummer, isn't it?",
                "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_74.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397162,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-THIE-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Things could be worse, though, right? I mean, for one thing, being dropped down in a hole can be lonely. At least we have each other, yeah?",
                "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_75.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397162,
