            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm doomed! Doomed! Doooooomed! Oh, dare I say hello? You look like a Wizard from Wizard City. Am I dreaming you?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Assistant_Professor_Umlilo_Sunchaser.dds",
