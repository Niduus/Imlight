            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm not? Frabjous day! I can't talk more, or the Blackback Soldiers will punish me! Hmm. They don't seem to scare you, do they?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Assistant_Professor_Umlilo_Sunchaser.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/UmliloSunchaser_ZFA_03.mp3",
