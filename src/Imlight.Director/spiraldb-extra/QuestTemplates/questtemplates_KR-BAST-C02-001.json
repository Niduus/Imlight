            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But I know some of our treasures remain safeguarded in the Mausoleum. Can you enter the tombs and find me a blade and armor?",
