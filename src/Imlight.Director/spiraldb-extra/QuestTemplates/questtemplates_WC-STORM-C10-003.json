            "m_personaName": "WC-RAV-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "No need to go very far away... you can try it out somewhere in Wizard City. How about the pond in Cyclops Lane?",
