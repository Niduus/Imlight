            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There aren't any ships nearby, so it won't cause too much of a disruption, and it will be a nice bit of promotion for Storm magic!",
