            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfHalstonBalestrom_ZFA_18.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
