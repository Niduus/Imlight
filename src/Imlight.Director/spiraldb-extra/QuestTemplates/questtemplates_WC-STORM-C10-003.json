            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38141,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-RAV-NPC05_Persona",
