            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But first, you should wear these protective earplugs! Let the Sirens sing their song, and then remove them when you're ready.",
