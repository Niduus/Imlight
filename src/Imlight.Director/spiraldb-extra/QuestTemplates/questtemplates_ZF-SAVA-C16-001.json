            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This useless, broken boiler that rogue Hannibal traded me? I gave him good <ITALICS>biltong</ITALICS> for that!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Esop_Thornpaw.dds",
