          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Wait, you want the boiler? That boiler is... an art piece! It ties the lawn together. I couldn't possibly give it away.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Esop_Thornpaw.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/EsopThornpaw_ZFA_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466170,
            "m_cameraName": ""
          },
          {
