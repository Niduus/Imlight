            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Trade for it? What a terrific idea. I hear the Darkmane tribe had a bumper crop from their garden.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Esop_Thornpaw.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/EsopThornpaw_ZFA_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466170,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you could get their chief to give you some vegetables, I'd be happy to give you this piece of junk... er, my center piece.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Esop_Thornpaw.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/EsopThornpaw_ZFA_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466170,
