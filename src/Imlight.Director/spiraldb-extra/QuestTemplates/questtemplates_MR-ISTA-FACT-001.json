            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I don't care what Snake thinks about this. It's for Istanboa, and he abandoned that cause long ago. You can help us, and you will be rewarded.",
