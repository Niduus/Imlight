            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "But me no want to scare dwarves. Me want help with my Bridge. Nasty old Gruff Goats keep walking over it.",
