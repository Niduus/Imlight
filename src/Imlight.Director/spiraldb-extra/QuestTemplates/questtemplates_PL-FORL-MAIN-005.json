            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC03-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh goodness! That's it, isn't it? My Flapjack Pan! I love my Flapjack Pan so much. Yes, I sure do.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/ChillyLilly_POL_16.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346206,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC03-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You'll have to excuse me, Mistress, but I won't be going back with you. I'm going to stay here in Walruskberg. Yes, I surely am.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/ChillyLilly_POL_17.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346206,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC03-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I wish you the best of luck with that, Mistress. I certainly do. I hope you have a safe journey, very safe.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/ChillyLilly_POL_18.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346206,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC03-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "All right, Wizard. I guess this is goodbye. Or maybe I'll see you in the city. I'd like that, like it very much.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/ChillyLilly_POL_19.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346206,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC03-B_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I'm sorry if I've given your friend Ivan cause to worry. Maybe Mariya has better news. You should speak with her.",
                "m_picture": "GUI/NpcPortraits/Portrait_Penguin_TownieF_F_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/ChillyLilly_POL_20.mp3",
                "m_action": "",
