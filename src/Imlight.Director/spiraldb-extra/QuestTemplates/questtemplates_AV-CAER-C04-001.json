            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Strike down the Logres Knights, and make them reveal Falynn's fate. Find her for me, Wizard.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Treant_Ancient.dds",
