        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-CAER-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are an apprentice to the stripling, Merle Ambrose, are you? Hurm. I've not heard that name in many seasons.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Treant_Ancient.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/OldGreenBeard_AVA_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 537805,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-CAER-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You wish to enter the Weirwood? The path has been closed since the Froudlings attacked.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Treant_Ancient.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/OldGreenBeard_AVA_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 537805,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-CAER-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I have lost one of my daughters, Wizard. The wind moans that Falynn Greensleeves was captured by chaotic Logres Knights.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Treant_Ancient.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/OldGreenBeard_AVA_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 537805,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-CAER-NPC06_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My Falynn is but a defenseless sapling. Make the Logres Knights tell you how to find her, Wizard. Then, mayhaps, we can speak.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Treant_Ancient.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/OldGreenBeard_AVA_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 537805,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
