        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-FLOAT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You have been sent to consult with the Oracle to find the Pyramid of the Falling Star?",
            "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/OcuhajeMirrorKnife_AZT_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470553,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-FLOAT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are not the only one searching for the Oracle. There are obstacles to overcome in this journey. Your first is Isla Tormenta.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/OcuhajeMirrorKnife_AZT_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470553,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-FLOAT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The island was conquered by a Kronosaur, who kidnapped the Storm Quetzals. He cages their power for himself.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/OcuhajeMirrorKnife_AZT_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470553,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-FLOAT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Defeat Ahuizotl Drowned Dog. Free the Storm Quetzals he captured, and coax them back to the Storm Pillars.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/OcuhajeMirrorKnife_AZT_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470553,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-FLOAT-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They will recharge the Storm Pillars, which will summon a Prismatic Blade. Take it, for you will need it later.",
            "m_picture": "GUI/NpcPortraits/Portrait_Jaguar_Shaman_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/OcuhajeMirrorKnife_AZT_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 470553,
