            "m_dialogEvent": "",
            "m_actorTemplateID": 617083,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HIGH-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you aid me in recovering my Charm Bag, I'll teach you a spell your professors have never heard of. Won't that be a surprise?",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Owls_Fianna.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FiannaYellowknife_AVA_24.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617083,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HIGH-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Recently, many of my kind gathered to share wisdom and lore. My Charm Bag was taken from me while I was in a dream-trance.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Owls_Fianna.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FiannaYellowknife_AVA_25.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617083,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HIGH-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It was a Raven who stole my Charm Bag... an outsider from the world of Grizzleheim! A Raven named Hrefna Nightfeather.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Owls_Fianna.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FiannaYellowknife_AVA_26.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617083,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-HIGH-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That Raven skulks in a cave near the Toadstool Village in the Wild, in Weirwood. Return my bag and you will be rewarded!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Owls_Fianna.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FiannaYellowknife_AVA_27.mp3",
