            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I did not go to any magic school like your Ravenwood, but as a wood witch, I am privy to many magical sleights and tricks.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Owls_Fianna.dds",
