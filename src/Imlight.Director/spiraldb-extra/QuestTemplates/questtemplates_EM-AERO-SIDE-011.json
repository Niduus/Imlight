            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yeah, them songs take over your brain till they're the only thing you hear, the only thing you think and the only thing you smell for some reason.",
