            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Anyway, let me cobble together that Ghost Shell for you and... done. Now, just chase that Voltergeist out of the Turbine and follow it.",
