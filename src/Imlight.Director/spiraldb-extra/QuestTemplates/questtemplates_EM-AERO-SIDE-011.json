            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Probably should have warned you about that before sending you out there, maybe give you some ear plugs. But I'm out of those too.",
