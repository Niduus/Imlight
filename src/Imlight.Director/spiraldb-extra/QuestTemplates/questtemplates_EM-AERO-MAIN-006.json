      "m_displayImage1": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You looking for a room for the night? Sorry, stranger, but the inn is closed. Oh, you're here for Helena. Odd one, isn't she?",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Such a sad story she has. It's hardened her. But I can see in your eyes she never told it to you, so I best hold my tongue. What does she need?",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Stormade? I'd love to give you some, but I'll need some help from you first. Information? No, I need something more specific.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We just had a Whirlyburly match against Port Aero and now our coach is... uh, coaching a spirited discussion between the fans inside.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That's why we're closed and why I'm out here. So if you want my Stormade, you'll need to settle them hooligans before they drink it all.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Saw you head off with Coach. Did you get your Stormade? Good. And, yes, I'll make sure the Legends get their electrolytes. I know my civic duty.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, you want to give me Helena's information anyhow? The info she wanted you to trade for that Stormade? That's mighty kind of you.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "WE'RE causing the Nightmare Myth Monsters? The Frog Prince and such, that's us?",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, thanks for telling me. I'll spread the word, don't worry. 'Spose Helena told you to trade that info? She assumes the worst of everyone.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERO-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "She didn't used to - I knew her when she lived in Nimbus - so much has changed since then. But that's her story to tell. You should get back.",
                "m_picture": "GUI/NpcPortraits/Dwarf_AeroCitizenF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Constance_EM2_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1447332,
                "m_cameraName": ""
              }
            ]
          }
        ]
