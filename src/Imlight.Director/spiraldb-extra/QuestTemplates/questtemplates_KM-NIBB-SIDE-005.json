      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-NIBB-NPC21_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You have Apple Peels? Wonderful. I have the Soda Water you need. Together we can purify the Gobblerstopper so it stops mutating everyone.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_BogWitch_Fairy_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/CharleneWard_003_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506515,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-NIBB-NPC21_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That glob of recycled jelly is more important than you can ever know. It is a font of understanding. It is truth in its chewiest form.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_BogWitch_Fairy_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/CharleneWard_003_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506515,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-NIBB-NPC21_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "No, I'm not going crazy! Well, I mean I did for a minute. My mind was overwhelmed with another world's history and customs all at once.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_BogWitch_Fairy_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/CharleneWard_003_10.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506515,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-NIBB-NPC21_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But that's the point. By absorbing all these customs and cultures, the Gobblerstopper has become the common ground between all Spiral worlds.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_BogWitch_Fairy_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/CharleneWard_003_11.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506515,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-NIBB-NPC21_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Other worlds aren't sources of fear, they are avenues to new understandings, new views, new perspectives.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_BogWitch_Fairy_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/CharleneWard_003_12.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506515,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-NIBB-NPC21_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "With its mutagenic qualities scrubbed out, I'll make the Gobblerstopper the centerpiece of the Karamelle Cultural Exchange Museum.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_BogWitch_Fairy_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/CharleneWard_003_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506515,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-NIBB-NPC21_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Tourists can use it to see the Spiral through everyone else's eyes, understand each other as never before and perhaps go home a little bit sweeter.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_BogWitch_Fairy_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/CharleneWard_003_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506515,
                "m_cameraName": ""
              }
            ]
          }
        ]
