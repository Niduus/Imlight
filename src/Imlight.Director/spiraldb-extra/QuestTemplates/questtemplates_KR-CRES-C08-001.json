        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The souls did from their bodies fly - they flew from rack to scourge! And every soul, it passed me by, sounding a lowly dirge.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_18.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283092,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Let me think, let me think. Let me think! Kosmas! Yes, Kosmas is next! Our navigator was a great bull from Aquila.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283092,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-CrescentBeach-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've heard the Umbra Legion tellin' stories what sound like he's taken to hauntin' Fort Rachias. Search the fort for Kosmas' spirit!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/TaylorColeridge_KH2_20.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283092,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
