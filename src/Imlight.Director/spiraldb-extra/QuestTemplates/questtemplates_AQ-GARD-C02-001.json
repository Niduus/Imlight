          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AQ-HUB-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Good Wizard, you have proven yourself time and again. You have won such accolades and awards, even the Immortals are impressed.",
            "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Aegle_AQL_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 741211,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AQ-HUB-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you heard of the Pit of the Noxii? It is a stadium beneath Olympus devoted to the warrior's spirit and dueler's craft.",
            "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Aegle_AQL_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 741211,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AQ-HUB-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The most fearsome and notorious gladiator of all time, Dimachaerus, was trapped there by Zeus and his brothers, Poseidon and Hades.",
            "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Aegle_AQL_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 741211,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AQ-HUB-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you are truly confident in your abilities, Zeus welcomes you to try your wits against Gladiator Dimachaerus.",
            "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Aegle_AQL_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 741211,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AQ-HUB-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you best Dimachaerus, you will forever be known as a Supreme Gladiator. And if you fail, your name will still be recorded by the poets.",
            "m_picture": "GUI/NpcPortraits/Portrait_Eagle_DruidF_D_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AQL|WorldData|Sound/Dialogue/Aegle_AQL_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 741211,
            "m_cameraName": ""
          }
        ]
      },
