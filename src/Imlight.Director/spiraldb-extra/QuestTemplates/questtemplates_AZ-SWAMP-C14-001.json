            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Please speak to Techotl and see if you can ensure Wise Man Zope Broad Seer is well and good.",
