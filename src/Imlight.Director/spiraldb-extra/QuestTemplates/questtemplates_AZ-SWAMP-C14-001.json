            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I am worried that some tragedy has befallen Zope. Last I knew he went to trade with Techotl Redsmoke in Mangrove Marsh.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_Warrior_B_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/CantaresFiveFlowers_AZT_25.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 701129,
