      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-Bastion-NPC27_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Bastion's walls were too strong to break, and our stores were vast. We would not fall to siege, so the Shadow Queen turned to dark magic.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/DyvimWhiteHart_KHR_36.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205094,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-Bastion-NPC27_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Shadow Queen unleashed a spell of unimaginable cruelty. It transformed all within Bastion into crystal.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/DyvimWhiteHart_KHR_37.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205094,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-Bastion-NPC27_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Those Burrowers who were not caught in her spell fled to the Last Wood, where we have continued to resist her, for generations.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/DyvimWhiteHart_KHR_38.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205094,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-Bastion-NPC27_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I was not alive when Bastion fell, but my parents' parents barely escaped. My people have fought the Shadow Queen since time out of mind.",
                "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/DyvimWhiteHart_KHR_39.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1205094,
