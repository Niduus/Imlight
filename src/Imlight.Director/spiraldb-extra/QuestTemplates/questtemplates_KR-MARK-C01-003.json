            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Shadow Queen's armies have long pursued us. We held Bastion for a hundred years against the darkness, before it was finally lost.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/DyvimWhiteHart_KHR_32.mp3",
