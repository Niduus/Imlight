            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Look at them and then I will tell you a sorrowful tale.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/DyvimWhiteHart_KHR_34.mp3",
