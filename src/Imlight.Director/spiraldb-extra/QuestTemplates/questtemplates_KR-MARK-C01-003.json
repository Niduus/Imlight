            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "These Crystal Statues that stand vigil in Bastion are a testament to the horrors the Shadow Queen inflicted upon my people.",
            "m_picture": "GUI/NpcPortraits/Portrait_Mice_Knight_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/DyvimWhiteHart_KHR_33.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1205094,
