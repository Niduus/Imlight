            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now that we've determined you'll be staying to compete in the tournament, it's time to get you squared away.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Mrs_Dowager.dds",
