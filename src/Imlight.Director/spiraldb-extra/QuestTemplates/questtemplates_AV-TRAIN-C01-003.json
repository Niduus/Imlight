                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That said, they do covet magic and are notorious thieves! Can you seek them out in Upper Caer Lyon and retrieve my lost book?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Otter_Scribe_Francis.dds",
                "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FrancisLux_AVA_15.mp3",
