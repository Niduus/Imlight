            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "When <ITALICS>The Art of Magic</ITALICS> (volumes I and II) are returned, I will help you in your studies.",
