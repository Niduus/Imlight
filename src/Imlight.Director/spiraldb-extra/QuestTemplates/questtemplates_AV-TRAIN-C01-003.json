      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Do you wish to learn more of the ways of magic? Methods by which you could learn additional spells? I can be of help.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Otter_Scribe_Francis.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FrancisLux_AVA_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617241,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Somewhere in this library is a famous two-volume work called the <ITALICS>The Art of Magic. </ITALICS>",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Otter_Scribe_Francis.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FrancisLux_AVA_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617241,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It contains many secrets of magic, but I have not been able to lay eyes on the book for some time.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Otter_Scribe_Francis.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FrancisLux_AVA_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617241,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AV-ABBEY-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It would do me no end of good if you could search the shelves of the Standing Tower Library here and find my missing books!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Otter_Scribe_Francis.dds",
            "m_soundFile": "|Sound_Dialogue_AVA|WorldData|Sound/Dialogue/FrancisLux_AVA_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 617241,
            "m_cameraName": ""
          }
        ]
      },
      {
