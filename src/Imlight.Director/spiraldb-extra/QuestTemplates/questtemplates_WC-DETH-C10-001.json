      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So... we meet again. Who sent you?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Dworgyn? It has been years since he worked for me. Whatever does he need?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_01b.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh... he seeks the secrets of my monster, my greatest creation! You know, that really takes me back...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We were young, and I was just getting into the whole mad scientist thing, and Dworgyn had just graduated from Hench School.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The things we got up to! Robbing graveyards, stitching corpses, calling lightning from the sky!  Those were the days...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But I am afraid I cannot help you. My papers were stolen from my lab some time ago.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I heard rumors that they had been taken by a sorcerer named the Hoarder, but I do not know any more.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Go now, and slink back to Dworgyn with your tail between your legs.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_07.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, you don't have a tail? Well... let me out of this cell, and I'll fix that...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Mad_Scientist.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/DrKatzenstein_ZFA_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 527122,
