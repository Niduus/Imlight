  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If it isn't my favorite student! What brings you here?",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfDworgyn_ZFA_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What's that? I sent for you? Oh, yes... of course I did! I have the very best of news for you... it's time for a new spell!",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfDworgyn_ZFA_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "This one is a favorite of mine, and goes way back to when I was just getting started in the henchman business.",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfDworgyn_ZFA_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm going to teach you to summon Katzenstein's Monster! That's right! A fearsome construct of flesh and metal!",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfDworgyn_ZFA_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Before we get started, though, you must speak to Dr. Katzenstein himself! He'll tell you how to invoke his monster!",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfDworgyn_ZFA_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go speak to him in Marleybone. After the unfortunate events you're no doubt aware of, he's in the custody of Scotland Yard.",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfDworgyn_ZFA_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 82209,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-NIS-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go speak to Dr. Katzenstein in Marleybone. He's being held in a cell in Scotland Yard. Return here when you're done with him!",
            "m_picture": "GUI/NpcPortraits/Human_Dworgyn_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/ProfDworgyn_ZFA_08.mp3",
