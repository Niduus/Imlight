                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Nana brand, you say? Oh... oh my... You... should talk to my President in charge of handling such things.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Hamster_GrandF_A_NPC.dds",
