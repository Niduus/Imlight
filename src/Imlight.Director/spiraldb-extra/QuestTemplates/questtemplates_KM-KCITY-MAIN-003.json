                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, hallo there, sweetie. What can Nana do for you? Would you like to hear the history of Karamelle Delights, or our VIP Pet Snack Club, or perhaps...",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Hamster_GrandF_A_NPC.dds",
