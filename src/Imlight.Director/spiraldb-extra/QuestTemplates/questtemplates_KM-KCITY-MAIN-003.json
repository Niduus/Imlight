                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Of course, Nana remembers you. She remembers all her Valued Customers. You are ever so sweet and... valuable. Now what can I do for you?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Hamster_GrandF_A_NPC.dds",
