                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1510014,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-KCITY-NPC03_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh my, Sour Gummies! Well, that is what happens when you go with one of those other brands. They do not have that extra touch of sweet...",
