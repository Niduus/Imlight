        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "All right. I have a plan to smuggle you into the Thieves Den. You're probably not going to like it. I know I wouldn't, but... it's the only way.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DevinnTheDrifter_MIR_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397144,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "As it so happens, I usually have three Dancers in my Dance Squad. As you can see, we're down one, so you can pretend to be the third dancer.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DevinnTheDrifter_MIR_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397144,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Just step over to the Wagon and you'll find a Dromel Dancer Costume you can put on. Then we'll make our grand entrance.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/DevinnTheDrifter_MIR_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397144,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-CATE-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go ahead, put it on. I know you might not be excited about this, but if you want to get into the Thieves Den, it's what you have to do.",
