        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-THIE-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "My main concern... I just hope he doesn't leave us down here to rot. I've done enough of that, thank you very much.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_76.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-THIE-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Welcome to the Underden, my friends. Ali Baboon and his guests appreciate your participation in this exciting sporting event.",
            "m_picture": "GUI/NpcPortraits/Portrait_Baboon_Boss_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/AliBaboon_MIR_18.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391064,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-THIE-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A gauntlet of combatants awaits you in the adjoining chambers - a test of your prowess. You should know, however, that victory is impossible.",
            "m_picture": "GUI/NpcPortraits/Portrait_Baboon_Boss_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/AliBaboon_MIR_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391064,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-THIE-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Whatever. Are you trying to make us scared? Nice try! I say he's underestimating us. They always do, don't they?",
            "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_77.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1397162,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-THIE-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm afraid not, my bony friend. You will suffer humiliating defeat here, but it should be a terrific show! With that, let the games begin...!",
            "m_picture": "GUI/NpcPortraits/Portrait_Baboon_Boss_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/AliBaboon_MIR_20.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391064,
            "m_cameraName": ""
          }
        ]
      }
    ]
