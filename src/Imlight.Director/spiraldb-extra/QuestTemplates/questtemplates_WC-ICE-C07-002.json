                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "A Frost Diamond? Luck has left you behind, my friend. The only one I know of in this whole region is unavailable.",
