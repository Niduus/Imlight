                "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/HagenShieldbreaker_CEL_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 164454,
