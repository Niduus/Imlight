                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The owner is an unworthy cur of a fellow named Volkir Rimeaxe. He dwells in a cave not far from here.",
