                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you find him and ask him nicely (and by \"ask nicely\" I mean smite him), he may surrender the Frost Diamond to you.",
