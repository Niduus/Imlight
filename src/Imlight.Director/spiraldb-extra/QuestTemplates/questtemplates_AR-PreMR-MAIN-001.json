      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh... there you are. Well, have you remembered what you forgot? Any bells ringing? Something about Grandfather Tree, perhaps?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/LibrarianFitzhume_MIR_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346371,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Don't you think it's about time someone went and checked on Bartleby? Well, don't look at me - you're the one who attended Ravenwood.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/LibrarianFitzhume_MIR_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346371,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh, and Scholar Zander wants a word before you go - probably to share his latest theory about the meaning of life. Go on now. Time is wasting!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/LibrarianFitzhume_MIR_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1346371,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AR-ARC-NPC10_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well, what are you waiting for? Go on, Initiate. You can only neglect your responsibilities for so long.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/LibrarianFitzhume_MIR_05.mp3",
