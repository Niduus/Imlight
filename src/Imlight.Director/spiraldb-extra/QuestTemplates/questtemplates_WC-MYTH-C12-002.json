            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "With the Wheel of the Sun and the Tonaltzintli Codex, we have all we need to summon the Celestial Calendar.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
