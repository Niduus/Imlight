            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ProfCyrusDrake_AZT_25.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38206,
