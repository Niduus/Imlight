            "m_personaName": "WC-RAV-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go to Azteca, where the Calendar was made. Reassemble the Wheel of the Sun somewhere appropriate, such as in the Zocalo.",
