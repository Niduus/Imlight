            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I've copied the relevant summons from the Tonaltzintli Codex. You should be off... unless you have something better to do?",
