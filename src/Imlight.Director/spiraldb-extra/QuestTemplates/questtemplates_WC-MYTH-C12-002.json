            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yes, the Zocalo will do. There is a short avenue flanked by pillars, the Plaza del Oro. That should serve you well enough.",
            "m_picture": "GUI/NpcPortraits/Portrait_Human_Drake_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/ProfCyrusDrake_AZT_24.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 38206,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
