            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The crafting skill of the Burrowers harkens back to the Old Times. There is much I can teach you.",
