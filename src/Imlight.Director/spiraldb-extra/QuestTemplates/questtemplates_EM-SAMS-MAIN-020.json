                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Look out! What are you doing here, you monster?",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
