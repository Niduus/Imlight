                "m_personaName": "EM-CHAOS-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I have come to talk, nothing more. Surely we can be reasonable, yes?",
                "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Spider_B_NPC.dds",
