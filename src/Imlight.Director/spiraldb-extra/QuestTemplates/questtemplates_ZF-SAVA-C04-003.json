  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now that my people are able to protect themselves again, and our food stores have been restored, I can sit with you.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KakutaDarkmane_ZFA_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You are looking for a pride of young Wizards? Yes, I can help you. We have one of your pride-mates here, with us.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KakutaDarkmane_ZFA_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hahah! No, she is no prisoner. She is a valued guest. Her name is Eden Windforest.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KakutaDarkmane_ZFA_18.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "A guide led the Wizard pride here, but they kept a respectful distance. All but one.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KakutaDarkmane_ZFA_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Eden was braver than the others, and came close, right into our camp. When the others left, she asked if she could stay.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KakutaDarkmane_ZFA_20.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466164,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'll find her by that sad patch of dry, barren earth we call the garden. Go and speak with her.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KakutaDarkmane_ZFA_21.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466164,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-SAV-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You'll find Eden Windforest by our little garden. It is a sad thing and she is doing her best.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KakutaDarkmane_ZFA_22.mp3",
