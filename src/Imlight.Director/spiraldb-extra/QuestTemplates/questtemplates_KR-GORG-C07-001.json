            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bear with me, this scheme has a lot of moving parts! We want to turn the Umbra Legion's weapons against them.",
