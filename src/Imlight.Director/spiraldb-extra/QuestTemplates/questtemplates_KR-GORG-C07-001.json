            "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/DorianBrightEyes_KHR_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1223199,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-TyrianGorge-NPC08_Persona",
