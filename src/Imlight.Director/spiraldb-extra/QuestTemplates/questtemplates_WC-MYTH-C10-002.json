              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Cyrus Drake sent you for a spell? Haven't the Drakes meddled enough in the affairs of Dragonspyre?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/MilosBookwyrm_ZFA_23.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Enough, though. I cannot provide you with such a spell, because I don't have it any more! It was taken by the Hoarder!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/MilosBookwyrm_ZFA_24.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Who's that? You don't know? The Hoarder is Morganthe's most devout follower, hoarding magic in hope of her return!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/MilosBookwyrm_ZFA_25.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Hoarder took many spells from the Atheneum, including yours, and keeps them within a tower in the Plaza of Conquests.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/MilosBookwyrm_ZFA_26.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 126293,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "DS-LIB-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If you wish that spell, you must defeat the Hoarder and take the Basilisk spell from the Hoarder's Books of Myth. Good luck!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_M_wizard_base_1_Ghost_NPC.dds",
