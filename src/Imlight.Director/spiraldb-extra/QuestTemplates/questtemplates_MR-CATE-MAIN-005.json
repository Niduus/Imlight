                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If there ever was a chance of me agreeing to an alliance with Aggrobah, there isn't any more. Your treachery has accomplished that much.",
