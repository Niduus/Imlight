  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Are you going after the Sphinx? We done tried that, my fellow hunters and I. It went badly.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Jebediah_EM2_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447396,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "That Sphinx is a monster... a demon... it attacked us with... RIDDLES! It speaks in your mind with hideous brainteasers, thought-melters.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Jebediah_EM2_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447396,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The headaches, I thought they'd never end. Not from the telepathy, but from those riddles. They're almost more than a mortal mind can bear.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Jebediah_EM2_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447396,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Don't venture into that cavern, Wizard, for your own sanity. Forget my fellow hunters, they're all but lost.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Jebediah_EM2_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447396,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-AERO-NPC20_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Don't go into that tunnel. Don't go after the Sphinx. It's just too confusing.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Jebediah_EM2_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1447396,
            "m_cameraName": ""
          }
        ]
      }
    ]
