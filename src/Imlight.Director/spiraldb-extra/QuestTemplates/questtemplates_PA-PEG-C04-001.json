          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There is a problem. The final ingredient in the spell requires the soul-stone of the leader of the Goblin horde.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_25.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465145,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Goblins have spoken fearfully of Lord Graustark. I suspect that whoever he is, he's lurking in the tower down the street.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_26.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465145,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You should go and defeat this Lord Graustark and collect his soul-stone, the source of his magic.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_27.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 465145,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "PA-HUB-NPC13_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Only then can you use the incantation to dispel the portal. Return to me when you have done that impossible deed.",
