            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You've brought a means of dispelling the magic portal? And all of the ingredients? Let me see that...",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_PA_Groundskeeper_Verne.dds",
            "m_soundFile": "|Sound_Dialogue_WYS|WorldData|Sound/Dialogue/GroundskeeperVerne_WYS_24.mp3",
