                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD2-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, I knew she was going to want her hat back soon. I didn't have the heart to tell her that a terrible wind picked it up.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Upper01.dds",
                "m_soundFile": "|Marleybone|WorldData|Sound/Dialogue/CatherineDalton_QST_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39714,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD2-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I tried to retrieve it but a Scratcher picked it up and, well, that was the end of it. Those cats think it is funny to mock our fashion senses.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Upper01.dds",
                "m_soundFile": "|Marleybone|WorldData|Sound/Dialogue/CatherineDalton_QST_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39714,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-YARD2-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I ordered a new one from Houghe Warner but I am far too terrified to walk about with all those cats roaming around. Could you pick it up and take it to her?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Upper01.dds",
                "m_soundFile": "|Marleybone|WorldData|Sound/Dialogue/CatherineDalton_QST_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 39714,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
