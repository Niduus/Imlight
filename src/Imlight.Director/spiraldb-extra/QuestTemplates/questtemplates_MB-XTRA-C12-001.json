                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Spring Hat that Catherine ordered? The one that looks just like the one I ordered for Amy Brooks? Let me see where it is...",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Blue.dds",
                "m_soundFile": "|Marleybone|WorldData|Sound/Dialogue/HougheWarner_QST_13.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 81152,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MB-SHOP-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes, I got a message from the Post Office saying it has arrived, but I've been too afraid to go out and pick it up. If you'd be so kind, could you go pick it up and take it to her?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_Blue.dds",
                "m_soundFile": "|Marleybone|WorldData|Sound/Dialogue/HougheWarner_QST_14.mp3",
