                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, it's a hat for Amy Brooks? Well, I guess I can let you have it, if you take it right to her. Let it not be said that I deprived a woman of her fashion!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_Shopkeeper_MB_White.dds",
