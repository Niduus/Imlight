                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You are looking for a package for Houghe Warner? Yes, it's here, but I'm not supposed to give it to anyone other than the name on the package.",
