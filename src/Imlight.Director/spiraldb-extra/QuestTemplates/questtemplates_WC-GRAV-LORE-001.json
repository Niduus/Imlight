      "m_displayImage2": "",
      "m_clientTags": [],
      "m_genericEvents": [],
      "m_autoQualify": false,
      "m_autoComplete": false,
      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "All right. Here we go. Don't worry. My research indicates these Pekuliarities are only dangerous under... special circumstances. You'll be fine.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_28.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "All right, to start, I'll add three flasks of concentrated Pekrons. And... nothing. No reaction whatsoever. Hm. I thought that would do it.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_29.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Very well, I'll add just one more flask, and let's see how that reacts... hm. Nothing.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_30.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, perhaps I'm being too cautious. Let me just add the rest of this and see what happens...",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_31.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Great jumping gravity frogs! A Pekuliarity! It worked! I can't-this is... it's actually extremely dangerous! Stand back. Let me neutralize it!",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_32.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, that was close. Are you all right? Thank the stars... yes, I know I said it was safe, but I didn't actually think it would work. I apologize.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_33.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "If my research is correct, a Pekuliarity like that, if it weren't under control, could annihilate half of Wizard City!",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_34.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah... but let's keep that quiet for now. Come. Meet me back in Ravenwood and we can discuss what we learned.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_35.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That was exciting, wasn't it? A real-life Pekuliarity right in front of us... and they said such a thing couldn't exist. We showed them!",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_36.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh dear, and look at this - your badge is glowing pink... hot pink. That can't be good. I will have to consider the implications of this.",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_37.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "WC-RAV-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "We still need more data to investigate these matters further, so keep checking in for your daily assignments. Until tomorrow, then!",
                "m_picture": "GUI/NpcPortraits/Portrait_Dog_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/GRV/AegonStatz_GRV_38.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378050,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
