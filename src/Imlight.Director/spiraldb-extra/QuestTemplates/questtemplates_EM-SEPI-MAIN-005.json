  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They'll be looking for ye near the Head, so ye need to get 'em chasing in the opposite direction, like say... uh... the Ink Gland.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Dynt_EMP_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401196,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Plus, if ye send a raft out with the Ink, the Cabal might think ye escaped and call off the search. I've even a raft ye can use!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Dynt_EMP_17.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401196,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-003_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Not a terrible idea, Dynt. But I think we can all see that our only viable option is to assault the Headquarters.",
            "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_198.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401198,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-002_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Actually, Dynt's onto something. We do need to keep Medulla and the Cabal confused. Plus, jettisoning Ink causes Squids to move backwards!",
            "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_91.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401197,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-003_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I was just about to say that! Good idea, Dynt. When we've triumphed over the Cabal, we'll get you out of here. I promise.",
            "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_199.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401198,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-002_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Forget that. We're getting you out now, Dynt. Go get your raft. Meet us in the Ink Gland Sector after the Wizard and I clear it.",
            "m_picture": "GUI/NpcPortraits/Portrait_Shadow_Bat_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Bat_EMP_92.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401197,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-003_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I was wrong about you, Bat. I'll get into position beside the entrance to the Right Eye Sector. I'll meet you both there! Goodbye, Dynt.",
            "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Pork_EMP_200.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401198,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Just when I'd begun to think that there were no more heroes out there... Yar, better get me to the Ink Gland afore I start a-blubbering!",
            "m_picture": "GUI/NpcPortraits/Portrait_Pirate_Cabalist_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Dynt_EMP_18.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401196,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "EM-SEP-001_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Yar! I'm so excited! Just gimme a bit to gather me raft and some provisions, and I'll meet ye in the Ink Gland!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Dynt_EMP_19.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1401196,
            "m_cameraName": ""
          }
        ]
      }
    ]
