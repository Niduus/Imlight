            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-FishingNPC-01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Yes? Lucky Hookline sent you to learn about the Fishing in Avalon? And you wish to challenge me to a Fishing competition?",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Merchant_Courtney_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/BrookeWaterman_FAV_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391392,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-FishingNPC-01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Sorry. I decline your invitation. You see, there's no possibility you'd ever out Fish me. No offense. I'm simply unbeatable.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Merchant_Courtney_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/BrookeWaterman_FAV_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391392,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-FishingNPC-01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, now I do hope that won't discourage you from Fishing in Avalon. Oh, I know! You should challenge my sister, Wren, in Caer Lyon.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Merchant_Courtney_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/BrookeWaterman_FAV_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391392,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AV-FishingNPC-01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You'll find her lesser Fishing talents more comparable with your own. Oh, and do tell her I sent you. She'll be charmed, I'm sure.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_AV_Fox_Merchant_Courtney_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_GEN|WorldData|Sound/Dialogue/FAV/BrookeWaterman_FAV_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391392,
                "m_cameraName": ""
              }
            ]
          }
        ]
