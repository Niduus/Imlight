  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-SCI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "While ye were hittin’ the books, I did some studyin’ of me own. I believe I know where hides our mysterious foe!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_38.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-SCI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The pathing rotes on their cogitator circuits spell it out that they’re originating in the Crystal Reactor.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_39.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-SCI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Crystal Reactor is in the next dome over from this one, a locked tower at the heart of all the Celestian power array!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_40.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227168,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-SCI-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The books ye read told ye how to open the gates ta that tower. Now ye must go there and confront this baddie and give ‘em what-for!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Master_Engineer.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/EngineerMontgomery_CEL_41.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227168,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
