                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ach, a Spellbinder. Young Bolthy says you do not hop in the Shadow?",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/PresterBlazingWind_KH2_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283169,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Be quiet-calm, Burrower-friend. There was no intention to boil your blood. But the Shadow Queen has strange-strange allies in these dark days.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/PresterBlazingWind_KH2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283169,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC11_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hoppers know her moods by the motion of the Hive. It was quiet-calm for many months, but now is buzz-buzz more than in memory.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/PresterBlazingWind_KH2_03.mp3",
                "m_action": "",
