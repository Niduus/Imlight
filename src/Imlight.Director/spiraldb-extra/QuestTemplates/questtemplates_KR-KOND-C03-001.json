            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Greetings, Spellbinder. They say the Shadow Queen was once a Spellbinder. A <ITALICS>Wizard. </ITALICS>",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/EdwinArcaneArchitect_KH2_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283170,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "As you say. The Astral Relics were built a thousand years ago, when the world was newborn and blind.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/EdwinArcaneArchitect_KH2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283170,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Shadow Queen came to the Kondha Forest to steal the secrets of the Solar Arc, for the brightest light casts the darkest shadow.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/EdwinArcaneArchitect_KH2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283170,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC12_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Do you have the heart-fire to learn its secrets and triumph over her? What will the world look like if you fall?",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/EdwinArcaneArchitect_KH2_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283170,
                "m_cameraName": ""
              }
            ]
          }
