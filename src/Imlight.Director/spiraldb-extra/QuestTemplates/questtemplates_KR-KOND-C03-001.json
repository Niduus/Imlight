              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC13_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Spellbinder! We. Are. Saul. The. OneWhoKnows. We. Learned. Burrow-speak. Long. Ago. And. Helped. Teach. The. Others.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/SaulOneWhoKnows_KH2_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283171,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC13_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Ah, you already speak Hopper? Beaut. You are good-kind. Many seasons ago, Saul saw high-walled Bastion.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/SaulOneWhoKnows_KH2_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283171,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC13_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The Saul made the long hop, once. It is how the Saul can speak as you do. The Saul teaches all Hoppers sent on the long hop.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/SaulOneWhoKnows_KH2_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283171,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC13_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You met Stieg QuickSand? That brightens the day's gloom. And Bolthy says his freedom was your work.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/SaulOneWhoKnows_KH2_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283171,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KR-KondhaDesert-NPC13_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You have helped us. However, we cannot help a stranger find the Solar Arc. Thus you must become one of our tribe.",
                "m_picture": "GUI/NpcPortraits/Portrait_Jerboa_Elder_C_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/SaulOneWhoKnows_KH2_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1283171,
                "m_cameraName": ""
              }
            ]
          }
