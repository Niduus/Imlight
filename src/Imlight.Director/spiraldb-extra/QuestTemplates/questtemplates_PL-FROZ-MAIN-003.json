                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, what are we waiting for? I have been dreaming of this moment my whole life! Come on. I'll race you to the cave!",
