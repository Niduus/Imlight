                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Enough! Enough! Back off already! All this fighting is making me hot. What is it you want to know?",
                "m_picture": "GUI/NpcPortraits/Portrait_Elf_Hunter_B_MOB.dds",
