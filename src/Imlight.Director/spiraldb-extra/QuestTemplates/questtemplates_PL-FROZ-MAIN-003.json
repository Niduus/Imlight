                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You want to know where that beastly She-Yeti lives? Fine. Her name is Alorna. She lives in a cave up on the ridge.",
                "m_picture": "GUI/NpcPortraits/Portrait_Elf_Hunter_B_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/LordGroff_POL_03.mp3",
