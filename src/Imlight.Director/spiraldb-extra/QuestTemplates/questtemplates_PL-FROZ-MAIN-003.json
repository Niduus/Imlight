                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Up on the ridge? I knew I should've checked there. Thank you, Lord Groff. Maybe you're a righteous guy after all.",
                "m_picture": "GUI/NpcPortraits/Portrait_Yeti_Explorer_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Zoot_POL_14.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1217874,
