            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "To get close, we need someone the Empress trusts. She has a private dancer at the Theater, an Osky named Bearyshnakov, who seeks to defect.",
