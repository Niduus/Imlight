            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you would go to his dressing room at the Bolshoi Theater, he might know a way for you to get close enough to the Empress to steal the key.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/RedRosa_POL_36.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1340496,
