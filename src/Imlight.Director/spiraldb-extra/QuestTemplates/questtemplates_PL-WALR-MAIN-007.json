            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Breaking our friends out of the Basstille will be hard. The Empress keeps the Basstille Key with her always, under the pillow on her palanquin.",
