        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "After you sought me out, I made some inquiries. There are many strange and troubling stories flitting about Sardonyx.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/NadezhaSpiceSeer_KH2_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283124,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "From what I gleaned, Brother Zed was seen in the Tower of Pale Beauty. That is a Moth place, so I don't know what he is up to.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/NadezhaSpiceSeer_KH2_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283124,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I would stay out of the affairs of Moths and Mantises, if I were you, Stranger. But if you must continue looking, look there.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/NadezhaSpiceSeer_KH2_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1283124,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "KR-Sardonyx-NPC09_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Abandon this pursuit, Stranger. But if you choose to ignore my warning, then search for Zed in the Tower of Pale Beauty.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_KH2|WorldData|Sound/Dialogue/NadezhaSpiceSeer_KH2_09.mp3",
