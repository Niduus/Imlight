            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Well, you found her house all right, but the witch isn't home. She's probably in her garden, but I wouldn't disturb her. She's not very nice.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/Mellori_POL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
