              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I suppose I could spare a few minutes. Meet me back at my house and we can talk. Might not like what I have to say though. Might not.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/BabaYaga_POL_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346220,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well now, here we are. I'd say welcome to my humble home, but as you already know, you're really not welcome. Heehee.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_POL|WorldData|Sound/Dialogue/BabaYaga_POL_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1346220,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "PL-BLEAK-NPC10_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "This is my daughter, Mellori. Mellori, this young Wizard came all the way from Ravenwood.",
                "m_picture": "GUI/NpcPortraits/Portrait_Human_WitchF_A_NPC.dds",
