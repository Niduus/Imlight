                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "So tell me, where is Bat? I simply must taunt him as childishly as possible.",
                "m_picture": "GUI/NpcPortraits/Portrait_Pig_Captain_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EM2|WorldData|Sound/Dialogue/Pork_EM2_30.mp3",
