                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I can only speculate that the conflict between Grandmother Raven and Grandfather Spider is somehow amplifying the storms. Most intriguing.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Sparck_EMP_32.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397524,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The crash damaged the hull beyond repair: the ship will never fly again. We may, however, still be able to use our Escape Pods to reach Zanadu.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Sparck_EMP_33.mp3",
