                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "In answer to your query, I am uninjured. Unfortunately, I cannot say the same of the Ark.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Sparck_EMP_30.mp3",
