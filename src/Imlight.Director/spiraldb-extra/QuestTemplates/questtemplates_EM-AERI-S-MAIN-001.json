                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I require a working Cyclolabe and Lux Capacitor to modify a Pod. Our Capacitor is intact, but apparently our Cyclolabe is broken.",
