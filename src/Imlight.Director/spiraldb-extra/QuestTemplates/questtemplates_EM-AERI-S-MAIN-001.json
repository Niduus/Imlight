            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It's hard to know where we stand if I don't know the condition of the crew. Get to the Hold and check on Sparck.",
