              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "EM-AERI-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "The crash was certainly unexpected. The aethyr storms have intensified since my sister and I were smuggled out of Empyrea.",
                "m_picture": "GUI/NpcPortraits/Portrait_Nimbari_Wizard_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/Sparck_EMP_31.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1397524,
