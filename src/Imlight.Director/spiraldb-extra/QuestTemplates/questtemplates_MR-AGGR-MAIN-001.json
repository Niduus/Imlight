            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What is your business in our fair city? Oh? You are here to see the King of Thieves? How convenient. I just so happen to be the Prince of Thieves!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Robin_MIR_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381190,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-ALKA-NPC05-B_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Um, excuse me. I've been out of circulation for a while, and I know things have changed, but you really mean to tell me that YOU are royalty...?",
            "m_picture": "GUI/NpcPortraits/Portrait_Skull_King_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Ozzy_MIR_33.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1381172,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "MR-AGGR-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Haha... I jest, of course. I am no Prince. Hehe. Someone already ran that scam... I mean... the King of Thieves? Yes, this way! Right down the alley.",
            "m_picture": "GUI/NpcPortraits/Portrait_FennecFox_Thief_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Robin_MIR_04.mp3",
