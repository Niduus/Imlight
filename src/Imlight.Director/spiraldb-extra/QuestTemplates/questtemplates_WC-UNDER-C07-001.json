            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/KingThermidor_GH2_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466075,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hmm... I've lost my guards, and I can't go look for them because of the dratted eels. They are very bitey!",
