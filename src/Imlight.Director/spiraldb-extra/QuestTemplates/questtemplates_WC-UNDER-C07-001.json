            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "If you can explore the area and find my missing guards, I'd be happy to talk to you about returning to Crab Alley.",
