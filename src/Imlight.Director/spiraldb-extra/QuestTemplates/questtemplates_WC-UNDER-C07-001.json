            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Great to see you! It's always good to meet a fan! I met King Amadeo, and he asked me to perform for him soon.",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Crab_King_Rockstar_NPC.dds",
