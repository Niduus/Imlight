            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/KingThermidor_GH2_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466075,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Have you been to Crab Alley recently? How are things back home?",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Crab_King_Rockstar_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/KingThermidor_GH2_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466075,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC11_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "What!? My kingdom has been taken over? That sounds terrible! I should go back, but I can't leave without my guards!",
            "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Art_Portrait_Crab_King_Rockstar_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_TRI|WorldData|Sound/Dialogue/KingThermidor_GH2_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466075,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC11_Persona",
