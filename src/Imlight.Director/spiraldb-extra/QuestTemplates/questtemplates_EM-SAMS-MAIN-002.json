            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I know it looked like those Frogs were going to hurt me, but they totally weren't. You're strangers, I get it: you don't know how we do things.",
