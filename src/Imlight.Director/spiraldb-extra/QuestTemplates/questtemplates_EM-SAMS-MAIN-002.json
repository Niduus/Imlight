            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Life and Death energy constantly shifts and swirls through the jungle. It's really amazing. I was preparing the grove for a Death influx, see.",
