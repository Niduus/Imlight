                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Zexia SteelWeaver would know. She excels at crafting with them. Let me think now. My men told me something about her.",
                "m_picture": "GUI/NpcPortraits/Portrait_Millipede_Warrior_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_KHR|WorldData|Sound/Dialogue/ZurGrush_KHR_03.mp3",
