            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC15_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Finally! I'll have a double fudge burger with cream cheese. Huh? You're here to teach me about history? Oof. Fine. I'm too lazy to walk away.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerFarmer_003_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506529,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC15_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Wow. Gobblers used to be explorers? And we discovered how to work the land here? I weren't taught that in twelve years of Gobblergarten.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerFarmer_003_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506529,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC15_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I should do something? I have always wondered about farming. If I grew my own food, I wouldn't depend on Nana... That's it. I'm gonna be a farmer!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerFarmer_003_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506529,
                "m_cameraName": ""
              }
            ]
          }
        ]
