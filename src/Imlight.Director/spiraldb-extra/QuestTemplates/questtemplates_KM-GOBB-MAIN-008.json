            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC16_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Just drop the food directly into my face. What? No food. Just... motivation? What kind of monster are you?!? What? You say I could feed myself?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerBuilder_003_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506530,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC16_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Gobblers really used to be great thinkers and makers? Truth be told, I've always had this voice inside me telling me to build things.",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerBuilder_003_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506530,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC16_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I figured it was gas. You know, if'n we restored the factory here, we could use it to make all sorts of things. Even FOOD! I'll tell the others!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerBuilder_003_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506530,
                "m_cameraName": ""
              }
            ]
          }
        ]
