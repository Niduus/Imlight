              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hey, you're that strange little stranger that's going around filling Gobblers' heads with things that ain't food, ain't ya? What's your angle?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerEngineer_003_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506531,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "To inform us Nana's keeping us fat and docile so she can steal our sweat to make a Gummy army? That's quite an angle. But what can I do?",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerEngineer_003_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506531,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "KM-GOBB-NPC17_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Literally anything, you say? I've been interested in engineering ever since that time I tried to eat a clock. 'Spose I could give that a go!",
                "m_picture": "|_Shared|WorldData|GUI/NpcPortraits/Portrait_Gobbler_Skinny_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_003|WorldData|Sound/Dialogue/GobblerEngineer_003_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1506531,
                "m_cameraName": ""
              }
            ]
          }
        ]
