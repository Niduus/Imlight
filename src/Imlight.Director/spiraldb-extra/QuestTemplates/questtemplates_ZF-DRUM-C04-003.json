        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-DRUM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Where does the iron blade, Shango's Thunder, point you? Towards Kallah Silverback's shack? I am not surprised.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Hanabiko_Smokesign_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KokoSmokesign_ZFA_37.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466186,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-DRUM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "His lair is guarded by the Spider Bridge. If you tried to cross it, you would get stuck fast, and then he'd have you.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Hanabiko_Smokesign_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KokoSmokesign_ZFA_38.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466186,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-DRUM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I can protect you with a simple spell, but to make it, I need you to find my iron pot. Someone swiped it when I was imprisoned.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Hanabiko_Smokesign_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KokoSmokesign_ZFA_39.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466186,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "ZF-DRUM-NPC02_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I also need my wooden spoon that one of the Blackback Soldiers took, and we need a pinch more Eternal Flame from Umlilo.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_Hanabiko_Smokesign_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_ZF|WorldData|Sound/Dialogue/KokoSmokesign_ZFA_40.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 466186,
            "m_cameraName": ""
          }
        ]
      },
