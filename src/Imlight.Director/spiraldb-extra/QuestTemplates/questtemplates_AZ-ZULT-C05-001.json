  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZULTUN-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Hello, Outsider. Your reputation precedes you as a great champion to many. Could you help find a Marleybonian visitor for me?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MicLasBronzewing_AZT_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 689200,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZULTUN-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Her name is Kathleen Wilder and she is a writer of romantic stories. Like you, she is an outsider to Azteca.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MicLasBronzewing_AZT_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 689200,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZULTUN-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "She also likes to get into trouble. Lots of trouble. Last I saw her, she was obsessed with the legendary treasure, El Yollotl.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MicLasBronzewing_AZT_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 689200,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZULTUN-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "She said she had found and copied a rare treasure map, but that was the last I heard! No one has seen her since.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MicLasBronzewing_AZT_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 689200,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZULTUN-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Kathleen Wilder has a small Ground Nest she was staying in. Can you search it for clues, and help me find her whereabouts?",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MicLasBronzewing_AZT_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 689200,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-ZULTUN-NPC04_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Look in Kathleen Wilder's Ground Nest and see if you can find some clues to where she might be!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MicLasBronzewing_AZT_06.mp3",
