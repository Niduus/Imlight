      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZULTUN-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Whew. That was a close one. Thanks for rescuing me.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Upper01.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/KathleenWilder_AZT_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689137,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZULTUN-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Zolo Stoneheart told me he knew where to find a priceless emerald treasure, called El Yollotl. With it I could start a new life!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Upper01.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/KathleenWilder_AZT_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689137,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZULTUN-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "But Zolo just wanted to make me write a novel starring him as the hero! As if!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Upper01.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/KathleenWilder_AZT_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689137,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-ZULTUN-NPC02_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now that you've freed me, I'll just have to redouble my efforts to find that gemstone! Maybe we'll meet again!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Upper01.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/KathleenWilder_AZT_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 689137,
                "m_cameraName": ""
              }
            ]
          }
