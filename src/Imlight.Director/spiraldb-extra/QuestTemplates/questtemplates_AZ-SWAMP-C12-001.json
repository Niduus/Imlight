      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Is Bligh still chattering on about that blasted Quadrant... you'd think it was a compass or something!",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/LtFletcher_AZT_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684545,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I did not lose it. A Moon Skull Priestess attacked me and took it! What was I, a poor, weak, defenseless Monquistan to do?",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/LtFletcher_AZT_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684545,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hey, you are tall and strong! Maybe you could you get it back? I don't know which one took it. Fight as many as it takes!",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/LtFletcher_AZT_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684545,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You got it? Great work! I'm sure it was easy to find for one of your stature.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/LtFletcher_AZT_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684545,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Please take it back to Mr. Bligh. He wants to sail home soon as he can build a boat.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/LtFletcher_AZT_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684545,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC09_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I say, good luck and good riddance. We're all tired of his incessant blathering.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/LtFletcher_AZT_06.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684545,
                "m_cameraName": ""
              }
            ]
          }
        ]
