            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "That scoundrel, Lt. Fletcher, lost my prized Golden Quadrant!",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MrBligh_AZT_01.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684546,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Fletcher knows how much it means to me, and he was careless and foolish. Now it is gone!",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MrBligh_AZT_02.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684546,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "However, if he were to find it and return it, I would forgive and forget.",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MrBligh_AZT_03.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684546,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You have returned my prized Quadrant! Thank you, Wizard. Now, to sail out of this wretched swamp!",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MrBligh_AZT_04.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684546,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "AZ-SWAMP-NPC08_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Let Ponce sally forth with his foolish folly! I'm going home. I just need to find a boat, first...",
                "m_picture": "GUI/NpcPortraits/Portrait_Monkey_Soldier_B_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/MrBligh_AZT_05.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 684546,
                "m_cameraName": ""
              }
            ]
          }
        ]
      },
