      "m_dialogList": {
        "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
        "m_dialogs": [
          {
            "m_dialogTag": "Completion",
            "m_dialogEntries": [
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CAMP-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I’m no Sherlock Bones, but by the look of things, this is some incontrovertible evidence! One, two, three!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
                "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_25.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227125,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CAMP-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "One: That piece of shell belongs to a Crustacean.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
                "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_26.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227125,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CAMP-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Two: That watch belongs to Barclay O’Brian, one of our expedition. He was so proud of that watch! He mail-ordered it from a dealer on Firecat Alley, in Wizard City. Barclay wouldn’t part with it for anything!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
                "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_27.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227125,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CAMP-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "And three: That piece of stone looks like it has the same pattern as the two big stone towers at the center of the Pinnacles.",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
                "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_28.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227125,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CAMP-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "It looks like the Crustaceans took our members of our expedition and locked them into one of the Pinnacle towers!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
                "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_29.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227125,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "CL-CAMP-NPC05_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I’ll bet that one of the Crustaceans in the area has to have a key. Go and defeat one of them and take it, then make your way into the tower!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
                "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_30.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 227125,
                "m_cameraName": ""
              }
            ]
          }
        ]
