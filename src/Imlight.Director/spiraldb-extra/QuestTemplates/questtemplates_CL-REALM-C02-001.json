            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You haven’t seen the pieces of a broken tablet anywhere, have you? It was just here a moment ago.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_42.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We had it from a pack of Water Lurkers, who seemed to be reading and memorizing the inscriptions on it.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_43.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "In the process of recovering the tablet, it was broken, so I was trying to restore it and see what it said.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_44.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I’d finished treating the tablet surface with a fish oil preservative, and then a swarm of Voltic Eels came by.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_45.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Oh no... I forgot that they’re quite fond of fish oil preservative! Those little blighters must have eaten the pieces of the tablet!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_DogWorker_08_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/RupertFleming_CEL_46.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227130,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-REALM-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you go and get the missing pieces of the broken tablet from the Voltic Eels?",
