  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Three of the Amber Spheres shattered when the wards were broken. Their prisoners have escaped - to my sorrow, I was not strong enough to stop them.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The first is a Renegade of our order, who sought to become the Great Tree's Scion. He failed.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_11.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bitterness consumed him, and the evils we fought took root in his soul. He has fled to Avalon.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_12.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Next is Satharilith, a vile Myth-born abomination that devours thoughts and replaces them with its own. It has gone to Valenceland.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_13.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The last is a horror born in the dark spaces between the worlds. We named it The Devourer. It has fled to the very edge of the Spiral.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_14.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The evil these fiends might unleash is unspeakable. As the Great Oak's Scion it falls to you to stop them; bring them back, sealed in Amber Orbs.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-CATA-NPC011_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Three of our ancient prisoners; the Renegade, Satharilith, and the Devourer, have fled into the Spiral. Hunt them down and bring them back!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_CAT|WorldData|Sound/Dialogue/DruidGhostWarden_CAT_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1451817,
            "m_cameraName": ""
          }
        ]
      }
    ]
