                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "I told him all that anger wasn't healthy. You were there. I may be a Junior Djinni, but I've learned a thing or two over the centuries.",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_154.mp3",
                "m_action": "",
                "m_dialogEvent": "",
