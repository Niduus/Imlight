                "m_nameOverride": "Nashkurgal",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh! Its... it's about time. I've been waiting for you two to come. I was on your side all along, of course...",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_Scrivener_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Nashkurgal_MIR_11.mp3",
