                "m_dialogEvent": "",
                "m_actorTemplateID": 0,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-EERE-NPC01_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh really? Let me get this straight. First you betray the Baron, then you betray us, and now you betray Eerkala? And you expect us to trust you?",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_MageF_A_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Istar_MIR_156.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1378196,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "",
                "m_nameOverride": "Nashkurgal",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Well, when you put it that way... Fine! You've figured me out! Are you happy? I hope so. That way you can enjoy your final moments...!",
                "m_picture": "GUI/NpcPortraits/Portrait_Djinn_Scrivener_A_MOB.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/Nashkurgal_MIR_12.mp3",
