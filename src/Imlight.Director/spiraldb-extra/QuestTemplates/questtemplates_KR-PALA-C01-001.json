                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "There now. The Celestial Bridge spans the abyss surrounding the Shadow Palace. You may cross to find your own particular doom.",
