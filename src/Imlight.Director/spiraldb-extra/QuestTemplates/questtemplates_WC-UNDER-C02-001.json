  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I'm happy to see you! Everything is topsy-turvy!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Herman_GH2_01.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358233,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "King Thermidor had just returned from his world tour, when we awoke one morning to find a breach in our river wall!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Herman_GH2_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358233,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The King went into the breach to investigate, and he came back in the company of Riverclaws!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Herman_GH2_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358233,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "He's been acting very strangely ever since! Now Riverclaws are strutting around like they own the place!",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Herman_GH2_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358233,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The King had a falling-out with his advisor, Sir Thomas Cromshell, and now Cromshell is locked in the White Tower.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Herman_GH2_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358233,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you talk to Sir Thomas in the White Tower? The tower is locked, so you'll need a key.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Herman_GH2_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358233,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "WC-TU-NPC01_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "One of those Riverclaw guards may have a key.... you'll have to defeat one and take it.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue|WorldData|Sound/Dialogue/Herman_GH2_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 358233,
            "m_cameraName": ""
          }
        ]
      },
