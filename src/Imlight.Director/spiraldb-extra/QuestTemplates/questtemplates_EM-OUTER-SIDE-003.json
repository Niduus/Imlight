            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/AlgarSilvereyes_EMP_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 1391525,
            "m_cameraName": ""
          },
          {
