            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "So help me help us combat our fears by recovering the Forbidden Books of Magic from a Hidden Archive.",
            "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_F_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_EMP|WorldData|Sound/Dialogue/AlgarSilvereyes_EMP_09.mp3",
