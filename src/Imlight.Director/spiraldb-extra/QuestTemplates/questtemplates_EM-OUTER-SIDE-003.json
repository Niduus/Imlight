            "m_personaName": "EM-OUTER-NPC17_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "And now everyone's afraid to so much as summon a pixie lest it harken the return of \"the Shadow.\" Bunch of superstitious nonsense, if you ask me.",
