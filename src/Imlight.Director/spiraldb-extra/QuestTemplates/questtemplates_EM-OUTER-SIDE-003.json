            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "We Dwarves abandoned magic long ago. As we neared war with the Fire Dwarves, our Wizards unleashed... terrors.",
            "m_picture": "GUI/NpcPortraits/Dwarf_IceCouncilor_F_NPC.dds",
