            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Go, Outsider, and make the Green Shields take you to my sister, Chalchiu Green Skirt!",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChief_A_NPC.dds",
