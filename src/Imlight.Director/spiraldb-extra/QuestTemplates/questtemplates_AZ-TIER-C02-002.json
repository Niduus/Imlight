      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-TIERRA-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Now you need us to melt the Gold down? You are a pushy one, Outsider. What are you trying to make? A Pyramid Key? For what?",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChief_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TlaliLongCave_AZT_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 701127,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-TIERRA-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Pyramid of the Mother Moon? That place was lost a long time ago! It fell into Pitch Black Lake. Well before my time.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChief_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TlaliLongCave_AZT_07.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 701127,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-TIERRA-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You need Greenstones to finish your key? Good luck with that! My sister controls the Greenstones, and she's unreasonable.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChief_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TlaliLongCave_AZT_08.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 701127,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-TIERRA-NPC03_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Chalchiu and I have not spoken since our father died. You will have to strong-arm some Green Shields into taking you to her.",
            "m_picture": "GUI/NpcPortraits/Portrait_Tritops_SpkChief_A_NPC.dds",
            "m_soundFile": "|Sound_Dialogue_AZT|WorldData|Sound/Dialogue/TlaliLongCave_AZT_09.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 701127,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "AZ-TIERRA-NPC03_Persona",
