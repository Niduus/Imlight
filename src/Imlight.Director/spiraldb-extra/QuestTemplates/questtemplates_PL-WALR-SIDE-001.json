            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Please, Wizard, get my Sacred Blue Paint from the Inspectors Brigade so I can properly inspire my Pingouin brethren to fight for freedom!",
