            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Bon jour! I am Toulouse. You are familiar with my work, no? No? Really? Oh well, an art aficionado is not what I'm looking for anyhow.",
            "m_picture": "GUI/NpcPortraits/Portrait_Penguin_Townie_B_NPC.dds",
