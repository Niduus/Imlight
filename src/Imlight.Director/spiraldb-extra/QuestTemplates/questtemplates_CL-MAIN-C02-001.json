  "m_dialogList": {
    "$type": "Imcodec.ObjectProperty.TypeCache.ActorDialogList, Imcodec.ObjectProperty",
    "m_dialogs": [
      {
        "m_dialogTag": "Prep",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC06_Parker_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Perhaps you could help me, if you’ve got the time to spare? I’m a journalist, traveling with the expedition.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Lower03.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/DeirdreParker_CEL_02.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 311093,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC06_Parker_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "It’s my duty to chronicle the exploration and to provide information to my readers about what Celestia was like.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Lower03.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/DeirdreParker_CEL_03.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 311093,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC06_Parker_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "To that end, I need to learn all I can about Celestian culture. The Celestian zodiac fascinates me!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Lower03.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/DeirdreParker_CEL_04.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 311093,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC06_Parker_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "They left teaching devices around their city, so that life was full of knowledge about the stars that guided them.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Lower03.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/DeirdreParker_CEL_05.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 311093,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-HUB-NPC06_Parker_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Could you read the Celestian Tomes of the Zodiac around the city and learn about them? Your help will be invaluable!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_MB_Ladies_Lower03.dds",
            "m_soundFile": "|Sound_Dialogue_CL|WorldData|Sound/Dialogue/DeirdreParker_CEL_06.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 311093,
            "m_cameraName": ""
          }
        ]
      },
      {
        "m_dialogTag": "Underway",
        "m_dialogEntries": [
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
