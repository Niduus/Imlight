            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "You back for some more polite conversation? No offense, but I'm not really in the mood. Either get that Key from the Armory or get out.",
            "m_picture": "GUI/NpcPortraits/Portraits_Cat_StoutF_A_NPC.dds",
