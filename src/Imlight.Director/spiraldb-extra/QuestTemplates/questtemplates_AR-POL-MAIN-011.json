            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "There's something we're missing. I wonder if the Auroracle's riddle holds the clues to this mystery. She said Land and Sky would be sundered.",
