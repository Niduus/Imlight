                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Defeat the Spearfang Slashers and recover our jewelry, and the Inzinzebu Bandits who stole our spices. Then come back here.",
