                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "You need the Councilor's approval to open the Savannah Gate? Why would you want to do that? It's not safe out there!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Vir_Goodheart_NPC.dds",
