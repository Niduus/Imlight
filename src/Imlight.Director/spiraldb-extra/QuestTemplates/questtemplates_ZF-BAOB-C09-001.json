                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Oh, I see. You're looking for the missing students. That is important. And brave!",
                "m_picture": "GUI/NpcPortraits/Art_Portrait_ZF_Vir_Goodheart_NPC.dds",
