                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Hello, Wizard! The streets are abuzz with news of how you've dislodged so much of the Thuggie grime from our fair city.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_O_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/YahyaDunestrider_MIR_08.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391045,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Now, if you'll kindly hand over the keys you collected, I'll get to work reuniting the poor dispossessed citizens with their properties.",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_O_NPC.dds",
                "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/YahyaDunestrider_MIR_09.mp3",
                "m_action": "",
                "m_dialogEvent": "",
                "m_actorTemplateID": 1391045,
                "m_cameraName": ""
              },
              {
                "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
                "m_personaName": "MR-AGGR-NPC18_Persona",
                "m_nameOverride": "",
                "m_nameSTKey": null,
                "m_guiDisplay": "",
                "m_maxTimeSeconds": 0,
                "m_invisible": false,
                "m_requirements": null,
                "m_dialog": "Excellent! Thank you for all you've done, my friend. Now, I believe I promised you a reward! And Yahya Dunestrider is a Qhat of his word...",
                "m_picture": "GUI/NpcPortraits/Portrait_Cat_Sorcerer_O_NPC.dds",
