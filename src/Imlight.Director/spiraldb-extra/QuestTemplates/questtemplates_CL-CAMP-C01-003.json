            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Can you go and see if you can recover the bottles of sealant from the Crustacean Pincers who took them from us? Four bottles will do it, I should think!",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_16.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227125,
