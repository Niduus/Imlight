            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "I’ve some bad news. Well, more of a spot of bother, really, but it needs to be addressed.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_14.mp3",
