            "m_dialogEvent": "",
            "m_actorTemplateID": 227125,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
            "m_personaName": "CL-CAMP-NPC05_Persona",
            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "The Crustaceans broke the dome and I’m struggling to find a means of repairing it. We kept a supply of sealant on hand, but they seem to have taken it.",
            "m_picture": "GUI/NpcPortraits/Art_Portrait_CL_Excavator01.dds",
            "m_soundFile": "|Celestia|WorldData|Sound/Dialogue/DaltonPrescott_CEL_15.mp3",
            "m_action": "",
            "m_dialogEvent": "",
            "m_actorTemplateID": 227125,
            "m_cameraName": ""
          },
          {
            "$type": "Imcodec.ObjectProperty.TypeCache.NPCDialogEntry, Imcodec.ObjectProperty",
