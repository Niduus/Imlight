            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Here is the key to the World Door. Start by investigating this recent colossal sand storm. As you know, Grandfather Spider is likely involved.",
            "m_picture": "",
            "m_soundFile": "|Sound_Dialogue_MIR|WorldData|Sound/Dialogue/QismahShasa_MIR_10.mp3",
            "m_action": "",
            "m_dialogEvent": "",
