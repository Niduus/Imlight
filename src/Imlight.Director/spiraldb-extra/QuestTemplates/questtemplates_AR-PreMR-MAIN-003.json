            "m_nameOverride": "",
            "m_nameSTKey": null,
            "m_guiDisplay": "",
            "m_maxTimeSeconds": 0,
            "m_invisible": false,
            "m_requirements": null,
            "m_dialog": "Search for clues, but be patient and disciplined. The answers will come in time. I suspect they will lead you to the Eye of History as well.",
