{
  // Shadow Self Magician (Rank 24, Shadow, 17,295 health), Darkmoor. Shadow Self Magician: invulnerable until all its HoTs are on it and all DoTs on the wizards.
  // From Wizard404's data (fetched 2026-10-24; its cheat notes are wiki-written, so they guide, not prove; ones it marks as needing verification are made as if confirmed).
  // Built first from blocks that were there, then from new universal blocks where a Notes names one (Niduus,
  // 2026-10-23: "ALL CHEATS are to be compatible for PLAYERS and CREATURES"). Lines are the game's own, by key.
  "TemplateID": 1655790,
  "Name": "Shadow Self Magician (Rank 24)",
  "ShadowPips": 2,
  "Cheats": [
    { "When": "BattleStart",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003963"},
        {"Do": "Cast", "Spell": "Brace", "SpellID": 455179500, "Target": "Self", "DispelImmune": false},
        {"Do": "Immune", "Rounds": 0, "Target": "Self"},
        {"Do": "Mark", "Mark": "invulnerable", "Target": "Self"}
      ],
      "Notes": "Round 1: Brace and invulnerability." },

    { "When": "RoundStart", "Round": 2,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003965"},
        {"Do": "Cast", "Spell": "Ember Blast", "SpellID": 500891066, "Target": "Self", "DispelImmune": false},
        {"Do": "Cast", "Spell": "MOB HoT", "SpellID": 500891062, "Target": "AllEnemies", "DispelImmune": false}
      ],
      "Notes": "Round 2: Ember Blast on itself and MOB HoT on each wizard." },

    { "When": "RoundEnd", "Round": 4, "Every": 2,
      "Actions": [
        {"Do": "PickOne", "Count": 2},
        {"Do": "Cast", "Spell": "Ember Blast", "SpellID": 500891066, "Target": "Self", "DispelImmune": false},
        {"Do": "Cast", "Spell": "MOB HoT", "SpellID": 500891062, "Target": "Enemy", "DispelImmune": false},
        {"Do": "Immune", "Rounds": 0, "Target": "Self"}
      ],
      "Notes": "End of round 4 and every other: one more DoT on itself or HoT on a wizard, and the invulnerability back." },

    { "When": "PlayerCasts", "Category": "Blade",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003967"},
        {"Do": "Cast", "Spell": "Push HOT", "SpellID": 157305101, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "A blade: Push HOT moves the HoT onto it." },

    { "When": "PlayerCasts", "Category": "Trap",
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003967"},
        {"Do": "Cast", "Spell": "Steal DOT", "SpellID": 742419762, "Target": "Caster", "DispelImmune": false}
      ],
      "Notes": "A trap: Steal DOT pushes the DoT onto the wizard." },

    { "When": "RoundStart", "HasWho": "AnyEnemy", "HasKind": "HoT", "HasNot": true, "FromRound": 3, "Cooldown": 2,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003968"},
        {"Do": "Cast", "Spell": "Supernova", "SpellID": 1039118069, "Target": "Self", "DispelImmune": false},
        {"Do": "RemoveWards", "Kind": "All", "Target": "Self"}
      ],
      "Notes": "No HoT left on a wizard and no DoT on it: Supernova takes the invulnerability off. New If: HasWho AnyEnemy." },

    { "When": "BossDefeated", "HasWho": "AnyEnemy", "HasKind": "DoT", "HasNot": true,
      "Actions": [
        {"Do": "Say", "Line": "CombatMessages_00003966"},
        {"Do": "Cast", "Spell": "Blessing", "SpellID": 1641304242, "Target": "Self", "DispelImmune": false},
        {"Do": "SetHealth", "Amount": 17295}
      ],
      "Notes": "Defeated while no wizard has a DoT: back with Blessing." }
  ]
}
