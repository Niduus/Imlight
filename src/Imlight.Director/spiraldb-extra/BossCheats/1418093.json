{
  // Monstrology copy of Malistaire the Undying, Castle Darkmoor (G14_DM_Malistaire_Boss_MM); same as 1336035.json.
  // From Wizard101 Central's pages for "Malistaire the Undying (Shadow)" and "Haunted Malistaire" (Justin saved them, 2026-10-21).
  // Under 1,000 health (or defeated) he comes back as Haunted Malistaire (G14-DM-Malistaire_Shadow, 1336037.json), a
  // creature of its own with its own model and 48,000 health. With no enemy circle free he comes back in his own circle
  // instead (48,000 health, phase 2 below). His drops stay on this template, and come when the last form is defeated.
  // Which game spell does each move is a guess from the names in Spells/G14-CombatTrigger-Spells; check a test log.
  "TemplateID": 1418093,
  "Name": "Malistaire the Undying",
  // Central: "Shadow Pips 4 max", in both forms.
  "ShadowPips": 4,
  "Cheats": [
    { "When": "BattleStart", "Cast": "Mega Taunt - Shadow", "Target": "FirstEnemy", "Line": "I cannot be stopped", "Once": true,
      "Notes": "First round: Shadow Mega Taunt on the first wizard." },

    { "When": "PlayerCasts", "Spells": ["Balanceblade", "Bladestorm", "Elemental Blade", "Spirit Blade"],
      "Cast": "Steal Charm", "Target": "Receiver", "Line": "What was yours is mine",
      "Notes": "A universal blade: he steals it from whoever got it (from the caster when it went on many)." },
    { "When": "PlayerCasts", "Spells": ["Tower Shield", "Legion Shield", "Elemental Shield", "Spirit Shield"],
      "Cast": "Steal Ward", "Target": "Receiver", "Line": "What was yours is mine",
      "Notes": "A universal ward: he steals it." },

    { "When": "PlayerCasts", "OnBoss": true, "Spells": ["Feint", "Life Feint", "Hex", "Curse", "Potent Trap"],
      "Cast": "Cleanse Ward", "Target": "Self", "Line": "I cast off your spells",
      "Notes": "A universal trap on him: he cleanses it. Mass Feint does not count." },
    { "When": "PlayerCasts", "OnBoss": true, "Spells": ["Black Mantle"],
      "Cast": "Cleanse Charm", "Target": "Self", "Line": "I cast off your spells",
      "Notes": "A universal negative charm on him: he cleanses it." },
    { "When": "PlayerCasts", "OnBoss": true, "Spells": ["Elemental Defuse", "Spirit Defuse"],
      "Cast": "Cleanse Charm 3 - Shadow", "Target": "Self", "Line": "I cast off your spells",
      "Notes": "Defuse: he removes all three charms." },
    { "When": "PlayerCasts", "OnBoss": true, "Spells": ["Weakness", "Mass Weakness"],
      "Cast": "Empower - Death DMG - MOB ONLY", "Target": "Self", "Line": "I grow stronger every moment",
      "Notes": "A weakness on him: he takes 300 Death damage for 3 pips." },
    { "When": "PlayerCasts", "OnBoss": true, "SingleTarget": true, "Kind": "Damage",
      "Cast": "Black Mantle", "Target": "Caster", "Line": "Can you face my stare",
      "Notes": "A single-target hit on him: Black Mantle on the attacker." },

    { "When": "RoundEnd", "Phase": 1, "Round": 3, "Every": 5, "Cast": "Supernova Sun", "Target": "Enemy",
      "Line": "Fear the power of Dragonspyre",
      "Notes": "Black Dragon: 535 damage and destroys the aura. The game's Polymorph - Dragon Trigger turns him into the dragon, which the server cannot do (the dragon stayed on the field), so Supernova Sun does the same hit: 535 Balance damage and removes the aura." },
    { "When": "RoundEnd", "Phase": 1, "Round": 4, "Every": 5, "Cast": "Minotaur Death Sun", "Target": "Enemy",
      "Line": "A gift from Tartarus", "Notes": "Sun Deadly Minotaur on a random wizard." },
    { "When": "RoundEnd", "Phase": 1, "Round": 5, "Every": 5, "Cast": "Virulence - Malistaire", "Target": "Self",
      "Line": "My curse upon you", "Notes": "His aura: more Death damage and power pip chance." },
    { "When": "RoundStart", "Phase": 1, "Round": 5, "Every": 4, "Cast": "Malistaire Dragon - Roar",
      "Line": "Its power shakes your spells apart", "Notes": "Skeletal Dragon removes every wizard's charms and wards (guess: the Roar spell)." },

    { "When": "HealthBelow", "Phase": 1, "Health": 1000, "Defeat": true, "Spawn": 1336037, "SetHealth": 48000, "SetPhase": 2,
      "Line": "I touch Shadow",
      "Notes": "Haunted Malistaire (1336037) takes over. Only with no enemy circle free: he comes back in his own circle at 48,000 health, phase 2." },

    // Phase 2 is only for when Haunted Malistaire found no circle; his own cheats are in 1336037.json.

    { "When": "RoundEnd", "Phase": 2, "Round": 1, "Every": 4, "Cast": "Shadowblade Self Mob", "Target": "Self", "Line": "I call upon Shadow" },
    { "When": "RoundEnd", "Phase": 2, "Round": 2, "Every": 4, "Cast": "Shadowspear", "Target": "Self", "Line": "I call upon Shadow" },
    { "When": "RoundEnd", "Phase": 2, "Round": 3, "Every": 4, "Cast": "Mass Shadow Trap", "Line": "I call upon Shadow",
      "Notes": "Shadow Trap on all wizards." },
    { "When": "RoundEnd", "Phase": 2, "Round": 4, "Every": 4, "Cast": "NA G14-DM-ShadowMalistaire", "Target": "Enemy",
      "Line": "I will show you the Shadow", "Notes": "Shadow Steal." },
    { "When": "RoundStart", "Phase": 2, "Round": 4, "Every": 4, "Cast": "Malistaire Dragon - Roar",
      "Line": "Its power shakes your spells apart" },
    { "When": "RoundStart", "Phase": 2, "Chance": 20, "Cast": "Malistaire Dragon - Attack", "Target": "Self", "Silent": true,
      "Line": "Curse you beast", "Notes": "Skeletal Dragon now and then puts a +100% trap on his side (guess: the Attack spell). Silent: the spell is a Balance card and its cast should not show." }
  ]
}
