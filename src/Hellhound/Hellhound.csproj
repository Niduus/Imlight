<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hellhound, the bots' own app (Niduus, 2026-11-22: "a standalone exe that does all the same as Ahziael currently does but
    obviously designed around the bots and to be as light as possible"; "this one will just be called Hellhound. Everything bot
    related goes in this and future bot updates go to this one ONLY"). No window toolkit and no packages: one small native exe
    (Native AOT) that shows its page in the browser, on this PC only (127.0.0.1). It works through the same files beside the
    server that Ahziael's Bots pages use, so Ahziael's bot pages can be retired step by step.
  -->
  <PropertyGroup>
    <!-- A Windows program: no black console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hellhound</AssemblyName>
    <RootNamespace>Hellhound</RootNamespace>
    <Version>0.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- Its own icon (Niduus, 2026-11-22: "give Hellhound a image for it's icon"); hellhound.svg is the source. -->
    <ApplicationIcon>hellhound.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="page.html" LogicalName="page.html" />
    <!-- The game's picture reader (DDS and TGA), shared with Ahziael. -->
    <Compile Include="..\Imlight.Setup\GameImage.cs" Link="GameImage.cs" />
  </ItemGroup>

</Project>
