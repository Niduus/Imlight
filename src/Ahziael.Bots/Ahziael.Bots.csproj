<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ahziael Bots (Niduus, 2026-11-22: "a standalone exe that does all the same as Ahziael currently does but obviously designed
    around the bots and to be as light as possible"). No window toolkit and no packages: one small native exe (Native AOT) that
    shows its page in the browser, on this PC only (127.0.0.1). It reads the same files beside the server that Ahziael's Bots
    pages read. First piece: read only, it changes nothing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AhziaelBots</AssemblyName>
    <RootNamespace>Ahziael.Bots</RootNamespace>
    <Version>0.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="page.html" LogicalName="page.html" />
  </ItemGroup>

</Project>
